rule 0 : \s*\\\n\s* =>  
rule 1 : \s*\n\s* =>  
rule 2 : //.* => 
rule 3 : /\*.*?\*/ => 
rule 4 : \b(0[xX][0-9a-fA-F]+|\d+)[uUlL]+\b => \1
