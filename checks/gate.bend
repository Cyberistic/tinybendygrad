# GENERATED by `.agents/slop/shlscope/gen.py --emit-bend`. NOT HAND-WRITTEN: the
# fixtures are written ONCE in the generator and both this file and the CPython
# expectations are emitted from them. The row is one `mm.lift` call printed as a
# PAIR, so the row IS the answer and not a Bool over it.

def ss_row(nm: String, +b: F.Bnd2) -> IO(Unit):
  IO.print(String.concat([nm, " lo=", F.bnd_show(F.Bnd2.lo(b)), " hi=", F.bnd_show(F.Bnd2.hi(b))]))

# THE DIVERGENCE ROWS. Printed, counted, NEVER counted as passes -- the driver
# checks them against the pinned saturation rather than against CPython, because
# CPython's answer is unbounded and no 64-bit pair can hold it.
def ssx_row(nm: String, +b: F.Bnd2) -> IO(Unit):
  IO.print(String.concat([nm, " lo=", F.bnd_show(F.Bnd2.lo(b)), " hi=", F.bnd_show(F.Bnd2.hi(b))]))

# `lf_c2` takes two `Bnd`s and returns two `Bnd2`s, so it cannot say "src0 is a
# COMPUTED pair and src1 is a CONSTANT amount". That is exactly the round trip's
# shape, so this is the one new constructor, and it is the shape `fold.bend` would
# need if the round trip were ever a row of its own rather than of a gate.
def ss_pair(+a: F.Bnd2, +b: F.Bnd) -> List<&2, F.Bnd2>: [a, F.Bnd2{b, b}]

# `(x << k) >> k`, THE PORT'S OWN COMPOSITION. A LOGICAL right shift fails this
# for every negative `x`; an ARITHMETIC left shift fails it for none, so the row
# sees a sign bug on EITHER side at once.
def ss_rt(+x: F.Bnd, +k: F.Bnd) -> F.Bnd2:
  F.mm.lift(O.OpsSHR{}, ss_pair(F.mm.lift(O.OpsSHL{}, F.lf_c2(x, k), O.ANone{}, S.int64()), k), O.ANone{}, S.int64())

