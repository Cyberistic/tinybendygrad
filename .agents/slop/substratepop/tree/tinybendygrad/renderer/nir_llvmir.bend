# nir_llvmir.bend -- tinygrad/renderer/nir.py (321 lines) AND
# tinygrad/renderer/llvmir.py (286 lines).
#
# TWO FILES IN ONE, and the reason is measured rather than convenient: neither
# `nir.py` nor `llvmir.py` emits a string of its own EXCEPT through a template
# over a dtype table (`glsl_type`, `ldt`, `aop`/`lop`, `c`, `ncast`), and a
# dropped literal in a dtype table is exactly the failure the gate exists for.
# `nir.py` is otherwise ENTIRELY mesa ctypes FFI -- `nir_builder_instr_insert`,
# `nir_def_init`, `nir_intrinsic_instr_create` -- so its portable surface is the
# tables, the op-name strings, and the INTRINSIC ARITHMETIC (`num_components`,
# `ALIGN_MUL`, `WRITE_MASK`, `bit_size`, `padded_idx`).
#
# THE CONVENTIONS are `renderer/__init__.bend`'s HEADER, read in full; this file
# obeys all twelve. The four that bite hardest here:
#
#   1. A RENDERER IS A `Data` RECORD OF ITS OPTIONS. Python's `LLVMRenderer` has
#      `abi` / `string_rewrite` / `code_for_op` / `extra_matcher` / `has_local` /
#      the four maxima / `suffix` as class attributes and `AMDLLVMRenderer`
#      replaces five of them. A renderer here is one `Data` record per device
#      (see `Llvm`), constructed once, never mutated -- and the GATE reads the
#      record's fields, so a wrong constant is a moved row rather than a wrong
#      shader nobody diffs.
#   2. THE GATE IS A STRING DIFF, NEVER A BOOLEAN ABOUT STRINGS. Every row is
#      `<name> = [BEND]   py=[CPYTHON]` and every `py=` half is COMPUTED by
#      `.agents/slop/nl/nl-oracle.py` calling live CPython. The `py=` halves
#      below are GENERATED by that same script's `bend` mode -- none is typed.
#      `cstyle.bend` arrived with 215 hand-written expectations of which
#      SEVENTEEN were wrong (five in the oracle, twelve real port bugs), so a
#      typed expectation is an agreement with the author and nothing more.
#   4. A `match` MAY ONLY SCRUTINISE A PARAMETER OR A PATTERN BINDER, so every
#      `Data` field has a hand-written `Type.field` reader (there is no
#      `value.field` sugar and no generated projection: brief rules 26/27) and
#      every dtype test crosses a def boundary as a `Bool`.
#   6. A RECORD LITERAL AND A RECORD PATTERN BOTH NAME EVERY FIELD.
#
# ---------------------------------------------------------------------------
# THE GATE. 205 rows + the one framing newline `IO.print` supplies, all diffed
# byte-for-byte against `.agents/slop/nl/py1.txt`:
#   .venv/bin/python .agents/slop/nl/nl-oracle.py rows > .agents/slop/nl/py1.txt
#   ./bin/bend tinybendygrad/renderer/nir_llvmir.bend > /tmp/nl_i.txt
#   ./bin/bend tinybendygrad/renderer/nir_llvmir.bend -o /tmp/nl && /tmp/nl > /tmp/nl_n.txt
#   diff /tmp/nl_i.txt .agents/slop/nl/py1.txt && diff /tmp/nl_n.txt .agents/slop/nl/py1.txt
# The Bend side prints the WHOLE table with ONE `IO.print`, so `IO.print`'s own
# newline is the only frame and the oracle's single trailing "\n" is its match.
# Both lanes were measured byte-identical to each other AND to the oracle.
#
# CHECK THE ORACLE'S EXIT PATH BEFORE BELIEVING IT. A gate whose oracle emits
# zero rows is not a passing gate, and an oracle has shipped one that printed
# 432 "ALL PROOFS CHECK" rows while emitting none. So the row count IS part of
# the gate here: 205 rows, `wc -l` 206, oracle exit 0. `--check-only` exits 1
# even on a clean file (`dtype.bend`'s 14 unfilled laws), so the acceptance
# test is the DIFF and the FIRST LINE of `--check-only`, never the exit status.
#
# THE `py=` LITERALS ARE GENERATED, NOT TYPED. `nl-oracle.py`'s `bend` mode
# prints the row-builder source under "THE GENERATED ROWS" from the same run that
# prints the gate text, so a change to the ORACLE and a change to the GATE cannot
# disagree. `cstyle.bend` arrived with 215 hand-written expectations of which
# SEVENTEEN were wrong; that is the cost of typing them.
#
# THAT GENERATION IS WHAT PAID FOR THE DTYPE RENAME. When `LAWS/spec.bend`
# renamed `float8_e4m3` -> `fp8e4m3`, `half` -> `f16`, `__bf16` -> `bf16`,
# `float` -> `f32`, `double` -> `f64` and the eight integer C spellings ->
# `i8`..`u64`, CPython's `DType.name` changed with it -- so the oracle's ROW
# NAMES changed, the `py=` halves were regenerated by `bend` mode, and the
# port followed. The regeneration is not cosmetic bookkeeping: 55 of the 79 red
# rows were exactly the rows whose LABEL carries a dtype name. Regenerating is
# also what proves the direction was right -- no `py=` VALUE changed in the
# rename (`ldt(f32)` was `float` before and is `float` now), because `ldt` keys
# on dtype OBJECTS and only the NAME was renamed.
#
# THE MUTATION TABLE is at the foot of the file, measured with
# `.agents/slop/nl/nl-mutate.py` -- 44 mutations, THREE of which are whitespace
# controls that move nothing, and FIVE of which are the `ldt.fp` re-arm
# including M40b, which reproduces the committed defect exactly: it COMPILES,
# prints `ALL PROOFS CHECK`, and answers `KeyError` where CPython answers
# `float`.
#
# ---------------------------------------------------------------------------
# THE STAGES, and what landed in each
#
#   STAGE 1  DONE, 205 rows, both lanes byte-identical to `py1.txt`.
#            `ldt` is re-armed on `Cls`/`bits`/`pri` -- see the note at
#            `ldt.fp` and M40/M40b at the foot of the file.
#            `llvmir.py`'s pure surface. `ldt`'s type map with its `ptr` and
#            `count` arms; `lcast` over the full 14x14 dtype grid in BOTH
#            directions; the three `lop` tables, `lop` itself per dtype and per
#            op, and `flags`; every class constant of `Renderer`,
#            `LLVMRenderer`, `CPULLVMRenderer` and `AMDLLVMRenderer` as a `Data`
#            record with one constructor per device; the three
#            `supported_dtypes` overrides; `llvm_intrinsics`, `code_for_op`,
#            `code_for_workitem`, `barrier`; the naming walk's `%data{slot}` and
#            `%{'local'|'reg'}_{slot}`; the `getelementptr` line of
#            `base_rewrite[0]`; and the AMD `f32_to_fp8` prefix -- which is
#            `llvmir.py`'s ONLY formatter and so is what `fmt` means here.
#   STAGE 2  NOT STARTED. `_render_fn` (:156-160), `_render_footer` (:210, :265),
#            the per-op emitter strings of `base_rewrite` (:77-144) and
#            `_render_kernel`'s naming walk (:161-202).
#   STAGE 3  NOT STARTED. `nir.py`: `glsl_type` (:14), `u_aop`/`s_aop`/`f_aop`
#            (:19-23), `c` (:26), `ncast` (:27-28), `scope` (:83),
#            `padded_idx` (:246), the intrinsic bounds arithmetic
#            (`num_components`, `ALIGN_MUL`, `WRITE_MASK`, `bit_size`), and
#            `NIRRenderer` / `NAKRenderer` / `LVPRenderer` / `IR3Renderer`'s
#            `supported_dtypes` (:244, :253, :321) and `code_for_op` (:119, :262).
#   STAGE 4  NOT STARTED. whatever is left, named.


import Base
import ./__init__.bend as R
import ./../uop/ops.bend as O
import ./../uop/fold.bend as F
import ./../LAWS/spec.bend as S

# ===========================================================================
# THE GATE PRIMITIVES. `r` is `tc_ptx.bend`'s row builder: a row is a VALUE, so
# a group of them is a `String` and the whole gate is one `IO.print`. The `py=`
# half is a LITERAL, which is what makes the diff a diff -- it cannot be the
# same expression as the `got=` half.
#
# `String.concat` DROPS A LITERAL SILENTLY: a `", "` that never made it into the
# list still typechecks, still runs, and emits a line that is wrong rather than
# broken. That is the whole argument for this file's existence.
# ===========================================================================

def r(+nm: String, +got: String, +want: String) -> String:
  String.concat([nm, " = [", got, "]   py=[", want, "]\n"])

def bs(+x: Bool) -> String: Bool.pick(String, x, "True", "False")

# `S.Dt.nm` has no reader in `spec.bend` (four readers exist and `nm` is not one
# of them), so this is the fifth -- `tc_ptx.bend` has the same one and this is
# the MERGE POINT: when `spec.bend` grows `Dt.nm`, both become calls.
def dtn(+d: S.Dt) -> String:
  match d:
    case S.Dt{pri, bits, cls, nm}: nm

def ushow(+xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}   : ""
    case h <> +t : String.concat([U32.show(h), Bool.pick(String, List.is_empty(&2, U32, t), "", ","), ushow(t)])

def unames.go(+ds: List<&2, S.Dt>, acc: List<&2, String>) -> List<&2, String>:
  match ds:
    case Nil{}   : acc
    case d <> +t : unames.go(t, List.append(&2, String, acc, [dtn(d)]))

def unames(+ds: List<&2, S.Dt>) -> String: String.join(unames.go(ds, Nil{}), ",")

# `d in {dtypes.bool, dtypes.uints}` and `d in dtypes.fp8s` -- the two membership
# tests `supported_dtypes` and `ldt` both need. They walk the SAME list the
# renderer walks, so a dtype that is added to `lop`'s keys is automatically in
# these sets; a port with a second copy of `dtypes.fp8s` is a port that can
# disagree with itself.
def named(+nm: String, +ds: List<&2, S.Dt>) -> Bool:
  match ds:
    case d <> +t: Bool.or(String.eq(dtn(d), nm), named(nm, t))
    case Nil{}   : False{}

# ===========================================================================
# STAGE 1a. `ldt` -- llvmir.py:12-17. THE TYPE MAP.
#
#     def ldt(dt:DType, count=1, ptr=False):
#       if ptr: return ldt(dt, count) + "*"
#       if count > 1: return f"<{count} x {ldt(dt, 1, ptr)}>"
#       return {dtypes.void: "void", dtypes.bool: "i1", dtypes.int8: "i8", ..., **{d: "i8" for d in dtypes.fp8s},
#               dtypes.float16: "half", dtypes.bfloat16: "bfloat", dtypes.float32: "float", dtypes.float64: "double"}[dt]
#
# THREE FACTS THE MAP ENCODES, and all three are rows:
#   * `i8` is spelled FIVE TIMES and the four fp8 dtypes SHARE the signed and
#     unsigned 8-bit entry -- `ldt(uchar) == ldt(schar) == ldt(fp8e4m3) == "i8"`.
#     A reader that made the unsigned table wider than the signed one would agree
#     with the map on eleven dtypes and be wrong on eight.
#   * the map has NO KEY for `weakfloat` or `weakint`, and CPython raises
#     `KeyError`. Bend has no exceptions, so the wall is the STRING `"KeyError"`
#     and `ldt weakfloat` / `ldt weakint` are the rows that say so.
#   * `ldt(weakfloat).itemsize` is 100, so a port that computed the integer names
#     from `bits` for EVERY class would answer `i100` rather than `KeyError`.
#     The `Cls` ladder is what keeps the weak classes out of the integer branch.
#
# THE PTR ARM IS NOT A RECURSION HERE. `ldt(dt, count, ptr=True)` calls
# `ldt(dt, count)` and that call can never re-enter the ptr arm -- the depth is
# one -- but the DECREASE CHECKER only sees that `ptr` becomes `False{}`, which
# is not a subterm. So the ptr test is a `Bool.pick` between two calls of a
# NON-RECURSIVE `ldt.v`, and the `String.concat` appends the `"*"` here. That is
# the same "make the flag a parameter and the work a leaf" shape rule 28 asks for,
# reached from the other side: there is no second def of one recursion, there are
# simply two defs and one of them is not recursive.
# ===========================================================================

# `"i" + str(bits)`, the integer arm -- NOT `bits // 8`. The map is
# `int8: "i8", int16: "i16", int32: "i32", int64: "i64"`, so the number after the
# `i` IS THE BIT COUNT. MEASURED: the first port wrote `U32.div(bits, 8)` on the
# reading that `i8` meant "8 bytes", and eight rows answered `i1`, `i2`, `i4`,
# `i8` -- a plausible, wrong, self-consistent table.
#
# And that is EXACTLY why the `Cls` ladder matters: `weakfloat`'s `bits` is 800,
# so a reader that reached the integer arm for a weak dtype would answer `i800`
# where CPython raises `KeyError`. `ldt weakfloat` is that row.
def ldt.ints(bits: U32) -> String: String.concat(["i", U32.show(bits)])

# The eight CFloat members BY WIDTH, then by `pri` for the two 16-bit ones.
# THIS IS THE RE-ARM, AND IT IS THE SAME SHAPE `renderer/llvmir.bend`'s `lt.fp`
# ALREADY CARRIES -- imported rather than reinvented, because a third spelling of
# the same map is a third thing to keep in step with `spec.bend`.
#
# THE OLD LADDER ARMED ON THE dtype NAME -- `"float"`, `"half"`, `"__bf16"`,
# `"double"`, `"float8_e4m3"` and four more -- and `LAWS/spec.bend` has RENAMED
# them to `"f32"`, `"f16"`, `"bf16"`, `"f64"`, `"fp8e4m3"`. Every arm therefore
# stopped matching and fell through to `case _: "KeyError"`: 79 of 205 rows went
# red with the file still compiling and the checker still silent. It sat
# undetected because upstream `dtype.py:140-142` keeps the OLD names as ATTRIBUTE
# ALIASES, so `dtypes.half is dtypes.f16` and nothing raises.
#
# `Cls`, `bits` and `pri` are the fields the rename does not touch. Within
# `CFloat`, `bits == 8` is the fp8 quadruple and every one of them spells `i8`,
# so the four-name collapse is the MAP'S OWN property and not a shortcut:
# `ldt(fp8e4m3) == ldt(i8) == "i8"` is true in CPython too and both are rows.
# `pri` then separates f16 (12) from bf16 (13) from f32 (14) from f64 (15), and
# it separates the two 8-bit pairs (10, 11) as well -- though it does not have
# to, because those two pairs answer the same string either way.
#
# `weakfloat` is `bits == 800` and `weakint` is `bits == 800` with `pri` 9 and 0.
# Neither is `CFloat`, so `ldt.of`'s `Cls` ladder never reaches this def for
# them -- which is why the width test here cannot answer `i8` for a weak float,
# and why `ldt weakfloat` / `ldt weakint` stay `KeyError`.
def ldt.fp(bits: U32, pri: U32) -> String:
  match bits:
    case 8: "i8"
    case _: match pri:
             case 12: "half"
             case 13: "bfloat"
             case 14: "float"
             case _: "double"

# the dict itself. `Cls` is a seven-constructor `Data` union and `match` on it is
# a match on a PARAMETER here, so this ladder is legal; the catch-all covers
# `CWeakInt` and `CWeakFloat`, the two members with no key, and `ldt weakint` /
# `ldt weakfloat` are the rows that make the catch-all LIVE rather than dead.
def ldt.of(+d: S.Dt) -> String:
  match d:
    case S.Dt{pri, bits, cls, nm}:
      match cls:
        case S.CVoid{}  : "void"
        case S.CBool{}  : "i1"
        case S.CUint{}  : ldt.ints(bits)
        case S.CSint{}  : ldt.ints(bits)
        case S.CFloat{} : ldt.fp(bits, pri)
        case _: "KeyError"

# `ldt(dt, count)` with `ptr` False -- the `count > 1` arm and the bare name.
def ldt.v(+d: S.Dt, +count: U32) -> String:
  Bool.pick(String, U32.is_gt(count, 1), String.concat(["<", U32.show(count), " x ", ldt.of(d), ">"]), ldt.of(d))

# `ldt(dt, count, ptr)` -- llvmir.py:12. See the note above: NOT a self-call.
def ldt.t(+d: S.Dt, +count: U32, ptr: Bool) -> String:
  Bool.pick(String, ptr, String.concat([ldt.v(d, count), "*"]), ldt.v(d, count))

# ===========================================================================
# STAGE 1b. `lcast` -- llvmir.py:26-36. THE CAST TABLE, 14x14.
#
#     if dtypes.is_float(input_type):
#       if dtypes.is_float(output_type): return 'fpext' if output_type.itemsize > input_type.itemsize else 'fptrunc'
#       if dtypes.is_int(output_type):   return 'fptoui' if dtypes.is_unsigned(output_type) else 'fptosi'
#     if dtypes.is_unsigned(input_type) or dtypes.is_bool(input_type):
#       if dtypes.is_float(output_type): return 'uitofp'
#       if dtypes.is_int(output_type):   return 'trunc' if output_type.itemsize < input_type.itemsize else 'zext'
#     if dtypes.is_int(input_type):
#       if dtypes.is_float(output_type): return 'sitofp'
#       if dtypes.is_int(output_type):   return 'trunc' if output_type.itemsize < input_type.itemsize else 'sext'
#     raise NotImplementedError(...)
#
# THE FALL-THROUGH IS REAL and it is the whole shape. Python's three top-level
# `if`s have no `else`, so the first one reaching a dtype it cannot handle does
# NOT return -- it falls into the second, and the second into the third. A port
# that read the three as three exclusive arms would answer `fptrunc` for
# `float -> bool`, where CPython raises: `is_float(bool)` is False, so control
# leaves the first `if` entirely.
#
# `Bool.pick` IS the fall-through: each arm is "this clause fired" and the
# otherwise-arm is the CONTINUATION. `NI` is the wall marker -- CPython raises
# `NotImplementedError` and Bend has no exceptions, so the port answers the
# exception's NAME. `lcast.a void` and `lcast.b void` are the rows that make
# every `NI` reachable, and `lcast.b bool` is the row that makes the fall-through
# itself reachable: `float -> bool` is the ONLY pair where clause 1 is entered
# and answers nothing.
#
# `is_bool` is spelled `Cls.is_bool` and `is_int` is `Dt.is_int`, which counts
# `CWeakInt` -- so `void -> int32` is `NI` here, and `lcast.a void` says so for
# all fourteen outputs.
# ===========================================================================

def NI() -> String: "NotImplementedError"

# the SECOND and THIRD top-level `if`s, llvmir.py:30-35.
def lcast.b(+it: S.Dt, +ot: S.Dt) -> String:
  Bool.pick(String, Bool.or(S.Dt.is_unsigned(it), S.Dt.is_bool(it)),
    Bool.pick(String, S.Dt.is_float(ot), "uitofp",
      Bool.pick(String, S.Dt.is_int(ot),
        Bool.pick(String, U32.is_lt(S.Dt.itemsize(ot), S.Dt.itemsize(it)), "trunc", "zext"), NI())),
    Bool.pick(String, S.Dt.is_int(it),
      Bool.pick(String, S.Dt.is_float(ot), "sitofp",
        Bool.pick(String, S.Dt.is_int(ot),
          Bool.pick(String, U32.is_lt(S.Dt.itemsize(ot), S.Dt.itemsize(it)), "trunc", "sext"), NI())),
      NI()))

# `lcast` -- llvmir.py:26. `.b` is the continuation, declared FIRST because a def
# may only call defs above it.
def lcast.a(+it: S.Dt, +ot: S.Dt) -> String:
  Bool.pick(String, S.Dt.is_float(it),
    Bool.pick(String, S.Dt.is_float(ot),
      Bool.pick(String, U32.is_gt(S.Dt.itemsize(ot), S.Dt.itemsize(it)), "fpext", "fptrunc"),
      Bool.pick(String, S.Dt.is_int(ot), Bool.pick(String, S.Dt.is_unsigned(ot), "fptoui", "fptosi"), NI())),
    lcast.b(it, ot))

# ===========================================================================
# STAGE 1c. `lop` -- llvmir.py:67-75. THE ALU OP TABLE, 17 dtypes x 13 ops.
#
#     unsigned_lop = {ADD:"add", MUL:"mul", CDIV:"udiv", CMOD:"urem", CMPLT:"icmp ult", ...}
#     signed_lop   = {**unsigned_lop, ADD:"add nsw", CMPLT:"icmp slt", CDIV:"sdiv", CMOD:"srem", SHR:"ashr"}
#     float_lop    = {ADD:"fadd"+flags, MUL:"fmul"+flags, CMPLT:fcmp+flags+" olt", ...}
#     lop          = {**{x:unsigned_lop for x in (dtypes.bool,)+dtypes.uints},
#                     **{x:signed_lop for x in dtypes.sints}, **{x:float_lop for x in dtypes.floats}}
#
# FOUR FACTS THE TABLE ENCODES:
#   * `flags` is `" nsz arcp contract afn"` with a LEADING SPACE, and it is
#     concatenated onto five of the six float entries. It is a row of its own
#     (`lop.flags`) precisely so that a dropped space is a moved row.
#   * `signed_lop` is `{**unsigned_lop, ...}`, so it has the SAME TWELVE KEYS in
#     the SAME ORDER and only five values differ. A port that spelled the signed
#     table out independently would have twelve chances to disagree on the seven
#     shared values -- which is why the three tables here are three LADDERS over
#     thirteen ops and not three tables of literals.
#   * `float_lop` has SIX keys and the other two have TWELVE, so `lop[float]` has
#     no `CDIV` and `lop[int8]` has no `FDIV`. `lop float` / `lop signed char`
#     carry the whole per-dtype list in one row, which is where a wrong KEY set
#     is visible; `lop.op FDIV` is the row that shows which dtypes HAVE it.
#   * `lop`'s KEYS are in INSERTION order -- bool + uints, then sints, then
#     floats -- and `lop.keys` is that order, not a sorted one, so the gate is
#     positional. The three key LISTS below are that order, one per table.
#
# A dtype is UNSIGNED-or-BOOL, SIGNED, or FLOAT; those are the three tests the
# dispatch needs, and `Dts` is the per-table dtype list the op-direction rows
# walk. `S.Dt.is_bool` and `S.Dt.is_unsigned` are disjoint, so `Bool.or` of the
# two is the `(dtypes.bool,)+dtypes.uints` membership and needs no third class.
# ===========================================================================

def ldt.flags() -> String: " nsz arcp contract afn"

def ulop(op: O.Op) -> String:
  match op:
    case O.OpsADD{}  : "add"
    case O.OpsMUL{}  : "mul"
    case O.OpsCDIV{} : "udiv"
    case O.OpsCMOD{} : "urem"
    case O.OpsCMPLT{}: "icmp ult"
    case O.OpsCMPNE{}: "icmp ne"
    case O.OpsCMPEQ{}: "icmp eq"
    case O.OpsOR{}   : "or"
    case O.OpsAND{}  : "and"
    case O.OpsXOR{}  : "xor"
    case O.OpsSHL{}  : "shl"
    case O.OpsSHR{}  : "lshr"
    case _: "?"

# `signed_lop` overrides FIVE of `unsigned_lop`'s twelve and inherits seven.
def slop(op: O.Op) -> String:
  match op:
    case O.OpsADD{}  : "add nsw"
    case O.OpsMUL{}  : "mul"
    case O.OpsCDIV{} : "sdiv"
    case O.OpsCMOD{} : "srem"
    case O.OpsCMPLT{}: "icmp slt"
    case O.OpsCMPNE{}: "icmp ne"
    case O.OpsCMPEQ{}: "icmp eq"
    case O.OpsOR{}   : "or"
    case O.OpsAND{}  : "and"
    case O.OpsXOR{}  : "xor"
    case O.OpsSHL{}  : "shl"
    case O.OpsSHR{}  : "ashr"
    case _: "?"

# the SIX keys, in dict order, and the FIVE that take `flags`.
def flop.f(op: O.Op) -> String:
  match op:
    case O.OpsADD{}  : String.concat(["fadd", ldt.flags()])
    case O.OpsMUL{}  : String.concat(["fmul", ldt.flags()])
    case O.OpsCMPLT{}: String.concat(["fcmp", ldt.flags(), " olt"])
    case O.OpsCMPNE{}: String.concat(["fcmp", ldt.flags(), " une"])
    case O.OpsCMPEQ{}: String.concat(["fcmp", ldt.flags(), " oeq"])
    case O.OpsFDIV{} : String.concat(["fdiv", ldt.flags()])
    case _: "?"

# `lop[dt][op]`. The two `Bool` crosses are the dispatch: `uf` is
# `(dtypes.bool,)+dtypes.uints` and `sf` is `dtypes.floats`, and `sf` is tested
# SECOND so a float can never reach `slop`.
def lop.of(uf: Bool, sf: Bool, +op: O.Op) -> String:
  Bool.pick(String, uf, ulop(op), Bool.pick(String, sf, flop.f(op), slop(op)))

def lop.uf(+d: S.Dt) -> Bool: Bool.or(S.Dt.is_bool(d), S.Dt.is_unsigned(d))

def lop.cell(+d: S.Dt, +op: O.Op) -> String: lop.of(lop.uf(d), S.Dt.is_float(d), op)

# --- the three OP LISTS, each in its dict's own insertion order
def lops.uf() -> List<&2, O.Op>:
  [O.OpsADD{}, O.OpsMUL{}, O.OpsCDIV{}, O.OpsCMOD{}, O.OpsCMPLT{}, O.OpsCMPNE{}, O.OpsCMPEQ{},
   O.OpsOR{}, O.OpsAND{}, O.OpsXOR{}, O.OpsSHL{}, O.OpsSHR{}]

def lops.sf() -> List<&2, O.Op>:
  [O.OpsADD{}, O.OpsMUL{}, O.OpsCMPLT{}, O.OpsCMPNE{}, O.OpsCMPEQ{}, O.OpsFDIV{}]

def lops.uf6() -> List<&2, O.Op>: lops.uf()

# --- the three DTYPE LISTS, `lop`'s keys in insertion order
def dts.uf() -> List<&2, S.Dt>: [S.boolean(), S.uint8(), S.uint16(), S.uint32(), S.uint64()]

def dts.sf() -> List<&2, S.Dt>: [S.int8(), S.int16(), S.int32(), S.int64()]

def dts.ff() -> List<&2, S.Dt>:
  [S.fp8e4m3(), S.fp8e5m2(), S.fp8e4m3fnuz(), S.fp8e5m2fnuz(), S.half(), S.bfloat16(), S.single(), S.double()]

# the ops a DTYPE's table has. `uf` and `sf` name the table the way `lop_of` does.
def lop.ops(uf: Bool, sf: Bool) -> List<&2, O.Op>: Bool.pick(List<&2, O.Op>, sf, lops.sf(), lops.uf6())

def lop.ops_of(+d: S.Dt) -> List<&2, O.Op>: lop.ops(lop.uf(d), S.Dt.is_float(d))

# --- one "OP=name" cell
def lop.pair(+d: S.Dt, +op: O.Op) -> String: String.concat([O.Ops.name.of(op), "=", lop.cell(d, op)])

# `",".join` over the table, and the fold is HAND-ROLLED rather than
# `List.foldl`. MEASURED, and it is a refinement of the `List.foldl` note: the
# STEP is also a `~` template position, so a step that needs a runtime parameter
# cannot be a `~`-position def reference NOR a partial application --
#     List.foldl(~&2, ~U32, ~List<&2, U32>, step(k), xs, Nil{})
#     #| - expected : a template applied to closed ~ arguments
#     #|               (k is a variable here, not comptime: pass it at run time)
# `step(k)` is a def CALL and a call is not closed. So the two folds that need a
# dtype (`lop.row` and `lop.orow`) walk by hand, and the one that does not
# (`unames`, above) would be a `foldl`.
#
# The separator is `List.append(acc, [cell])` per element plus ONE `String.join`
# at the end. A baked-in separator is the spelling that drops the head and
# leaves a trailing one, and it is what `lop.pairs.go`'s accumulator type is
# chosen to make impossible: the accumulator is a LIST of cells, not a String.
def lop.pairs.go(+os: List<&2, O.Op>, +d: S.Dt, acc: List<&2, String>) -> List<&2, String>:
  match os:
    case Nil{}   : acc
    case o <> +t : lop.pairs.go(t, d, List.append(&2, String, acc, [lop.pair(d, o)]))

def lop.row(+d: S.Dt) -> String: String.join(lop.pairs.go(lop.ops_of(d), d, Nil{}), ",")

# `lop.keys` in INSERTION order: (bool + uints) ++ sints ++ floats.
def lop.keys() -> List<&2, S.Dt>:
  List.concat(&2, S.Dt, [dts.uf(), dts.sf(), dts.ff()])

# THE OP DIRECTION. `lop[dt][FDIV]` exists for the EIGHT floats and for nothing
# else, and `lop[dt][CDIV]` for the NINE non-floats -- so the dtype list an op
# row walks is chosen by membership in `float_lop`, and `lop.op FDIV` /
# `lop.op CDIV` are the two rows that separate the two key sets.
def lop.has_f(+op: O.Op) -> Bool: List.contains(~O.Op, O.eq_op, lops.sf(), op)

# `lop[dt][op]` EXISTS IFF `op in float_lop` FOR A FLOAT and `op in
# unsigned_lop` FOR AN INTEGER -- TWO DIFFERENT KEY SETS, and that is the whole
# rule. `float_lop` has SIX keys, the integer tables TWELVE, and the two OVERLAP
# in five: ADD, MUL, CMPLT, CMPNE and CMPEQ are in all three tables, so those five
# ops exist for EVERY dtype. FDIV is the only op that is in the float table and
# not in the integer ones.
#
# The first port spelled this as an XNOR (`is_float(d) == op in float_lop`), which
# is wrong for the five shared ops: it drops every integer dtype from `lop.op ADD`
# and the row came back with eight entries where CPython has seventeen. `lop.op
# ADD`, `lop.op CMPLT` and `lop.op FDIV` are the three rows that see the three
# cases.
def lop.has_u(+op: O.Op) -> Bool: List.contains(~O.Op, O.eq_op, lops.uf(), op)

def lop.has(+op: O.Op, +d: S.Dt) -> Bool:
  Bool.pick(Bool, S.Dt.is_float(d), lop.has_f(op), lop.has_u(op))

# THE ORDER IS `dtypes.all`'s, NOT `lop`'s. `lop`'s keys are (bool + uints) ++
# sints ++ floats, so rebuilding the list per op would put `bool` first on the
# twelve shared ops where CPython's row puts it LAST -- a diff in every one of
# the thirteen op rows for no reason at all. `R.dtypes_all()` is the one order
# both sides agree on and `lop.has_f` is the filter.
#
# THE FIRST PORT FILTERED WITH A FOLD ACCUMULATOR THAT WAS NEVER SET: it started
# `False{}`, nothing ever set it, and `Bool.and(False{}, _)` is `False{}`. So all
# thirteen op rows came back EMPTY. It typechecked, it ran, and
# `String.join(Nil{}, ",")` is `""` -- a plausible row shape with nothing in it.
# That is the "pin a COUNT, not a boolean" note paying for itself again, and it
# is why there is NO accumulator here at all.
def lop.dts.go(+ds: List<&2, S.Dt>, +op: O.Op, acc: List<&2, S.Dt>) -> List<&2, S.Dt>:
  match ds:
    case Nil{}   : acc
    case d <> +t :
      +rest = lop.dts.go(t, op, acc)
      Bool.pick(List<&2, S.Dt>, lop.has(op, d), List.append(&2, S.Dt, [d], rest), rest)

def lop.dts_of(+op: O.Op) -> List<&2, S.Dt>: lop.dts.go(R.dtypes_all(), op, Nil{})

def lop.ocell(+d: S.Dt, +op: O.Op) -> String: String.concat([dtn(d), "=", lop.cell(d, op)])

def lop.ors.go(+ds: List<&2, S.Dt>, +op: O.Op, acc: List<&2, String>) -> List<&2, String>:
  match ds:
    case Nil{}   : acc
    case d <> +t : lop.ors.go(t, op, List.append(&2, String, acc, [lop.ocell(d, op)]))

def lop.orow(+op: O.Op) -> String: String.join(lop.ors.go(lop.dts_of(op), op, Nil{}), ",")

# ===========================================================================
# STAGE 1d. THE RENDERER AS A RECORD OF ITS OPTIONS -- llvmir.py:146-155,
# 204-231, 226-247.
#
# `Renderer` carries fifteen attributes, `LLVMRenderer` overrides three and
# `AMDLLVMRenderer` overrides five. Python's "override" is a class attribute
# being rebound; Bend has no inheritance, so a `Data` record plus ONE
# CONSTRUCTOR PER DEVICE IS the inheritance, and `llvm_of` IS `Renderer`'s own
# record because `LLVMRenderer` overrides nothing it inherits.
#
# `LLVMRenderer.abi` is an ANNOTATION and not a value (llvmir.py:147), so
# `getattr(LLVMRenderer, 'abi')` raises `AttributeError` and `_render_fn`'s
# `self.abi` would raise too: the base class is abstract in that field. A `Data`
# field cannot be absent, so `has_abi: Bool` IS the absent case -- convention 3's
# flatten, and `llvm.abi = [AttributeError]` is the row that keeps it honest
# instead of letting the record answer `None` where CPython raises.
#
# `global_prod_max` is `tuple|None` and convention 3 says the same thing about
# it: `gpmax_has: Bool` plus `gpmax`. `shared_max` is an INT in Python and a
# `U32` here, so `smax` is one field and not a one-element list.
# ===========================================================================

type Llvm is Data:
  Llvm{has_abi: Bool, abi: U32, has_local: Bool, has_shared: Bool, suffix: String,
       gmax: List<&2, U32>, lmax: List<&2, U32>, gpmax_has: Bool, gpmax: List<&2, U32>, smax: U32}

def Llvm.has_abi(x: Llvm) -> Bool:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: has_abi

def Llvm.abi(x: Llvm) -> U32:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: abi

def Llvm.has_local(x: Llvm) -> Bool:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: has_local

def Llvm.has_shared(x: Llvm) -> Bool:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: has_shared

def Llvm.suffix(x: Llvm) -> String:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: suffix

def Llvm.gmax(x: Llvm) -> List<&2, U32>:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: gmax

def Llvm.lmax(x: Llvm) -> List<&2, U32>:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: lmax

def Llvm.gpmax_has(x: Llvm) -> Bool:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: gpmax_has

def Llvm.gpmax(x: Llvm) -> List<&2, U32>:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: gpmax

def Llvm.smax(x: Llvm) -> U32:
  match x:
    case Llvm{has_abi, abi, has_local, has_shared, suffix, gmax, lmax, gpmax_has, gpmax, smax}: smax

# `abi` as Python SPELLS it: `None`, or `amdgpu_kernel`, or the AttributeError
# marker for the base that has no value at all. The `U32` tag is 0/1 because
# those are the only two on this tree -- `CPULLVMRenderer.abi` is `None` on
# every platform that is not win32 and `'win64cc'` on win32 (:207), and win32 is
# not a target this gate can ask CPython about.
def abi_str(has: Bool, tag: U32) -> String:
  Bool.pick(String, has, Bool.pick(String, U32.is_eq(tag, 1), "amdgpu_kernel", "None"), "AttributeError")

# `Renderer`'s OWN record -- llvmir.py:279-87 read through __init__.bend.
def Renderer_of() -> Llvm:
  Llvm{False{}, 0, True{}, True{}, "", [2415919103, 2415919103, 2415919103], [2415919103, 2415919103, 2415919103],
       False{}, Nil{}, 32768}

# `LLVMRenderer` -- llvmir.py:146-155. It overrides NOTHING it inherits, which is
# a fact the gate can see: `llvm.global_max` and `base.global_max` are the same
# string, and a constructor that "overrode" one would move four rows.
def llvm_of() -> Llvm: Renderer_of()

# `CPULLVMRenderer` -- llvmir.py:204-219. `has_local = False`,
# `global_max = (1, 0, 0)`, `abi = None` on darwin.
def cpullvm_of() -> Llvm:
  Llvm{True{}, 0, False{}, True{}, "", [1, 0, 0], [2415919103, 2415919103, 2415919103], False{}, Nil{}, 32768}

# `AMDLLVMRenderer` -- llvmir.py:226-231. `global_max`, `global_prod_max` and
# `shared_max` come from `HIPRenderer` and `abi` is `"amdgpu_kernel"`.
def amd_of() -> Llvm:
  Llvm{True{}, 1, True{}, True{}, "", [2147483647, 65535, 65535], [2415919103, 2415919103, 2415919103],
       True{}, [4294967295, 4294967295, 4294967295], 65536}

# `llvm_intrinsics` -- llvmir.py:225. Three ops to three llvm names, in dict
# order, and `code_for_op` is `{**LLVMRenderer.code_for_op, **intrinsics}` so
# `amd.code_for_op` has SIXTEEN keys where the base has THIRTEEN.
def intr_of(+op: O.Op) -> String:
  match op:
    case O.OpsSQRT{}: "sqrt"
    case O.OpsLOG2{}: "log2"
    case O.OpsEXP2{}: "exp2"
    case _: "?"

def intrs() -> List<&2, O.Op>: [O.OpsSQRT{}, O.OpsLOG2{}, O.OpsEXP2{}]

# `code_for_op = {k:lambda:None for v in lop.values() for k in v.keys()}` --
# llvmir.py:149. The THIRTEEN keys are the union of the three tables, which is
# `lops.uf() ++ [FDIV]`, and the values are all `None` so the key SET is the
# whole answer. `amd` ADDS `llvm_intrinsics` and the row count is the gate.
def cfo_base() -> List<&2, O.Op>: List.append(&2, O.Op, lops.uf(), [O.OpsFDIV{}])

def cfo_amd() -> List<&2, O.Op>: List.append(&2, O.Op, cfo_base(), intrs())

# `code_for_workitem` -- llvmir.py:222-223. `chr(120 + int(x))` is the lane
# letter, so x is a WIDTH and the name depends on which of `g`/`l` asked.
def lane_chr(+x: U32) -> String:
  Bool.pick(String, U32.is_eq(x, 0), "x", Bool.pick(String, U32.is_eq(x, 1), "y", "z"))

def wi(is_l: Bool, x: U32) -> String:
  String.concat(["tail call i32 @llvm.amdgcn.", Bool.pick(String, is_l, "workitem", "workgroup"), ".id.",
    lane_chr(x), "()"])

# `barrier` -- llvmir.py:221. THREE newlines, so it is a LIST of three strings
# and `barrier.lines` is 4 -- the fourth element being the empty tail, which is
# the trailing newline CPython's constant carries. `barrier[3] = []` is that row
# and dropping it is a moved row rather than a silent loss.
# The TWO QUOTES are the load-bearing part of `syncscope("workgroup")`: a
# `syncscope(workgroup)` without them is a different LLVM attribute and a
# perfectly plausible string, which is why `barrier[0]` and `barrier[2]` are rows
# and not a count.
def barrier() -> List<&2, String>:
  [String.concat(["fence syncscope(\"workgroup\") release"]),
   "tail call void @llvm.amdgcn.s.barrier()",
   "fence syncscope(\"workgroup\") acquire", ""]

# ===========================================================================
# STAGE 1e. `supported_dtypes` -- llvmir.py:217-219 and :286.
#
#     # CPULLVMRenderer
#     return {d for d in super().supported_dtypes() if
#             (d != dtypes.bfloat16 or self.target.arch.startswith(("x86", "arm"))) and
#             (d != dtypes.half or OSX) and d not in dtypes.fp8s}
#     # AMDLLVMRenderer
#     return {d for d in super().supported_dtypes() if d not in dtypes.fp8s or d in amd_fp8s(self.target.arch)}
#
# THREE THINGS COME IN AS PARAMETERS, and each is a wall of its own:
#   * `arch.startswith(("x86", "arm"))` -- Bend has `String.starts_with`, which
#     takes ONE prefix, so the tuple is two tests or-ed. A `Bool` is what the
#     row asks for, and `sd cpullvm riscv64` is the fixture that says the
#     conjunction is a conjunction: riscv64 has NEITHER prefix.
#   * `OSX` is a `helpers` CONSTANT (`OSX = ...`), imported into llvmir's
#     namespace, and the gate sets `llvmir.OSX` rather than reading it -- so the
#     parameter is honest and both cells are gated (`osx True` / `osx False`).
#   * `amd_fp8s(arch)` is a `cstyle.bend` table. Its only non-empty answer on this
#     tree is gfx942's FNUZ PAIR, so the port takes the MEMBERSHIP as a `Bool` and
#     `sd amd gfx942` is the row that shows the difference. The alternative --
#     spelling out four gates -- would be `cstyle.bend`'s table, and this file
#     does not own it.
#
# `super().supported_dtypes()` is `__init__.bend`'s `supported_dtypes(emu)`, so
# both overrides READ THE SAME LIST and neither can drift from the base. The base
# itself is `sd base`, and it is `__init__.bend`'s row `sd empty` re-checked here
# so a change to that file shows up in this diff too.
# ===========================================================================

def fp8s() -> List<&2, S.Dt>: [S.fp8e4m3(), S.fp8e5m2(), S.fp8e4m3fnuz(), S.fp8e5m2fnuz()]

# `amd_fp8s(arch)` on this tree is the FNUZ PAIR and nothing else, so it is its
# own list here rather than a second spelling of the fp8 set.
def fnuzs() -> List<&2, S.Dt>: [S.fp8e4m3fnuz(), S.fp8e5m2fnuz()]

def is_fnuz(+d: S.Dt) -> Bool: List.contains(~S.Dt, O.eq_dt, fnuzs(), d)


# `d not in dtypes.fp8s`. `List.contains(~A, eq, xs, +x)` takes a DEF and a list
# and ONE `+` element, and the `+` on `x` is a REQUIREMENT ON THE CALLER -- so
# `d` is `+` here and at every caller. One copy of the four-name set, which is
# what `ldt.fp`'s four `i8` arms and this share.
def is_fp8(+d: S.Dt) -> Bool: List.contains(~S.Dt, O.eq_dt, fp8s(), d)

def sd_base() -> List<&2, S.Dt>: R.supported_dtypes(Nil{})

# `(d != bfloat16 or x86) and (d != half or osx) and d not in fp8s` --
# llvmir.py:217-219. The `is_fp8` call makes `d` reusable, hence `+d`.
def sd.drop_cpu(+d: S.Dt, x86: Bool, osx: Bool) -> Bool:
  Bool.or(Bool.or(Bool.and(O.eq_dt(d, S.bfloat16()), Bool.not(x86)),
                  Bool.and(O.eq_dt(d, S.half()), Bool.not(osx))), is_fp8(d))

# `d not in fp8s or d in amd_fp8s(arch)` -- llvmir.py:286. ONE conjunct where
# the CPU renderer has three, and `sd amd gfx942` is the only row that can tell
# the two apart from `sd amd gfx1100`.
def sd.drop_amd(+d: S.Dt, fnuz: Bool) -> Bool:
  Bool.and(is_fp8(d), Bool.not(Bool.and(fnuz, is_fnuz(d))))

# `Bool.pick` ANSWERS ITS SECOND ARGUMENT WHEN THE CONDITION IS TRUE, so a
# KEEP filter is `Bool.pick(..., keep(d), [d] ++ rest, rest)`. The first port
# passed `drop(d)` -- the predicate's own name -- and `supported_dtypes` came back
# as the four fp8 dtypes, which is exactly the set the filter is supposed to
# REMOVE. The row that caught it is `sd cpullvm x86_64 osx True`: every other
# dtype dropped and the fp8s survived.
#
# TWO FOLDS, NOT ONE PREDICATE ARGUMENT. `Bool.pick` is STRICT, so passing
# `sd.drop_cpu(h, x86, osx)` as the `Bool` argument of a generic filter would run
# it on every element and then throw the answer away -- and `Bool.pick`'s arms
# would need the SAME predicate twice. So the flag rides the walk and the arm
# calls the predicate, which is `sd.cpu.go`'s and `sd.amd.go`'s only difference.
# `List.append(&2, S.Dt, [h], rest)` is `[h] ++ rest`: the KEPT element goes in
# FRONT, which is what a Python set-comprehension filter preserves.
def sd.cpu.go(+ts: List<&2, S.Dt>, +x86: Bool, +osx: Bool) -> List<&2, S.Dt>:
  match ts:
    case Nil{}   : Nil{}
    case h <> +t :
      +rest = sd.cpu.go(t, x86, osx)
      Bool.pick(List<&2, S.Dt>, Bool.not(sd.drop_cpu(h, x86, osx)), List.append(&2, S.Dt, [h], rest), rest)

def sd.amd.go(+ts: List<&2, S.Dt>, +fnuz: Bool) -> List<&2, S.Dt>:
  match ts:
    case Nil{}   : Nil{}
    case h <> +t :
      +rest = sd.amd.go(t, fnuz)
      Bool.pick(List<&2, S.Dt>, Bool.not(sd.drop_amd(h, fnuz)), List.append(&2, S.Dt, [h], rest), rest)



# ===========================================================================
# STAGE 1f. THE NAMING WALK'S TWO NAMES -- llvmir.py:178 and :181.
#
#     r[u] = f"%data{u.arg.slot}"
#     r[u] = f"%{'local' if u.addrspace == AddrSpace.LOCAL else 'reg'}_{str(u.arg.slot)}"
#
# THE SECOND IS A THREE-WAY AGREEMENT: `LOCAL` is spelled `local` and GLOBAL,
# REG and ALU all read `reg`. A reader that tested `!= GLOBAL`, or `is REG`, or
# inverted the test, still answers `%reg_5` on two of the four fixtures -- and
# `name buffer global` / `name buffer reg` / `name buffer alu` are three rows
# that all read `%reg_5`, with `name buffer local` the only one that differs.
# That is the "a gate COLUMN that is constant over the whole suite is a column no
# mutation can move" note in its sharpest form: three rows here are CONSTANT by
# construction, and the mutation table says so rather than claiming credit.
# ===========================================================================

def nm_param(slot: U32) -> String: String.concat(["%data", U32.show(slot)])

def nm_buf(is_local: Bool, slot: U32) -> String:
  String.concat(["%", Bool.pick(String, is_local, "local", "reg"), "_", U32.show(slot)])

# ===========================================================================
# STAGE 1g. `base_rewrite[0]` -- llvmir.py:79-80, THE GETELEMENTPTR LINE.
#
#     f"  {ctx[x]} = getelementptr inbounds {ldt(x.dtype)}, {ldt(x.dtype, ptr=True)} {ctx[x.src[0]]}, "
#     f"{ldt(x.src[1].dtype)} {ctx[x.src[1]]}"
#
# FOUR `ldt` CALLS and they are NOT the same call: the element type takes the
# buffer's count, the POINTER takes the same count AND `ptr=True`, and the index
# takes its OWN dtype at count 1. A fixture with count 1 cannot tell the first two
# apart, which is why `gep %v0 floatx4 long` and `gep %v9 __bf16x8 unsigned long`
# carry counts 4 and 8: `<4 x float>, <4 x float>*` versus a bare `float, float*`
# is a whole different line.
# ===========================================================================

def gep_line(+xn: String, +d: S.Dt, +cnt: U32, +s0: String, +d1: S.Dt, +s1: String) -> String:
  String.concat(["  ", xn, " = getelementptr inbounds ", ldt.t(d, cnt, False{}), ", ", ldt.t(d, cnt, True{}), " ",
    s0, ", ", ldt.t(d1, 1, False{}), " ", s1])

# ===========================================================================
# STAGE 1h. THE `f32_to_fp8` PREFIX -- llvmir.py:252-263. THIS IS WHAT `fmt`
# MEANS FOR THIS FILE: `llvmir.py` has no `fmt` of its own (that is `ptx.py`'s),
# and this prefix is its one formatter.
#
#     prefix = [f"""define i8 @f32_to_fp8(float %val, i1 %is_bf8) {{
#     entry: %ival = ... ... exit: %packed = phi i32 [...]
#     %trunc = trunc i32 %packed to i8\n  ret i8 %trunc
#     }}""".replace(": ", ":\n  ")] if has_fp8 else []
#
# THE `.replace(": ", ":\n  ")` IS THE WHOLE OF THE FORMATTING and it is EIGHT
# substitutions on a twenty-line raw string, which turn `label: rest` into
# `label:` / `  rest` -- twenty lines become TWENTY-EIGHT. `String.split` takes a
# single `Char`, so the two-character separator is split by hand below; that is
# the honest cost of `String.replace` not existing, and `fp8_split` is a real def
# rather than the 28 literals the first draft would have used.
#
# `fp8_max` is `amd_fp8s(arch)[0].max`, which is a FLOAT, and CPython's `{fp8_max}`
# spells it `240.0` while `F32.show(240.0)` is `240`. So the port takes the max as
# an ALREADY-SPELLED STRING and `f32show 240.0` is the named row that says where
# the `.0` went -- convention 10, a wall with a name rather than a plausible
# wrong string.
#
# LINE 12 CARRIES FOUR TRAILING SPACES after `float -{fp8_max})`, from
# llvmir.py:258. The gate does not strip them: both sides are CPython's bytes, and
# `diff` is byte-exact. That is the point of a byte diff (the `creation.bend`
# rule 22 argument runs the other way, for a printer INHERITED from another file).
# ===========================================================================

def nl() -> String: String.from_list([Char.from_u32(10)])

def sp4() -> String: String.repeat(" ", 4n)

def fp8_raw(+mx: String) -> String:
  String.concat(["define i8 @f32_to_fp8(float %val, i1 %is_bf8) {",
    nl(), "entry: %ival = bitcast float %val to i32", nl(), "  %exp = and i32 %ival, 2139095040", nl(),
    "  %is_special = icmp eq i32 %exp, 2139095040", nl(),
    "br i1 %is_special, label %select_clip, label %clip", nl(), "clip: br i1 %is_bf8, label %bf8_clip, label %fp8_clip",
    nl(), "bf8_clip: %clamped_bf8 = call float @llvm.amdgcn.fmed3.f32(float %val, float 57344.0, float -57344.0)",
    nl(), "  br label %select_clip", nl(),
    "fp8_clip: %clamped_fp8 = call float @llvm.amdgcn.fmed3.f32(float %val, float ", mx, ", float -", mx, ")",
    sp4(), nl(), "  br label %select_clip", nl(),
    "select_clip: %phi_val = phi float [%val, %entry], [%clamped_bf8, %bf8_clip], [%clamped_fp8, %fp8_clip]",
    nl(), "  br i1 %is_bf8, label %do_bf8, label %do_fp8", nl(),
    "do_bf8: %packed_bf8 = call i32 @llvm.amdgcn.cvt.pk.bf8.f32(float %phi_val, float %phi_val, i32 0, i1 false)",
    nl(), "  br label %exit", nl(),
    "do_fp8: %packed_fp8 = call i32 @llvm.amdgcn.cvt.pk.fp8.f32(float %phi_val, float %phi_val, i32 0, i1 false)",
    nl(), "  br label %exit", nl(), "exit: %packed = phi i32 [%packed_bf8, %do_bf8], [%packed_fp8, %do_fp8]",
    nl(), "  %trunc = trunc i32 %packed to i8", nl(), "  ret i8 %trunc", nl(), "}"])

# `str.replace(": ", ":\n  ")` as a char walk. `String.split` takes ONE `Char` and
# there is no `String.replace`, so a two-Char separator is hand-walked.
#
# THE SEPARATOR'S SECOND CHARACTER IS CONSUMED, AND THAT IS THE WHOLE PROBLEM.
# The first version matched `':'` followed by `' '` and emitted `":" + nl + "  "`
# from a recursion on the tail -- and the tail STILL BEGAN WITH THE SPACE, so
# every label body came out indented THREE spaces and `fp8 prefix[2]` read
# `   %ival = bitcast float %val to i32` where CPython reads two. Four rows a
# human would have squinted at and a byte diff does not.
#
# The fix is a ONE-BIT STATE: `drop` says "the previous character was a colon", so
# the space after it is emitted as `""`. It is a fold over the character list with
# a `Bool` accumulator, which is the shape rule jit.bend rule 1 asks for (the
# accumulator rides as a second parameter, not as a `Data` record).
def colon() -> Char: Char.from_u32(58)

def spc() -> Char: Char.from_u32(32)

def fp8_is_colon(+h: Char) -> Bool: Char.is_eq(h, colon())

def fp8_is_sp(+h: Char) -> Bool: Char.is_eq(h, spc())

# THE ACCUMULATOR IS THE WHOLE OF THE SECOND BUG. A version that returned the
# transformed TAIL had no `acc`, so the `drop` arm answered `""` for the ENTIRE
# remainder: `fp8_split2` turned a 1048-character string into 57 and
# `fp8 prefix lines` read 3. It typechecked, it ran, and the prefix was a
# perfectly plausible three-line function header. `fp8 prefix lines` is the count
# row that saw it -- a per-line diff alone would have shown the same three lines
# and said nothing about the other twenty-five.
def fp8_split2(+cs: List<&2, Char>, drop: Bool, +acc: String) -> String:
  match cs:
    case Nil{}   : acc
    case +h <> +t :
      +rest = fp8_split2(t, fp8_is_colon(h), "")
      Bool.pick(String, Bool.and(drop, fp8_is_sp(h)), String.concat([acc, rest]),
        String.concat([acc, Bool.pick(String, fp8_is_colon(h), String.concat([":", nl(), "  "]),
          String.from_list([h])), rest]))

def fp8_lines(raw: String) -> List<&2, String>:
  String.lines(fp8_split2(String.to_list(raw), False{}, ""))

def fp8_prefix(has_fp8: Bool, +mx: String) -> List<&2, String>:
  Bool.pick(List<&2, String>, has_fp8, fp8_lines(fp8_raw(mx)), Nil{})

# `repr(x)` of a one-word string, which is what `Renderer.suffix` and the three
# `suffix` overrides print. CPython's `repr` puts SINGLE quotes round it, and the
# oracle prints `repr(...)`, so this is a two-Character decoration rather than a
# format -- and `q()` in tc_ptx is the same function under the same name.
def q1(+s: String) -> String: String.concat(["'", s, "'"])

# `None` or the joined triple -- `global_prod_max` is the only `tuple|None` on the
# record, and convention 3's `Bool` plus payload is what makes it a field at all.
def pmax(+x: Llvm) -> String:
  Bool.pick(String, Llvm.gpmax_has(x), ushow(Llvm.gpmax(x)), "None")

# `",".join(sorted(o.name for o in cls.code_for_op))`. A `set` in CPython has no
# order, so the ORACLE sorts -- which is the "a set is a hole in a positional
# gate" note, and `code_for_op.len` is the row that pins the SIZE the sorted join
# cannot.
def opnames.go(+os: List<&2, O.Op>, acc: List<&2, String>) -> List<&2, String>:
  match os:
    case Nil{}   : acc
    case o <> +t : opnames.go(t, List.append(&2, String, acc, [O.Ops.name.of(o)]))

def osort.lt(+a: String, +b: String) -> Bool: String.is_lt(a, b)

# AN INSERTION SORT, and the `Bool.pick` IS INLINE because a self-call cannot be
# factored out of one arm without becoming mutual recursion (engine/jit rule 2).
# The head binder is `+h <> +t` -- both read twice, once in `[h] ++ t` and once in
# the self-call -- which is `tc_ptx`'s keep-filter and `jit`'s `srt_ins` exactly.
#
# TWO WRONG FIRST VERSIONS, both `ALL PROOFS CHECK`, both a plausible thirteen-
# slot list with duplicates in it (`ADD,AND,ADD,CDIV,ADD,CMOD,...`): one returned
# `rest` on the else arm, which DROPPED the head, and one built `[x, h] ++ rest`
# where `rest` already carried `x`, which DUPLICATED it. `amd.code_for_op.len` is
# the count row that a reader would have wanted here; what caught it was that the
# SORTED STRING was the thing being diffed.
def osort.ins(+x: String, xs: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}   : [x]
    case +h <> +t :
      Bool.pick(List<&2, String>, osort.lt(x, h), List.append(&2, String, [x, h], t),
        List.append(&2, String, [h], osort.ins(x, t)))

def osort.names(+os: List<&2, O.Op>) -> List<&2, String>:
  match os:
    case Nil{}   : Nil{}
    case o <> +t : List.append(&2, String, osort.names(t), [O.Ops.name.of(o)])

def osort.ss(+xs: List<&2, String>, acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}   : acc
    case x <> +t : osort.ss(t, osort.ins(x, acc))

def opnames_sorted(+os: List<&2, O.Op>) -> List<&2, String>: osort.ss(osort.names(os), Nil{})

# THE SORTED SPELLING, and it is a DIFFERENT def rather than a flag. CPython's
# `supported_dtypes` returns a `set`, so the oracle sorts -- and a `set` has no
# order. `lop.keys` is NOT sorted, because `lop`'s insertion order is a dict's
# and a dict does have one. Two rows, two orders, two defs: "where the oracle has
# to normalise, the gate loses a dimension" (tc_ptx stage 2 rule 6).
def unames_s(+ds: List<&2, S.Dt>) -> String: String.join(osort.ss(unames.go(ds, Nil{}), Nil{}), ",")

def opnames(+os: List<&2, O.Op>) -> String: String.join(opnames_sorted(os), ",")

# `",".join(f"{op.name}={name}" for op, name in llvm_intrinsics.items())` -- dict
# insertion order, so SQRT, LOG2, EXP2 and NOT sorted.
def intr_names.go(+os: List<&2, O.Op>, acc: List<&2, String>) -> List<&2, String>:
  match os:
    case Nil{}   : acc
    case o <> +t : intr_names.go(t, List.append(&2, String, acc, [String.concat([O.Ops.name.of(o), "=", intr_of(o)])]))

def intr_names() -> String: String.join(intr_names.go(intrs(), Nil{}), ",")

# ===========================================================================
# THE ROW BUILDERS. Eleven small wrappers, one per group, and every `py=` half is
# a LITERAL generated by `.agents/slop/nl/nl-oracle.py`'s `bend` mode -- which
# computes it by calling live CPython. The generated text is pasted verbatim
# below under "THE GENERATED ROWS"; regenerate with
#     .venv/bin/python .agents/slop/nl/nl-oracle.py bend > .agents/slop/nl/stage1.bend
# and splice it in, so a change to the ORACLE and a change to the GATE are the
# same commit.
# ===========================================================================

def nth(+xs: List<&2, String>, i: U32) -> String: Maybe.default(&2, String, List.get(&2, String, xs, U32.to_nat(i)), "")

def nlen(+xs: List<&2, U32>) -> U32: U32.from_nat(List.length(&2, U32, xs))

def oplen(+xs: List<&2, O.Op>) -> U32: U32.from_nat(List.length(&2, O.Op, xs))

def slen(+xs: List<&2, String>) -> U32: U32.from_nat(List.length(&2, String, xs))

def dtlen(+xs: List<&2, S.Dt>) -> U32: U32.from_nat(List.length(&2, S.Dt, xs))

# `ldt <name>`, `ldt ptr <name>` and `ldt <n> <ptr|spaces> <name>` -- the three
# shapes the map answers. The third's LABEL carries the `ptr` flag spelled the
# way the oracle spells it, because a row whose two sides have different NAMES
# is a diff that looks like a value change.
def r_ldt(nm: String, +d: S.Dt, py: String) -> String: r(String.concat(["ldt ", nm]), ldt.t(d, 1, False{}), py)

def r_ldtp(nm: String, +d: S.Dt, py: String) -> String: r(String.concat(["ldt ptr ", nm]), ldt.t(d, 1, True{}), py)

def r_ldtn(nm: String, +d: S.Dt, +cnt: U32, ptr: Bool, py: String) -> String:
  r(String.concat(["ldt ", nm]), ldt.t(d, cnt, ptr), py)

# THE 14x14 GRID, ONE ROW PER INPUT AND ONE PER OUTPUT. `CA` is spelled out
# because the ORDER is the grid and a list derived from `dtypes.all` would
# reorder it silently -- and a reordered grid is a diff in EVERY row at once,
# which is a loud failure for a wrong reason. `void` is IN the grid because
# CPython answers `NotImplementedError` for it and the port has no exceptions.
def CA() -> List<&2, S.Dt>:
  [S.void(), S.half(), S.bfloat16(), S.single(), S.double(), S.boolean(),
   S.int8(), S.int16(), S.int32(), S.int64(), S.uint8(), S.uint16(), S.uint32(), S.uint64()]

def lca_join(+d: S.Dt, +ts: List<&2, S.Dt>, acc: List<&2, String>) -> List<&2, String>:
  match ts:
    case Nil{}   : acc
    case b <> +t : lca_join(d, t, List.append(&2, String, acc, [String.concat([dtn(b), "=", lcast.a(d, b)])]))

def lcb_join(+b: S.Dt, +ts: List<&2, S.Dt>, acc: List<&2, String>) -> List<&2, String>:
  match ts:
    case Nil{}   : acc
    case a <> +t : lcb_join(b, t, List.append(&2, String, acc, [String.concat([dtn(a), "=", lcast.a(a, b)])]))

def r_lca(nm: String, +d: S.Dt, py: String) -> String:
  r(String.concat(["lcast.a ", nm]), String.join(lca_join(d, CA(), Nil{}), ","), py)

def r_lcb(nm: String, +b: S.Dt, py: String) -> String:
  r(String.concat(["lcast.b ", nm]), String.join(lcb_join(b, CA(), Nil{}), ","), py)

# `lop <dtype>` -- that dtype's WHOLE table in dict order, so a wrong VALUE and a
# wrong KEY SET are both visible in one row. `lop.op <OP>` is the same grid read
# along the other axis, and it is the row that says which dtypes HAVE the op.
def r_lop(nm: String, +d: S.Dt, py: String) -> String: r(String.concat(["lop ", nm]), lop.row(d), py)

def r_lopo(nm: String, +op: O.Op, py: String) -> String: r(String.concat(["lop.op ", nm]), lop.orow(op), py)

# the two naming-walk rows. `r_nmbuf`'s `is_local` is the WHOLE of the LLVM
# test: `name buffer global`, `name buffer reg` and `name buffer alu` all read
# `%reg_5` and only `name buffer local` differs, which the mutation table records
# as a constant column rather than claiming three independent rows.
def r_nm(nm: String, slot: U32, py: String) -> String: r(String.concat(["name ", nm]), nm_param(slot), py)

def r_nmbuf(nm: String, is_local: Bool, slot: U32, py: String) -> String:
  r(String.concat(["name buffer ", nm]), nm_buf(is_local, slot), py)

def r_sdb(py: String) -> String: r("sd base", unames_s(sd_base()), py)

def r_sdcpu(nm: String, x86: Bool, osx: Bool, py: String) -> String:
  r(String.concat(["sd cpullvm ", nm]), unames_s(sd.cpu.go(sd_base(), x86, osx)), py)

def r_sdamd(nm: String, fnuz: Bool, py: String) -> String:
  r(String.concat(["sd amd ", nm]), unames_s(sd.amd.go(sd_base(), fnuz)), py)

def r_gep(nm: String, +xn: String, +d: S.Dt, +cnt: U32, +s0: String, +d1: S.Dt, +s1: String, py: String) -> String:
  r(String.concat(["gep ", nm]), gep_line(xn, d, cnt, s0, d1, s1), py)

# `fp8 max cpython` is `str(amd_fp8s('gfx942')[0].max)` -- the SPELLING the port
# must substitute, because `F32.show(240.0)` is `240` and CPython's `{fp8_max}`
# is `240.0`. `f32show 240.0` is the BEND-ONLY row that names the gap: it has no
# CPython half (its `py=` is the literal marker `BEND-ONLY`), and the notes are
# explicit that a row with no oracle belongs in a NAMED list rather than in a
# silent filter. It is named here, and it is one line.
def r_f32show(py: String) -> String: r("f32show 240.0", F32.show(240.0), py)

def r_fpmax(spelt: String, py: String) -> String: r("fp8 max cpython", spelt, py)

# ===========================================================================
# THE GENERATED ROWS. `nl-oracle.py`'s `bend` mode, verbatim.
# ===========================================================================

def r_ldts() -> String:
  String.concat([r_ldt("void", S.void(), "void"), r_ldt("fp8e4m3", S.fp8e4m3(), "i8"), r_ldt("fp8e5m2", S.fp8e5m2(), "i8"), r_ldt("fp8e4m3fnuz", S.fp8e4m3fnuz(), "i8"), r_ldt("fp8e5m2fnuz", S.fp8e5m2fnuz(), "i8"), r_ldt("f16", S.half(), "half"), r_ldt("bf16", S.bfloat16(), "bfloat"), r_ldt("f32", S.single(), "float"), r_ldt("f64", S.double(), "double"), r_ldt("u8", S.uint8(), "i8"), r_ldt("u16", S.uint16(), "i16"), r_ldt("u32", S.uint32(), "i32"), r_ldt("u64", S.uint64(), "i64"), r_ldt("i8", S.int8(), "i8"), r_ldt("i16", S.int16(), "i16"), r_ldt("i32", S.int32(), "i32"), r_ldt("i64", S.int64(), "i64"), r_ldt("bool", S.boolean(), "i1"), r_ldt("weakfloat", S.weakfloat(), "KeyError"), r_ldt("weakint", S.weakint(), "KeyError"), r_ldtp("f32", S.single(), "float*"), r_ldtp("i32", S.int32(), "i32*"), r_ldtp("void", S.void(), "void*"), r_ldtp("bool", S.boolean(), "i1*"), r_ldtp("f16", S.half(), "half*"), r_ldtp("bf16", S.bfloat16(), "bfloat*"), r_ldtn("0     f32", S.single(), 0, False{}, "float"), r_ldtn("1     f32", S.single(), 1, False{}, "float"), r_ldtn("2     f32", S.single(), 2, False{}, "<2 x float>"), r_ldtn("4     f32", S.single(), 4, False{}, "<4 x float>"), r_ldtn("8     f64", S.double(), 8, False{}, "<8 x double>"), r_ldtn("16     f16", S.half(), 16, False{}, "<16 x half>"), r_ldtn("4 ptr f32", S.single(), 4, True{}, "<4 x float>*"), r_ldtn("2 ptr i32", S.int32(), 2, True{}, "<2 x i32>*"), r_ldtn("1 ptr f32", S.single(), 1, True{}, "float*"), r_ldtn("4 ptr bf16", S.bfloat16(), 4, True{}, "<4 x bfloat>*")])

def r_lcas() -> String:
  String.concat([r_lca("void", S.void(), "void=NotImplementedError,f16=NotImplementedError,bf16=NotImplementedError,f32=NotImplementedError,f64=NotImplementedError,bool=NotImplementedError,i8=NotImplementedError,i16=NotImplementedError,i32=NotImplementedError,i64=NotImplementedError,u8=NotImplementedError,u16=NotImplementedError,u32=NotImplementedError,u64=NotImplementedError"), r_lca("f16", S.half(), "void=NotImplementedError,f16=fptrunc,bf16=fptrunc,f32=fpext,f64=fpext,bool=NotImplementedError,i8=fptosi,i16=fptosi,i32=fptosi,i64=fptosi,u8=fptoui,u16=fptoui,u32=fptoui,u64=fptoui"), r_lca("bf16", S.bfloat16(), "void=NotImplementedError,f16=fptrunc,bf16=fptrunc,f32=fpext,f64=fpext,bool=NotImplementedError,i8=fptosi,i16=fptosi,i32=fptosi,i64=fptosi,u8=fptoui,u16=fptoui,u32=fptoui,u64=fptoui"), r_lca("f32", S.single(), "void=NotImplementedError,f16=fptrunc,bf16=fptrunc,f32=fptrunc,f64=fpext,bool=NotImplementedError,i8=fptosi,i16=fptosi,i32=fptosi,i64=fptosi,u8=fptoui,u16=fptoui,u32=fptoui,u64=fptoui"), r_lca("f64", S.double(), "void=NotImplementedError,f16=fptrunc,bf16=fptrunc,f32=fptrunc,f64=fptrunc,bool=NotImplementedError,i8=fptosi,i16=fptosi,i32=fptosi,i64=fptosi,u8=fptoui,u16=fptoui,u32=fptoui,u64=fptoui"), r_lca("bool", S.boolean(), "void=NotImplementedError,f16=uitofp,bf16=uitofp,f32=uitofp,f64=uitofp,bool=NotImplementedError,i8=zext,i16=zext,i32=zext,i64=zext,u8=zext,u16=zext,u32=zext,u64=zext"), r_lca("i8", S.int8(), "void=NotImplementedError,f16=sitofp,bf16=sitofp,f32=sitofp,f64=sitofp,bool=NotImplementedError,i8=sext,i16=sext,i32=sext,i64=sext,u8=sext,u16=sext,u32=sext,u64=sext"), r_lca("i16", S.int16(), "void=NotImplementedError,f16=sitofp,bf16=sitofp,f32=sitofp,f64=sitofp,bool=NotImplementedError,i8=trunc,i16=sext,i32=sext,i64=sext,u8=trunc,u16=sext,u32=sext,u64=sext"), r_lca("i32", S.int32(), "void=NotImplementedError,f16=sitofp,bf16=sitofp,f32=sitofp,f64=sitofp,bool=NotImplementedError,i8=trunc,i16=trunc,i32=sext,i64=sext,u8=trunc,u16=trunc,u32=sext,u64=