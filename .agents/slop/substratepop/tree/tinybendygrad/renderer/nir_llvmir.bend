def r_nms() -> String:
  String.concat([r_nm("param 0", 0, "%data0"), r_nm("param 3", 3, "%data3"), r_nm("param 7", 7, "%data7"), r_nmbuf("global", False{}, 5, "%reg_5"), r_nmbuf("local", True{}, 5, "%local_5"), r_nmbuf("reg", False{}, 5, "%reg_5"), r_nmbuf("alu", False{}, 5, "%reg_5")])

def r_geps() -> String:
  String.concat([r_gep("%v3 f32x1 i32", "%v3", S.single(), 1, "%data0", S.int32(), "%v2", "  %v3 = getelementptr inbounds float, float* %data0, i32 %v2"), r_gep("%v0 f32x4 i64", "%v0", S.single(), 4, "%reg_1", S.int64(), "%v1", "  %v0 = getelementptr inbounds <4 x float>, <4 x float>* %reg_1, i64 %v1"), r_gep("%v7 f16x1 u32", "%v7", S.half(), 1, "%local_2", S.uint32(), "%v6", "  %v7 = getelementptr inbounds half, half* %local_2, i32 %v6"), r_gep("%v9 bf16x8 u64", "%v9", S.bfloat16(), 8, "%data1", S.uint64(), "%v8", "  %v9 = getelementptr inbounds <8 x bfloat>, <8 x bfloat>* %data1, i64 %v8")])

def r_fps() -> String:
  String.concat([r("fp8 prefix none", U32.show(slen(fp8_prefix(False{}, "240.0"))), "0"), r("fp8 prefix lines", U32.show(slen(fp8_prefix(True{}, "240.0"))), "28"), r("fp8 prefix[0]", nth(fp8_prefix(True{}, "240.0"), 0), "define i8 @f32_to_fp8(float %val, i1 %is_bf8) {"), r("fp8 prefix[1]", nth(fp8_prefix(True{}, "240.0"), 1), "entry:"), r("fp8 prefix[2]", nth(fp8_prefix(True{}, "240.0"), 2), "  %ival = bitcast float %val to i32"), r("fp8 prefix[3]", nth(fp8_prefix(True{}, "240.0"), 3), "  %exp = and i32 %ival, 2139095040"), r("fp8 prefix[4]", nth(fp8_prefix(True{}, "240.0"), 4), "  %is_special = icmp eq i32 %exp, 2139095040"), r("fp8 prefix[5]", nth(fp8_prefix(True{}, "240.0"), 5), "br i1 %is_special, label %select_clip, label %clip"), r("fp8 prefix[6]", nth(fp8_prefix(True{}, "240.0"), 6), "clip:"), r("fp8 prefix[7]", nth(fp8_prefix(True{}, "240.0"), 7), "  br i1 %is_bf8, label %bf8_clip, label %fp8_clip"), r("fp8 prefix[8]", nth(fp8_prefix(True{}, "240.0"), 8), "bf8_clip:"), r("fp8 prefix[9]", nth(fp8_prefix(True{}, "240.0"), 9), "  %clamped_bf8 = call float @llvm.amdgcn.fmed3.f32(float %val, float 57344.0, float -57344.0)"), r("fp8 prefix[10]", nth(fp8_prefix(True{}, "240.0"), 10), "  br label %select_clip"), r("fp8 prefix[11]", nth(fp8_prefix(True{}, "240.0"), 11), "fp8_clip:"), r("fp8 prefix[12]", nth(fp8_prefix(True{}, "240.0"), 12), "  %clamped_fp8 = call float @llvm.amdgcn.fmed3.f32(float %val, float 240.0, float -240.0)    "), r("fp8 prefix[13]", nth(fp8_prefix(True{}, "240.0"), 13), "  br label %select_clip"), r("fp8 prefix[14]", nth(fp8_prefix(True{}, "240.0"), 14), "select_clip:"), r("fp8 prefix[15]", nth(fp8_prefix(True{}, "240.0"), 15), "  %phi_val = phi float [%val, %entry], [%clamped_bf8, %bf8_clip], [%clamped_fp8, %fp8_clip]"), r("fp8 prefix[16]", nth(fp8_prefix(True{}, "240.0"), 16), "  br i1 %is_bf8, label %do_bf8, label %do_fp8"), r("fp8 prefix[17]", nth(fp8_prefix(True{}, "240.0"), 17), "do_bf8:"), r("fp8 prefix[18]", nth(fp8_prefix(True{}, "240.0"), 18), "  %packed_bf8 = call i32 @llvm.amdgcn.cvt.pk.bf8.f32(float %phi_val, float %phi_val, i32 0, i1 false)"), r("fp8 prefix[19]", nth(fp8_prefix(True{}, "240.0"), 19), "  br label %exit"), r("fp8 prefix[20]", nth(fp8_prefix(True{}, "240.0"), 20), "do_fp8:"), r("fp8 prefix[21]", nth(fp8_prefix(True{}, "240.0"), 21), "  %packed_fp8 = call i32 @llvm.amdgcn.cvt.pk.fp8.f32(float %phi_val, float %phi_val, i32 0, i1 false)"), r("fp8 prefix[22]", nth(fp8_prefix(True{}, "240.0"), 22), "  br label %exit"), r("fp8 prefix[23]", nth(fp8_prefix(True{}, "240.0"), 23), "exit:"), r("fp8 prefix[24]", nth(fp8_prefix(True{}, "240.0"), 24), "  %packed = phi i32 [%packed_bf8, %do_bf8], [%packed_fp8, %do_fp8]"), r("fp8 prefix[25]", nth(fp8_prefix(True{}, "240.0"), 25), "  %trunc = trunc i32 %packed to i8"), r("fp8 prefix[26]", nth(fp8_prefix(True{}, "240.0"), 26), "  ret i8 %trunc"), r("fp8 prefix[27]", nth(fp8_prefix(True{}, "240.0"), 27), "}"), r("f32show 240.0", F32.show(240.0), "BEND-ONLY")])

def r_stage1() -> String:
  String.concat([r_ldts(), r_lcas(), r_lcbs(), r_lopf(), r_lops(), r_lopos(), r_lopz(), r_consts(),
    r_sds(), r_nms(), r_geps(), r_fps()])

# ONE print for the WHOLE table, so `IO.print`'s own newline is the only frame and
# the oracle's single trailing "\n" is its match. There is deliberately no
# separator between groups: the oracle's `stage1()` is a plain concatenation, so
# a newline here would be a line CPython never printed.
def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(r_stage1())

# ===========================================================================
# THE MUTATION TABLE. Re-measured 2026-10-03 with
# `.agents/slop/nl/nl-mutate.py`: one textual edit at a time, each row diffed
# against the unmutated 205 WHOLE `name=value` LINES, by index, never by row
# NAME (a name-comparing harness reported 0 for all 30 mutations in one unit).
# "moved" is the number of rows that changed; the driver prints which. THREE
# edits move nothing and that is the point of them. FORTY-FOUR mutations now,
# the five newest being the `ldt.fp` re-arm below.
#
#   M1  `ldt`'s integer arm is `bits`, not `bits // 8`        14
#   M2  `f16` spells `bfloat`, not `half`                          4
#   M3  the `count` arm is `>= 1`, not `> 1`                   32
#   M4  (CONTROL: a comment-only edit)                           0
#   M5  `fpext`/`fptrunc` are swapped                           8
#   M6  the unsigned narrow arm is `sext`, not `zext`           13
#   M7  float->int ignores `is_unsigned`                        8
#   M8  the wall marker is `NoCast`                            28
#   M9  `flags` loses its LEADING SPACE                        16
#   M10 `signed_lop`'s CMPLT is `icmp ult`                      6
#   M11 `float_lop`'s FDIV is `fadd`                          10
#   M12 `unsigned_lop` drops SHR                               20
#   M13 `op in float_lop` is always True                        7
#   M14 the op rows use `lop`'s key order, not `dtypes.all`'s  12
#   M15 `code_for_op` drops FDIV                                6
#   M16 AMD's `code_for_op` keeps one intrinsic                 2
#   M17 AMD's `shared_max` is the base's 32768                  1
#   M18 CPULLVM's `has_local` is True                          1
#   M19 the absent `abi` answers `None`, not `AttributeError`   1
#   M20 `nm_buf`'s LOCAL test is inverted                       4
#   M21 `code_for_workitem` swaps workgroup/workitem           6
#   M22 the lane letter map collapses y onto x                 2
#   M23 `barrier` drops the TWO QUOTES                          2
#   M24 `barrier` drops its EMPTY TAIL                          1
#   M25 the GEP element type is count 1, not the count          2
#   M26 `inbounds` is dropped from the GEP line                 4
#   M27 the FOUR TRAILING SPACES of fp8_clip line 12           1
#   M28 the `: ` separator's space is not consumed              8
#   M29 (CONTROL: a comment-only edit)                           0
#   M30 CPULLVM's `not in fp8s` conjunct is dropped             8
#   M31 CPULLVM's bfloat16 clause is dropped                     4
#   M32 AMD keeps ALL FOUR fp8, not the FNUZ pair               1
#   M33 `is_fp8` tests the FNUZ pair, not the fp8 set          12
#   M34 `lop`'s keys put `bool` last                            1
#   M35 the insertion sort's ELSE arm drops the head           16
#   M36 `supported_dtypes` does not sort                        13
#   M37 the `lcast` GRID's order changes (no cell changes)      28
#   M38 `has_fp8` is always True                                1
#   M39 (CONTROL: a comment-only edit)                           0
#   M40 the name ladder alone, `ldt.of` untouched      FAIL compile
#   M40b THE REGRESSION, VERBATIM AND FULLY APPLIED              24
#   M41 `ldt.fp`'s WIDTH arm is `i16`, not `i8`                  4
#   M42 `ldt.fp`'s `pri == 13` arm is `half`, not `bfloat`        4
#   M43 `ldt.fp`'s catch-all is `float`, not `double`            2
#
# M40 AND M40b ARE ONE EXPERIMENT SPLIT IN TWO, and it is the most important
# entry in this table. `M40` restores `ldt.fp`'s NAME-based ladder verbatim
# and leaves `ldt.of` calling `ldt.fp(bits, pri)`: it does NOT COMPILE
# (`expected : String`). `M40b` is the same ladder with the call site
# re-pointed at `nm` -- i.e. EXACTLY what was committed -- and it COMPILES,
# runs, and prints:
#
#     $ ./bin/bend <scratch> --check-only
#     ALL PROOFS CHECK
#     $ ./bin/bend <scratch> | grep '^ldt f32'
#     ldt f32 = [KeyError]   py=[float]
#
# while upstream answers `float`. So the whole hazard of this file is not a
# claim about a hypothetical: it is reproducible on demand, and the ONLY thing
# that caught it was the string diff against live CPython. `bend --check-only`
# was, and remains, silent. That is why M40b is in the table and not in a
# footnote: a gate that has never been shown the bug it is guarding against is
# a gate whose green rows are worth nothing.
#
# M41, M42 and M43 ARE THE THREE ARMS OF THE RE-ARM, and their row counts say
# what each one is load-bearing for. M41 moves the FOUR fp8 rows and nothing
# else, which is the fp8 quadruple's `bits == 8` collapse being the MAP's own
# property. M42 moves the FOUR bf16 rows (`ldt bf16`, `ldt ptr bf16`,
# `ldt 4 ptr bf16`, `gep %v9 bf16x8 u64`) and no f16 or f32 row, so `pri` is
# separating them and `bits` alone would not: `bits == 16` is shared by `f16`
# and `bf16`. M43 moves `ldt f64` and `ldt 8 f64`, which says the catch-all
# IS `f64`'s arm -- and M43 IS A THEOREM in the other direction too: adding
# `case 15: "double"` above the unchanged catch-all would move NOTHING, because
# the two spellings are the same function over every reachable `pri`.
#
# WHAT THE TABLE SAYS.
#
# FIVE BUGS IN THIS FILE WERE CAUGHT BY THE BYTE DIFF AND NOT BY THE CHECKER,
# and all five are in the table above because they are the ones a reader would
# most confidently have kept:
#
#   * M1 -- `ldt`'s integer arm was `bits // 8`. Eight rows answered `i1`, `i2`,
#     `i4`, `i8`, which is a self-consistent table and not a typo-looking one.
#     `ldt`'s map is `int8: "i8"`, so the number after the `i` IS the bit count;
#     `i8` never meant "8 bytes".
#   * M28 + M27 -- the `.replace(": ", ":\n  ")` walk did not consume the
#     separator's SPACE (four rows indented three spaces instead of two) and a
#     version with no ACCUMULATOR turned a 1048-character string into 57, so the
#     prefix was a plausible THREE-LINE function header. The count row
#     `fp8 prefix lines` is what saw the second one; a per-line diff alone would
#     have shown the same three lines and said nothing about the other
#     twenty-five.
#   * M35 -- the insertion sort's else arm returned the tail without the head, so
#     `llvm.code_for_op` came back as `ADD,MUL,ADD,OR,ADD,...`: thirteen slots
#     with five `ADD`s, and `llvm.code_for_op.len` GREEN throughout. This is the
#     "pin a COUNT, not a boolean" note in its sharpest form -- here it is the
#     count row that could NOT see the bug, and the sorted STRING that could.
#   * M3 -- the `count` arm was `>= 1` in the first draft, so `ldt(1, float)`
#     rendered `<1 x float>` and M3 moves THIRTY-TWO rows. It is the largest
#     single movement in the table and it is here because "a big number" is not a
#     substitute for knowing WHICH rows.
#
# M24 IS A THINNESS WORTH NAMING. `barrier`'s EMPTY TAIL is `""` and `nth`
# defaults a missing element to `""`, so dropping it moves `barrier.lines` and
# NOTHING ELSE -- the `barrier[3]` row is unchanged because its value is the same
# string either way. The count row is the only witness, and that is what a count
# row is FOR.
#
# M38 IS A THINNESS WORTH NAMING TOO. `has_fp8` is
# `any(u.dtype in dtypes.fp8s for u in uops)` (llvmir.py:252) and a reader that
# always answered True would move `fp8 prefix none` by ONE row and the
# twenty-eight line rows by NONE. The line rows are blind to it by construction;
# the gate is not blind, and one row is the whole cost of noticing.
#
# M20 IS A CONSTANT COLUMN, and it is not a defect: `name buffer global`,
# `name buffer reg` and `name buffer alu` all read `%reg_5` because ONLY the
# LOCAL addrspace is spelled. Inverting the test moves all four rows rather than
# one, which is better than the `reduce.bend` rule-4 shape but for the same
# reason: the test has to be one test and the column has to exist.
#
# M14 AND M37 ARE PURE ORDER MUTATIONS and they move 12 and 28 rows while
# changing no value at all. `diff` is POSITIONAL, so an order bug is a loud
# failure; a per-cell comparison would have called both green. This is the
# argument for one long generated line per grid rather than one row per cell --
# and it is also the argument AGAINST: M14 shows that a whole group can move at
# once, which is why `lop.op` is thirteen rows and not one.
#
# THREE CONTROLS, M4, M29 and M39, are comment-only edits and each moves nothing.
# They are what makes the other thirty-six numbers mean something: a harness that
# reported "0 rows" for everything would look identical on the three thinnesses
# above.
# ===========================================================================
