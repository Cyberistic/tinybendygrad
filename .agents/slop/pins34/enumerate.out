graphs             numerator= len(graphs)                                                denominator= 1
graphs-answered    numerator= len(graphs) - len(unset)                                   denominator= 1
graphs-unset       numerator= len(unset)                                                 denominator= 1
expect-moved       numerator= len(moved)                                                 denominator= 1
graphs-refused     numerator= len(refused)                                               denominator= 1
graphs-agree       numerator= files_with('D1-graph-*.txt', 'VERDICT: AGREE')             denominator= 1
graphs-disagree    numerator= files_with('D1-graph-*.txt', 'VERDICT: DISAGREE')          denominator= 1
byte-identical     numerator= lines_with('D2-bytediff.txt', 'BYTE-IDENTICAL')            denominator= 1
not-comparable     numerator= lines_with('D2-bytediff.txt', 'NOT COMPARED')              denominator= 1
stable-pairs       numerator= anchored('D9-stability.txt', ': 2 runs BYTE-IDENTICAL$')   denominator= of 5
stable-failed      numerator= lines_with('D9-stability.txt', 'ONE SIDE IS A 0-ROW FAILURE') denominator= of 5
stable-differ      numerator= anchored('D9-stability.txt', ': 2 runs DIFFER$')           denominator= of 5
plants-disagree    numerator= files_with('D5-plant-*.txt', 'VERDICT: DISAGREE')          denominator= of 7
cross              numerator= lines_with('D4-cross-range.txt', 'CROSS VERDICT: OK')      denominator= of 1
selfcheck          numerator= first_line('D0-selfcheck.txt')                             denominator= 1
conflations        numerator= lines_with('D7-conf.txt', 'VERDICT: OK')                   denominator= of 4
controls           numerator= files_with('D3-control-*.txt', 'CONTROL VERDICT: OK')      denominator= of 5
oracle-selfcheck   numerator= grep_line('D0-coverage-census.txt', 'ORACLE SELFCHECK')    denominator= 1
census-rc          numerator= last_line('D0-coverage-census.txt')                        denominator= 1

