# THE SHADERS, ENTRIES AND GEOMETRY, from `renderer/wgsl.py` and
# `ProgramInfo.launch_dims` on the ast the CPU executed. `local_size` is
# recorded and never dispatched on: ops_webgpu.py never reads it and the
# workgroup size is the WGSL attribute.
def entry0() -> String: "r_8_8_8"
def wgsl0() -> String: "fn nan() -> f32 { let bits = 0xffffffffu; return bitcast<f32>(bits); }\n@group(0) @binding(0)\nvar<uniform> INFINITY : f32;\n@group(0) @binding(1)var<storage,read_write>data0_64:array<f32>;\n@group(0) @binding(2)var<storage,read_write>data1_64:array<f32>;\n@group(0) @binding(3)var<storage,read_write>data2_64:array<f32>;\n@compute @workgroup_size(1) fn r_8_8_8(@builtin(workgroup_id) gindex: vec3<u32>,@builtin(local_invocation_id) lindex: vec3<u32>) {\n  for (var Lidx1 = 0; Lidx1 < 8; Lidx1++) {\n    var cast0 = bitcast<i32>((bitcast<u32>(Lidx1)<<3u));\n    var val0 = data1_64[cast0];\n    var val1 = data1_64[(cast0+1)];\n    var val2 = data1_64[(cast0+2)];\n    var val3 = data1_64[(cast0+3)];\n    var val4 = data1_64[(cast0+4)];\n    var val5 = data1_64[(cast0+5)];\n    var val6 = data1_64[(cast0+6)];\n    var val7 = data1_64[(cast0+7)];\n    var cast1 = vec4<f32>(val0,val1,val2,val3);\n    var cast2 = vec4<f32>(val4,val5,val6,val7);\n    for (var Lidx2 = 0; Lidx2 < 8; Lidx2++) {\n      var val8 = data2_64[(Lidx2+16)];\n      var val9 = data2_64[(Lidx2+24)];\n      var val10 = data2_64[(Lidx2+32)];\n      var val11 = data2_64[(Lidx2+40)];\n      var val12 = data2_64[(Lidx2+48)];\n      var val13 = data2_64[(Lidx2+56)];\n      var val14 = data2_64[(Lidx2+8)];\n      var val15 = data2_64[Lidx2];\n      data0_64[(cast0+Lidx2)] = ((cast1[0]*val15)+(cast1[1]*val14)+(cast1[2]*val8)+(cast1[3]*val9)+(cast2[0]*val10)+(cast2[1]*val11)+(cast2[2]*val12)+(cast2[3]*val13));\n    }\n  }\n}"
def gx0() -> U32: 1
def gy0() -> U32: 1
def gz0() -> U32: 1
def entry1() -> String: "r_8_8_8"
def wgsl1() -> String: "fn nan() -> f32 { let bits = 0xffffffffu; return bitcast<f32>(bits); }\n@group(0) @binding(0)\nvar<uniform> INFINITY : f32;\n@group(0) @binding(1)var<storage,read_write>data0_64:array<f32>;\n@group(0) @binding(2)var<storage,read_write>data1_64:array<f32>;\n@group(0) @binding(3)var<storage,read_write>data2_64:array<f32>;\n@compute @workgroup_size(1) fn r_8_8_8(@builtin(workgroup_id) gindex: vec3<u32>,@builtin(local_invocation_id) lindex: vec3<u32>) {\n  for (var Lidx1 = 0; Lidx1 < 8; Lidx1++) {\n    var cast0 = bitcast<i32>((bitcast<u32>(Lidx1)<<3u));\n    var val0 = data1_64[cast0];\n    var val1 = data1_64[(cast0+1)];\n    var val2 = data1_64[(cast0+2)];\n    var val3 = data1_64[(cast0+3)];\n    var val4 = data1_64[(cast0+4)];\n    var val5 = data1_64[(cast0+5)];\n    var val6 = data1_64[(cast0+6)];\n    var val7 = data1_64[(cast0+7)];\n    var cast1 = vec4<f32>(val0,val1,val2,val3);\n    var cast2 = vec4<f32>(val4,val5,val6,val7);\n    for (var Lidx2 = 0; Lidx2 < 8; Lidx2++) {\n      var val8 = data2_64[(Lidx2+16)];\n      var val9 = data2_64[(Lidx2+24)];\n      var val10 = data2_64[(Lidx2+32)];\n      var val11 = data2_64[(Lidx2+40)];\n      var val12 = data2_64[(Lidx2+48)];\n      var val13 = data2_64[(Lidx2+56)];\n      var val14 = data2_64[(Lidx2+8)];\n      var val15 = data2_64[Lidx2];\n      data0_64[(cast0+Lidx2)] = ((cast1[0]*val15)+(cast1[1]*val14)+(cast1[2]*val8)+(cast1[3]*val9)+(cast2[0]*val10)+(cast2[1]*val11)+(cast2[2]*val12)+(cast2[3]*val13));\n    }\n  }\n}"
def gx1() -> U32: 1
def gy1() -> U32: 1
def gz1() -> U32: 1


# ---------------------------------------------------------------------------
# THE DEVICE BUFFERS. `Cs.call` begins at `Cs.of()`, so the buffers are their own
# `Cs` and `webgpu_call.js`'s `walk` concatenates the step lists through ONE
# machine -- a `Cs` per phase is how that driver is meant to be driven, not a
# workaround. `WriteBuffer`'s `(CALL_WRITE, write_len)` pair is `copy.copyin`'s
# own emission (ops_webgpu.py:221), not a shape invented for this file.
# ---------------------------------------------------------------------------
# THE HANDLE IS THE CALLER'S OWN ID, NOT A MINT. `webgpu_call.bend` binds a `bufs`
# slot to `bs[i-1].id` -- the caller's id -- precisely so the seam's minted slots and
# the caller's buffers are two namespaces a collision would be visible in, and
# `webgpu_call.js`'s `buf()` resolves `m.slots.get(id) ?? m.owned.get(id)`. So the
# `CreateBuffer` op carries `id_bN` as its `slot`, and `Cs.mint` is not called here
# at all. MEASURED the other way round: minting and then writing to `id_bN` stopped
# the walk at step 13 of 84 with "unbound slot 101", because the create was filed
# under 1 and the write asked for 101.
def mkbuf(+c: G.Cs, id: U32, size: U32) -> G.Cs:
  G.Cs.at(c, W.CALL_CREATE, W.OBJ_BUFFER, G.CreateBuffer{id, size, W.alloc.usage()})

def putbytes(+c: G.Cs, buf: U32, +bytes: List<&2, U32>) -> G.Cs:
  G.Cs.at(c, W.CALL_WRITE, W.copy.write_len(U32.from_nat(List.length(&2, U32, bytes))),
          G.WriteBuffer{buf, bytes})

def one(v: U32) -> List<&2, U32>: [v]

def ush(xs: List<&2, U32>, +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: List.reverse(&2, String, acc)
    case x <> t: ush(t, U32.show(x) <> acc)

def l0() -> G.Cs: G.Cs.call(bufs0(), 0n, Nil{}, gx0(), gy0(), gz0(), False{}, Nil{}, entry0(), wgsl0())
def l1() -> G.Cs: G.Cs.call(bufs1(), 0n, Nil{}, gx1(), gy1(), gz1(), False{}, Nil{}, entry1(), wgsl1())


# THE DEVICE BUFFERS, one `CreateBuffer` each in first-bind order, then one
# `putbytes` per upload in the oracle's order. Spelled out from the oracle's
# own lists so a different fixture needs no edit here and cannot drift from
# the trace that produced it.
def mkbuf_b0(+c: G.Cs) -> G.Cs: mkbuf(c, id_b0(), size_b0())
def mkbuf_b1(+c: G.Cs) -> G.Cs: mkbuf(c, id_b1(), size_b1())
def mkbuf_b2(+c: G.Cs) -> G.Cs: mkbuf(c, id_b2(), size_b2())
def mkbuf_b3(+c: G.Cs) -> G.Cs: mkbuf(c, id_b3(), size_b3())
def mkbuf_b4(+c: G.Cs) -> G.Cs: mkbuf(c, id_b4(), size_b4())

def mm_buffers() -> G.Cs:
  c = mkbuf_b4(mkbuf_b3(mkbuf_b2(mkbuf_b1(mkbuf_b0(G.Cs.of())))))
  c = putbytes(c, id_b1(), bytes_b1())
  c = putbytes(c, id_b2(), bytes_b2())
  c = putbytes(c, id_b4(), bytes_b4())
  c

# TWO READBACKS OF THE SAME RUN, and the second one is what makes the first one
# interpretable. `mm_read_out` maps the ANSWER; `mm_read_in` maps an UPLOADED
# INPUT. If `mm_read_in` comes back bit-identical to the words that were written,
# then the buffers held exactly what CPython held and any difference in the
# answer is the ARITHMETIC; if it does not, the difference is the DATA and the
# arithmetic is not what needs looking at. One number cannot tell those apart.
#
# They are two `walk`es rather than two `MappedRange`es in one, because
# `webgpu_call.js` keeps only the LAST mapped range (`m.range` is overwritten),
# so a single walk would silently drop the first readback -- a null range that
# reads as an empty answer rather than as a missing one.
def mm_read_out() -> G.Cs:
  +r = G.Cs.readable(G.Cs.of(), id_b3(), size_b3())
  G.Cs.read(r, G.Cs.next(G.Cs.of()), size_b3())
def mm_read_in() -> G.Cs:
  +r = G.Cs.readable(G.Cs.of(), id_b1(), size_b1())
  G.Cs.read(r, G.Cs.next(G.Cs.of()), size_b1())

def mm_read() -> G.Cs: mm_read_out()
# THE WHOLE RUN, as the `List<&2, G.Cs>` `webgpu_call.js`'s `walk` consumes: the
# device init, the device buffers, the two launches, the staging read.
#
# `mm_read` is `Cs.timing.on` with the wait arm off. `Cs.readable` mints the
# STAGING buffer first, so its handle is `Cs.next` of the state it was handed
# -- `webgpu_call.bend` names the mistake: `next(r) - 1` is the command buffer
# and the walk stops with "unbound slot".
def mm_prefix() -> List<&2, G.Cs>: [G.Cs.init(G.METAL(), Nil{}), mm_buffers(), l0(), l1()]
def mm_run() -> List<&2, G.Cs>: List.append(&2, G.Cs, mm_prefix(), [mm_read_out()])
def mm_run_in() -> List<&2, G.Cs>: List.append(&2, G.Cs, mm_prefix(), [mm_read_in()])


# ---------------------------------------------------------------------------
# THE PURE HALF, and it runs with no GPU at all:
#   ./bin/bend .agents/slop/e2e_mm.bend
# Every row is read off a `Cs` the driver later executes, so a wrong row here is a
# wrong PROGRAM and not a wrong number about the program.
# ---------------------------------------------------------------------------
def row(nm: String, b: Bool) -> IO(Unit): IO.print(String.concat([nm, "=", Bool.show(b)]))
def lrow(nm: String, xs: List<&2, U32>) -> IO(Unit):
  IO.print(String.concat([nm, "=", String.join(ush(xs, Nil{}), ",")]))

def t_buffers() -> IO(Unit):
  do IO<Unit>:
    +c : G.Cs <- IO.pure(G.Cs, mm_buffers())
    lrow("mm_buffer_len", one(G.Cs.len(c)))
    lrow("mm_uploads", one(G.Cs.count(W.CALL_WRITE, c)))
    row("mm_uploads_eq_fixture", U32.is_eq(G.Cs.count(W.CALL_WRITE, c), mm_upload_count()))
    lrow("mm_usage", one(W.alloc.usage()))
    lrow("mm_readable_usage", one(W.copy.readable_usage()))

def t_launch0() -> IO(Unit):
  do IO<Unit>:
    +c : G.Cs <- IO.pure(G.Cs, l0())
    lrow("mm_l0_len", one(G.Cs.len(c)))
    lrow("mm_l0_bg_sizes", G.Cs.bg_sizes(G.Cs.bg(c)))
    lrow("mm_l0_bg_ids", G.Cs.bg_ids(G.Cs.bg(c)))
    lrow("mm_l0_bg_bufs", G.Cs.bg_bufs(G.Cs.bg(c)))
    row("mm_l0_nowait", Bool.not(G.Cs.wait(c)))

def t_launch1() -> IO(Unit):
  do IO<Unit>:
    +c : G.Cs <- IO.pure(G.Cs, l1())
    lrow("mm_l1_len", one(G.Cs.len(c)))
    lrow("mm_l1_bg_sizes", G.Cs.bg_sizes(G.Cs.bg(c)))
    lrow("mm_l1_bg_ids", G.Cs.bg_ids(G.Cs.bg(c)))
    lrow("mm_l1_bg_bufs", G.Cs.bg_bufs(G.Cs.bg(c)))
    row("mm_l1_nowait", Bool.not(G.Cs.wait(c)))

# THE BIND GROUP LAYOUT THE PORT DERIVES, as `(binding, type)` pairs. This is the
# one row that is not a restatement: the gate compares it against the bindings
# tinygrad's OWN WGSL declares, which this generator PARSED out of the shader.
def t_layout() -> IO(Unit):
  do IO<Unit>:
    lrow("mm_layout", W.bgl.flat(W.bgl.of(3, 0), Nil{}))
    lrow("mm_layout_n", one(U32.from_nat(List.length(&2, W.Bgl, W.bgl.of(3, 0)))))
    lrow("mm_bind_uniform", one(W.BIND_UNIFORM()))
    lrow("mm_bind_storage", one(W.BIND_STORAGE()))

def t_read() -> IO(Unit):
  do IO<Unit>:
    +c : G.Cs <- IO.pure(G.Cs, mm_read())
    lrow("mm_read_len", one(G.Cs.len(c)))
    lrow("mm_read_slots", G.Cs.slots(c))

def main() -> IO(Unit):
  do IO<Unit>:
    a : Unit <- t_buffers()
    b : Unit <- t_launch0()
    c : Unit <- t_launch1()
    d : Unit <- t_layout()
    e : Unit <- t_read()
    IO.print("e2e-mm-done=1")

