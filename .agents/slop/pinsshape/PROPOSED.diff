+def captured_tables(entries):
+    """`{(table, reader)}` whose READER proves byte identity against a stream it produces.
+
+    **THE EXEMPTION ATTACHES TO THE PATH THE COMPARISON NAMES, NOT TO EVERY PATH THE READER
+    MENTIONS.** The first version of this collected `f.name in named[n]` over every basename the
+    reader touched, and MEASURED it exempted 5 tables including `-pins.rows` and `.rows` -- because
+    this file's own PLANTS dict spells the comparison out in a comment, so `pins-shape-gate.py`
+    names itself and the reader's capture-ness spread to tables it never touches. An exemption that
+    spreads is not an exemption.
+
+    What survives is the HONEST question -- which table does THIS comparison read -- and the answer
+    has to come from the same expression, so the path and the comparison are read TOGETHER:
+
+        GOOD = <path>          ...  same = GOOD.read_bytes() == r.stdout.encode()
+
+    The binding is `NAME = <...>/"x.rows"` and the use is `NAME.read_bytes() == ... .encode()`. MEASURED
+    tree-wide that binds exactly one pair: `checks/repair-dupes.py` -> `gates/cstyle-live.rows`,
+    whose line 1 is data and therefore cannot carry a header without breaking the comparison."""
+    binds = re.compile(r"""(\w+)\s*=\s*[^\n=]*["']([\w./-]+\.rows)["']""")
+    out = set()
+    for f in entries:
+        try:
+            src = f.read_text()
+        except (UnicodeDecodeError, OSError):
+            continue
+        if not CAPTURED.search(src):
+            continue
+        for var, path in binds.findall(src):
+            if re.search(rf"{re.escape(var)}\.read_bytes\(\)\s*==\s*[\w.]+\.encode\(\)", src):
+                out.add(path.rsplit("/", 1)[-1])
+    return out
