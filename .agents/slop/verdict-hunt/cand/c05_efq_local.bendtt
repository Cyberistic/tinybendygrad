Emp.arms : ∀x0 : <> -> *(.Q2) =
  λ{}

Emp : *(.Q2) =
  Σx0 : <> -> (Emp.arms x0)

Emp.efq : ∀x0 : Emp -> <> =
  λ{(,): λ{}}

Bit.arms : ∀x0 : <B0, B1> -> *(.Q2) =
  λ{.B0: <()>; λ{.B1: <()>; λ{}}}

Bit : *(.Q2) =
  Σx0 : <B0, B1> -> (Bit.arms x0)

W.arms : ∀x0 : <W> -> *(.Q2) =
  λ{.W: Σx0 : Bit -> Σx1 : Emp -> <()>; λ{}}

W : *(.Q2) =
  Σx0 : <W> -> (W.arms x0)

uses : ∀x0 : W -> Bit =
  λx0 => (.B0, ())
