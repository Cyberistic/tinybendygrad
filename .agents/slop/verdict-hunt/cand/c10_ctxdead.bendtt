D.arms : ∀x0 : <C0, C1> -> *(.Q2) =
  λ{.C0: <()>; λ{.C1: <()>; λ{}}}

D : *(.Q2) =
  Σx0 : <C0, C1> -> (D.arms x0)

bad : ∀x0 : Empty -> ∀x1 : D -> ∀x2 : D -> Empty =
  λ+x0 => λ{(,): λ{.C0: λ{(): λ{(,): λx1 => λx2 => (λ{(,): λ{}} x0)}; λ{}}; λ{.C1: λ{(): λ{(,): λx1 => λx2 => (λ{(,): λ{}} x0)}; λ{}}; λ{}}}}

Empty.arms : ∀x0 : <> -> *(.Q2) =
  λ{}

Empty : *(.Q2) =
  Σx0 : <> -> (Empty.arms x0)

Empty.efq : ∀x0 : Empty -> <> =
  λ{(,): λ{}}
