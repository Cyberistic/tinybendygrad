# sched-fixture.bend -- GENERATED by .agents/slop/sched-fixture.py. Do not hand-edit.
#
# Every `+nK = O.UOp.new(...)` below is EMITTED from CPython's own object graph
# by sched-emit.py, so no node here is transcribed and no expectation is typed.
# The rows it prints are the fields `.agents/slop/sched-oracle.txt` records for
# the same spec.
#
# WHAT THIS FILE IS NOT: it is not a claim that the port reproduces tinygrad's
# SCHEDULER. It hands the port's `create_schedule` (named `schedule`) the exact
# sched_sink CPython built and compares the LINEAR field by field. Everything
# upstream of that -- rangeify, prepare, callify -- is `__init__.py:82-301` and is
# still deferred.
import Base
import ./../../tinybendygrad/helpers.bend as H
import ./../../tinybendygrad/LAWS/spec.bend as S
import ./../../tinybendygrad/uop/ops.bend as O
import ./../../tinybendygrad/schedule/__init__.bend as SC

# BOOL LITERALS ARE PATTERNS, NOT TERMS. `False{}` compiles in a `case` arm and
# is REFUSED in a term position ("expected : a defined name, observed : False"),
# which is how the first emitted `ParamArg` died. The port never needs a Bool
# literal term either -- `graphcmp.bend:824` forwards a `vol: Bool` parameter --
# so these two defs are the cheapest honest spelling.
def bfalse() -> Bool: U32.is_eq(1, 0)
def btrue() -> Bool: U32.is_eq(0, 0)

def row(nm: String, v: U32) -> IO(Unit):
  IO.print(String.concat([nm, "=", U32.show(v), "\n"]))

# ---------------------------------------------------------------------------
# THE SHAPE, AND WHY EVERY RECURSIVE DEF BELOW IS SPLIT IN TWO.
#
# AN ARENA PARAMETER MAY BE CONSUMED ONCE. Measured twice: a `+ar` read twice is
# "expected : u / observed : u (consumed more than once)", and so is a NON-`+`
# `ar` that is both read and handed to its own self-call. So the schedule file's
# idiom applies -- a `.go` computes everything it needs from the arena FIRST, as
# VALUES, and the recursive `def` only threads them:
#
#     def f(ar, ss, acc)      -> match ss: Nil => acc | s<>rest => f.go(ar, rest, acc, dig(ar, s))
#     def f.go(ar, ss, acc, d)-> f(ar, ss, acc*36 + d)
#
# THE ORDER IS ALSO LOAD-BEARING: `def f` is declared BEFORE `def f.go` because
# `f.go`'s body calls `f`, and a body that calls an UNFILLED def is refused with
# "expected : a filled definition (an unfilled law is a dead claim)". This is the
# same bill `Kahn`/`Sized` pay at schedule/__init__.bend:895-901.
# ---------------------------------------------------------------------------

# THE PACKING. `dig` is `gate.code` (schedule/__init__.bend:1226) widened to the
# ops sched-emit.py EMITS; a list of ops packs base36 so the LAST op is the LAST
# digit and a whole sequence is ONE comparable token. Digit 0 means "no code", so
# an uncoded op is visible rather than a silent leading zero.
#
# THE OPS ARE THE ONES ACTUALLY EMITTED. The first list at this position
# included `O.OpsDIV{}` and FAILED TO COMPILE -- "a declared constructor
# (unknown: OpsDIV)": ops.bend has NO DIV variant at all, so DIV is NOT PORTED in
# this tree. sched-stage2.md records which specs need it.
def dig(op: O.Op) -> U32:
  match op:
    case O.OpsAFTER{}  : 1
    case O.OpsCALL{}   : 2
    case O.OpsEND{}    : 3
    case O.OpsSTORE{}  : 4
    case O.OpsSINK{}   : 5
    case O.OpsPARAM{}  : 6
    case O.OpsBUFFER{} : 7
    case O.OpsALLOC{}  : 8
    case O.OpsLINEAR{} : 9
    case O.OpsCONST{}  : 10
    case O.OpsRANGE{}  : 11
    case O.OpsMUL{}    : 12
    case O.OpsADD{}    : 13
    case O.OpsINDEX{}  : 14
    case O.OpsREDUCE{} : 15
    case O.OpsMAX{}    : 16
    case O.OpsCAST{}   : 17
    case _             : 0

def lin_nsrc(l: SC.Lin) -> U32:
  U32.from_nat(List.length(&2, U32, SC.Lin.out(l)))

def l_out(l: SC.Lin) -> List<&2, U32>: SC.Lin.out(l)

# ---------------------------------------------------------------------------
# THE FOLDS. Every reader is TWO defs: one that reads the ARENA and builds a
# `List<&2, U32>` of codes, and one arena-FREE fold that packs that list. The
# split is forced by two measured rules and it is worth naming both:
#
# 1. A PARAMETER MAY BE CONSUMED ONCE. A non-`+` `ar` that is both read and
#    handed to its own self-call is "expected : ar / observed : ar (consumed more
#    than once)". A `+ar` may be duplicated -- `wt_go` at
#    schedule/__init__.bend:865 passes it twice in one call -- so the arena
#    readers below all take `+ar`.
# 2. MUTUAL RECURSION NEEDS A FORWARD REFERENCE AND THE COMPILER REFUSES IT
#    ("expected : a filled definition"). `wt_go`/`wt` is NOT mutual: `wt` is a
#    plain def above the loop. So each fold here is a SINGLE self-recursive def
#    that builds a list, and the packing is a second, arena-free recursion.
#    That is rule 1 of the schedule file's own header ("put the decision in a
#    PARAMETER ... or split the def in two") in the only shape that composes with
#    an arena.
#
# `List.append(x, A, xs, ys)` is `xs ++ ys` (the head/tail trap in agent-core), so
# every append below puts the NEW element in the SECOND list and reads as
# "accumulate at the tail", which is Python's order.
# ---------------------------------------------------------------------------

# CPython `lin_ksrc`: every kernel's src ops, kernels in LINEAR order.
#
# THE ENCODING IS THE FLATTENED SEQUENCE IN BASE36 -- not one field per kernel.
# The first attempt multiplied by `36^nsrc(k)` per kernel, which is right and
# which Bend REFUSES: there is no `pow` ("expected : a defined name"). The flat
# fold needs no exponent and still agrees with CPython, because `lin_ksrc` IS the
# flat concatenation.
#
# THE ORDER IS THE WHOLE POINT OF THIS ROW, AND IT IS EASY TO INVERT -- so the bug
# is recorded rather than fixed silently. The first version read
# `List.append(&2, U32, srcs.of(ar, rest), [dig(...)])`: the recursive call FIRST.
# `List.append(x, A, xs, ys)` is `xs ++ ys`, so that PREPENDS, and `matmul_ksrc`
# came out 287933 = base36 `6665` = `[PARAM,PARAM,PARAM,SINK]` where CPython reads
# `['SINK','PARAM','PARAM','PARAM']`. This is the head/tail swap agent-core warns
# about, reached again, and only a SEQUENCE row catches it -- a count would not.
def srcs.of(+ar: O.Arena, ss: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match ss:
    case Nil{}     : acc
    case s <> rest : srcs.of(ar, rest, List.append(&2, U32, acc, [dig(SC.sc_op(ar, s))]))

def srcs.of1(+ar: O.Arena, ss: List<&2, U32>) -> List<&2, U32>:
  srcs.of(ar, ss, Nil{})

def srcs.all(+ar: O.Arena, ks: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match ks:
    case Nil{}     : acc
    case k <> rest : srcs.all(ar, rest, List.append(&2, U32, acc, srcs.of1(ar, SC.sc_srcs(ar, k))))

def pack(xs: List<&2, U32>, acc: U32) -> U32:
  match xs:
    case Nil{}     : acc
    case x <> rest : pack(rest, U32.add(U32.mul(acc, 36), x))

def ksrc(+ar: O.Arena, ks: List<&2, U32>) -> U32:
  pack(srcs.all(ar, ks, Nil{}), 0)

# THE UNTRUNCATED COUNT, so `_ksrc`'s 2^32 wrap can never be silent.
def ksrc_n(ar: O.Arena, ks: List<&2, U32>) -> U32:
  U32.from_nat(List.length(&2, U32, srcs.all(ar, ks, Nil{})))

# CPython `lin_knsrc`: the per-kernel arity, LINEAR order, base 16 so an arity of
# 15+ cannot collide with the next field.
def ns.all(+ar: O.Arena, ks: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match ks:
    case Nil{}     : acc
    case k <> rest : ns.all(ar, rest, List.append(&2, U32, acc, [SC.sc_nsrc(ar, k)]))

def pack16(xs: List<&2, U32>, acc: U32) -> U32:
  match xs:
    case Nil{}     : acc
    case x <> rest : pack16(rest, U32.add(U32.mul(acc, 16), x))

def knsrc(+ar: O.Arena, ks: List<&2, U32>) -> U32:
  pack16(ns.all(ar, ks, Nil{}), 0)

# CPython `lin_ktop`: the per-kernel BODY op. `k.src[0]` is `k.body` for a CALL.
def top.all(+ar: O.Arena, ks: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match ks:
    case Nil{}     : acc
    case k <> rest : top.all(ar, rest, List.append(&2, U32, acc, [dig(SC.sc_op(ar, SC.sc_src0(ar, k)))]))

def ktop(+ar: O.Arena, ks: List<&2, U32>) -> U32:
  pack(top.all(ar, ks, Nil{}), 0)

# CPython `lin_kmark`, GENERALISED. The port's `gate.mark`
# (schedule/__init__.bend:1268) reads `k.src[0].src[0].src[1].val` -- the STORE's
# value CONST -- and codes 1/2/3, answering 0 otherwise. Every real graph stores a
# rewritten EXPRESSION, so `gate.mark` is 0 on all six specs (sched-stage1.md
# records the measurement). The row that carries information is therefore the OP of
# that value: walk to the STORE under the kernel and code `store.src[1]`.
def mk.put(store: Bool, acc: U32, hit: U32) -> U32:
  match store:
    case True{} : hit
    case False{}: acc

# `u` MUST BE `+` HERE. A non-`+` `u` read twice is "expected : u / observed : u
# (consumed more than once)" -- and this body reads it twice, once for the STORE
# test and once for the src index. `+` is not a promise to mutate; it is the
# marker that says "this parameter may be consumed more than once", which is
# exactly `wt_go`'s arrangement at schedule/__init__.bend:865.
def mk.of(+ar: O.Arena, +u: U32, acc: U32) -> U32:
  mk.put(SC.sc_is(ar, u, O.OpsSTORE{}), acc, dig(SC.sc_op(ar, SC.sc_src(ar, u, 1))))

# THE SUBGRAPH, NOT THE DIRECT SRCS. The first version walked `sc_srcs(ar, k)`
# -- the kernel's own srcs -- and so never reached the STORE, which lives under
# `k.src[0]`, the body. `kmark` answered 0 on all six specs, and 0 is also what
# `gate.mark` returns for an uncoded value, so the bug was invisible in
# isolation. `O.UOp.toposort` (ops.bend:2839) is the port's UNGATED walk and it
# enters calls, which is what makes the STORE reachable.
def mk.go(+ar: O.Arena, us: List<&2, U32>, acc: U32) -> U32:
  match us:
    case Nil{}     : acc
    case u <> rest : mk.go(ar, rest, mk.of(ar, u, acc))

def kmark.go(+ar: O.Arena, ks: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match ks:
    case Nil{}     : acc
    case k <> rest : kmark.go(ar, rest, List.append(&2, U32, acc,
      [mk.go(ar, O.UOp.toposort(O.Arena.budget(ar), ar, k), 0)]))

def kmark.go1(+ar: O.Arena, ks: List<&2, U32>) -> List<&2, U32>:
  kmark.go(ar, ks, Nil{})

def kmark(+ar: O.Arena, ks: List<&2, U32>) -> U32:
  pack(kmark.go1(ar, ks), 0)

# `sc_topo_of(fuel, +ar, +self)` is the ONE port def here that needs a `+` arena,
# and it is called once, so it needs no split -- but it cannot share an arena with
# the readers above, so each spec gets its OWN `+`-threaded build for it.
def gated(+ar: O.Arena, t: U32) -> U32:
  U32.from_nat(List.length(&2, U32, SC.sc_topo_of(O.Arena.budget(ar), ar, t)))

