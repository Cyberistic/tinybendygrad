def chain.sched() -> SC.Lin:
  +r = chain.build()
  SC.schedule(O.Found.ar(r), O.Found.i(r))
def chain.lf() -> O.Found: SC.linear(chain.sched())
def chain.lar() -> O.Arena: O.Found.ar(chain.lf())
def chain.root() -> U32: O.Found.i(chain.build())
def chain.out() -> List<&2, U32>: SC.Lin.out(chain.sched())
def chain.cyc() -> U32: U32.from_nat(SC.cycles(SC.Lin.c(chain.sched())))
def chain.linop() -> U32: dig(SC.sc_op(chain.lar(), O.Found.i(chain.lf())))
def chain.gated() -> U32:
  +r = chain.build()
  gated(O.Found.ar(r), O.Found.i(r))

# ---------------------------------------------------------------------------
# THE ROWS. `_cyc` is THE RAISE: CPython raises `RuntimeError("cycle detected in
# assign graph")` (`__init__.py:79`) exactly when it is non-zero, and the port
# cannot raise, so the count is the observable. `_ksrc_n` is the third verdict:
# it says whether `_ksrc`'s base36 integer held every digit.
def main() -> IO(Unit):
  do IO<Unit>:
    row("matmul_gated", matmul.gated())
    row("matmul_root_op", dig(SC.sc_op(matmul.lar(), matmul.root())))
    row("matmul_lin_n", lin_nsrc(matmul.sched()))
    row("matmul_lin_op", matmul.linop())
    row("matmul_ksrc", ksrc(matmul.lar(), matmul.out()))
    row("matmul_ksrc_n", ksrc_n(matmul.lar(), matmul.out()))
    row("matmul_knsrc", knsrc(matmul.lar(), matmul.out()))
    row("matmul_ktop", ktop(matmul.lar(), matmul.out()))
    row("matmul_kmark", kmark(matmul.lar(), matmul.out()))
    row("matmul_cyc", matmul.cyc())
    row("matmul_sym_gated", matmul_sym.gated())
    row("matmul_sym_root_op", dig(SC.sc_op(matmul_sym.lar(), matmul_sym.root())))
    row("matmul_sym_lin_n", lin_nsrc(matmul_sym.sched()))
    row("matmul_sym_lin_op", matmul_sym.linop())
    row("matmul_sym_ksrc", ksrc(matmul_sym.lar(), matmul_sym.out()))
    row("matmul_sym_ksrc_n", ksrc_n(matmul_sym.lar(), matmul_sym.out()))
    row("matmul_sym_knsrc", knsrc(matmul_sym.lar(), matmul_sym.out()))
    row("matmul_sym_ktop", ktop(matmul_sym.lar(), matmul_sym.out()))
    row("matmul_sym_kmark", kmark(matmul_sym.lar(), matmul_sym.out()))
    row("matmul_sym_cyc", matmul_sym.cyc())
    row("conv_gated", conv.gated())
    row("conv_root_op", dig(SC.sc_op(conv.lar(), conv.root())))
    row("conv_lin_n", lin_nsrc(conv.sched()))
    row("conv_lin_op", conv.linop())
    row("conv_ksrc", ksrc(conv.lar(), conv.out()))
    row("conv_ksrc_n", ksrc_n(conv.lar(), conv.out()))
    row("conv_knsrc", knsrc(conv.lar(), conv.out()))
    row("conv_ktop", ktop(conv.lar(), conv.out()))
    row("conv_kmark", kmark(conv.lar(), conv.out()))
    row("conv_cyc", conv.cyc())
    row("elementwise_gated", elementwise.gated())
    row("elementwise_root_op", dig(SC.sc_op(elementwise.lar(), elementwise.root())))
    row("elementwise_lin_n", lin_nsrc(elementwise.sched()))
    row("elementwise_lin_op", elementwise.linop())
    row("elementwise_ksrc", ksrc(elementwise.lar(), elementwise.out()))
    row("elementwise_ksrc_n", ksrc_n(elementwise.lar(), elementwise.out()))
    row("elementwise_knsrc", knsrc(elementwise.lar(), elementwise.out()))
    row("elementwise_ktop", ktop(elementwise.lar(), elementwise.out()))
    row("elementwise_kmark", kmark(elementwise.lar(), elementwise.out()))
    row("elementwise_cyc", elementwise.cyc())
    row("multi_gated", multi.gated())
    row("multi_root_op", dig(SC.sc_op(multi.lar(), multi.root())))
    row("multi_lin_n", lin_nsrc(multi.sched()))
    row("multi_lin_op", multi.linop())
    row("multi_ksrc", ksrc(multi.lar(), multi.out()))
    row("multi_ksrc_n", ksrc_n(multi.lar(), multi.out()))
    row("multi_knsrc", knsrc(multi.lar(), multi.out()))
    row("multi_ktop", ktop(multi.lar(), multi.out()))
    row("multi_kmark", kmark(multi.lar(), multi.out()))
    row("multi_cyc", multi.cyc())
    row("chain_gated", chain.gated())
    row("chain_root_op", dig(SC.sc_op(chain.lar(), chain.root())))
    row("chain_lin_n", lin_nsrc(chain.sched()))
    row("chain_lin_op", chain.linop())
    row("chain_ksrc", ksrc(chain.lar(), chain.out()))
    row("chain_ksrc_n", ksrc_n(chain.lar(), chain.out()))
    row("chain_knsrc", knsrc(chain.lar(), chain.out()))
    row("chain_ktop", ktop(chain.lar(), chain.out()))
    row("chain_kmark", kmark(chain.lar(), chain.out()))
    row("chain_cyc", chain.cyc())
