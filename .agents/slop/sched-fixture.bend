def matmul.sched() -> SC.Lin:
  +r = matmul.build()
  SC.schedule(O.Found.ar(r), O.Found.i(r))
def matmul.lf() -> O.Found: SC.linear(matmul.sched())
def matmul.lar() -> O.Arena: O.Found.ar(matmul.lf())
def matmul.root() -> U32: O.Found.i(matmul.build())
def matmul.out() -> List<&2, U32>: SC.Lin.out(matmul.sched())
def matmul.cyc() -> U32: U32.from_nat(SC.cycles(SC.Lin.c(matmul.sched())))
def matmul.linop() -> U32: dig(SC.sc_op(matmul.lar(), O.Found.i(matmul.lf())))
def matmul.gated() -> U32:
  +r = matmul.build()
  gated(O.Found.ar(r), O.Found.i(r))

