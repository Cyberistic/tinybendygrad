def multi.sched() -> SC.Lin:
  +r = multi.build()
  SC.schedule(O.Found.ar(r), O.Found.i(r))
def multi.lf() -> O.Found: SC.linear(multi.sched())
def multi.lar() -> O.Arena: O.Found.ar(multi.lf())
def multi.root() -> U32: O.Found.i(multi.build())
def multi.out() -> List<&2, U32>: SC.Lin.out(multi.sched())
def multi.cyc() -> U32: U32.from_nat(SC.cycles(SC.Lin.c(multi.sched())))
def multi.linop() -> U32: dig(SC.sc_op(multi.lar(), O.Found.i(multi.lf())))
def multi.gated() -> U32:
  +r = multi.build()
  gated(O.Found.ar(r), O.Found.i(r))

def chain.build() -> O.Found:
    +n0 = O.UOp.new(O.Arena.empty(), O.OpsPARAM{}, [], O.AParam{O.ParamArg{0, S.single(), Some{12}, None{}, None{}, None{}, S.AGlobal{}, Some{S.D1{0}}, bfalse(), None{}, None{}, bfalse(), None{}}}, O.TNone{})
    +n1 = O.UOp.new(O.Found.ar(n0), O.OpsPARAM{}, [], O.AParam{O.ParamArg{0, S.single(), Some{12}, None{}, None{}, None{}, S.AGlobal{}, Some{S.D1{0}}, bfalse(), None{}, None{}, bfalse(), None{}}}, O.TNone{})
    +n2 = O.UOp.new(O.Found.ar(n1), O.OpsCONST{}, [], O.APy{O.CInt{H.i64_of_i32(4)}}, O.TNone{})
    +n3 = O.UOp.new(O.Found.ar(n2), O.OpsRANGE{}, [O.Found.i(n2)], O.ARange{[0], O.AXIS_WEAK{}}, O.TNone{})
    +n4 = O.UOp.new(O.Found.ar(n3), O.OpsCONST{}, [], O.APy{O.CInt{H.i64_of_i32(3)}}, O.TNone{})
    +n5 = O.UOp.new(O.Found.ar(n4), O.OpsMUL{}, [O.Found.i(n3), O.Found.i(n4)], O.ANone{}, O.TNone{})
    +n6 = O.UOp.new(O.Found.ar(n5), O.OpsRANGE{}, [O.Found.i(n4)], O.ARange{[1], O.AXIS_WEAK{}}, O.TNone{})
    +n7 = O.UOp.new(O.Found.ar(n6), O.OpsADD{}, [O.Found.i(n5), O.Found.i(n6)], O.ANone{}, O.TNone{})
    +n8 = O.UOp.new(O.Found.ar(n7), O.OpsINDEX{}, [O.Found.i(n1), O.Found.i(n7)], O.ANone{}, O.TNone{})
    +n9 = O.UOp.new(O.Found.ar(n8), O.OpsPARAM{}, [], O.AParam{O.ParamArg{1, S.single(), Some{12}, None{}, None{}, None{}, S.AGlobal{}, Some{S.D1{0}}, bfalse(), None{}, None{}, bfalse(), None{}}}, O.TNone{})
    +n10 = O.UOp.new(O.Found.ar(n9), O.OpsINDEX{}, [O.Found.i(n9), O.Found.i(n7)], O.ANone{}, O.TNone{})
