# probe.rows -- IS THE TOOLCHAIN BROKEN?  Measured on THIS gate, not inherited.
# Every run is .venv/bin/python checks/bounded.py --seconds 300 --mb 2048 -- ./bin/bend ...
# The VERDICT TOKEN is parsed, not the exit code.  Compiler: bend 2.0.34 (per brief).

## A. TWO-ARGUMENT APPLICATION, WRITTEN THE WAY dtype.bend CALLS IT TODAY (pure, `=` bind)
import ../../../../tinybendygrad/dtype.bend as D

def main() -> IO(Unit):
  do IO<Unit>:
    v : F32 = D.Dt.fp16(1.5)
    w : U32 = D.Dt.fp8_from(F32.bits(1.5), 0)
    IO.print("F32ROW pure_fp16 = " ++ F32.show(v))
    IO.print("F32ROW pure_fp8fr = " ++ U32.show(w))
--- $ ./bin/bend pure.bend -o pure.js
WITHIN-LIMITS rc=0 peak-RSS=512 MB err=42B  -> COMPILES
--- $ node pure.js
abi123 trunc_A = 15:240
abi123 trunc_B = 3735928559:305419896
abi123 fdiv_b3 = 0:2
abi123 fdiv_b5 = 0:1
abi123 fdiv_b1 = 0:7
abi1 fp8from_e4m3 = 60
abi1 fp8from_fnuz = 68
abi1 bf16_1p5 = 1.5
abi4 fp16_1p5 = 1.5
abi4 fp16_1p1 = 1.0996094
abi4 fp16_m2p25 = -2.25
abi4 fp8to_0x3C = 1.5
node rc=0, 12/12 rows

