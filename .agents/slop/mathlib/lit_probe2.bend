import Base

# Is there an f32 BITCAST in Bend 2.0.34? `F32.show` exists per `bend guide` but
# is an axiom, so `helpers.bend:893` cannot print an F32 with it either.
# A port that needs to PIN an f32 constant has to compare it somehow.
#
# Three routes are probed here:
#   1. `F32.is_eq`  -- is `F32.div(0.5, 1.0)` equal to the literal `0.5`?
#   2. `F32.trunc`  -- does trunc recover 3 from pi?
#   3. `F32.cmp`    -- does ordering work?
#
# If (1) is exact then "write the constant as a decimal literal" IS available to
# the port, and the 37-mention constant cluster is not a wall.
#
# EXPECTATIONS from `.agents/slop/mathlib/expect2.txt`, generated by CALLING
# CPython. Never typed.

def half() -> F32:
  F32.div(1.0, 2.0)

def third() -> F32:
  F32.div(1.0, 3.0)

def pi() -> F32:
  F32.div(3.141592653589793, 1.0)

def two_thirds() -> F32:
  F32.div(2.0, 3.0)

def say(nm: String, b: Bool) -> IO(Unit):
  IO.print(String.concat([nm, "=", Bool.show(b)]))

def main() -> IO(Unit):
  do IO<Unit>:
    # 1. does a computed 1/2 equal the literal 0.5?
    say("eq_half_lit_half", F32.is_eq(half(), 0.5))
    say("eq_half_lit_one", F32.is_eq(half(), 1.0))
    # 2. does 2/3 equal a decimal literal for 2/3?
    say("eq_two_thirds_lit", F32.is_eq(two_thirds(), 0.6666666666666666))
    # 3. does trunc recover 3 from pi?
    say("trunc_pi_is_3", U32.is_eq(F32.to_u32(F32.trunc(pi())), 3))
    say("trunc_third_is_0", U32.is_eq(F32.to_u32(F32.trunc(third())), 0))
    # 4. is the LITERAL pi itself usable and distinct from 3?
    say("lit_pi_trunc_is_3", U32.is_eq(F32.to_u32(F32.trunc(3.141592653589793)), 3))
    say("lit_3_trunc_is_3", U32.is_eq(F32.to_u32(F32.trunc(3.0)), 3))
    # 5. is 1/3 literally different from 2/3?
    say("third_ne_two_thirds", F32.is_ne(third(), two_thirds()))
    # 6. does inf behave as inf (inf * 0 is nan, inf > 1e30)
    say("inf_gt_big", F32.is_gt(F32.div(1.0, 0.0), 1000000.0))
    say("inf_times_zero_is_nan", F32.is_ne(F32.mul(F32.div(1.0, 0.0), 0.0), 0.0))
    # 7. MEASURED: `1e30` is NOT a valid literal -- "expected : a numeric literal".
    # Only a decimal point form is. This is why every f32 constant in the tree is
    # written longhand, e.g. `0.044715` at mixin/elementwise.bend's gelu row.
    say("big_lit_trunc", U32.is_eq(F32.to_u32(F32.trunc(1000000.0)), 1000000))