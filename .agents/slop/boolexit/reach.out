                                                      | if code in VERDICT:
gates/gatekit.py                :97    SUB  VERDICT    keys=[0, 1, 3, 4, 5]    index=code                         bool=False guard=EARLIER-isinstance-bool-on:code
                                                      | return VERDICT[code]
gates/gatekit.py                :110   IN   VERDICT    keys=[0, 1, 3, 4, 5]    index=code                         bool=False guard=SAME-EXPR-and-isinstance-bool (sho
                                                      | return code if code in VERDICT and not isinstance(code, bool) else REFUSED
