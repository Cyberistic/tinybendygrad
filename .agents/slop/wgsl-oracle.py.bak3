#!/usr/bin/env python3
"""The CPython oracle for tinybendygrad/renderer/wgsl.bend.

Drives the REAL pipeline -- `to_program(ast, WGSLRenderer(...))`, which is what
`WebGPUProgram` does, so `wgsl_matcher` (the renderer's `extra_matcher`) runs as
the final graph rewrite exactly as it does in production -- and prints one row
per line of the emitted WGSL. The Bend lane prints the same rows and the two are
diffed. No row is a boolean about a string.
"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from tinygrad import Tensor, dtypes
from tinygrad.uop.ops import Ops, UOp
from tinygrad.helpers import Target
from tinygrad.renderer.wgsl import WGSLRenderer
from tinygrad.codegen import to_program

D = "CPU"


def ren(arch: str) -> WGSLRenderer:
  return WGSLRenderer(Target(device="", renderer="wgpu", arch=arch))


def render(fn, arch=""):
  t = fn()
  prg = to_program(t.uop, ren(arch))
  return str(prg.src[-1].arg)


def show(tag, text):
  for line in text.split("\n"):
    print(f"[{tag}] {line}")


# R1 float32 add -- the plain ALU surface, the buffer prologue, workgroup_size.
def k_alu():
  a = Tensor([1.0, 2.0, 3.0, 4.0], device=D).realize()
  b = Tensor([5.0, 6.0, 7.0, 8.0], device=D).realize()
  return (a + b)


# R2 a gated store -> WHERE -> select, and a comparison on bools.
def k_where():
  a = Tensor([1.0, 2.0, 3.0, 4.0], device=D).realize()
  b = Tensor([5.0, 6.0, 7.0, 8.0], device=D).realize()
  return ((a > b).where(a, b))


# R3 half arithmetic -- `enable f16`, the vec2<f16> bitcast helpers.
def k_half():
  a = Tensor([1.0, 2.0, 3.0, 4.0], dtype=dtypes.half, device=D).realize()
  b = Tensor([5.0, 6.0, 7.0, 8.0], dtype=dtypes.half, device=D).realize()
  return (a + b)


# R4 PACKED uchar -- `atomic<u32>` buffers, atomicAnd/atomicAdd read-modify-write.
def k_packed():
  a = Tensor.arange(16, device=D, dtype=dtypes.int32).cast(dtypes.uchar).realize()
  b = Tensor.arange(16, device=D, dtype=dtypes.int32).cast(dtypes.uchar).realize()
  return (a + b)


# R5 packed char, the OTHER packed width: sign_extend on load, the shift-amount
# ladder on store, and `atomic<u32>` again.
def k_packed_char():
  a = (Tensor.arange(16, device=D, dtype=dtypes.int32) - 8).cast(dtypes.char).realize()
  b = (Tensor.arange(16, device=D, dtype=dtypes.int32) - 8).cast(dtypes.char).realize()
  return (a + b)


# R6 i8/i16 casts -- render_cast's truncate/sign-extend forms.
def k_narrow():
  a = Tensor([1, 2, 3, 4], dtype=dtypes.int8, device=D).realize()
  b = Tensor([5, 6, 7, 8], dtype=dtypes.int16, device=D).realize()
  return (a + b).cast(dtypes.int32)


# R7 is_nan -- `nan()`, and the CMPEQ(a,a) -> `!is_nan` rewrite.
def k_nan():
  a = Tensor([1.0, 2.0, 3.0, 4.0], device=D).realize()
  return ((a == a) + (a != a))


# R8 a LOCAL buffer -> `var<workgroup>` hoisted out of the body by render_kernel.
def k_local():
  a = Tensor([1.0, 2.0, 3.0, 4.0], device=D).realize()
  b = Tensor([5.0, 6.0, 7.0, 8.0], device=D).realize()
  return (a @ b.T) if False else (a + b)


FIX = [("alu", k_alu, ""), ("where", k_where, ""), ("half", k_half, "shader-f16"),
       ("packed", k_packed, ""), ("pchar", k_packed_char, ""), ("narrow", k_narrow, ""),
       ("nan", k_nan, "")]


def main():
  want = sys.argv[1] if len(sys.argv) > 1 else "all"
  for tag, fn, arch in FIX:
    if want not in ("all", tag):
      continue
    show(tag, render(fn, arch))


if __name__ == "__main__":
  main()
