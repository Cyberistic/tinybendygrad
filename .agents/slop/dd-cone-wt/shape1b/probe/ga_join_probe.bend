def esc_pair(l: String) -> List<&2, String>: [l, "\\n"]

def esc_row(got: List<&2, String>) -> String:
  String.concat(List.concat(&2, String, List.map(&2, String, List<&2, String>, esc_pair, got)))

def t(nm: String, s: String) -> IO(Unit):
  IO.print(String.concat([nm, " -> ", U32.show(U32.from_nat(String.length(s)))]))

def main() -> IO(Unit):
  do IO<Unit>:
  t("concat", esc_row(ls()))
  t("join", String.join(ls(), "\\n"))
