def esc.go(ls_: List<&2, String>, +acc: List<&2, String>) -> List<&2, String>:
  match ls_:
    case Nil{}: acc
    case +h <> t: esc.go(t, List.append(&2, String, [h, "\\n"], acc))

def esc_row(got: List<&2, String>) -> String:
  String.concat(esc.go(got, Nil{}))

def t(nm: String, s: String) -> IO(Unit):
  IO.print(String.concat([nm, " -> ", U32.show(U32.from_nat(String.length(s)))]))

def main() -> IO(Unit):
  do IO<Unit>:
  t("concat", esc_row(ls()))
