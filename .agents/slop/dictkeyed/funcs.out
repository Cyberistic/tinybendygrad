===== checks/index-arm-gate.py:149-163  fn=not_intent_to_add  verbs=['ls-files'] shape=LINEWISE keyed_container=False
    149| def not_intent_to_add(root: Path, paths: list[str]) -> list[str]:
    150|     """`git ls-files --debug` prints the intent-to-add bit in its `flags:` line. An ITA entry is the
    151|     INTENT shape and git 2.50.1 refuses it; only the UNFLAGGED ones are EMPTIED and destructive."""
    152|     if not paths:
    153|         return []
    154|     rc, out, err = git(root, "ls-files", "--debug", "--", *paths)
    155|     if rc != 0:
    156|         raise RuntimeError(f"ls-files --debug rc={rc}: {err.strip()}")
    157|     cur, flags = None, {}
    158|     for line in out.splitlines():
    159|         if not line.startswith("  "):
    160|             cur = line.strip()
    161|         elif line.strip().startswith("flags:"):
    162|             flags[cur] = int(line.split("flags:")[1].strip(), 16)
    163|     return [p for p in paths if flags.get(p, 0) & 0x4000 == 0]

