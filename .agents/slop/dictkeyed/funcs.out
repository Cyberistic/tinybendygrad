===== gates/oracle-census-gate.py:165-177  fn=head_paths  verbs=['diff', 'ls-tree'] shape=LINEWISE keyed_container=False
    165| def head_paths(paths=()) -> set[str]:
    166|     """Every tracked path, from the COMMIT.
    167| 
    168|     NOT `git ls-files`: `jj git colocation` stages an `e69de29b` placeholder for every untracked
    169|     file, and MEASURED on this tree that changes the answer (`AGENTS.md`: 882 placeholders, 7.9 MB
    170|     across 149 owner directories, `git diff --cached` naming 0). The index is a question about the
    171|     editor. `git ls-tree -r HEAD` is the question about the repository.
    172|     """
    173|     cmd = ["git", "ls-tree", "-r", "HEAD", "--name-only"]
    174|     if paths:
    175|         cmd += ["--", *paths]
    176|     out = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
    177|     return {p for p in out.stdout.split("\n") if p}

