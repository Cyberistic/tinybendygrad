===== checks/cites-census.py:182-205  fn=suffix_index  verbs=['ls-tree'] shape=LINEWISE keyed_container=True
    182| def suffix_index() -> dict[str, list[str]]:
    183|     """Every tracked path under every `/`-aligned suffix of itself, so `uop/ops.bend` finds
    184|     `tinybendygrad/uop/ops.bend`.  The population is `git ls-tree -r HEAD`, the extractor that
    185|     already declared it -- NOT a hand list of roots.  MEASURED 2026-10-15: the tree has 14 tracked
    186|     top-level directories and `ROOT` is the repo root, so `ROOT/"uop/ops.py"` names nothing while
    187|     the claim's own spelling names `tinygrad/uop/ops.py`.  That mismatch was 1,047 of the 1,262
    188|     `unreadable or absent` rows, and **0 of those 324 subjects resolved at ROOT.**
    189|     A value may hold several paths: `.agents/slop/strays/{origin,working}/` keep full copies, so
    190|     suffix matching is genuinely ambiguous and `read` refuses it rather than picking one."""
    191|     global _SUFFIX, _TRACKED
    192|     if _SUFFIX is None:
    193|         r = subprocess.run(["git", "ls-tree", "-r", "HEAD", "--name-only"], cwd=ROOT,
    194|                            capture_output=True, text=True)
    195|         if r.returncode != 0:
    196|             print(f"{REFUSED}: git ls-tree rc={r.returncode}: {r.stderr.strip()}")
    197|             sys.exit(EXITS[REFUSED])
    198|         _TRACKED, idx = r.stdout.splitlines(), {}
    199|         for path in _TRACKED:
    200|             i = path.find("/")
    201|             while i != -1:
    202|                 idx.setdefault(path[i:], []).append(path)
    203|                 i = path.find("/", i + 1)
    204|         _SUFFIX = idx
    205|     return _SUFFIX

