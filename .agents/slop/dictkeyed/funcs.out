    172|                           capture_output=True, text=True, check=True)
    173|     tree = {}
    174|     for line in proc.stdout.splitlines():
    175|         meta, _, path = line.partition("\t")
    176|         bits = meta.split()
    177|         if len(bits) >= 3:
    178|             tree[path] = bits[2]
    179|     return tree

===== gates/gates-pop.py:793-816  fn=_tree_paths  verbs=['ls-tree'] shape=LINEWISE keyed_container=False
    793| def _tree_paths(root):
    794|     """`(sorted tracked paths, source)` -- `git ls-tree -r --name-only HEAD`, or the working copy.
    795| 
    796|     **THE COMMIT TREE IS THE PRUNE, WHICH IS WHY THERE IS NO PRUNE LIST.** `references/`,
    797|     `.venv/`, `node_modules/`, `.agents/slop/opstree/`, `/runs/`, `/bin/bend` are every one of them
    798|     `.gitignore`d, so a candidate set read off the TREE excludes them by construction --
    799|     `checks/gendirs.py` cannot do this and carries a `SKIP_TOP` tuple for it. The fallback exists
    800|     for `--plant`, whose synthetic trees are not repositories, and it SAYS WHICH it used: a
    801|     derivation whose provenance is unprinted is a claim, and `gate-surface.py`'s `walk_control` is
    802|     the second instance of this exact shape.
    803|     """
    804|     r = subprocess.run(["git", "-C", str(root), "ls-tree", "-r", "--name-only", "HEAD"],
    805|                        capture_output=True, text=True)
    806|     if r.returncode == 0 and r.stdout.strip():
    807|         return sorted(r.stdout.splitlines()), "COMMIT TREE (git ls-tree -r HEAD)"
    808|     # `find -type f` DOES NOT DESCEND A SYMLINKED DIRECTORY (196 under `e2epy/` here), so
    809|     # `rglob` can report fewer files than `os.walk` would and the denominator would understate
    810|     # itself. `os.walk` with `followlinks=False` is the honest walk, and it is the same one
    811|     # `gate_homes` uses a few lines below.
    812|     out = []
    813|     for dirpath, dirnames, filenames in os.walk(root):
    814|         dirnames[:] = [d for d in dirnames if d not in _SKIP]
    815|         out += [str((Path(dirpath) / f).relative_to(root)) for f in filenames]
    816|     return sorted(out), "WORKING COPY (git absent)"

