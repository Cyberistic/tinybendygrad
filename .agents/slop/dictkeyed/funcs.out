    281|                        cwd=ROOT, capture_output=True, text=True)
    282|     n = e = 0
    283|     for line in r.stdout.splitlines():
    284|         meta, _, _path = line.partition("\t")
    285|         parts = meta.split()
    286|         if len(parts) >= 3 and parts[1] == "blob":
    287|             n += 1
    288|             e += parts[2] == empty
    289|     return n, e

===== checks/git-index-guard.py:52-63  fn=fingerprint  verbs=['diff'] shape=LINEWISE keyed_container=False
     52| def fingerprint() -> tuple[str | None, str, str]:
     53|     """(token, head, error). token is None on an unreadable repository."""
     54|     rc, head = git("rev-parse", "HEAD")
     55|     if rc != 0:
     56|         return None, "", "not a git repository or no HEAD"
     57|     rc, staged = git("diff", "--cached", "--name-status", "-z")
     58|     if rc != 0:
     59|         return None, "", "git diff --cached failed"
     60|     head = head.strip()
     61|     entries = [e for e in staged.split("\0") if e]
     62|     body = "\n".join(["head", head, "staged", str(len(entries)), *entries])
     63|     return hashlib.sha256(body.encode()).hexdigest(), head, ""

