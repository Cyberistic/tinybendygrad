DOC	BODY	def discover(root): """`(entries, libs)`, by walking the two homes. NEVER a literal list of files. `iterdir()` and not `rglob()`, so a `__pycache__` directory under a home is not descended into and a cached `.pyc` cannot be counted as a gate. `os.lstat` and not `Path.exists()`, because `Path.exists()` FOLLOWS SYMLINKS: `bin/bend` is a symlink to a worktree and an existence test that follows it would certify a link target as a tree file. """ entries, libs = ([], []) for home in HOMES: h = root / home if not os.path.isdir(h): continue for p in sorted(h.iterdir()): if p.suffix not in SUFFIXES or not p.is_file(): continue (entries if entry_reason(p) in ('py-main', 'sh-dispatch', 'sh-selfref') else libs).append(p) return (entries, libs)
