import Base
import ./../../../tinybendygrad/helpers.bend as H

def one(nm: String, ah: U32, al: U32, bh: U32, bl: U32) -> IO(Unit):
  do IO<Unit>:
    IO.print(String.concat([nm, "=", H.i64_text(H.i64_div(H.i64_of_hi_lo(ah, al), H.i64_of_hi_lo(bh, bl)))]))

def main() -> IO(Unit):
  do IO<Unit>:
    one("r0", 0, 1, 2147483648, 0)
    one("r1", 0, 2, 2147483648, 0)
    one("r2", 0, 3, 2147483648, 0)
