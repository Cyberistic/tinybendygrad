import Base
def Blob.at(h: String, i: U32) -> Char: Maybe.default(&2, Char, String.get(h, U32.to_nat(i)), Char.from_u32(48))
def Hex.d(c: Char) -> U32: Char.to_u32(c)
def Hex.isdig(c: Char) -> Bool: Char.is_digit(c)
def Hex.isupp(c: Char) -> Bool: Char.is_upper(c)
def Hex.islow(c: Char) -> Bool: Char.is_lower(c)
def Hex.d48(c: Char) -> U32: U32.sub(Hex.d(c), 48)
def Hex.d87(c: Char) -> U32: U32.sub(Hex.d(c), 87)
def Hex.d55(c: Char) -> U32: U32.sub(Hex.d(c), 55)
def Hex.uppval(+c: Char) -> U32: Bool.pick(U32, Hex.isupp(c), Hex.d55(c), 15)
def Hex.lowval(+c: Char) -> U32: Bool.pick(U32, Hex.islow(c), Hex.d87(c), Hex.uppval(c))
def Hex.val(+c: Char) -> U32: Bool.pick(U32, Hex.isdig(c), Hex.d48(c), Hex.lowval(c))
def Blob.nib(h: String, i: U32) -> U32: Hex.val(Blob.at(h, i))
def Blob.u8(+h: String, +i: U32) -> U32: U32.add(U32.mul(Blob.nib(h, U32.mul(i, 2)), 16), Blob.nib(h, U32.add(U32.mul(i, 2), 1)))
def Blob.le16(+h: String, +i: U32) -> U32: U32.add(Blob.u8(h, i), U32.mul(Blob.u8(h, U32.add(i, 1)), 256))
def Blob.le32(+h: String, +i: U32) -> U32: U32.add(Blob.le16(h, i), U32.mul(Blob.le16(h, U32.add(i, 2)), 65536))
def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(String.concat(["ch0=", U32.show(Char.to_u32(Blob.at("7f454c46", 0)))]))
    IO.print(String.concat(["u8@0=", U32.show(Blob.u8("7f454c46", 0))]))
    IO.print(String.concat(["u8@1=", U32.show(Blob.u8("7f454c46", 1))]))
    IO.print(String.concat(["u8@2=", U32.show(Blob.u8("7f454c46", 2))]))
    IO.print(String.concat(["le16@0=", U32.show(Blob.le16("7f454c46", 0))]))
    IO.print(String.concat(["le32@0=", U32.show(Blob.le32("7f454c46", 0))]))
    IO.print(String.concat(["le32@2=", U32.show(Blob.le32("7f454c46", 2))]))
