wmask 255_16	GRAPH:255<<16^4294967295	4278255615	LANE
wmask 255_24	GRAPH:255<<24^4294967295	16777215	LANE
wmask 255_8	GRAPH:255<<8^4294967295	4294902015	LANE
wmask 65535_0	GRAPH:65535<<0^4294967295	4294901760	LANE
wmask 65535_16	GRAPH:65535<<16^4294967295	65535	LANE

