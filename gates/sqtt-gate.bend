# gates/sqtt-gate.bend -- THE GATE DRIVER for `tinybendygrad/renderer/amd/sqtt.bend`.
#
# THE ROWS MOVED HERE FROM THE PORT FILE. **THE PORT FILE CARRIES THE PORT AND
# THIS FILE CARRIES THE INSTRUMENT**, AND THE TREE's OWN CONVENTION SAYS SO:
# `gates/README.md:173` -- "a gate's `.bend` driver and its CPython oracle sit in
# `gates/`, named by the gate that needs them."
#
# **AND THE ROWS ARE PURE CONSUMERS: THEY CALL THE PORT's DEFS AND DEFINE
# NOTHING THAT THE PORT NEEDS.**

import Base
import ./../tinybendygrad/renderer/amd/sqtt.bend as P
import ./../tinybendygrad/helpers.bend as H
import ./../tinybendygrad/renderer/amd/dsl.bend as D

def srow(nm: String, v: String) -> IO(Unit): IO.print(String.concat([nm, "=", v]))
def urow(nm: String, v: U32) -> IO(Unit): IO.print(String.concat([nm, "=", P.u32_text(v)]))

def nat_text(v: Nat) -> String: U32.show(U32.from_nat(v))
def u32_at(i: U32, xs: List<&2, U32>) -> U32: P.u32_at.go(List.get(&2, U32, xs, U32.to_nat(i)), P.DSLT())

def u32_list_text(xs: List<&2, U32>) -> String: P.u32_list_text.go(xs, "")

def name_at(off: U32, +xs: List<&2, P.Pn>) -> String: P.pn_name.go(P.n_of(xs), off, xs, False{}, "")

def op_of(nm: String, +xs: List<&2, P.Pn>) -> U32: P.pn_off.go(P.n_of(xs), nm, xs, False{}, P.DSLT())

def cls_count() -> U32: P.cls_count.go(P.CLS_NAMES(), 0)

def di_text(v: List<&2, U32>) -> String: P.di_text.go(v, "")

def set_mul(xs: List<&2, U32>) -> String: P.set_mul.go(xs, "")

def set_sp(xs: List<&2, U32>) -> String: P.set_sp.go(xs, "")

def str_list_text(xs: List<&2, String>) -> String: P.str_list_text.go(xs, "")
def nibs_of(hi_max: U32) -> U32: P.NIB_ROUND(hi_max)
def is_marker(rt: U32, pl: U32) -> Bool: Bool.and(Bool.not(U32.is_zero(rt)), U32.is_zero(pl))
def is_config(hi_byte: U32) -> Bool: Bool.not(U32.is_zero(U32.and(hi_byte, 128)))
def wave_interest(coarse: U32) -> Bool: Bool.not(U32.is_zero(U32.and(coarse, 1)))
def terminate_all(coarse: U32) -> Bool: Bool.not(U32.is_zero(U32.and(coarse, 8)))


# --- THE GATE ROWS ------------------------------------------------------
