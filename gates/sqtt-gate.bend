def g_state() -> IO(Unit):
  do IO<Unit>:
    srow("state_RDNA3_n", nat_text(P.state_RDNA3_n()))
    srow("state_RDNA3", u32_list_text(P.state_RDNA3()))
    urow("nop_last_RDNA3", P.nop_last_RDNA3())
    srow("state_RDNA4_n", nat_text(P.state_RDNA4_n()))
    srow("state_RDNA4", u32_list_text(P.state_RDNA4()))
    urow("nop_last_RDNA4", P.nop_last_RDNA4())
    srow("state_CDNA_n", nat_text(P.state_CDNA_n()))
    srow("state_CDNA", u32_list_text(P.state_CDNA()))
    urow("nop_last_CDNA", P.nop_last_CDNA())
    # THE FIRST BYTE of each table, which is the only one a reader needs to
    # tell the three architectures apart at a glance.
    urow("state_first_RDNA3", u32_at(0, P.state_RDNA3()))
    urow("state_first_RDNA4", u32_at(0, P.state_RDNA4()))
    urow("state_first_CDNA", u32_at(0, P.state_CDNA()))
    # and byte 0x10, where the NOP default shows up
    urow("state_16_RDNA3", u32_at(16, P.state_RDNA3()))
    urow("state_255_RDNA3", u32_at(255, P.state_RDNA3()))
    urow("state_16_RDNA4", u32_at(16, P.state_RDNA4()))
    urow("state_255_RDNA4", u32_at(255, P.state_RDNA4()))
    urow("state_16_CDNA", u32_at(16, P.state_CDNA()))
    urow("state_255_CDNA", u32_at(255, P.state_CDNA()))
