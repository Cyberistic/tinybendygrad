# gates/gradient-gate.bend -- the gate driver for `tinybendygrad/mixin/gradient.bend`.
#
# The rows moved here from the port file, which keeps the port and loses the
# instrument: `gates/README.md:173` -- "a gate's `.bend` driver and its CPython
# oracle sit in `gates/`, named by the gate that needs them."
#
# Every row calls a port def through `P.` and defines nothing the port needs.

import Base
import ./../tinybendygrad/mixin/gradient.bend as P

import ./../tinybendygrad/LAWS/spec.bend as S
import ./../tinybendygrad/helpers.bend as H
import ./../tinybendygrad/uop/ops.bend as O
import ./../tinybendygrad/uop/fold.bend as F
def row(nm: String, v: U32) -> IO(Unit):
  IO.print(String.concat([nm, "=", U32.show(v)]))

# A STRING ROW, because the walk's SIGNATURE is text and CPython's is text too: a
# signature packed into a `U32` would need an op-code table, and one invented here would
# be a table the oracle cannot check. These rows are `name=<the oracle's own bytes>` and
# the differ is a `diff`, not an interpretation.
def srow(nm: String, v: String) -> IO(Unit):
  IO.print(String.concat([nm, "=", v]))

def main() -> IO(Unit):
  do IO<Unit>:
    a : Unit <- row("claims", P.t_claims())
    b : Unit <- row("const_cast", P.t_const_cast())
    row("size_const", P.t_size_const())
    row("size_mul", P.t_size_mul())
    row("one_n", P.t_one_n())
    row("seven_n", P.t_seven_n())
    row("const_raw", P.t_const_raw())
    row("neginf", P.t_neginf())
    row("recip_n", P.t_recip_n())
    row("sin_n", P.t_sin_n())
    row("log2_n", P.t_log2_n())
    row("exp2_n", P.t_exp2_n())
    row("sqrt_n", P.t_sqrt_n())
    row("trunc_n", P.t_trunc_n())
    row("pow_n0", P.t_pow_n0())
    row("pow_n1", P.t_pow_n1())
    row("max_n0", P.t_max_n0())
    row("max_n1", P.t_max_n1())
    row("mul_n", P.t_mul_n())
    row("where_n", P.t_where_n())
    row("add_n", P.t_add_n())
    row("stage_n", P.t_stage_n())
    row("rebind_n", P.t_rebind_n())
    row("rej29", P.t_rej29())
    c : Unit <- row("rebind_solid", P.t_rebind_solid())
    d : Unit <- row("rebind_len", P.t_rebind_len())
    e : Unit <- row("rebind_0_hole", P.t_rebind_0_hole())
    f : Unit <- row("rebind_1_ctx", P.t_rebind_1_ctx())
    g : Unit <- row("rebind_off", P.t_rebind_off())
    h : Unit <- row("claim29", P.t_claim29())
    i : Unit <- row("claim29_off", P.t_claim29_off())
    j : Unit <- row("recip_len", P.t_recip_len())
    k : Unit <- row("sin_len", P.t_sin_len())
    l : Unit <- row("log2_len", P.t_log2_len())
    m : Unit <- row("exp2_len", P.t_exp2_len())
    n : Unit <- row("sqrt_len", P.t_sqrt_len())
    o : Unit <- row("trunc_len", P.t_trunc_len())
    p : Unit <- row("cmplt_len", P.t_cmplt_len())
    q : Unit <- row("cmplt_solid", P.t_cmplt_solid())
    r : Unit <- row("add_len", P.t_add_len())
    s : Unit <- row("add_solid", P.t_add_solid())
    t : Unit <- row("add_same", P.t_add_same())
    u : Unit <- row("pow_len", P.t_pow_len())
    v : Unit <- row("pow_solid", P.t_pow_solid())
    w : Unit <- row("max_len", P.t_max_len())
    x : Unit <- row("max_solid", P.t_max_solid())
    y : Unit <- row("mul_len", P.t_mul_len())
    z : Unit <- row("mul_same", P.t_mul_same())
    row("where_len", P.t_where_len())
    row("where_0_hole", P.t_where_0_hole())
    row("stage_len", P.t_stage_len())
    row("stage_ctx", P.t_stage_ctx())
    row("expand_len", P.t_expand_len())
    row("reshape_len", P.t_reshape_len())
    row("sink_len", P.t_sink_len())
    row("sink_srcs", P.t_sink_srcs())
    row("first_wins", P.t_first_wins())
    row("keep_pair", P.t_keep_pair())
    row("keep_skip", P.t_keep_skip())
    row("max_eq_op", P.t_max_eq_op())
    row("max_outer", P.t_max_outer())
    row("rej_len", P.t_rej_len())
    row("rej_gate", P.t_rej_gate())
    row("rej_len27", P.t_rej_len27())
    row("store_len", P.t_store_len())
    row("store_0_hole", P.t_store_0_hole())
    row("store_1_ctx", P.t_store_1_ctx())
    row("t0_is_cast", P.t_t0_is_cast())
    row("cast_len", P.t_cast_len())
    row("cast_solid", P.t_cast_solid())
    row("bitcast_len", P.t_bitcast_len())
    row("bitcast_solid", P.t_bitcast_solid())
    srow("walk_row", P.dag_row())
    srow("walk_sig", P.dag_walk_sig())
    srow("walk_inpath", P.dag_inpath())
    srow("walk_keys", P.dag_keys())
    srow("walk_grad_a", P.dag_grad_a(P.walk_dag()))
    srow("walk_grad_b", P.dag_grad_b(P.walk_dag()))
    srow("walk_grad_c", P.dag_grad_c(P.walk_dag()))
    srow("walk_grad_p", P.dag_grad_p(P.walk_dag()))
    srow("walk_grad_q", P.dag_grad_q(P.walk_dag()))
    srow("walk_grad_r", P.dag_grad_r(P.walk_dag()))
    row("walk_n_toposort", P.dag_n_topo())
    row("walk_walk_n", P.dag_walk_n())
    row("walk_n_inpath", P.dag_n_inpath())
    row("walk_grads_n", P.dag_grads_n())
    row("walk_skip_n", P.dag_skip_n())
    row("walk_hole_n", P.dag_hole_n())
    srow("gs_walk", P.gs_walk())
    row("gs_walk_n", P.gs_walk_n())
    srow("gs_inpath", P.gs_inpath())
    row("gs_n_inpath", P.gs_n_inpath())
    row("gs_grads_n", P.gs_grads_n())
    srow("gs_keys", P.gs_keys())
    row("gs_skip_n", P.gs_skip_n())
    row("gs_hole_n", P.gs_hole_n())
    row("gs_set_n", P.gs_set_n())
    row("gs_zero_n", P.gs_zero_n())
    srow("gs_set_sig", P.gs_set_sig())
    row("bw_nodes", P.bw_nodes())
    srow("bw_sig", P.bw_sig())
    row("bw_distinct", P.bw_distinct())
    srow("pm_walk", P.pm_walk())
    row("pm_walk_n", P.pm_walk_n())
    # THE TUPLE LENGTH, NOT THE NODE COUNT: upstream's rule answers
    # `(node, hole)` and the tuple is always two long for a rule that fires.
    # `P.pm_rule_len` is the ANSWER's node count -- a different quantity under the
    # same name, and the two rows disagreed about the NAME (1 against 2).
    row("pm_rule_tup_len", P.pm_rule_tup_len())
    row("pm_rule_n_grads", P.pm_rule_n_grads())
    row("pm_rule_n_nodes", P.pm_rule_n_nodes())
    srow("pm_order", P.pm_order())
    row("pm_rule_is_ctx", P.pm_rule_is_ctx())
