    srow("pm1_rule_arg", P.pm1_rule_arg())
    row("pm1_grads_n", P.pm1_grads_n())
    srow("pm1_keys", P.pm1_keys())
    row("pm1_set_n", P.pm1_set_n())
    row("pm1_zero_n", P.pm1_zero_n())
    srow("pm1_set_sig", P.pm1_set_sig())
    row("pm1_bw_nodes", P.pm1_bw_nodes())
    srow("pm1_bw_sig", P.pm1_bw_sig())
    row("pm1_bw_distinct", P.pm1_bw_distinct())
    srow("pm_argsort_0_2_1", P.pm_argsort_0_2_1())
    srow("pm_argsort_1_2_0", P.pm_argsort_1_2_0())
    srow("pm_argsort_2_1_0", P.pm_argsort_2_1_0())
    srow("pm_argsort_1_0_2", P.pm_argsort_1_0_2())
    srow("pm_argsort_2_0_1", P.pm_argsort_2_0_1())
    srow("pm_argsort_1_0", P.pm_argsort_1_0())
