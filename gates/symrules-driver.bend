def fx.run4(name: String, +ar: O.Arena, +r: U32) -> String:
  String.concat([name, "=", fx.ans(SY.sym_f(F.folded(ar), r))])

def fx.run3(name: String, +ar: O.Arena, root: Maybe<&2, U32>) -> String:
  match root:
    case Some{r}: fx.run4(name, ar, r)
    case None{}: String.concat([name, "= parse-error"])

def fx.run2(name: String, e: String, st: SY.St) -> String:
  match st:
    case SY.St{ar, stk, root}: fx.run3(name, ar, root)

