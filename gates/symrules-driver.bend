# THE PORT SIDE OF `gates/symrules-oracle.py` -- **THE BODY-VERIFICATION INSTRUMENT**, AND IT
# WAS ABSENT.
#
# THE ORACLE BUILDS THE SAME GRAPHS IN CPYTHON AND DIFFS THE ANSWERS -- IT IS THE
# BODY-VERIFICATION INSTRUMENT -- AND IT NEEDS A DRIVER THAT READS
# `gates/symrules-cases.rows` AND PRINTS ONE ANSWER PER CASE. **NO SUCH DRIVER WAS IN THE
# TREE** (MEASURED 2026-11-06: NO `.bend` FILE NAMED `symrules-cases` AND NO `.py` PRODUCED A
# `symf=` COLUMN), SO THE ORACLE COULD NOT COMPARE ANYTHING AND THE CENSUS's 134 GREEN ROWS
# WERE GREEN ON **CITATION AND OP SET ALONE**.
#
# THE ORACLE MATCHES THE ROWS BY POSITION, SO THE DRIVER PRINTS EXACTLY THE CASES IN THE
# FILE'S ORDER AND NO MORE.
#
# THE PORT's `sym_f` IS USED AND NOT `sym`: `sym` ANSWERS AN INDEX INTO THE ARENA IT GREW, AND
# `rewrite` THROWS THAT ARENA AWAY, SO A RULE THAT MINTS LEAVES THE INDEX PAST THE END.

# THE CASES FILE, AND **IT IS OVERRIDABLE BY `IO.args()` SO THAT ONE DRIVER SERVES BOTH THE
# PINNED CASES AND A SWEEP.** MEASURED 2026-11-08: `IO.args()` WORKS WITH `bin/bend`
# (`./bin/bend gates/symrules-driver.bend /tmp/other.rows`), **AND `IO.args()`'s INDEX 0 IS THE
# PROGRAM, NOT THE FIRST ARGUMENT** -- `tinybendygrad/runtime/ops_bend.bend` READS ITS LANE
# FROM INDEX **1** FOR THE SAME REASON, SO IT IS THE TREE's CONVENTION AND NOT A NEW ONE.
#
# **AND THE OVERRIDE IS WHAT MAKES THE DELETED-RULES SWEEP POSSIBLE WITHOUT A SECOND COPY OF
# THE DRIVER**: THE 2,397-LINE DRIVER IS THE TRUTH ABOUT HOW THE PORT REWRITES, AND A COPY OF
# IT WOULD BE A SECOND TRUTH THAT COULD DRIFT.
def CASES_DEFAULT() -> String: "gates/symrules-cases.rows"

def CASES_OF(as: List<&1, String>) -> String:
  Maybe.default(&1, String, List.get(&1, String, as, 1n), CASES_DEFAULT())

def CASES() -> String: CASES_DEFAULT()

def SEP() -> Char: '|'

# ---- THE HEAD OF A NODE --------------------------------------------------------------

def fx.cval.of(a: O.Arg) -> O.Const:
  match a:
    case O.APy{v}: v
    case _: O.CInvalid{}

def fx.pname(m: Maybe<&2, String>) -> String:
  match m:
    case Some{n}: n
    case None{}: "?"

def fx.pname.of(a: O.Arg) -> String:
  match a:
    case O.AParam{pa}: fx.pname(O.ParamArg.name(pa))
    case _: "?"

# THE HEAD, AND A REDUCE'S ARG CARRIES THE ROP AND THE AXIS COUNT, SO THE HEAD IS
# `reduce:<rop>`.
#
# MEASURED 2026-11-06: WITHOUT THIS THE DRIVER PRINTED `reduce` AND THE ORACLE PRINTED
# `reduce:add`, AND THE COMPARISON SAID THE TWO DIFFERED -- **THE PORT'S REDUCE IS NOT
# `reduce` AND NOT `reduce:add` EITHER: IT IS `reduce` WITH THE ROP IN ITS ARG.** THE PORT's
# OWN `fz_arg.rop` (`tinybendygrad/uop/symbolic.bend`'s `:8264`) BUILDS THE SAME `AReduce`.
# THE HEAD, AND A **LEAF** IS MARKED WITH AN `L` PREFIX SO THE ORACLE KNOWS IT PRINTS BARE.
#
# MEASURED 2026-11-06: THE ORACLE's `sh` GIVES A CONST AND A PARAM THEIR BARE HEAD AND GIVES
# EVERYTHING ELSE THE PARENTHESIZED FORM, AND **THE HEAD ALONE DOES NOT SAY WHICH** -- A
# SRC-LESS `NOOP` IS NOT A LEAF AND A `c1` IS. SO THE MARKER IS EXPLICIT.
def fx.head.of(a: O.Arg, op: O.Op) -> String:
  match a:
    case O.ADt{dt}: String.concat([O.Ops.name.of(op), ":", SY.fz_dtnm(dt)])
    case O.AParam{pa}: fx.pname.of(a)
    case O.AReduce{rop, num_axes}: String.concat(["reduce:", String.to_lower(O.Ops.name.of(rop))])
    case _: O.Ops.name.of(op)

# THE LEAF MARKER IS `~` AND NOT `L`, AND **THE `L` WAS AMBIGUOUS**: THE PORT's OP NAMES ARE
# UPPERCASE AND `LOG2` STARTS WITH `L`, SO A `L` MARKER READS `LOG2` AS A LEAF AND RENDERS IT
# `og2`. MEASURED 2026-11-07: THAT WAS THE `x451*` DIVERGENCE, AND IT WAS A BUG IN THE MARKER
# AND NOT IN THE PORT. **`~` STARTS NO OP NAME.**
def fx.head.par(par: Bool, a: O.Arg, op: O.Op) -> String:
  match par:
    case True{}: String.concat(["~", fx.pname.of(a)])
    case False{}: fx.head.of(a, op)

def fx.head.at(cst: Bool, par: Bool, a: O.Arg, op: O.Op) -> String:
  match cst:
    case True{}: String.concat(["~", SY.fz_render.cval(fx.cval.of(a))])
    case False{}: fx.head.par(par, a, op)

