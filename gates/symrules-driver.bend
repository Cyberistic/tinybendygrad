# THE ONE THE GRAPH WAS HANDED.

# ---- THE ANSWER, AND IT IS THE `Found` FAMILY ----------------------------------------
#
# A `Found` CARRIES ITS OWN ARENA, SO THE ANSWER IS RENDERED IN THE ARENA IT GREW AND NOT IN
# THE ONE THE GRAPH WAS HANDED.
def fx.ans3(+i: U32, +ar: O.Arena) -> String:
  fx.rows.go(GC.FUEL(), GC.pre(i, ar), ar, 0n, "")

def fx.ans2(+f: O.Found) -> String:
  fx.ans3(O.Found.i(f), O.Found.ar(f))

def fx.ans(m: Maybe<&1, O.Found>) -> String:
  match m:
    case Some{f}: fx.ans2(f)
    case None{}: "norewrite"

