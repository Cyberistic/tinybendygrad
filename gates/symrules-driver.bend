# THE FOLD OVER THE LINES.
def fx.rows(+ls: List<&2, String>, acc: String) -> String:
  match ls:
    case Nil{}: acc
    case l <> r: fx.rows(r, fx.rows2(fx.skip(l), l, acc))

def fx.read.closed(m: File & Result<&1, &1, U32 & String, String>) -> IO(String):
  (f, r) = m
  do IO<String>:
    s : String <- IO.pass(String, r)
    u : Unit <- File.close(f)
    IO.pure(String, s)

def main() -> IO(Unit):
  do IO<Unit>:
    as : List<String> <- IO.args()
    path : String <- IO.pure(String, CASES_OF(as))
    f : File <- IO.try(File, File.open(path, "r"))
    m : File & Result<&1, &1, U32 & String, String> <- File.read(f, 4000000)
    s : String <- fx.read.closed(m)
    IO.print(fx.rows(String.lines(s), ""))
    return Unit{}
