# POSITION FUNCTION IS THE DRIVER's OWN, FOR THE REASON ABOVE.
def fx.rows.go(fuel: Nat, +ns: List<&2, U32>, +ar: O.Arena, +k: Nat, acc: String) -> String:
  match fuel:
    case 0n: acc
    case 1n+p: match ns:
      case Nil{}: acc
      case u <> r:
        +k2 = k
        fx.rows.go(p, r, ar, Nat.add(k2, 1n),
                   String.concat([acc, U32.show(u), ":",
                                  fx.head.at(O.eq_op(O.Arena.op(ar, u), O.OpsCONST{}),
                                             O.eq_op(O.Arena.op(ar, u), O.OpsPARAM{}),
                                             O.Arena.arg(ar, u), O.Arena.op(ar, u)), ":",
                                  fx.srcs.tx(u, ar, ns), ";"]))

