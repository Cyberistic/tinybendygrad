# THE SAME RULES, SO THE TWO LANES SEE THE SAME CASES IN THE SAME ORDER.
def fx.skip(+ln: String) -> Bool:
  Bool.or(String.eq(String.trim(ln), ""), String.starts_with(String.trim(ln), "#"))

def fx.fields.at(ln: String, c: Char) -> List<&2, String>: String.split(ln, c)

def fx.fields(+ln: String) -> List<&2, String>: fx.fields.at(ln, SEP())

