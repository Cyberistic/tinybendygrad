def fx.case.name(+ln: String) -> Maybe<&2, String>:
  List.get(&2, String, fx.fields(ln), 0n)

def fx.case.expr(+ln: String) -> Maybe<&2, String>:
  List.get(&2, String, fx.fields(ln), 1n)

