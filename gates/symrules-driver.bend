def fx.ss.put(x: String, r: List<&2, String>) -> List<&2, String>:
  List.append(&2, String, [x], r)

# THE POSITIONS ARE FOUND IN **ONE FOLD OVER THE WALK** AND NOT BY A LOOKUP PER SRC.
#
# MEASURED 2026-11-06: THE LOOKUP PER SRC CONSUMES THE LIST (THE `+ns` IS LINEAR), SO THE
# SECOND SRC's POSITION IS WRONG -- THE LISTING READ `0:WHERE:1,4,5;1:CMPEQ:1,2;...` WHERE
# `CMPEQ`'s SRCS ARE AT POSITIONS 2 AND 3. **ONE FOLD CARRIES THE POSITIONS AND NEVER LOOKS
# ONE UP.**

# THE POSITIONS ARE FOUND IN **ONE FOLD OVER THE WALK** AND NOT BY A LOOKUP PER SRC.
#
# MEASURED 2026-11-06: THE LOOKUP PER SRC CONSUMES THE LIST (THE `+ns` IS LINEAR), SO THE
# SECOND SRC's POSITION IS WRONG -- THE LISTING READ `0:WHERE:1,4,5;1:CMPEQ:1,2;...` WHERE
# `CMPEQ`'s SRCS ARE AT POSITIONS 2 AND 3. **ONE FOLD CARRIES THE POSITIONS AND NEVER LOOKS
# ONE UP.**
# THE WALK LIST IS **BORROWED** AND NOT BOUND: IT IS READ TWICE (ONCE FOR THE LOOKUP AND ONCE
# FOR THE RECURSION), AND **A `+` BINDING CONSUMES IT**, SO THE SECOND LOOKUP SAW A CONSUMED
# LIST AND ANSWERED THE WRONG POSITION.
#
# MEASURED 2026-11-06: THE LISTING READ `0:WHERE:1,4,5;1:CMPEQ:1,2;...` -- WHERE's SRCS WERE
# RIGHT AND `CMPEQ`'s WERE NOT, AND THE DIFFERENCE WAS EXACTLY WHICH LOOKUP CAME FIRST.
# THE SRC ARENA INDICES AND NOT THE POSITIONS.
#
# MEASURED 2026-11-06: THE CENSUS LANE's `idx` -- WHICH IS THE ONLY POSITION FUNCTION IN THE
# TREE -- GIVES THE POSITION **ONE BEHIND** ON A WALK LIST, AND THE LISTING READ
# `1:XOR:1,2;2:x:;3:c5:;` WHERE THAT NODE's SRCS ARE AT POSITIONS 2 AND 3. **THE CENSUS LANE
# COMPARES TWO LISTINGS WITH THE SAME `idx` SO THE TWO ERRORS CANCEL AND IT IS INVISIBLE
# THERE.** THE ORACLE COMPARES THE PORT's LISTING AGAINST A CPYTHON TREE, SO IT CANNOT USE A
# POSITION.
#
# **SO THE DRIVER PRINTS THE SRC ARENA INDICES** -- WHICH ARE UNAMBIGUOUS -- AND THE ORACLE
# BUILDS THE TREE FROM THEM. THE ROW NUMBERS ARE THEN THE ARENA INDICES AND NOT POSITIONS, AND
# THE ORACLE READS A ROW BY ITS INDEX.
def fx.ss.go(+ar: O.Arena, u: U32, +ns: List<&2, U32>, t: List<&2, U32>) -> List<&2, String>:
  match t:
    case Nil{}: Nil{}
    case s <> r:
      fx.ss.put(U32.show(s), fx.ss.go(ar, u, ns, r))

# THE POSITION OF EVERY NODE, IN THE ORDER THE ROWS ARE NUMBERED.

def fx.ss.of(u: U32, +ar: O.Arena, ns: List<&2, U32>, t: List<&2, U32>) -> List<&2, String>:
  +n2 = ns
  fx.ss.go(ar, u, n2, t)

def fx.srcs.tx(+u: U32, +ar: O.Arena, ns: List<&2, U32>) -> String:
  +n2 = ns
  String.join(fx.ss.of(u, ar, n2, O.Arena.srcs(ar, u)), ",")

