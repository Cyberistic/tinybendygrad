# THE TWO HALVES ARE ASKED FOR AND PASSED ON, BECAUSE A `match` MAY NOT SCRUTINISE A COMPUTED
# VALUE.
def fx.rows4(nm: Maybe<&2, String>, ex: Maybe<&2, String>, acc: String) -> String:
  match nm:
    case Some{n}: match ex:
      case Some{e}: String.concat([acc, fx.run(n, e), "\n"])
      case None{}: acc
    case None{}: acc

def fx.rows3(+ln: String, acc: String) -> String:
  fx.rows4(fx.case.name(ln), fx.case.expr(ln), acc)

def fx.rows2(skip: Bool, +ln: String, acc: String) -> String:
  match skip:
    case True{}: acc
    case False{}: fx.rows3(ln, acc)

