# ===========================================================================
# THE ROWS.
# ===========================================================================
def g_glob() -> IO(Unit):
  do IO<Unit>:
    # --- THE FIELD-ORDER STRINGS. These are the gABI `register_fields` name
    # lists, and a transposition shows HERE first.
    row("elf_F_EHDR", F_EHDR())
    row("elf_F_SHDR", F_SHDR())
    row("elf_F_SYM64", F_SYM64())
    row("elf_F_SYM32", F_SYM32())
    row("elf_F_RELA", F_RELA())
    row("elf_F_REL", F_REL())
    # --- THE CONSTANTS, measured off autogen/libc.py.
    urow("elf_c_ELFMAG", ELFMAG())
    urow("elf_c_EI_CLASS", EI_CLASS())
    urow("elf_c_ELFCLASS32", ELFCLASS32())
    urow("elf_c_ELFCLASS64", ELFCLASS64())
    urow("elf_c_SHT_NULL", SHT_NULL())
    urow("elf_c_SHT_PROGBITS", SHT_PROGBITS())
    urow("elf_c_SHT_SYMTAB", SHT_SYMTAB())
    urow("elf_c_SHT_STRTAB", SHT_STRTAB())
    urow("elf_c_SHT_RELA", SHT_RELA())
    urow("elf_c_SHT_NOBITS", SHT_NOBITS())
    urow("elf_c_SHT_REL", SHT_REL())
    urow("elf_c_SHF_WRITE", SHF_WRITE())
    urow("elf_c_SHF_ALLOC", SHF_ALLOC())
    urow("elf_c_SHF_EXECINSTR", SHF_EXECINSTR())
    # --- THE BYTE LAYER, against CPython's struct.unpack.
    row("elf_blk_hexlen", U32.show(Blob.hexlen(B_E64_O())))
    row("elf_blk_bytes", U32.show(Blob.nbytes(B_E64_O())))
    row("elf_blk_magic_hex", Hex.of(Blob.le32(B_E64_O(), 0)))
    urow("elf_blk_u8_0", Blob.u8(B_E64_O(), 0))
    urow("elf_blk_u8_1", Blob.u8(B_E64_O(), 1))
    urow("elf_blk_u8_3", Blob.u8(B_E64_O(), 3))
    urow("elf_blk_u8_4", Blob.u8(B_E64_O(), 4))
    urow("elf_blk_le16_16", Blob.le16(B_E64_O(), 16))
    urow("elf_blk_le16_18", Blob.le16(B_E64_O(), 18))
    urow("elf_blk_le32_20", Blob.le32(B_E64_O(), 20))
    urow("elf_blk_le32_40", Blob.le32(B_E64_O(), 40))
    urow("elf_blk_le32_44", Blob.le32(B_E64_O(), 44))
    urow("elf_blk_le32_56", Blob.le32(B_E64_O(), 56))
    urow("elf_blk_le32_60", Blob.le32(B_E64_O(), 60))
    row("elf_blk_slice_0_4", Blob.slice(B_E64_O(), 0, 4))
    row("elf_blk_slice_4_4", Blob.slice(B_E64_O(), 4, 4))
    row("elf_blk_slice_896_16", Blob.slice(B_E64_O(), 896, 16))
    # --- THE HEX PARSER. All THREE offsets, and the uppercase arm is 55 not 87 --
    # the mistake a single-constant spelling makes, which SATURATES U32.
    urow("elf_hexval_0", Hex.val(Char.from_u32(48)))
    urow("elf_hexval_9", Hex.val(Char.from_u32(57)))
    urow("elf_hexval_a", Hex.val(Char.from_u32(97)))
    urow("elf_hexval_f", Hex.val(Char.from_u32(102)))
    urow("elf_hexval_A", Hex.val(Char.from_u32(65)))
    urow("elf_hexval_F", Hex.val(Char.from_u32(70)))
    urow("elf_hexval_z", Hex.val(Char.from_u32(122)))
    # --- THE HEX FORMATTER, all sixteen nibbles, plus the endianness pair.
    row("elf_hexdig", Hex.digit(0n) ++ Hex.digit(1n) ++ Hex.digit(2n) ++ Hex.digit(3n) ++ Hex.digit(4n) ++ Hex.digit(5n) ++ Hex.digit(6n) ++ Hex.digit(7n) ++ Hex.digit(8n) ++ Hex.digit(9n) ++ Hex.digit(10n) ++ Hex.digit(11n) ++ Hex.digit(12n) ++ Hex.digit(13n) ++ Hex.digit(14n) ++ Hex.digit(15n))
    row("elf_hexof_deadbeef", Hex.of(3735928559))
    row("elf_hexof_0", Hex.of(0))
    row("elf_hexof_ffffffff", Hex.of(4294967295))
    row("elf_hexpair_1234", Hex.pair(4660))
    row("elf_hexu8_ff", Hex.u8(255))
    row("elf_hexu8_00", Hex.u8(0))
    # --- THE MAGIC AND THE CLASS, on EVERY fixture including the two that refuse.
    brow("elf_magic_e64", magic_ok(B_E64_O()))
    brow("elf_magic_ea64", magic_ok(B_EA64_O()))
    brow("elf_magic_e32", magic_ok(B_E32_O()))
    brow("elf_magic_n64", magic_ok(B_N64_O()))
    brow("elf_magic_na64", magic_ok(B_NA64_O()))
    brow("elf_magic_n32", magic_ok(B_N32_O()))
    brow("elf_magic_ja64", magic_ok(B_JA64_O()))
    brow("elf_magic_r64so", magic_ok(B_R64_SO()))
    brow("elf_magic_rx64exe", magic_ok(B_RX64_EXE()))
    urow("elf_ei_class_e64", Blob.u8(B_E64_O(), EI_CLASS()))
    urow("elf_ei_class_ea64", Blob.u8(B_EA64_O(), EI_CLASS()))
    urow("elf_ei_class_e32", Blob.u8(B_E32_O(), EI_CLASS()))
    urow("elf_ei_class_n64", Blob.u8(B_N64_O(), EI_CLASS()))
    urow("elf_ei_class_na64", Blob.u8(B_NA64_O(), EI_CLASS()))
    urow("elf_ei_class_n32", Blob.u8(B_N32_O(), EI_CLASS()))
    urow("elf_ei_class_ja64", Blob.u8(B_JA64_O(), EI_CLASS()))
    urow("elf_ei_class_r64so", Blob.u8(B_R64_SO(), EI_CLASS()))
    urow("elf_ei_class_rx64exe", Blob.u8(B_RX64_EXE(), EI_CLASS()))
    row("elf_ecls_e64", ecls.name(is64(B_E64_O())))
    row("elf_ecls_ea64", ecls.name(is64(B_EA64_O())))
    row("elf_ecls_e32", ecls.name(is64(B_E32_O())))
    row("elf_ecls_n64", ecls.name(is64(B_N64_O())))
    row("elf_ecls_na64", ecls.name(is64(B_NA64_O())))
    row("elf_ecls_n32", ecls.name(is64(B_N32_O())))
    row("elf_ecls_ja64", ecls.name(is64(B_JA64_O())))
    row("elf_ecls_r64so", ecls.name(is64(B_R64_SO())))
    row("elf_ecls_rx64exe", ecls.name(is64(B_RX64_EXE())))
    brow("elf_is64_e64", is64(B_E64_O()))
    brow("elf_is64_ea64", is64(B_EA64_O()))
    brow("elf_is64_e32", is64(B_E32_O()))
    brow("elf_is64_n64", is64(B_N64_O()))
    brow("elf_is64_na64", is64(B_NA64_O()))
    brow("elf_is64_n32", is64(B_N32_O()))
    brow("elf_is64_ja64", is64(B_JA64_O()))
    brow("elf_is64_r64so", is64(B_R64_SO()))
    brow("elf_is64_rx64exe", is64(B_RX64_EXE()))
    # --- THE STRUCT SIZES, both classes. The AMD packer needs the Elf64 one
    # (renderer/amd/elf.py:50) so it is gated in BOTH files.
    urow("elf_ehdr_size64", Ehdr.size(True{}))
    urow("elf_ehdr_size32", Ehdr.size(False{}))
    urow("elf_shdr_size64", Shdr.size(True{}))
    urow("elf_shdr_size32", Shdr.size(False{}))
    urow("elf_sym_size64", Sym.size(True{}))
    urow("elf_sym_size32", Sym.size(False{}))
    urow("elf_eident_size", Ehdr.e_ident_size())

def Sec.ehdr(+t: String, +h: String) -> IO(Unit):
  do IO<Unit>:
    row(String.concat([t, "_hdr"]), Ehdr.text(Ehdr.at(h, is64(h))))
    row(String.concat([t, "_ehsize"]), U32.show(Ehdr.size(is64(h))))
    row(String.concat([t, "_shoff"]), W64.text(Ehdr.e_shoff(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_phoff"]), W64.text(Ehdr.e_phoff(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_entry"]), W64.text(Ehdr.e_entry(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_shnum"]), U32.show(Ehdr.e_shnum(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_shstrndx"]), U32.show(Ehdr.e_shstrndx(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_shentsize_declared"]), U32.show(Ehdr.e_shentsize(Ehdr.at(h, is64(h)))))
    row(String.concat([t, "_shdr_stride"]), U32.show(Shdr.size(is64(h))))
    row(String.concat([t, "_shdr_nfields"]), U32.show(Shdr.nfields(is64(h))))
    row(String.concat([t, "_magic"]), Hex.of(Blob.le32(h, 0)))
    row(String.concat([t, "_bytes"]), U32.show(Blob.nbytes(h)))
    row(String.concat([t, "_is64"]), Bool.show(is64(h)))

def Sec.all(+t: String, +h: String) -> IO(Unit):
  do IO<Unit>:
    row(String.concat([t, "_nsec"]), U32.show(Sections.len(Sections.of(h, Ehdr.at(h, is64(h)), is64(h)))))
    row(String.concat([t, "_names"]), Sec.names(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_hdrtxt"]), Sec.hd_text(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_name"]), Sec.col.name(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_type"]), Sec.col.typ(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_flags"]), Sec.col.flags(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_link"]), Sec.col.link(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_info"]), Sec.col.info(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_addr"]), Sec.col.addr(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_offset"]), Sec.col.off(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_size"]), Sec.col.size(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_sh_entsize"]), Sec.col.ent(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_content_lens"]), Sec.lens(Sections.build(h, Ehdr.at(h, is64(h)), is64(h))))
    row(String.concat([t, "_content0"]), Sec.content_hex(Sections.at_sec(Sections.build(h, Ehdr.at(h, is64(h)), is64(h)), 0)))
    row(String.concat([t, "_content1"]), Sec.content_hex(Sections.at_sec(Sections.build(h, Ehdr.at(h, is64(h)), is64(h)), 1)))
    row(String.concat([t, "_shstrtab_bytes"]), U32.show(Blob.nbytes(shstrtab(h, Ehdr.at(h, is64(h)), is64(h)))))

def g_sec() -> IO(Unit):
  do IO<Unit>:
    Sec.ehdr("elf_hdr_e64", B_E64_O())
    Sec.ehdr("elf_hdr_ea64", B_EA64_O())
    Sec.ehdr("elf_hdr_e32", B_E32_O())
    Sec.ehdr("elf_hdr_n64", B_N64_O())
    Sec.ehdr("elf_hdr_na64", B_NA64_O())
    Sec.ehdr("elf_hdr_n32", B_N32_O())
    Sec.ehdr("elf_hdr_ja64", B_JA64_O())
    Sec.ehdr("elf_hdr_r64so", B_R64_SO())
    Sec.ehdr("elf_hdr_rx64exe", B_RX64_EXE())
    Sec.all("elf_sec_e64", B_E64_O())
    Sec.all("elf_sec_ea64", B_EA64_O())
    Sec.all("elf_sec_e32", B_E32_O())
    Sec.all("elf_sec_n64", B_N64_O())
    Sec.all("elf_sec_na64", B_NA64_O())
    Sec.all("elf_sec_n32", B_N32_O())
    Sec.all("elf_sec_ja64", B_JA64_O())

def Str.walk(+t: String, +h: String) -> IO(Unit):
  do IO<Unit>:
    row(String.concat([t, "_shstrtab_bytes"]), U32.show(Blob.nbytes(shstrtab(h, Ehdr.at(h, is64(h)), is64(h)))))
    row(String.concat([t, "_shstrtab_head"]), String.take(shstrtab(h, Ehdr.at(h, is64(h)), is64(h)), 32n))
    row(String.concat([t, "_names"]), Str.names(Sections.of(h, Ehdr.at(h, is64(h)), is64(h)), shstrtab(h, Ehdr.at(h, is64(h)), is64(h))))

def g_str() -> IO(Unit):
  do IO<Unit>:
    Str.walk("elf_str_e64", B_E64_O())
    Str.walk("elf_str_ea64", B_EA64_O())
    Str.walk("elf_str_e32", B_E32_O())
    Str.walk("elf_str_n64", B_N64_O())
    Str.walk("elf_str_na64", B_NA64_O())
    Str.walk("elf_str_n32", B_N32_O())
    Str.walk("elf_str_ja64", B_JA64_O())
    Str.walk("elf_str_r64so", B_R64_SO())
    Str.walk("elf_str_rx64exe", B_RX64_EXE())

def main() -> IO(Unit):
  do IO<Unit>:
    a : Unit <- g_glob()
    b : Unit <- g_sec()
    c : Unit <- g_str()
    IO.print("elf-done=1")
