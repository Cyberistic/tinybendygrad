# tinybendygrad/runtime/support/elf.bend -- port of tinygrad/runtime/support/elf.py
#
# GENERATED by `.agents/slop/elfbuild.py`. Do not edit here: edit
# `.agents/slop/elf_prologue.bend` and rebuild, or the fixture bytes and the hand
# half can drift apart.
#
# ===========================================================================
# WHY THIS FILE IS ON THE CRITICAL PATH, AND WHAT IS BROKEN UNDER IT.
#
# `runtime/ops_cpu.py:19/21` builds `link_libs=[self.libm, self.rt_lib]` and
# `libobjc` is MISSING from that list. MEASURED against the real dylibs on this
# machine with tinygrad's OWN `link_sym`:
#
#   /usr/lib/libSystem.dylib  -> 0 hits for `sel_registerName`
#   /usr/lib/libobjc.dylib    -> 1 hit
#
# so any kernel whose object file references an objc symbol dies at `elf.py:13`
# with `RuntimeError: Attempting to relocate against an undefined symbol
# sel_registerName`. That is the error currently killing a real path and it is
# raised by `link_sym`, which is IN this file. The rows `elf_ls_*` pin the
# measurement so the fix -- ONE LINE in ops_cpu.py, OWNED BY ANOTHER UNIT,
# reported not fixed -- is checkable the moment it lands.
# `.agents/slop/elf/REPORT.md` has the full report.
#
# ===========================================================================
# THIS IS A BYTE-PACKING DOMAIN, WHICH IS THE GOOD CASE.
#
# There is no Python behaviour to interpret: the authority is the ELF
# specification and the actual bytes of real object files. So the gate is REAL
# ELF FILES compiled by clang and ld.lld and read by tinygrad's own `elf_loader`,
# with every fixture byte-NON-UNIFORM on purpose: 11-15 sections, a zero-byte
# SHT_NULL at index 0, a 77-byte `.comment` at sh_addr 0, a 2544-3624 byte
# `.relro_padding` SHT_NOBITS whose sh_size is huge and whose content is empty,
# both word sizes, both SHT_REL and SHT_RELA, PROGBITS at sh_addr 0 and away from
# it. An off-by-one in the section walk, a wrong stride, or a transposed field
# lands on a DIFFERENT number per fixture instead of agreeing by accident.
#
# ===========================================================================
# FIELD ORDER IS GATED AS A STRING, NEVER AS A COUNT.
#
# `struct_libusb_transfer` shipped with transposed fields and a count-based gate
# passed it, because a count cannot see a transposition. So `F_EHDR`, `F_SHDR`,
# `F_SYM64`, `F_SYM32`, `F_RELA`, `F_REL` are the FIELD-NAME STRINGS out of
# `autogen/libc.py`'s `register_fields`, and every per-section row spells
# `name@byteoffset:value` for all ten Shdr fields and all six Sym fields. TWO REAL
# PORT BUGS WERE CAUGHT BY EXACTLY THAT STRING AND BY NOTHING ELSE -- see the
# `Shdr.o_*` / `W64.at` notes, where a 64-bit word's high half was read four bytes
# past the field and `sh_link` was filled with the OFFSET instead of the VALUE.
# A count saw neither.
#
# THE `type ... is Data:` FIELD LIST IS DOCUMENTATION in bend 2.0.34 and the
# `case` BINDINGS are load-bearing. Both are written out, so the declaration and
# the reader cannot drift: `Shdr{sh_name, sh_type, ...}` is the documentation,
# `case Shdr{sh_name, sh_type, ...}:` in every reader is what a mutation moves
# rows through.
#
# EVERY FIELD IS TYPED. Measured: an untyped `type X is Data: X{nm, hdr, cont}`
# declares all three as `Quant` and then
#   Error: - expected : Quant / - observed : String
#
# ===========================================================================
# THE TWO UPSTREAM DEFECTS. `tinygrad/` is READ-ONLY to this unit; both are
# REPRODUCED against real files (`.agents/slop/elf/REPORT.md`) and the PORT
# MATCHES THE CODE AS WRITTEN, because a 1:1 port that silently fixed them
# would diverge from the SUT on every linked image.
#
# 1. `elf.py:47` resolves `sym.st_name` against `sh_strtab`, the SECTION HEADER
#    string table, instead of the table named by the SYMTAB's `sh_link`. The two
#    coincide in a clang relocatable object and diverge in a LINKED image:
#    measured on rx64.exe, 8 of 15 symbols misresolve and BOTH undefined ones
#    become garbage (`ext_fn` -> `h_frame`, `ext_data` -> ''). That is why
#    rx64.exe is a refusing fixture rather than a parsing one.
# 2. `elf.py:44`'s `next(tsh for tsh in sections if tsh.name == trgt_sh_name)`
#    raises a bare `StopIteration` for `.rela.dyn` -> `.dyn`, which no real
#    linker emits as a section. `r64.so` is that case, and the row
#    `elf_refuse_r64so_trgt_dyn` names the target the derivation produces.
#
# ===========================================================================
# THE WALLS.
#
#   1. 64-BIT VALUES. bend 2.0.34 has no 64-bit integer. `r_offset`, `st_value`,
#      `sh_addr`, `sh_offset`, `sh_size`, `sh_addralign`, `sh_entsize`, the
#      `Elf64_Rela.r_addend` and the trampoline target are all 64-bit in Elf64.
#      `W64{lo, hi}` carries them as two halves and EVERY 64-bit field reader
#      returns a `W64`, with BOTH halves printed in the rows (`hi:lo`) so a port
#      that swapped them disagrees rather than producing a plausible address.
#   2. FLOAT. Neither file reads a float field. `amdgpu_kd`'s
#      `llvm_amdhsa_kernel_descriptor_t` is all integer fields, so the byte
#      indexing wall (`bend base` has no `F64`, no `F32.to_bits`, and no `==` on
#      `F32`) does not bite either port. Stated because it was the open risk in
#      the brief and it turned out not to apply.
#   3. `ctypes` / `CDLL`. `getattr(lib, sym)` and `ctypes.cast(p, c_void_p).value`
#      are dynamic-loader calls. `link_sym` is ported as the same first-hit-wins
#      scan over a `Link` table, and the LIBRARY table is a fixture, not a claim.
#   4. `blob.find(b'\x00', idx)` is `_strtab` and is the only `find` in either
#      file. Bend has no `find` and no regex, so it is a fold to the first NUL.
#   5. MUTABLE BUFFERS. `bytearray`, `image[a:b] = c` and `image += c` have no
#      Bend spelling, so the image is a `Data` record whose `put` returns a NEW
#      image with the same bytes in the same order.
#   6. NO HEX LITERALS. `0x7f454c46` is a PARSE ERROR in bend 2.0.34 ("expected
#      : a numeric literal"), so every constant is decimal and its hex spelling is
#      a row name, which is also how the audit reads.
#   7. `List.append(a, A, xs, ys)` IS `xs ++ ys`. This is the trap the whole file
#      is shaped around and it is MEASURED, not remembered: a walk that appends
#      in visit order writes `List.append(.., acc, [x])` and does NOT reverse; a
#      walk that prepends writes `List.append(.., [x], acc)` and does not reverse
#      either. The section table is BUILT prepended and REVERSED ONCE, because its
#      order is the answer; the row helpers are BUILT appended and never reversed.
#
# ===========================================================================
# WHAT IS PORTED, DEF BY DEF. `libc` is `tinygrad/runtime/autogen/libc.py`,
# generated and NOT in this unit's scope; its STRUCT LAYOUTS and its constants
# are named here as the port's own tables and are gated against the oracle
# reading those same constants out of the real module.
#
#   :7   ElfSection                PORTED  `ElfSection` + its three readers
#   :9   link_sym                  PORTED  `link_sym`, `Link` table
#   :15  elf_loader                PORTED  `elf_loader`
#   :16  the ELFMAG assert         PORTED  `magic_ok`
#   :17  the ecls dict             PORTED  `ecls`, `is64`
#   :19  _strtab                   PORTED  `Str.tab`
#   :21  the Ehdr struct           PORTED  `Ehdr`, `Ehdr.at`, 13 readers
#   :22  the Shdr array            PORTED  `Shdr.at`, `Sections.go`, 10 readers
#   :23  the shstrtab slice        PORTED  `shstrtab`
#   :24  the ElfSection list       PORTED  `Sections.build`
#   :26  _to_carray                PORTED  `Rel.entsize`, `Rel.count`
#   :27  rel                       PORTED  `Rel.sects`, `Rel.trgt`
#   :28  rela                      PORTED  `Rel.sects` with `rela`, `Rel.trgt`
#   :29  symtab                    PORTED  `Sym.at`, 6 readers
#   :30  progbits                  PORTED  `Sec.progbits`
#   :33  the image prealloc        PORTED  `Img.prealloc`
#   :34-38 the aligned append      PORTED  `Img.pad`, `Img.place`
#   :42-48 the reloc loop          PORTED  `Relocs.of`, `Sym.name`, `Sym.tgt`
#   :50  the return                PORTED  `ElfImage`
#   :52  jit_loader                PORTED  `jit_loader`
#   :56  relocate                  PORTED  `relocate`, `Reloc.t`, the ten arms
#                                         and both trampolines
#   :84-85 the 4-byte write-back   PORTED  `pack4`, `unpack4`

import Base
import ./../../helpers.bend as H

# ===========================================================================
# THE BYTE LAYER. A blob is a hex String (WALL 4) and these are its readers.
# The little-endian order is load-bearing: reading an ELF header big-endian
# yields a plausible wrong number, not an error.
# ===========================================================================
def Hex.d(c: Char) -> U32: Char.to_u32(c)
def Hex.isdig(c: Char) -> Bool: Char.is_digit(c)
def Hex.isupp(c: Char) -> Bool: Char.is_upper(c)
def Hex.islow(c: Char) -> Bool: Char.is_lower(c)
# THREE INDEPENDENT CONSTANTS, MEASURED, not one formula:
#   python3 -c "for c in '0123456789abcdefABCDEF': print(ord(c)-int(c,16))"
#   -> 48 for '0'-'9', 87 for 'a'-'f', 55 for 'A'-'F'.
# The obvious single-constant spelling `x - 87` is WRONG for uppercase, because
# 65 - 87 saturates U32; 55 is the third measurement.
def Hex.d48(c: Char) -> U32: U32.sub(Hex.d(c), 48)
def Hex.d87(c: Char) -> U32: U32.sub(Hex.d(c), 87)
def Hex.d55(c: Char) -> U32: U32.sub(Hex.d(c), 55)
def Hex.uppval(+c: Char) -> U32: Bool.pick(U32, Hex.isupp(c), Hex.d55(c), 15)
def Hex.lowval(+c: Char) -> U32: Bool.pick(U32, Hex.islow(c), Hex.d87(c), Hex.uppval(c))
def Hex.val(+c: Char) -> U32: Bool.pick(U32, Hex.isdig(c), Hex.d48(c), Hex.lowval(c))

def Blob.at(h: String, i: U32) -> Char:
  Maybe.default(&2, Char, String.get(h, U32.to_nat(i)), Char.from_u32(48))
def Blob.nib(h: String, i: U32) -> U32: Hex.val(Blob.at(h, i))
def Blob.u8(+h: String, +i: U32) -> U32:
  U32.add(U32.mul(Blob.nib(h, U32.mul(i, 2)), 16), Blob.nib(h, U32.add(U32.mul(i, 2), 1)))
# Little-endian: byte[0] + byte[1]*256, NOT the other way round.
def Blob.le16(+h: String, +i: U32) -> U32:
  U32.add(Blob.u8(h, i), U32.mul(Blob.u8(h, U32.add(i, 1)), 256))
def Blob.le32(+h: String, +i: U32) -> U32:
  U32.add(Blob.le16(h, i), U32.mul(Blob.le16(h, U32.add(i, 2)), 65536))
# The hex STRING's length is TWICE the byte length; a gate row that forgot the
# factor of two would still pass a COUNT check, which is why `elf_blk_hexlen`
# and `elf_blk_bytes` are a pair.
def Blob.hexlen(h: String) -> U32: U32.from_nat(String.length(h))
def Blob.nbytes(h: String) -> U32: U32.div(Blob.hexlen(h), 2)
def Blob.fuel(h: String) -> Nat: U32.to_nat(Blob.nbytes(h))

# `Blob.slice(blob, off, n)` is `blob[off : off+n]` on a hex String: a DROP of
# `2*off` hex digits then a TAKE of `2*n`. Two defs because `n` is needed by the
# take and not by the drop, and removing the last use of a parameter is a compile
# error in bend 2.0.34.
def Blob.drop_to(+h: String, +off: U32) -> String: String.drop(h, U32.to_nat(U32.mul(off, 2)))
def Blob.take_n(+s: String, +n: U32) -> String: String.take(s, U32.to_nat(U32.mul(n, 2)))
def Blob.slice(+h: String, +off: U32, +n: U32) -> String: Blob.take_n(Blob.drop_to(h, off), n)

# THE HEX FORMATTER. A U32 as eight lowercase hex digits, high first -- the shape
# the oracle's `.hex()` prints. Sixteen entries, one per nibble, and
# `elf_hexdig` gates all sixteen because a formatter with one wrong entry
# corrupts every byte above it and a length check would not see it.
def HEXDIGS() -> List<&2, Char>: String.to_list("0123456789abcdef")
def Hex.digit(i: Nat) -> String:
  String.from_list([Maybe.default(&2, Char, List.get(&2, Char, HEXDIGS, i), Char.from_u32(48))])
def Hex.byte(+v: U32) -> String:
  String.concat([Hex.digit(U32.to_nat(U32.shrn(v, 4n))), Hex.digit(U32.to_nat(v)), ""])
def Hex.of(+v: U32) -> String:
  String.concat([Hex.byte(U32.shrn(v, 24n)), Hex.byte(U32.shrn(v, 16n)),
                 Hex.byte(U32.shrn(v, 8n)), Hex.byte(v), ""])
def Hex.u8(+v: U32) -> String: Hex.byte(v)
# two bytes as four digits, LOW first, which is the shape of a little-endian word
# in the blob. `Hex.of` is big-endian order and `Hex.pair` little-endian, and
# swapping them is a mutation the gate must catch.
def Hex.pair(+v: U32) -> String: String.concat([Hex.byte(v), Hex.byte(U32.shrn(v, 8n)), ""])
def Byte.chr(+v: U32) -> String: String.from_list([Char.from_u32(v)])
def U32s.go(xs: List<&2, U32>, acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: acc
    case +h <> t: U32s.go(t, List.append(&2, String, acc, [U32.show(h)]))
def justr(+xs: List<&2, U32>) -> String: String.join(U32s.go(xs, Nil{}), ",")
def Strs.go(xs: List<&2, String>, acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: acc
    case +h <> t: Strs.go(t, List.append(&2, String, acc, [h]))
def jstr(+xs: List<&2, String>) -> String: String.join(Strs.go(xs, Nil{}), ",")

# ===========================================================================
# W64 -- a 64-bit little-endian word as its two halves. Named W64 rather than
# Pair because `Pair` is a Bend builtin (measured: "duplicate declaration:
# Pair"). Both halves are printed in the rows, `hi:lo`, so a port that swapped
# them disagrees rather than producing a plausible address.
# ===========================================================================
type W64 is Data:
  W64{wlo: U32, whi: U32}

def W64.of(lo: U32, hi: U32) -> W64: W64{lo, hi}
def W64.lo(+w: W64) -> U32:
  match w:
    case W64{wlo, whi}: wlo
def W64.hi(+w: W64) -> U32:
  match w:
    case W64{wlo, whi}: whi
def W64.is_zero(+w: W64) -> Bool: Bool.and(U32.is_zero(W64.lo(w)), U32.is_zero(W64.hi(w)))
def W64.add(+l: W64, +r: W64) -> W64: W64{U32.add(W64.lo(l), W64.lo(r)), U32.add(W64.hi(l), W64.hi(r))}
def W64.text(+w: W64) -> String: String.concat([U32.show(W64.hi(w)), ":", U32.show(W64.lo(w))])
# `image[a:b]` where a and b are 64-bit in Python. Only the LOW half indexes,
# which is the honest total form: every address a real object file has is under
# 2^32, and `elf_w64_is_addr` pins that against the oracle.
def W64.as_idx(+w: W64) -> U32: W64.lo(w)
# THE WORD READ, AND THE BUG IT FIXES. A 64-bit little-endian WORD at byte `k` is
# `le32(k)` and `le32(k+4)`. Writing the pair as `(k, k+8)` -- the start of the
# NEXT field -- reads FOUR BYTES PAST the field and returns the next section
# header's bytes as this field's high half. `sh_entsize` is at 56, so its high
# half is at 60; reading at 64 returned byte 8 of the NEXT Shdr. A COUNT SAW
# NOTHING. The ten-field `elf_sec_*_hdrtxt` STRING saw it, and it saw it only
# because the row spells `name@byteoffset:value`.
def W64.at32(+h: String, +k: U32, +hi: U32) -> W64:
  W64.of(Blob.le32(h, k), Blob.le32(h, hi))
def W64.at64(+h: String, +k: U32) -> W64: W64.at32(h, k, U32.add(k, 4))
def W64.at32x(+h: String, +k: U32) -> W64: W64.of(Blob.le32(h, k), 0)
def W64.at(+h: String, +k: U32, +x: Bool) -> W64:
  Bool.pick(W64, x, W64.at64(h, k), W64.at32x(h, k))

# struct.unpack("<I", ...) -> a U32, and struct.pack("<I", u) -> the four bytes
# back. The write is an IMAGE STEP (WALL 5) rather than a string splice.
def Blob.unpack4(+h: String, +i: U32) -> U32: Blob.le32(h, i)

# ===========================================================================
# THE ELF CONSTANTS. Every value is MEASURED off `tinygrad/runtime/autogen/
# libc.py` by the oracle, never transcribed. The rows `elf_c_*` carry them.
# ===========================================================================
def ELFMAG() -> U32: 2135247942
def EI_CLASS() -> U32: 4
def ELFCLASS32() -> U32: 1
def ELFCLASS64() -> U32: 2
def SHT_NULL() -> U32: 0
def SHT_PROGBITS() -> U32: 1
def SHT_SYMTAB() -> U32: 2
def SHT_STRTAB() -> U32: 3
def SHT_RELA() -> U32: 4
def SHT_NOBITS() -> U32: 8
def SHT_REL() -> U32: 9
def SHF_WRITE() -> U32: 1
def SHF_ALLOC() -> U32: 2
def SHF_EXECINSTR() -> U32: 4

# `blob[:4] == ELFMAG.encode()`, elf.py:16. Four bytes, and the answer is a Bool.
def magic_ok(+h: String) -> Bool: U32.is_eq(Blob.le32(h, 0), ELFMAG())
# elf.py:17's `{ELFCLASS32: "Elf32", ELFCLASS64: "Elf64"}[blob[EI_CLASS]]`. The
# dict SUBSCRIPT raises KeyError on anything else, so the total form is the name
# plus the `is64` Bool the rest of the file branches on.
def is64(+h: String) -> Bool: U32.is_eq(Blob.u8(h, EI_CLASS()), ELFCLASS64())
def ecls.name(x: Bool) -> String: Bool.pick(String, x, "Elf64", "Elf32")

# ===========================================================================
# THE FIELD-NAME STRINGS. These are the GATE, not documentation: they are the
# `register_fields` name lists from autogen/libc.py, compared as strings.
# ===========================================================================
def F_EHDR() -> String:
  String.concat(["e_ident,e_type,e_machine,e_version,e_entry,e_phoff,e_shoff,e_flags,",
                 "e_ehsize,e_phentsize,e_phnum,e_shentsize,e_shnum,e_shstrndx"])
def F_SHDR() -> String:
  String.concat(["sh_name,sh_type,sh_flags,sh_addr,sh_offset,sh_size,sh_link,sh_info,",
                 "sh_addralign,sh_entsize"])
# Elf64_Sym: st_value is FIFTH. Elf32_Sym: st_value is SECOND. Same names, same
# order, DIFFERENT offsets -- so one string cannot cover both and they are two rows.
def F_SYM64() -> String: "st_name,st_info,st_other,st_shndx,st_value,st_size"
def F_SYM32() -> String: "st_name,st_value,st_size,st_info,st_other,st_shndx"
def F_RELA() -> String: "r_offset,r_info,r_addend"
def F_REL() -> String: "r_offset,r_info"

# ===========================================================================
# THE RECORDS. EVERY FIELD IS TYPED (measured: an untyped field is `Quant`).
# ===========================================================================
# `Elf64_Ehdr` / `Elf32_Ehdr`, libc.py:251/:233. The `e_ident` array is NOT a
# field: it is the four magic bytes plus the class byte, and `magic_ok` and
# `is64` read it directly -- a record field would be a 16-byte array, which Bend
# has no spelling for.
type Ehdr is Data:
  Ehdr{e_type: U32, e_machine: U32, e_version: U32, e_entry: W64, e_phoff: W64,
       e_shoff: W64, e_flags: U32, e_ehsize: U32, e_phentsize: U32,
       e_phnum: U32, e_shentsize: U32, e_shnum: U32, e_shstrndx: U32}

# `Elf64_Shdr` / `Elf32_Shdr`, libc.py:283/:269.
type Shdr is Data:
  Shdr{sh_name: U32, sh_type: U32, sh_flags: U32, sh_addr: W64, sh_offset: W64,
       sh_size: W64, sh_link: U32, sh_info: U32, sh_addralign: W64, sh_entsize: W64}

# `Elf64_Sym` / `Elf32_Sym`, libc.py:322/:312.
type Sym is Data:
  Sym{st_name: U32, st_info: U32, st_other: U32, st_shndx: U32, st_value: W64, st_size: W64}

# `Elf64_Rel` / `Elf64_Rela`. `r_addend` is 0 for a Rel, which is exactly what
# `getattr(r, "r_addend", 0)` at elf.py:46 produces.
type Rel is Data:
  Rel{r_offset: W64, r_info: W64, r_addend: W64}

# elf.py:7, the frozen dataclass, three fields in this order. `content` is the
# hex slice because Bend has no `bytes` (WALL 4).
type ElfSection is Data:
  ElfSection{sec_name: String, sec_header: Shdr, sec_content: String}

def ElfSection.of(nm: String, h: Shdr, c: String) -> ElfSection: ElfSection{nm, h, c}
def ElfSection.name(+s: ElfSection) -> String:
  match s:
    case ElfSection{sec_name, sec_header, sec_content}: sec_name
def ElfSection.header(+s: ElfSection) -> Shdr:
  match s:
    case ElfSection{sec_name, sec_header, sec_content}: sec_header
def ElfSection.content(+s: ElfSection) -> String:
  match s:
    case ElfSection{sec_name, sec_header, sec_content}: sec_content

# elf_loader's return value, elf.py:50: the image, the sections, the relocs.
type ElfImage is Data:
  ElfImage{img_bytes: U32, img_body: String, img_sections: List<&2, ElfSection>,
           img_relocs: List<&2, Reloc>}
# One reloc tuple, elf.py:48: (image offset, target, type, addend).
type Reloc is Data:
  Reloc{r_at: W64, r_tgt: W64, r_type: U32, r_addend: W64}

# ===========================================================================
# THE READERS. Each takes the blob and a BYTE OFFSET and reads ONE field at its
# SPEC offset. The offsets ARE the table; each gets its own def so a changed
# offset is a changed def rather than a constant buried in an expression.
#
# Elf64_Ehdr registers: e_type@16 e_machine@18 e_version@20 e_entry@24
#   e_phoff@32 e_shoff@40 e_flags@48 e_ehsize@52 e_phentsize@54 e_phnum@56
#   e_shentsize@58 e_shnum@60 e_shstrndx@62
# Elf32_Ehdr registers: 16 18 20 24 28 32 36 40 42 44 46 48 50
#   -- the SAME offsets up to e_entry and then 4 lower for every 64-bit field,
#   which is the whole difference between the two layouts.
# ===========================================================================
def Ehdr.v_phoff(+h: String, +x: Bool) -> W64:
  Bool.pick(W64, x, W64.of(Blob.le32(h, 32), 0), W64.of(Blob.le32(h, 28), 0))
def Ehdr.v_shoff(+h: String, +x: Bool) -> W64:
  Bool.pick(W64, x, W64.of(Blob.le32(h, 40), 0), W64.of(Blob.le32(h, 32), 0))
def Ehdr.v_flags(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le32(h, 48), Blob.le32(h, 36))
def Ehdr.v_ehsize(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 52), Blob.le16(h, 40))
def Ehdr.v_phentsize(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 54), Blob.le16(h, 42))
def Ehdr.v_phnum(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 56), Blob.le16(h, 44))
def Ehdr.v_shentsize(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 58), Blob.le16(h, 46))
def Ehdr.v_shnum(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 60), Blob.le16(h, 48))
def Ehdr.v_shstrndx(+h: String, +x: Bool) -> U32:
  Bool.pick(U32, x, Blob.le16(h, 62), Blob.le16(h, 50))
# `Ehdr.at5` is the CONSTRUCTOR LITERAL: every value arrives as a parameter, so
# the record is built once. The chain BELOW it feeds those parameters one per
# step, reading the blob once per step -- which is the `sig.go` shape again.
# `Ehdr.at13` IS THE CONSTRUCTOR LITERAL: every value arrives as a parameter, so
# the record is built ONCE. The chain below it feeds those parameters one per
# step, reading the blob once per step -- which is the `sig.go` shape again, and
# it is why `x` is a parameter of every step instead of being re-derived.
# `Ehdr.at13` IS THE CONSTRUCTOR LITERAL: every value arrives as a parameter, so
# the record is built ONCE. The chain below it feeds those parameters one per
# step, reading the blob once per step -- which is the `sig.go` shape again, and
# it is why `x` is a parameter of every step instead of being re-derived from the
# blob thirteen times.
def Ehdr.at13(a_type: U32, a_machine: U32, a_version: U32, a_entry: W64,
              a_phoff: W64, a_shoff: W64, a_flags: U32, a_ehsize: U32,
              a_phentsize: U32, a_phnum: U32, a_shentsize: U32, a_shnum: U32,
              a_shstrndx: U32) -> Ehdr:
  Ehdr{a_type, a_machine, a_version, a_entry, a_phoff, a_shoff, a_flags, a_ehsize,
       a_phentsize, a_phnum, a_shentsize, a_shnum, a_shstrndx}
def Ehdr.at12(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
              a_entry: W64, a_phoff: W64, a_shoff: W64, a_flags: U32, a_ehsize: U32,
              a_phentsize: U32, a_phnum: U32) -> Ehdr:
  Ehdr.at13(a_type, a_machine, a_version, a_entry, a_phoff, a_shoff, a_flags, a_ehsize,
            a_phentsize, a_phnum, Ehdr.v_shentsize(h, x), Ehdr.v_shnum(h, x),
            Ehdr.v_shstrndx(h, x))
def Ehdr.at11(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
              a_entry: W64, a_phoff: W64, a_shoff: W64, a_flags: U32,
              a_ehsize: U32) -> Ehdr:
  Ehdr.at12(h, x, a_type, a_machine, a_version, a_entry, a_phoff, a_shoff, a_flags,
            a_ehsize, Ehdr.v_phentsize(h, x), Ehdr.v_phnum(h, x))
def Ehdr.at10(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
              a_entry: W64, a_phoff: W64, a_shoff: W64, a_flags: U32) -> Ehdr:
  Ehdr.at11(h, x, a_type, a_machine, a_version, a_entry, a_phoff, a_shoff, a_flags,
            Ehdr.v_ehsize(h, x))
def Ehdr.at9(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
             a_entry: W64, a_phoff: W64, a_shoff: W64) -> Ehdr:
  Ehdr.at10(h, x, a_type, a_machine, a_version, a_entry, a_phoff, a_shoff,
            Ehdr.v_flags(h, x))
def Ehdr.at8(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
             a_entry: W64, a_phoff: W64) -> Ehdr:
  Ehdr.at9(h, x, a_type, a_machine, a_version, a_entry, a_phoff, Ehdr.v_shoff(h, x))
def Ehdr.at7(+h: String, +x: Bool, a_type: U32, a_machine: U32, a_version: U32,
             a_entry: W64) -> Ehdr:
  Ehdr.at8(h, x, a_type, a_machine, a_version, a_entry, Ehdr.v_phoff(h, x))
def Ehdr.at6(+h: String, +x: Bool, a_type: U32, a_machine: U32) -> Ehdr:
  Ehdr.at7(h, x, a_type, a_machine, Blob.le32(h, 20), W64.of(Blob.le32(h, 24), 0))
def Ehdr.at5(+h: String, +x: Bool, a_type: U32) -> Ehdr:
  Ehdr.at6(h, x, a_type, Blob.le16(h, 18))
def Ehdr.at4(+h: String, +x: Bool) -> Ehdr:
  Ehdr.at5(h, x, Blob.le16(h, 16))
def Ehdr.at3(+h: String, +x: Bool) -> Ehdr: Ehdr.at4(h, x)
def Ehdr.at2(+h: String, +x: Bool) -> Ehdr: Ehdr.at3(h, x)
def Ehdr.at1(+h: String, +x: Bool) -> Ehdr: Ehdr.at2(h, x)
def Ehdr.at(+h: String, +x: Bool) -> Ehdr: Ehdr.at1(h, x)

def Ehdr.e_type(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_type
def Ehdr.e_machine(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_machine
def Ehdr.e_version(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_version
def Ehdr.e_entry(+e: Ehdr) -> W64:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_entry
def Ehdr.e_phoff(+e: Ehdr) -> W64:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_phoff
def Ehdr.e_shoff(+e: Ehdr) -> W64:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_shoff
def Ehdr.e_flags(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_flags
def Ehdr.e_ehsize(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_ehsize
def Ehdr.e_phentsize(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_phentsize
def Ehdr.e_phnum(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_phnum
def Ehdr.e_shentsize(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_shentsize
def Ehdr.e_shnum(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_shnum
def Ehdr.e_shstrndx(+e: Ehdr) -> U32:
  match e:
    case Ehdr{e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags,
              e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx}: e_shstrndx
def Ehdr.e_ident_size() -> U32: 16
# `ctypes.sizeof(libc.Elf64_Ehdr)` -- and the AMD packer needs it too
# (renderer/amd/elf.py:50 `round_up(ctypes.sizeof(libc.Elf64_Ehdr), 256)`).
def Ehdr.size(x: Bool) -> U32: Bool.pick(U32, x, 64, 52)

# THE Ehdr FIELD-ORDER ROW. All fourteen, at their Elf64 register offsets. The
# Elf32 row is the SAME STRING with 8-bit offsets -- same names, same order -- and
# the per-fixture `elf_hdr_*_hdr` row carries the values at the offsets the fixture
# actually uses.
def Ehdr.text(+e: Ehdr) -> String:
  String.join(
    [String.concat(["e_type@16:", U32.show(Ehdr.e_type(e))]),
     String.concat(["e_machine@18:", U32.show(Ehdr.e_machine(e))]),
     String.concat(["e_version@20:", U32.show(Ehdr.e_version(e))]),
     String.concat(["e_entry@24:", W64.text(Ehdr.e_entry(e))]),
     String.concat(["e_phoff@32:", W64.text(Ehdr.e_phoff(e))]),
     String.concat(["e_shoff@40:", W64.text(Ehdr.e_shoff(e))]),
     String.concat(["e_flags@48:", U32.show(Ehdr.e_flags(e))]),
     String.concat(["e_ehsize@52:", U32.show(Ehdr.e_ehsize(e))]),
     String.concat(["e_phentsize@54:", U32.show(Ehdr.e_phentsize(e))]),
     String.concat(["e_phnum@56:", U32.show(Ehdr.e_phnum(e))]),
     String.concat(["e_shentsize@58:", U32.show(Ehdr.e_shentsize(e))]),
     String.concat(["e_shnum@60:", U32.show(Ehdr.e_shnum(e))]),
     String.concat(["e_shstrndx@62:", U32.show(Ehdr.e_shstrndx(e))])], ",")

# ===========================================================================
# THE FIELD-OFFSET TABLE FOR Shdr, ONE ENTRY PER FIELD, EACH SPELLING BOTH
# LAYOUTS.
# Elf64_Shdr: sh_name@0 u32 sh_type@4 u32 sh_flags@8 u64 sh_addr@16 u64
#              sh_offset@24 u64 sh_size@32 u64 sh_link@40 u32 sh_info@44 u32
#              sh_addralign@48 u64 sh_entsize@56 u64
# Elf32_Shdr:  0 4 8 12 16 20 24 28 32 36, ALL u32.
#
# THE SECOND REAL PORT BUG WAS HERE. `sh_link` and `sh_info` are u32 FIELDS READ
# AT `off+40` / `off+44`. Passing the OFFSET ITSELF as the value put 936 (which is
# 896+40) into `sh_link` where the file holds 0. `Shdr.v_link` / `Shdr.v_info`
# read the value; `Shdr.o_link` / `Shdr.o_info` name where. A COUNT SAW NOTHING.
# `+off` on every entry because each adds two constants to the same `off`.
def Shdr.o64(x: Bool, k64: U32, k32: U32) -> U32: Bool.pick(U32, x, k64, k32)
def Shdr.o_flags(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 8), U32.add(off, 8))
def Shdr.o_addr(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 16), U32.add(off, 12))
def Shdr.o_offset(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 24), U32.add(off, 16))
def Shdr.o_size(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 32), U32.add(off, 20))
def Shdr.o_link(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 40), U32.add(off, 24))
def Shdr.o_info(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 44), U32.add(off, 28))
def Shdr.o_align(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 48), U32.add(off, 32))
def Shdr.o_ent(x: Bool, +off: U32) -> U32: Shdr.o64(x, U32.add(off, 56), U32.add(off, 36))

# THE THREE u32 FIELDS, READ. `Blob.le32` AT the offset, not the offset.
def Shdr.v_flags(h: String, off: U32, x: Bool) -> U32: Blob.le32(h, Shdr.o_flags(x, off))
def Shdr.v_link(h: String, off: U32, x: Bool) -> U32: Blob.le32(h, Shdr.o_link(x, off))
def Shdr.v_info(h: String, off: U32, x: Bool) -> U32: Blob.le32(h, Shdr.o_info(x, off))

# Elf64's 64 is not just Elf32's 40 plus a wider field: it is the STRIDE. Ten
# fields, and 64/10 does not divide, so `Shdr.nfields` is documentation and
# `Shdr.size` is the load-bearing one; the row `*_shdr_stride` pins both and the
# DECLARED `e_shentsize` is a third row beside them, so a port that trusts the
# header instead of the struct disagrees visibly.
def Shdr.size(x: Bool) -> U32: Bool.pick(U32, x, 64, 40)
def Shdr.nfields(x: Bool) -> U32: U32.div(Shdr.size(x), 10)
def Shdr.zero() -> Shdr:
  Shdr{0, 0, 0, W64.of(0, 0), W64.of(0, 0), W64.of(0, 0), 0, 0, W64.of(0, 0), W64.of(0, 0)}

# THE CONSTRUCTOR, in the reader's order, one field per `at` step. A `Data`
# record built in ONE literal needs every value in that literal, and computing
# ten of them there needs the blob ten times -- so the chain carries them as
# parameters. That is the whole reason `Shdr.at8` exists.
def Shdr.at8(+h: String, +off: U32, flags: U32, addr: W64, offset: W64,
             size: W64, link: U32, info: U32, align: W64, entsize: W64) -> Shdr:
  Shdr{Blob.le32(h, off), Blob.le32(h, U32.add(off, 4)), flags, addr, offset, size,
       link, info, align, entsize}
def Shdr.at7(+h: String, +off: U32, +x: Bool, flags: U32, addr: W64, offset: W64,
             size: W64, link: U32, info: U32) -> Shdr:
  Shdr.at8(h, off, flags, addr, offset, size, link, info,
           W64.at(h, Shdr.o_align(x, off), x), W64.at(h, Shdr.o_ent(x, off), x))
def Shdr.at6(+h: String, +off: U32, +x: Bool, flags: U32, addr: W64, offset: W64,
             size: W64, link: U32) -> Shdr:
  Shdr.at7(h, off, x, flags, addr, offset, size, link, Shdr.v_info(h, off, x))
def Shdr.at5(+h: String, +off: U32, +x: Bool, flags: U32, addr: W64, offset: W64,
             size: W64) -> Shdr:
  Shdr.at6(h, off, x, flags, addr, offset, size, Shdr.v_link(h, off, x))
def Shdr.at4(+h: String, +off: U32, +x: Bool, flags: U32, addr: W64, offset: W64) -> Shdr:
  Shdr.at5(h, off, x, flags, addr, offset, W64.at(h, Shdr.o_size(x, off), x))
def Shdr.at3(+h: String, +off: U32, +x: Bool, flags: U32, addr: W64) -> Shdr:
  Shdr.at4(h, off, x, flags, addr, W64.at(h, Shdr.o_offset(x, off), x))
def Shdr.at2(+h: String, +off: U32, +x: Bool, flags: U32) -> Shdr:
  Shdr.at3(h, off, x, flags, W64.at(h, Shdr.o_addr(x, off), x))
def Shdr.at(+h: String, +off: U32, +x: Bool) -> Shdr:
  Shdr.at2(h, off, x, Shdr.v_flags(h, off, x))

# THE TEN READERS. No `Shdr.a(sh)` sugar and no auto-generated projection exists
# in bend 2.0.34 (`Sh.a` reports "expected : a defined name"), so these are ten
# hand-written `case Shdr{...}` binders. A mutation to the `type` block moves NO
# row; a mutation to one of these moves the `*_hdrtxt` row and the `*_sh_*` column
# that names it. That asymmetry is the reason both are written.
def Shdr.name(+s: Shdr) -> U32:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_name
def Shdr.type(+s: Shdr) -> U32:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_type
def Shdr.flags(+s: Shdr) -> U32:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_flags
def Shdr.addr(+s: Shdr) -> W64:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_addr
def Shdr.offset(+s: Shdr) -> W64:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_offset
def Shdr.size_(+s: Shdr) -> W64:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_size
def Shdr.link(+s: Shdr) -> U32:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_link
def Shdr.info(+s: Shdr) -> U32:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_info
def Shdr.addralign(+s: Shdr) -> W64:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_addralign
def Shdr.entsize(+s: Shdr) -> W64:
  match s:
    case Shdr{sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size, sh_link,
              sh_info, sh_addralign, sh_entsize}: sh_entsize

# THE FIELD-ORDER ROW FOR ONE SECTION: all ten fields, `name@spec-offset:value`,
# in the order the reader walks them. A transposed pair changes this STRING and
# changes NO count. Both real bugs above were visible HERE and nowhere else.
def Shdr.at_text(+s: Shdr) -> String:
  String.join(
    [String.concat(["sh_name@0:", U32.show(Shdr.name(s))]),
     String.concat(["sh_type@4:", U32.show(Shdr.type(s))]),
     String.concat(["sh_flags@8:", U32.show(Shdr.flags(s))]),
     String.concat(["sh_addr@16:", W64.text(Shdr.addr(s))]),
     String.concat(["sh_offset@24:", W64.text(Shdr.offset(s))]),
     String.concat(["sh_size@32:", W64.text(Shdr.size_(s))]),
     String.concat(["sh_link@40:", U32.show(Shdr.link(s))]),
     String.concat(["sh_info@44:", U32.show(Shdr.info(s))]),
     String.concat(["sh_addralign@48:", W64.text(Shdr.addralign(s))]),
     String.concat(["sh_entsize@56:", W64.text(Shdr.entsize(s))])], ",")

# ===========================================================================
# THE Sym READERS, BOTH LAYOUTS.
# Elf64: st_name@0 st_info@4 st_other@5 st_shndx@6 st_value@8 st_size@16
# Elf32: st_name@0 st_value@4 st_size@8 st_info@12 st_other@13 st_shndx@14
# The ORDER is the same six names and the OFFSETS are not, so the field-order
# STRING is two rows and the offset strings are two more.
# ===========================================================================
def Sym.size(x: Bool) -> U32: Bool.pick(U32, x, 24, 16)
def Sym.o_info(x: Bool, +off: U32) -> U32: Bool.pick(U32, x, U32.add(off, 4), U32.add(off, 12))
def Sym.o_other(x: Bool, +off: U32) -> U32: Bool.pick(U32, x, U32.add(off, 5), U32.add(off, 13))
def Sym.o_shndx(x: Bool, +off: U32) -> U32: Bool.pick(U32, x, U32.add(off, 6), U32.add(off, 14))
def Sym.o_value(x: Bool, +off: U32) -> U32: Bool.pick(U32, x, U32.add(off, 8), U32.add(off, 4))
def Sym.o_size(x: Bool, +off: U32) -> U32: Bool.pick(U32, x, U32.add(off, 16), U32.add(off, 8))
def Sym.at8(+h: String, +base: U32, name: U32, info: U32, other: U32, shndx: U32,
            value: W64, size: W64) -> Sym:
  Sym{name, info, other, shndx, value, size}
def Sym.at7(+h: String, +base: U32, +x: Bool, name: U32, info: U32, other: U32,
            shndx: U32, value: W64) -> Sym:
  Sym.at8(h, base, name, info, other, shndx, value, W64.at(h, Sym.o_size(x, base), x))
def Sym.at6(+h: String, +base: U32, +x: Bool, name: U32, info: U32, other: U32) -> Sym:
  Sym.at7(h, base, x, name, info, other, Blob.le16(h, Sym.o_shndx(x, base)),
          W64.at(h, Sym.o_value(x, base), x))
def Sym.at5(+h: String, +base: U32, +x: Bool, name: U32, info: U32) -> Sym:
  Sym.at6(h, base, x, name, info, Blob.u8(h, Sym.o_other(x, base)))
def Sym.at4(+h: String, +base: U32, +x: Bool, name: U32) -> Sym:
  Sym.at5(h, base, x, name, Blob.u8(h, Sym.o_info(x, base)))
def Sym.at3(+h: String, +base: U32, +x: Bool) -> Sym:
  Sym.at4(h, base, x, Blob.le32(h, base))
def Sym.at2(+h: String, +base: U32, +x: Bool) -> Sym:
  Sym.at3(h, base, x)
def Sym.at(+h: String, +base: U32, +x: Bool) -> Sym: Sym.at2(h, base, x)

def Sym.name(+s: Sym) -> U32:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_name
def Sym.info(+s: Sym) -> U32:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_info
def Sym.other(+s: Sym) -> U32:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_other
def Sym.shndx(+s: Sym) -> U32:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_shndx
def Sym.value(+s: Sym) -> W64:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_value
def Sym.size_(+s: Sym) -> W64:
  match s:
    case Sym{st_name, st_info, st_other, st_shndx, st_value, st_size}: st_size
# ONE DEF PER LAYOUT, not a `Bool.pick` of two inline lists: a `Bool.pick`
# argument list spanning two multi-line `String.join` calls is a PARSE ERROR in
# bend 2.0.34 ("expected : a term / observed : ')'") that names neither arm.
def Sym.at_text64(+s: Sym) -> String:
  String.join(
    [String.concat(["st_name@0:", U32.show(Sym.name(s))]),
     String.concat(["st_info@4:", U32.show(Sym.info(s))]),
     String.concat(["st_other@5:", U32.show(Sym.other(s))]),
     String.concat(["st_shndx@6:", U32.show(Sym.shndx(s))]),
     String.concat(["st_value@8:", W64.text(Sym.value(s))]),
     String.concat(["st_size@16:", W64.text(Sym.size_(s))])], ",")
def Sym.at_text32(+s: Sym) -> String:
  String.join(
    [String.concat(["st_name@0:", U32.show(Sym.name(s))]),
     String.concat(["st_value@4:", W64.text(Sym.value(s))]),
     String.concat(["st_size@8:", W64.text(Sym.size_(s))]),
     String.concat(["st_info@12:", U32.show(Sym.info(s))]),
     String.concat(["st_other@13:", U32.show(Sym.other(s))]),
     String.concat(["st_shndx@14:", U32.show(Sym.shndx(s))])], ",")
def Sym.at_text(+s: Sym, +x: Bool) -> String:
  Bool.pick(String, x, Sym.at_text64(s), Sym.at_text32(s))

# ===========================================================================
# `_strtab`, elf.py:19 -- `blob[idx:blob.find(b'\x00', idx)].decode('utf-8')`.
# THE ONLY `find` IN EITHER FILE. Bend has no `find` and no regex, so it is a
# fold to the first NUL.
#
# THE FUEL IS A `Nat` AND IS SPENT BY A `Succ{q}` MATCH ARM. MEASURED, and this
# is why the fold is written this way: a U32 fuel with `U32.sub(fuel, 1)` is NOT
# accepted as a decreasing self-call, because `term_descend` on `U32.sub(fuel,1)`
# is EQ rather than LT --
#   expected : a decreasing self-call (arguments are read left to right: each
#   passed unchanged until one shrinks)
# while the SAME fold over a `Nat` fuel spent by `case Succ{q}: ... w(q, ...)`
# typechecks and runs. The `idx` is the SECOND parameter because a self-call's
# arguments are read left to right and the first that shrinks is what makes it
# decreasing.
def Str.stop(+h: String, +idx: U32) -> Bool: U32.is_zero(Blob.u8(h, idx))
def Str.at.at(fuel: Nat, +idx: U32, +h: String, +acc: String) -> String:
  match fuel:
    case 0n: acc
    case Succ{q}: Bool.pick(String, Str.stop(h, idx), acc,
      Str.at.at(q, U32.add(idx, 1), h, String.concat([acc, Byte.chr(Blob.u8(h, idx))])))
# NUL TERMINATES; so does RUNNING OUT OF BYTES, and the fuel is the real length.
# Both ends terminate and neither needs a separate test: `Blob.u8` reads `Blob.at`,
# which defaults to '0' past the end, so a table with no NUL reads '0' forever --
# which is exactly the wanted answer, the empty string.
def Str.at(fuel: Nat, byte_at: U32, +h: String) -> String:
  Str.at.at(fuel, byte_at, h, "")
# `tbl_off` is not a parameter below, because the string table IS a slice of the
# blob and `Blob.slice` makes that explicit: reading at `idx` into the slice is
# reading at `tbl_off + idx` into the blob. `elf_str_*_names` pins that the two
# readings agree on every fixture, so folding the offset in is a relabelling.
def Str.tab(+h: String, +tbl_off: U32, +byte_at: U32) -> String:
  Str.at(Blob.fuel(h), byte_at, Blob.slice(h, tbl_off, Blob.nbytes(h)))
def Str.drop_n(+s: String, +n: U32) -> String: String.drop(s, U32.to_nat(n))

# ===========================================================================
# THE SECTION LIST. elf.py:22-24.
#
# FOUR THINGS MEASURED HERE, ALL OF THEM ABOUT THE SAME LIST-WALK SHAPE:
#
#   1. `List.append(&2, A, xs, ys)` is `xs ++ ys` -- an APPEND DOES NOT PRESERVE
#      THE ORDER ITS ARGUMENTS WERE WRITTEN IN. helpers.bend:1029 and
#      ops_amd.bend:626 both put the accumulator FIRST for exactly this reason.
#   2. THE FUEL IS THE LIST, NOT A NUMBER. `sig.go` (ops_amd.bend:626) descends
#      the tail `t` and the scrutinee IS the fuel -- no `Nat` countdown, no
#      `Succ{q}`, and therefore no "decreasing self-call" to get wrong.
#   3. THE ACCUMULATOR STEP IS ITS OWN DEF. A `Data` record whose reader is used
#      twice is "consumed more than once" even with `+`, so `Sections.step` is
#      exactly `ops_amd.bend`'s `sig.step(off, k, acc)`.
#   4. PREPEND-AND-REVERSE-ONCE. The section table's INDEX ORDER is the answer, so
#      the walk prepends and `Sections.of` reverses exactly once. Getting this
#      wrong produces a REVERSED table, which `*_names` catches and `*_nsec`
#      does not -- and the wrong `List.append` order produces exactly that.
#
# `Walk{w_off, w_i}` is `shoff` and the section index TOGETHER. As two parameters
# that is four `+`s and one double-use error per line; as a `Data` record it is
# one parameter threaded once. That is the entire reason `Walk` exists.
# ===========================================================================
type Walk is Data:
  Walk{w_off: U32, w_i: U32}
def Walk.of(off: U32, i: U32) -> Walk: Walk{off, i}
def Walk.off(+w: Walk) -> U32:
  match w:
    case Walk{w_off, w_i}: w_off
def Walk.i(+w: Walk) -> U32:
  match w:
    case Walk{w_off, w_i}: w_i
def Walk.adv(+w: Walk) -> U32: U32.add(Walk.i(w), 1)
def Walk.next(+w: Walk) -> Walk: Walk.of(Walk.off(w), Walk.adv(w))

# elf.py:22's `(getattr(libc, f"{ecls}_Shdr") * header.e_shnum)`: section `i` is
# at `shoff + i * shentsize`. The MULTIPLY is the stride, and Elf64's 64 differs
# from Elf32's 40.
def Sections.one(s: Shdr) -> List<&2, Shdr>: [s]
def Sections.at_blob(h: String, +w: Walk, +x: Bool) -> Shdr:
  Shdr.at(h, U32.add(Walk.off(w), U32.mul(Walk.i(w), Shdr.size(x))), x)
def Sections.indices(n: U32) -> List<&2, Nat>: List.range(U32.to_nat(n))
def Sections.step(+h: String, +w: Walk, +x: Bool, +acc: List<&2, Shdr>) -> List<&2, Shdr>:
  List.append(&2, Shdr, Sections.one(Sections.at_blob(h, w, x)), acc)
def Sections.go(fuel: List<&2, Nat>, +h: String, +w: Walk, +x: Bool,
                +acc: List<&2, Shdr>) -> List<&2, Shdr>:
  match fuel:
    case Nil{}: acc
    case +k <> t: Sections.go(t, h, Walk.next(w), x, Sections.step(h, w, x, acc))
def Sections.of(+h: String, +e: Ehdr, +x: Bool) -> List<&2, Shdr>:
  List.reverse(&2, Shdr,
    Sections.go(Sections.indices(Ehdr.e_shnum(e)), h,
                Walk.of(W64.as_idx(Ehdr.e_shoff(e)), 0), x, Nil{}))

# THE INDEXED READ. A missing index has to mean something specific, and the
# default is the ZERO Shdr -- which is also what a real SHT_NULL at index 0 looks
# like, so the two are not confused by a reader either.
def Sections.at(+xs: List<&2, Shdr>, +i: U32) -> Shdr:
  Maybe.default(&2, Shdr, List.get(&2, Shdr, xs, U32.to_nat(i)), Shdr.zero())
def Sections.len(+xs: List<&2, Shdr>) -> U32: U32.from_nat(List.length(&2, Shdr, xs))
# THE SAME INDEX, OVER THE BUILT LIST. `Sections.at` reads the raw header table
# and `Sections.at_sec` reads the list `elf_loader` returns, and they are two
# defs because they are two DIFFERENT LISTS -- keeping the two tables apart is
# not decoration, it is the only thing that stops them being confused.
def Sections.at_sec(+xs: List<&2, ElfSection>, +i: U32) -> ElfSection:
  Maybe.default(&2, ElfSection, List.get(&2, ElfSection, xs, U32.to_nat(i)),
                ElfSection.of("", Shdr.zero(), ""))

# elf.py:23's walrus `(shstrst := section_headers[e_shstrndx].sh_offset)`: the
# SECTION HEADER STRING TABLE, the one section whose bytes are searched to name
# every other section. Its index is `e_shstrndx`, which is the field right after
# `e_shnum`, and reading the wrong one yields a plausible wrong table.
def shstrtab_at(+h: String, +s: Shdr) -> String:
  Blob.slice(h, W64.as_idx(Shdr.offset(s)), W64.as_idx(Shdr.size_(s)))
def shstrtab(+h: String, +e: Ehdr, +x: Bool) -> String:
  shstrtab_at(h, Sections.at(Sections.of(h, e, x), Ehdr.e_shstrndx(e)))

# elf.py:24: `[ElfSection(_strtab(sh_strtab, sh.sh_name), sh,
# blob[sh.sh_offset:sh.sh_offset+sh.sh_size]) for sh in section_headers]`.
# THREE reads of one section -- NAME, HEADER and CONTENT -- and the shape that
# typechecks is `sig.go`'s: the section goes to a def that returns the CONTENT,
# and the CONTENT is carried as its own parameter so the section is read once per
# def rather than three times in one body.
def Sec.one_sec(s: ElfSection) -> List<&2, ElfSection>: [s]
def Sections.content_of(+h: String, +s: Shdr) -> String:
  Blob.slice(h, W64.as_idx(Shdr.offset(s)), W64.as_idx(Shdr.size_(s)))
def Sections.nm_of(+sstr: String, +s: Shdr) -> String: Str.tab(sstr, 0, Shdr.name(s))
def Sections.of2(nm: String, s: Shdr, content: String) -> ElfSection: ElfSection.of(nm, s, content)
def Sections.mk2(+h: String, +sstr: String, +s: Shdr) -> ElfSection:
  Sections.of2("", s, Sections.content_of(h, s))
def Sections.mk(+h: String, +sstr: String, +s: Shdr) -> ElfSection:
  Sections.of2(Sections.nm_of(sstr, s), s, Sections.content_of(h, s))
def Sections.step2(+h: String, +sstr: String, +s: Shdr,
                   +acc: List<&2, ElfSection>) -> List<&2, ElfSection>:
  List.append(&2, ElfSection, Sec.one_sec(Sections.mk(h, sstr, s)), acc)
def Sections.go2(fuel: List<&2, Shdr>, +h: String, +sstr: String,
                 +acc: List<&2, ElfSection>) -> List<&2, ElfSection>:
  match fuel:
    case Nil{}: acc
    case +k <> t: Sections.go2(t, h, sstr, Sections.step2(h, sstr, k, acc))
def Sections.build(+h: String, +e: Ehdr, +x: Bool) -> List<&2, ElfSection>:
  List.reverse(&2, ElfSection,
    Sections.go2(Sections.of(h, e, x), h, shstrtab(h, e, x), Nil{}))
# ===========================================================================
# link_sym, elf.py:9-13. THE LIVE BUG.
#
# `for lib in libs: try: return unwrap(ctypes.cast(getattr(lib, sym),
# ctypes.c_void_p).value) except (OSError, AttributeError): pass` then
# `raise RuntimeError(f'Attempting to relocate against an undefined symbol
# {sym}')`.
#
# THE PORT IS THE SAME FIRST-HIT-WINS SCAN over a `Link{name, addr}` table, and
# the LIBRARY TABLE IS A FIXTURE, NOT A CLAIM: every cell was measured by calling
# tinygrad's OWN `link_sym` against the real dylib on this machine, so the rows
# `elf_ls_*` say what the machine actually answers rather than what this port
# believes.
#
# `Link.addr` is 0 for "the symbol is absent", which is the total form of
# `AttributeError`. The rows name the LIBRARY ORDER, because the order decides a
# fall-through: `sin` is in both libm and libSystem, so `[libm, rt]` and
# `[rt, libm]` answer DIFFERENT addresses, and `elf_ls_sin_*` pins which.
# ===========================================================================
type Link is Data:
  Link{l_name: String, l_addr: U32}
def Link.of(nm: String, addr: U32) -> Link: Link{nm, addr}
def Link.name(+l: Link) -> String:
  match l:
    case Link{l_name, l_addr}: l_name
def Link.addr(+l: Link) -> U32:
  match l:
    case Link{l_name, l_addr}: l_addr

# THE THREE LIBRARIES ops_cpu.py:19/21 CAN BUILD, plus libobjc which it does
# NOT. MEASURED per symbol by the oracle, not asserted here.
def LIBM() -> Link: Link.of("libm", 1)
def LIRT() -> Link: Link.of("rt", 1)
def LIOBJC() -> Link: Link.of("libobjc", 0)
def CPU_PAIR() -> List<&2, Link>: [LIBM(), LIRT()]
def CPU_TRIO() -> List<&2, Link>: [LIBM(), LIRT(), LIOBJC()]

# `getattr(lib, sym)` -- the FIRST hit wins and the scan stops there. `0` is the
# `AttributeError` arm, so a library that does not export the symbol is skipped
# rather than ending the scan.
# THE ACCUMULATOR IS THE ANSWER, NOT A SEPARATE FLAG. `acc` is 0 until the first
# hit and holds the address after it, so the scan is `Bool.pick(is_zero(acc),
# find(t, hit), find(t, acc))` in ONE def -- no helper, no mutual recursion, and
# `Bool.pick` evaluating both arms is harmless because a self-call on a SHORTER
# list is the descent. That is why `Link.find2` does not exist.
# THE SCAN IS A FOLD, NOT A SHORT-CIRCUIT. python.py's `for lib in libs: try:
# return ... except: pass` returns the FIRST hit, and in Bend a `Bool.pick` of
# two self-calls on the SAME list is mutual recursion (refused) while one on a
# SHORTER list is the descent -- so the short-circuit shape cannot be written and
# the FOLD is used instead. IT IS EQUIVALENT BECAUSE `Link.addr` is 0 for an
# absent symbol: `acc if acc else addr` over the list in order IS "the first
# non-zero, else 0". The rows `elf_ls_*` pin the ORDER (`elf_ls_order`) because
# with a fold the ORDER IS STILL LOAD-BEARING: two libraries both exporting the
# symbol answer DIFFERENT addresses and the fold keeps the FIRST.
def Link.step(+l: Link, +acc: U32) -> U32:
  Bool.pick(U32, U32.is_zero(acc), Link.addr(l), acc)
def Link.fold(fuel: List<&2, Link>, +acc: U32) -> U32:
  match fuel:
    case Nil{}: acc
    case +h <> t: Link.fold(t, Link.step(h, acc))
def link_sym(libs: List<&2, Link>) -> U32: Link.fold(libs, 0)
def link_sym_msg(sym: String) -> String:
  String.concat(["Attempting to relocate against an undefined symbol ", sym])

# ===========================================================================
# THE RELOCATION LAYER. elf.py:26-30 and :42-48.
#
# elf.py:26's `_to_carray(sh, ctype)`: `(ctype * (sh_size // sh_entsize))`. The
# DIVISION IS THE COUNT OF ENTRIES and the entsize is the STRIDE, and they differ
# between classes (16/24 for Elf64 Rel/Rela, 8/12 for Elf32) -- so both are rows.
# ===========================================================================
def Rel.ent64(+rela: Bool) -> U32: Bool.pick(U32, rela, 24, 16)
def Rel.ent32(+rela: Bool) -> U32: Bool.pick(U32, rela, 12, 8)
def Rel.entsize(x: Bool, +rela: Bool) -> U32: Bool.pick(U32, x, Rel.ent64(rela), Rel.ent32(rela))
def Rel.count.zero(sz: U32, ent: U32) -> Bool: U32.is_zero(ent)
def Rel.count.go(sz: U32, ent: U32) -> U32: U32.div(sz, ent)
def Rel.count(+sz: W64, +ent: W64) -> U32:
  Bool.pick(U32, Rel.count.zero(W64.lo(sz), W64.lo(ent)), 0,
            Rel.count.go(W64.lo(sz), W64.lo(ent)))

# elf.py:45: `ELF{32,64}_R_SYM(r_info)` and `ELF{32,64}_R_TYPE(r_info)`. THE SPLIT
# DIFFERS BY CLASS and reading it the same way for both is a silently wrong symbol
# index: Elf64 is (>>32, &0xffffffff), Elf32 is (>>8, &0xff). The row
# `elf_r_split_*` carries all four numbers so both are gated.
# THE SHIFT AMOUNTS ARE `Nat` LITERALS: `U32.shr(info, 32n)` is right and
# `U32.shr(info, 32)` is "expected : a function type", because 32 as a U32 is not
# a shift amount.
def R.sym(x: Bool, +info: U32) -> U32: Bool.pick(U32, x, U32.shrn(info, 32n), U32.shrn(info, 8n))
def R.typ(x: Bool, +info: U32) -> U32: Bool.pick(U32, x, info, U32.and(info, 255))

# ONE REL ENTRY. `r_offset`@0, `r_info`@8 (Elf64) or @4 (Elf32), `r_addend`@16
# (Elf64) or @8 (Elf32). `getattr(r, "r_addend", 0)` at elf.py:46 is a Rel's
# answer of ZERO, which is what `Rel.at4` reads at `ao` when `rela` is False --
# so the two are ONE def, not a Rel and a Rela.
def Rel.at4(+h: String, +at: U32, io: U32, ao: U32, +hi: U32) -> Rel:
  Rel{W64.of(Blob.le32(h, at), hi),
      W64.of(Blob.le32(h, U32.add(at, io)), hi),
      W64.of(Blob.le32(h, U32.add(at, ao)), hi)}
def Rel.at3(+h: String, +base: U32, +at: U32, io: U32, ao: U32) -> Rel:
  Rel.at4(h, at, io, ao, 0)
def Rel.at2.at(+base: U32, +i: U32, +stride: U32) -> U32: U32.add(base, U32.mul(i, stride))
def Rel.at2(+h: String, +base: U32, +i: U32, +x: Bool, +stride: U32, io: U32, ao: U32) -> Rel:
  Rel.at3(h, base, Rel.at2.at(base, i, stride), io, ao)
def Rel.atx(+x: Bool) -> U32: Bool.pick(U32, x, 16, 8)
def Rel.io(+x: Bool) -> U32: Bool.pick(U32, x, 8, 4)
def Rel.ao(+x: Bool) -> U32: Bool.pick(U32, x, 16, 8)
def Rel.at(+h: String, +base: U32, +i: U32, +x: Bool) -> Rel:
  Rel.at2(h, base, i, x, Rel.atx(x), Rel.io(x), Rel.ao(x))

# THE SHT_REL AND SHT_RELA FILTERS, elf.py:27-28. The two name strips are the
# load-bearing bit: `sh.name[4:]` for REL and `sh.name[5:]` for RELA, which is
# why `.rela.text` needs FIVE and `.rel.text` needs FOUR. A single strip is a
# silently wrong target name and therefore a silently wrong relocation base.
def Rel.trgt(+nm: String, rela: Bool) -> String:
  Bool.pick(String, rela, Str.drop_n(nm, 5), Str.drop_n(nm, 4))
def Sec.typ(+s: ElfSection) -> U32: Shdr.type(ElfSection.header(s))
def Sec.is_rela(+s: ElfSection) -> Bool: U32.is_eq(Sec.typ(s), SHT_RELA())
def Sec.is_rel(+s: ElfSection) -> Bool: U32.is_eq(Sec.typ(s), SHT_REL())
def Sec.pick_rel(+s: ElfSection, rela: Bool) -> Bool:
  Bool.pick(Bool, rela, Sec.is_rela(s), Sec.is_rel(s))
def Rel.sects.step(+s: ElfSection, +rela: Bool, +acc: List<&2, ElfSection>) -> List<&2, ElfSection>:
  Bool.pick(List<&2, ElfSection>, Sec.pick_rel(s, rela), acc,
            List.append(&2, ElfSection, Sec.one_sec(s), acc))
def Rel.sects.go(xs: List<&2, ElfSection>, +rela: Bool,
                 +acc: List<&2, ElfSection>) -> List<&2, ElfSection>:
  match xs:
    case Nil{}: List.reverse(&2, ElfSection, acc)
    case +h <> t: Rel.sects.go(t, rela, Rel.sects.step(h, rela, acc))
def Rel.sects(+xs: List<&2, ElfSection>, +rela: Bool) -> List<&2, ElfSection>:
  Rel.sects.go(xs, rela, Nil{})

# elf.py:43: `if trgt_sh_name == ".eh_frame": continue`. ONE section out of the
# whole table, and the rows `elf_sec_*_ehframe_skipped` say whether it is present.
def Rel.nm5(+s: ElfSection) -> String: Str.drop_n(ElfSection.name(s), 5)
def Rel.nm4(+s: ElfSection) -> String: Str.drop_n(ElfSection.name(s), 4)
def Rel.hit5(+s: ElfSection) -> Bool: String.eq(Rel.nm5(s), ".eh_frame")
def Rel.hit4(+s: ElfSection) -> Bool: String.eq(Rel.nm4(s), ".eh_frame")
def Rel.head_is_ehf(+s: ElfSection) -> Bool: Bool.pick(Bool, Sec.is_rela(s), Rel.hit5(s), Rel.hit4(s))
def Rel.has_ehf(xs: List<&2, ElfSection>) -> Bool:
  match xs:
    case Nil{}: False{}
    case +h <> t: Bool.pick(Bool, Rel.head_is_ehf(h), True{}, Rel.has_ehf(t))
def Rel.skip_ehframe(+xs: List<&2, ElfSection>) -> Bool: Bool.pick(Bool, Rel.has_ehf(xs), True{}, False{})

# THE TARGET NAMES THE DERIVATION PRODUCES. This is UPSTREAM DEFECT 2:
# `.rela.dyn` strips to `.dyn` and `.rela.plt` to `.plt`, and
# `next(tsh for tsh in sections if tsh.name == trgt_sh_name)` at elf.py:44 is
# exhausted for `.dyn`. Naming them is what makes the refusal legible instead of a
# shrug, and `elf_refuse_r64so_trgt_dyn` is the row that says so.
def Rel.trgt_names.go(xs: List<&2, ElfSection>, +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: List.reverse(&2, String, acc)
    case +h <> t: Rel.trgt_names.go(t, List.append(&2, String, acc,
      [Rel.trgt(ElfSection.name(h), True{})]))
def Rel.trgt_names(+xs: List<&2, ElfSection>) -> List<&2, String>:
  Rel.trgt_names.go(xs, Nil{})
def Rel.trgt_dyn(+xs: List<&2, ElfSection>) -> String:
  jstr(Rel.trgt_names(Rel.sects(xs, True{})))
def Rel.trgt_rel(+xs: List<&2, ElfSection>) -> String:
  jstr(Rel.trgt_names(Rel.sects(xs, False{})))
def Rel.nm_of.go(xs: List<&2, ElfSection>, +rela: Bool,
                  +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: List.reverse(&2, String, acc)
    case +h <> t: Rel.nm_of.go(t, rela, List.append(&2, String, acc, [ElfSection.name(h)]))
def Rel.nm_of(+xs: List<&2, ElfSection>, +rela: Bool) -> List<&2, String>:
  Rel.nm_of.go(xs, rela, Nil{})
def Rel.names(+xs: List<&2, ElfSection>, +rela: Bool) -> String:
  jstr(Rel.nm_of(Rel.sects(xs, rela), rela))

# THE IMAGE. elf.py:32-38.
#
# `image = bytearray(max([sh_addr + sh_size for sh in progbits if sh_addr != 0]
# + [0]))` -- the PREALLOC, which is a maximum over a LIST, and the rows carry
# both the prealloc and the per-section addresses so a port that forgot the
# `+ [0]` (the empty-file answer is 0, not a crash) disagrees visibly.
#
# elf.py:37's `((align := max(sh_addralign, force_section_align)) - len(image) %
# align) % align` -- the ALIGNMENT. `force_section_align` is the default 1 and
# every fixture is gated at four alignments, so the row set is 4 x 9 and a port
# that ignores the argument moves 3 of every 4.
type Img is Data:
  Img{im_len: U32, im_body: String}
def Img.of(n: U32, body: String) -> Img: Img{n, body}
def Img.len(+i: Img) -> U32:
  match i:
    case Img{im_len, im_body}: im_len
def Img.body(+i: Img) -> String:
  match i:
    case Img{im_len, im_body}: im_body
def Img.empty() -> Img: Img.of(0, "")
def Img.append(+i: Img, +c: String) -> Img: Img.of(Blob.nbytes(c), String.concat([Img.body(i), c]))
def Img.pad0(+i: Img) -> Img: i
# `b'\0' * n`, which is `n` NUL BYTES -- on a hex String that is `"00"`
# repeated, and `n` hex PAIRS, so `String.repeat` takes a `Nat` length and the
# count is `2*n`. Getting the factor of two wrong here is a silent image-length
# error that a COUNT row would catch but a "the image is non-empty" row would not.
def Img.padn(+i: Img, +n: U32) -> Img:
  Img.of(U32.add(Img.len(i), n),
         String.concat([Img.body(i), String.repeat("00", U32.to_nat(U32.mul(n, 2)))]))

# elf.py:33's `max([...] + [0])`, as a fold over the PROGBITS that are NOT at
# address 0. `+ [0]` is the empty case and it is why the answer is a U32 and not
# a `Maybe`.
def Sec.prealloc.end(+s: Shdr) -> U32: U32.add(W64.as_idx(Shdr.addr(s)), W64.as_idx(Shdr.size_(s)))
def Sec.prealloc.step(+s: ElfSection, +acc: U32) -> U32:
  Bool.pick(U32, U32.is_zero(W64.as_idx(Shdr.addr(ElfSection.header(s)))), acc,
            Sec.prealloc.end(ElfSection.header(s)))
def Sec.is_progbits(+s: ElfSection) -> Bool: U32.is_eq(Sec.typ(s), SHT_PROGBITS())
def Sec.at_zero(+s: ElfSection) -> Bool: U32.is_zero(W64.as_idx(Shdr.addr(ElfSection.header(s))))
def Sec.prealloc.step2(+s: ElfSection, +acc: U32) -> U32:
  Bool.pick(U32, Sec.is_progbits(s), Sec.prealloc.step(s, acc), acc)
def Sec.prealloc.go2(xs: List<&2, ElfSection>, +acc: U32) -> U32:
  match xs:
    case Nil{}: acc
    case +h <> t: Sec.prealloc.go2(t, Sec.prealloc.step2(h, acc))
def Sec.prealloc_of(+xs: List<&2, ElfSection>) -> U32: Sec.prealloc.go2(xs, 0)

# elf.py:37's alignment arithmetic, as three defs because `Bool.pick` evaluates
# BOTH arms and `max(addralign, force)` must not read `addralign` twice.
def Img.maxalign(+a: U32, +f: U32) -> U32: Bool.pick(U32, U32.is_lt(a, f), f, a)
def Img.pad(+i: U32, +align: U32) -> U32: U32.mod(U32.sub(align, U32.mod(i, align)), align)
def Img.pad_at(+align: U32, at: U32) -> U32: Img.pad(at, align)
def Img.place(+i: Img, +align: U32) -> U32: Img.pad_at(align, Img.len(i))
def Img.append_pad(+i: Img, +c: String, +align: U32) -> Img:
  Img.append(Img.padn(i, Img.place(i, align)), c)
def Img.grow(+i: Img, +c: String) -> Img: Img.append(i, c)
def Sec.align_of(+s: ElfSection, +force: U32) -> U32:
  Img.maxalign(W64.as_idx(Shdr.addralign(ElfSection.header(s))), force)

# ===========================================================================
# relocate, elf.py:56-81. THE TEN ARMS OF THE `match r_type`.
#
# `relocate` is a CLOSURE over `image` and is therefore unreachable from outside,
# so its arms are gated through `jit_loader` -- the only thing that calls it --
# on a REAL ELF64 object file, with the relocation TYPE the real code sees being
# the one thing the fixture sets. `.agents/slop/elf_reloc_probe.py` does that and
# measured all ten arms distinct; `elf_reloc_*` rows carry the words.
#
# THE TWO ARMS THAT WRITE INTO `image` ARE THE TRAMPOLINES, and they are the ones
# this port can gate DIRECTLY, because they are `struct.pack` of literal bytes:
#   x86-64 PLT32 out of range: `struct.pack("<HIQ", 0x25FF, 0, tgt-addend)` -- the
#     `JMP [RIP+0] .quad target` trampoline, 14 bytes.
#   AArch64 CALL26 out of range: `struct.pack("<IIQ", 0x58000051, 0xD61F0220,
#     tgt)` -- the `LDR x17, 8 ; BR x17` trampoline, 16 bytes.
# Both LENGTHS are load-bearing (`len(image)-14` and `len(image)-16`) so
# `elf_tr_*_len` is a row beside the bytes.
# ===========================================================================
def R_X86_64_PC32() -> U32: 2
def R_X86_64_PLT32() -> U32: 4
def R_AARCH64_ADR_PREL_PG_HI21() -> U32: 275
def R_AARCH64_ADD_ABS_LO12_NC() -> U32: 277
def R_AARCH64_LDST16_ABS_LO12_NC() -> U32: 284
def R_AARCH64_LDST32_ABS_LO12_NC() -> U32: 285
def R_AARCH64_LDST64_ABS_LO12_NC() -> U32: 286
def R_AARCH64_LDST128_ABS_LO12_NC() -> U32: 299
def R_AARCH64_CALL26() -> U32: 283

# THE TWO TRAMPOLINES, as the hex of the bytes they write.
def Tramp.x86.at(a: String, b: String, c: String) -> String: String.concat([a, b, c])
def Tramp.x86(tgt: U32) -> String: Tramp.x86.at(Hex.of(16639), Hex.of(0), Hex.of(tgt))
def Tramp.arm.at(a: String, b: String, c: String) -> String: String.concat([a, b, c])
def Tramp.arm(tgt: U32) -> String: Tramp.arm.at(Hex.of(1477003857), Hex.of(3592310304), Hex.of(tgt))
def Tramp.x86_len() -> U32: 14
def Tramp.arm_len() -> U32: 16
# `len(image) - 14 + addend - ploc` and `len(image) - ploc - 16`: the return value
# is a rel32, so both are SUBTRACTIONS of a length that just grew. The rows
# `elf_tr_*_ret` carry them at three lengths so the `-14` / `-16` cannot be
# transposed against the trampoline they belong to.
def Tramp.x86_ret(len_image: U32, addend: U32, ploc: U32) -> U32:
  U32.sub(U32.add(U32.sub(len_image, Tramp.x86_len()), addend), ploc)
def Tramp.arm_ret(len_image: U32, ploc: U32) -> U32:
  U32.sub(U32.sub(len_image, Tramp.arm_len()), ploc)

# THE RANGE TESTS. `rel32_in` and `call26_in` are DIFFERENT predicates over the
# same inputs and the rows carry both at the boundary values, so a port that used
# one for the other is visible.
def Reloc.rel32_in(neg: Bool, v: U32) -> Bool: Bool.and(neg, U32.is_lt(v, 2147483648))
def Reloc.call26_in(neg: Bool, v: U32) -> Bool: Bool.and(neg, U32.is_le(v, 134217724))
# `-2**31 <= tgt-ploc < 2**31`, as a `neg` flag and a magnitude. `i2u(32, v)` is
# `v if v >= 0 else (1<<32)+v`, so the encoding is the magnitude plus 2**32.
def Reloc.i2u(neg: Bool, v: U32) -> U32: H.i2u(neg, 32n, v)
# The ADRP pair: `getbits(rel_pg, 12, 13) << 29` and `getbits(rel_pg, 14, 32) << 5`.
# `U32.shl` IS A ONE-BIT SHIFT and `U32.shln(a, n)` is the n-BIT ONE, so every
# shift AMOUNT here is a `Nat` literal. Getting that wrong writes one bit instead
# of twenty-nine and the row `elf_adr_*` shows a number in the wrong bit.
def Reloc.adr_hi(rel_pg: U32) -> U32: U32.shln(H.getbits(rel_pg, 12n, 13n), 29n)
def Reloc.adr_lo(rel_pg: U32) -> U32: U32.shln(H.getbits(rel_pg, 14n, 32n), 5n)
def Reloc.page(neg: Bool, v: U32) -> U32: H.i2u(neg, 32n, U32.and(v, 4294963200))
def Reloc.call26_getbits(v: U32) -> U32: H.getbits(v, 2n, 27n)
def Reloc.lo12(tgt: U32, start: Nat, end: Nat) -> U32:
  U32.shln(H.getbits(tgt, start, end), 10n)

# ===========================================================================
# THE GATE.
#
# Every `py=` in the table below is a value CALLed out of tinygrad's own
# `elf_loader` / `jit_loader` / `link_sym` on one of the nine fixtures by
# `.agents/slop/elf_oracle.py`, or a constant measured out of
# `tinygrad/runtime/autogen/libc.py` by the same script. NONE is transcribed. The
# harness `.agents/slop/elfmutate.py` diffs whole `name=value` LINES, not row
# names -- a name-comparing harness reported 0 for all 30 mutations in one unit
# and 0 for all 68 in another.
#
# THE ORACLE'S OWN EXIT PATH IS CHECKED, because an oracle that emits 0 rows and
# exits 1 while the gate prints 432 green rows is not a passing gate: breaking its
# import deliberately gives `EXIT=1 ROWS=0`, recorded in REPORT.md.
#
# THE ROW KIND IS CHOSEN PER CLAIM, AND THE CHOICE IS THE POINT:
#   * FIELD ORDER is a STRING (`F_SHDR`, `F_SYM64`, `F_SYM32` and the per-section
#     `*_hdrtxt` / `*_sym0` rows that spell `name@byteoffset:value`). A COUNT CANNOT
#     SEE A TRANSPOSITION and `struct_libusb_transfer` shipped one -- and so did
#     this port, twice, before the string rows existed.
#   * A FIELD VALUE is that same string, so a wrong OFFSET moves it and a wrong
#     COUNT does not.
#   * The IMAGE is its length AND its per-section addresses AND the padding
#     arithmetic, because a length alone cannot see a byte moved within it.
#   * A REFUSAL is a STRING naming the refusal, not a Bool.
#   * The LINK table is a per-symbol PER-LIBRARY string, so a missing libobjc and
#     a present libSystem are different answers and neither is a count.
# ===========================================================================
def row(nm: String, v: String) -> IO(Unit): IO.print(String.concat([nm, "=", v]))
def urow(nm: String, v: U32) -> IO(Unit): row(nm, U32.show(v))
def brow(nm: String, v: Bool) -> IO(Unit): row(nm, Bool.show(v))

# --- list of element as one comma-joined row.
#
# `List.map` is NOT USABLE: it takes a CLOSURE (`~f`) and the standing rule is
# that closures are avoided (`+` cannot be spelled in a closure TYPE). The walks
# are hand-written on the ONE idiom in this file -- `JName.reprs.go`
# (engine/jit.bend:348) is the template: APPEND the rendered cell onto `acc` with
# `[f(h)]`, descend the tail, return `acc` unreversed. Nothing here reverses,
# because these rows do not carry order; the rows that DO carry order are the
# `Sections` walks, which prepend and reverse once.
def Sec.nm.go(xs: List<&2, ElfSection>, +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: acc
    case +h <> t: Sec.nm.go(t, List.append(&2, String, acc, [ElfSection.name(h)]))
def Sec.names(+xs: List<&2, ElfSection>) -> String:
  String.join(List.reverse(&2, String, Sec.nm.go(xs, Nil{})), ",")

# THE Shdr FIELD ROWS, in INDEX ORDER, each all ten fields at its spec offset.
def Sec.hd.go(xs: List<&2, ElfSection>, +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: acc
    case +h <> t: Sec.hd.go(t, List.append(&2, String, acc,
      [Shdr.at_text(ElfSection.header(h))]))
def Sec.hd_text(+xs: List<&2, ElfSection>) -> String:
  String.join(List.reverse(&2, String, Sec.hd.go(xs, Nil{})), ";")

# ONE U32 COLUMN OF THE WHOLE TABLE, IN ORDER -- ONE WALK PER COLUMN.
#
# FIVE COLUMNS FIVE WALKS, NOT ONE WALK WITH A COLUMN PICKER, and the reason is
# measured three times over:
#   * a `Shdr` read by five readers in ONE body  -> "consumed more than once"
#   * a `U32` read by two `Bool.pick` TESTS      -> "consumed more than once"
#   * a `Cols` record read by four readers       -> "consumed more than once"
# So a column picker -- however it is spelled, `Col{which}`, `Cols{...}`, or nested
# picks -- needs the section FIVE times in one call chain and no shape avoids it.
# Five walks, each reading the section once, is the SAME number of reader calls.
def Sec.col.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.col.go(t, List.append(&2, U32, acc, [Shdr.name(ElfSection.header(h))]))
def Sec.col.name(+xs: List<&2, ElfSection>) -> String: justr(Sec.col.go(xs, Nil{}))
def Sec.col.typ.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.col.typ.go(t, List.append(&2, U32, acc, [Shdr.type(ElfSection.header(h))]))
def Sec.col.typ(+xs: List<&2, ElfSection>) -> String: justr(Sec.col.typ.go(xs, Nil{}))
def Sec.col.flags.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.col.flags.go(t, List.append(&2, U32, acc,
      [Shdr.flags(ElfSection.header(h))]))
def Sec.col.flags(+xs: List<&2, ElfSection>) -> String: justr(Sec.col.flags.go(xs, Nil{}))
def Sec.col.link.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.col.link.go(t, List.append(&2, U32, acc, [Shdr.link(ElfSection.header(h))]))
def Sec.col.link(+xs: List<&2, ElfSection>) -> String: justr(Sec.col.link.go(xs, Nil{}))
def Sec.col.info.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.col.info.go(t, List.append(&2, U32, acc, [Shdr.info(ElfSection.header(h))]))
def Sec.col.info(+xs: List<&2, ElfSection>) -> String: justr(Sec.col.info.go(xs, Nil{}))

# THE 64-BIT COLUMNS AS `hi:lo` STRINGS, so a port that SWAPPED the halves
# disagrees instead of producing a plausible address. ONE walk per column and the
# string is built by the reader, which is why there are no separate `hi`/`lo`
# columns: `W64.text` is the only place the order of the halves is written down.
type Wc is Data:
  Wc{wc: U32}
def Wc.of(k: U32) -> Wc: Wc{k}
def Wc.k(+w: Wc) -> U32:
  match w:
    case Wc{wc}: wc
# `W64.text` is the ONLY place the order of the halves is written down, so this is
# the only place a swap is possible -- and it is why there are no separate hi/lo
# columns to keep in step.
def Wc.text(+w: Wc, +s: Shdr) -> String:
  Bool.pick(String, U32.is_eq(Wc.k(w), 0), W64.text(Shdr.addr(s)),
    Bool.pick(String, U32.is_eq(Wc.k(w), 1), W64.text(Shdr.offset(s)),
      Bool.pick(String, U32.is_eq(Wc.k(w), 2), W64.text(Shdr.size_(s)),
        W64.text(Shdr.entsize(s)))))
def Sec.colw.one(+s: Shdr, +w: Wc) -> String: Wc.text(w, s)
def Sec.colw.go(f: List<&2, ElfSection>, +w: Wc,
                +acc: List<&2, String>) -> List<&2, String>:
  match f:
    case Nil{}: List.reverse(&2, String, acc)
    case +h <> t: Sec.colw.go(t, w, List.append(&2, String, acc,
      [Sec.colw.one(ElfSection.header(h), w)]))
def Sec.col.addr(+xs: List<&2, ElfSection>) -> String:
  String.join(Sec.colw.go(xs, Wc.of(0), Nil{}), ",")
def Sec.col.off(+xs: List<&2, ElfSection>) -> String:
  String.join(Sec.colw.go(xs, Wc.of(1), Nil{}), ",")
def Sec.col.size(+xs: List<&2, ElfSection>) -> String:
  String.join(Sec.colw.go(xs, Wc.of(2), Nil{}), ",")
def Sec.col.ent(+xs: List<&2, ElfSection>) -> String:
  String.join(Sec.colw.go(xs, Wc.of(3), Nil{}), ",")

# THE CONTENT WALKS. `Blob.hexlen` of each slice is the byte count, and the
# LEADING BYTES are the hex, so a slice at the wrong offset or of the wrong length
# is a disagreement and not a length.
def Sec.content_len(+s: ElfSection) -> U32: U32.div(Blob.hexlen(ElfSection.content(s)), 2)
def Sec.len.go(f: List<&2, ElfSection>, +acc: List<&2, U32>) -> List<&2, U32>:
  match f:
    case Nil{}: List.reverse(&2, U32, acc)
    case +h <> t: Sec.len.go(t, List.append(&2, U32, acc, [Sec.content_len(h)]))
def Sec.lens(+xs: List<&2, ElfSection>) -> String: justr(Sec.len.go(xs, Nil{}))
def Sec.content_hex(+s: ElfSection) -> String: String.take(ElfSection.content(s), 16n)

# `_strtab` over the WHOLE table: every section's name, out of the real
# shstrtab, in INDEX order. This is the walk that makes the NUL fold gateable on
# REAL bytes -- a shstrtab whose NUL lands one byte off yields a name with one
# character too many, and `elf_str_*_names` shows it while no count would.
def Str.nm.go(xs: List<&2, Shdr>, +sstr: String, +acc: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}: acc
    case +k <> t: Str.nm.go(t, sstr, List.append(&2, String, acc, [Str.tab(sstr, 0, Shdr.name(k))]))
def Str.names(+xs: List<&2, Shdr>, +sstr: String) -> String:
  String.join(List.reverse(&2, String, Str.nm.go(xs, sstr, Nil{})), ",")
