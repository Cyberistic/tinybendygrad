# ===========================================================================
# THE STRING TABLE. `usb.py` has twenty-one user-visible strings and every one
# of them is either a LITERAL or an f-string whose literal parts are load-bearing.
# They are diffed AS STRINGS, not as a boolean about a string, because
# `String.concat` drops a literal silently and a row that said "the message is
# not empty" would stay green with the prefix removed.
#
# FOUR of them cannot be rendered here and are named as the seam: `{address:#x}`
# and `{ltssm:02X}` need hex (Bend 2.0.34 has `U32.show` and no radix), and
# `libusb_strerror` is a C call whose return is the message's tail.
#     TODO(p3) tinygrad/runtime/support/usb.py:16   `libusb_strerror(rc)`.
#     TODO(p3) tinygrad/runtime/support/usb.py:102  `0x{ltssm:02X}`.
#     TODO(p3) tinygrad/runtime/support/usb.py:129  `address={address:#x}`.
#     TODO(p3) tinygrad/runtime/support/usb.py:133  `f'Reserved (0b{cpl_status:03b})'`.
# ===========================================================================

def MSG_BULK_OUT() -> String: "bulk OUT 0x02 failed"
def MSG_BULK_IN() -> String: "bulk IN 0x81 failed"
def MSG_SHORT_WRITE() -> String: "bulk OUT short write: "
def MSG_BYTES() -> String: " bytes"
def MSG_TLP_RETRIES() -> String: "TLP error after retries: ret_status="
def MSG_TLP_CPL() -> String: "TLP completion status: "
def MSG_CPL_UNSUP() -> String: "Unsupported Request: "
def MSG_CPL_ABORT() -> String: "Completer Abort"
def MSG_CPL_RETRY() -> String: "Config Retry"
def MSG_CPL_RESERVED() -> String: "Reserved (0b"
def MSG_LTSSM() -> String: "PCIe link not up (LTSSM=0x"
def MSG_LTSSM_TAIL() -> String: "), custom firmware not ready"
def MSG_INVALID_SIZE() -> String: "Invalid size "
def MSG_ALIGNED_SIZE_W() -> String: "pcie_mem_write requires 4-byte aligned size, got "
def MSG_ALIGNED_SIZE_R() -> String: "pcie_mem_read requires 4-byte aligned size, got "
def MSG_ALIGNED_ACCESS_R() -> String: "pcie_mem_read requires 4-byte aligned access, got off="
def MSG_ALIGNED_ACCESS_W() -> String: "pcie_mem_write requires 4-byte aligned access, got off="
def MSG_SZ() -> String: ", sz="
def MSG_CHECKED() -> String: ": "
def PRODUCT_OK() -> String: "custom"
def PRODUCT_OK2() -> String: "AS2462"

# :52 `assert self.product.startswith("custom") or self.product.startswith("AS2462")`
def product_ok(+product: String) -> Bool:
  Bool.or(String.starts_with(product, PRODUCT_OK()), String.starts_with(product, PRODUCT_OK2()))

# :132 the status map. `status_map.get(cpl_status, f'Reserved (0b{cpl_status:03b})')`
# -- so 0b001, 0b010 and 0b100 have names and EVERYTHING else is Reserved. It is a
# DICT with three keys, so 0 and 5 are Reserved and not an error, and the keys are
# declared in the order 1, 4, 2.
def CPL_UNSUP() -> U32: 1     # 0b001
def CPL_RETRY() -> U32: 2     # 0b010
def CPL_ABORT() -> U32: 4     # 0b100

# `case _:` does not close a `Nat` match in Bend 2.0.34, so the three keys are an
# OR of EQUALITIES and the fallback is the default argument of the OR -- which is
# also the shape `status_map.get(cpl_status, ...)` has.
def cpl_name(+cpl_status: U32) -> String:
  Bool.pick(String, U32.is_eq(cpl_status, CPL_ABORT()), MSG_CPL_ABORT(),
    Bool.pick(String, U32.is_eq(cpl_status, CPL_RETRY()), MSG_CPL_RETRY(),
      Bool.pick(String, U32.is_eq(cpl_status, CPL_UNSUP()), MSG_CPL_UNSUP(), MSG_CPL_RESERVED())))

def cpl_named(+cpl_status: U32) -> Bool:
  Bool.or(U32.is_eq(cpl_status, CPL_UNSUP()),
          Bool.or(U32.is_eq(cpl_status, CPL_RETRY()), U32.is_eq(cpl_status, CPL_ABORT())))

# ===========================================================================
# THE PACKET FORMATS. `send_batch` (:87-92) is the only place `usb.py` packs a
# wire structure, and both formats are `struct.calcsize` calls this port must not
# get wrong by eye: `"<IIIBBB16s"` is 31 bytes and `"<IIIB"` is 13, which is
# exactly the `bulk_read(13)` on the next line. A reader who counts `16s` as four
# more uint32 gets 39.
#
# THE FIELD NAMES ARE THE ROLES the calling code gives them -- `struct.pack` has no
# field names, so this is a reading of `"<IIIBBB16s"` against the seven arguments
# :89 hands it, and the WIDTHS beside each name are `struct.calcsize` of the
# field's own format.
#     :89  0x43425355 "USBC", tag, len(data) or 0, 0, 0, len(cdb), cdb
# ===========================================================================
def CDB_FMT() -> String: "<IIIBBB16s"
def CDB_FIELDS() -> String: "magic tag datalen zero0 zero1 cdblen cdb"
def CDB_WIDTHS() -> String: "4 4 4 1 1 1 16"

# :91 `"<IIIB"` unpacked as `sig, rtag, _, status`, and the `_` is a DISCARDED
# field: read and never used, so its name here is the discard.
def REPLY_FMT() -> String: "<IIIB"
def REPLY_FIELDS() -> String: "sig rtag discard status"
def REPLY_WIDTHS() -> String: "4 4 4 1"

# :92 `assert (sig, rtag, status) == (0x53425355, tag, 0)` -- the two magics are
# 'USBC' out and 'USBS' back, and the reply's STATUS must be zero.
def MAGIC_USBC() -> U32: 1128420181  # 0x43425355
def MAGIC_USBS() -> U32: 1396855637  # 0x53425355

def reply_ok(+sig: U32, +rtag: U32, +status: U32, +tag: U32) -> Bool:
  Bool.and(Bool.and(U32.is_eq(sig, MAGIC_USBS()), U32.is_eq(rtag, tag)),
           U32.is_zero(status))

# :67 / :71 the two request types, and they are the ONLY difference between
# `control_write` and `control_read`: 0x40 is vendor|device|OUT and 0xC0 adds the
# IN bit.
def RTYPE_OUT() -> U32: 64     # 0x40
def RTYPE_IN() -> U32: 192     # 0xC0
def EP_OUT() -> U32: 2         # 0x02, bulk OUT
def EP_IN() -> U32: 129        # 0x81, bulk IN 0x01 | 0x80

def ep_dir(+ep: U32) -> U32: U32.and(ep, 128)

# THE THREE SIZES COME FROM `struct.calcsize`, and they are ROWS rather than
# literals precisely because a reader who counts `"<IIIBBB16s"` by eye gets 37.
# `usb-constsweep.py` confirms all three by calling `struct.calcsize`.
def CDB_SIZE() -> U32: 31
def REPLY_SIZE() -> U32: 13
def REPLY_READ_LEN() -> U32: 13







# THE STRING ROWS. Every literal is DIFFED AS A STRING: a row that said "the
# message is non-empty" would stay green with the prefix removed, and
# `String.concat` drops a literal silently.
#
# ONE FLAT LIST, not a fold over per-fixture GROUPS. A `List<&2, List<&2, String>>`
# is exactly the shape `<>` and `List.concat` want and a LITERAL does not, and
# Bend's parser closes the outer literal on the inner `[`.
def t_strings() -> IO(Unit):
  IO.print(lines_of(
    [
     s1("usb_prod_custom_x", "custom asic"),
     b1("usb_prod_custom_x_custom", String.starts_with("custom asic", "custom")),
     b1("usb_prod_custom_x_as2462", String.starts_with("custom asic", "AS2462")),
     b1("usb_prod_custom_x_either", product_ok("custom asic")),
     s1("usb_prod_as2462_x", "AS2462 fw"),
     b1("usb_prod_as2462_x_custom", String.starts_with("AS2462 fw", "custom")),
     b1("usb_prod_as2462_x_as2462", String.starts_with("AS2462 fw", "AS2462")),
     b1("usb_prod_as2462_x_either", product_ok("AS2462 fw")),
     s1("usb_prod_lower_x", "Custom asic"),
     b1("usb_prod_lower_x_custom", String.starts_with("Custom asic", "custom")),
     b1("usb_prod_lower_x_as2462", String.starts_with("Custom asic", "AS2462")),
     b1("usb_prod_lower_x_either", product_ok("Custom asic")),
     s1("usb_prod_none_x", "Acme Rocket"),
     b1("usb_prod_none_x_custom", String.starts_with("Acme Rocket", "custom")),
     b1("usb_prod_none_x_as2462", String.starts_with("Acme Rocket", "AS2462")),
     b1("usb_prod_none_x_either", product_ok("Acme Rocket")),
     s1("usb_prod_empty_x", ""),
     b1("usb_prod_empty_x_custom", String.starts_with("", "custom")),
     b1("usb_prod_empty_x_as2462", String.starts_with("", "AS2462")),
     b1("usb_prod_empty_x_either", product_ok("")),
     u1("usb_cpl_0_unsup", Bool.to_u32(U32.is_eq(0, CPL_UNSUP()))),
     u1("usb_cpl_0_retry", Bool.to_u32(U32.is_eq(0, CPL_RETRY()))),
     u1("usb_cpl_0_abort", Bool.to_u32(U32.is_eq(0, CPL_ABORT()))),
     b1("usb_cpl_0_named", cpl_named(0)),
     s1("usb_cpl_0_name", cpl_name(0)),
     u1("usb_cpl_1_unsup", Bool.to_u32(U32.is_eq(1, CPL_UNSUP()))),
     u1("usb_cpl_1_retry", Bool.to_u32(U32.is_eq(1, CPL_RETRY()))),
     u1("usb_cpl_1_abort", Bool.to_u32(U32.is_eq(1, CPL_ABORT()))),
     b1("usb_cpl_1_named", cpl_named(1)),
     s1("usb_cpl_1_name", cpl_name(1)),
     u1("usb_cpl_2_unsup", Bool.to_u32(U32.is_eq(2, CPL_UNSUP()))),
     u1("usb_cpl_2_retry", Bool.to_u32(U32.is_eq(2, CPL_RETRY()))),
     u1("usb_cpl_2_abort", Bool.to_u32(U32.is_eq(2, CPL_ABORT()))),
     b1("usb_cpl_2_named", cpl_named(2)),
     s1("usb_cpl_2_name", cpl_name(2)),
     u1("usb_cpl_3_unsup", Bool.to_u32(U32.is_eq(3, CPL_UNSUP()))),
     u1("usb_cpl_3_retry", Bool.to_u32(U32.is_eq(3, CPL_RETRY()))),
     u1("usb_cpl_3_abort", Bool.to_u32(U32.is_eq(3, CPL_ABORT()))),
     b1("usb_cpl_3_named", cpl_named(3)),
     s1("usb_cpl_3_name", cpl_name(3)),
     u1("usb_cpl_4_unsup", Bool.to_u32(U32.is_eq(4, CPL_UNSUP()))),
     u1("usb_cpl_4_retry", Bool.to_u32(U32.is_eq(4, CPL_RETRY()))),
     u1("usb_cpl_4_abort", Bool.to_u32(U32.is_eq(4, CPL_ABORT()))),
     b1("usb_cpl_4_named", cpl_named(4)),
     s1("usb_cpl_4_name", cpl_name(4)),
     u1("usb_cpl_5_unsup", Bool.to_u32(U32.is_eq(5, CPL_UNSUP()))),
     u1("usb_cpl_5_retry", Bool.to_u32(U32.is_eq(5, CPL_RETRY()))),
     u1("usb_cpl_5_abort", Bool.to_u32(U32.is_eq(5, CPL_ABORT()))),
     b1("usb_cpl_5_named", cpl_named(5)),
     s1("usb_cpl_5_name", cpl_name(5)),
     u1("usb_cpl_6_unsup", Bool.to_u32(U32.is_eq(6, CPL_UNSUP()))),
     u1("usb_cpl_6_retry", Bool.to_u32(U32.is_eq(6, CPL_RETRY()))),
     u1("usb_cpl_6_abort", Bool.to_u32(U32.is_eq(6, CPL_ABORT()))),
     b1("usb_cpl_6_named", cpl_named(6)),
     s1("usb_cpl_6_name", cpl_name(6)),
     u1("usb_cpl_7_unsup", Bool.to_u32(U32.is_eq(7, CPL_UNSUP()))),
     u1("usb_cpl_7_retry", Bool.to_u32(U32.is_eq(7, CPL_RETRY()))),
     u1("usb_cpl_7_abort", Bool.to_u32(U32.is_eq(7, CPL_ABORT()))),
     b1("usb_cpl_7_named", cpl_named(7)),
     s1("usb_cpl_7_name", cpl_name(7)),
     s1("usb_msg_bulk_out", MSG_BULK_OUT()),
     s1("usb_msg_bulk_in", MSG_BULK_IN()),
     s1("usb_msg_short_write", MSG_SHORT_WRITE()),
     s1("usb_msg_bytes", MSG_BYTES()),
     s1("usb_msg_tlp_retries", MSG_TLP_RETRIES()),
     s1("usb_msg_tlp_cpl", MSG_TLP_CPL()),
     s1("usb_msg_cpl_unsup", MSG_CPL_UNSUP()),
     s1("usb_msg_cpl_abort", MSG_CPL_ABORT()),
     s1("usb_msg_cpl_retry", MSG_CPL_RETRY()),
     s1("usb_msg_cpl_reserved", MSG_CPL_RESERVED()),
     s1("usb_msg_ltssm", MSG_LTSSM()),
     s1("usb_msg_ltssm_tail", MSG_LTSSM_TAIL()),
     s1("usb_msg_invalid_size", MSG_INVALID_SIZE()),
     s1("usb_msg_aligned_size_w", MSG_ALIGNED_SIZE_W()),
     s1("usb_msg_aligned_size_r", MSG_ALIGNED_SIZE_R()),
     s1("usb_msg_aligned_access_r", MSG_ALIGNED_ACCESS_R()),
     s1("usb_msg_aligned_access_w", MSG_ALIGNED_ACCESS_W()),
     s1("usb_msg_sz", MSG_SZ()),
     s1("usb_msg_checked", MSG_CHECKED()),
     s1("usb_product_ok", PRODUCT_OK()),
     s1("usb_product_ok2", PRODUCT_OK2())]))

def t_packets() -> IO(Unit):
  IO.print(lines_of(
    [s1("usb_cdb_fmt", CDB_FMT()),
     s1("usb_cdb_fields", CDB_FIELDS()),
     s1("usb_cdb_widths", CDB_WIDTHS()),
     u1("usb_cdb_size", CDB_SIZE()),
     s1("usb_reply_fmt", REPLY_FMT()),
     s1("usb_reply_fields", REPLY_FIELDS()),
     s1("usb_reply_widths", REPLY_WIDTHS()),
     u1("usb_reply_size", REPLY_SIZE()),
     u1("usb_reply_read_len", REPLY_READ_LEN()),
     b1("usb_reply_ok_exact", reply_ok(MAGIC_USBS(), 7, 0, 7)),
     b1("usb_reply_ok_wrong_tag", reply_ok(MAGIC_USBS(), 8, 0, 7)),
     b1("usb_reply_ok_nonzero_status", reply_ok(MAGIC_USBS(), 7, 1, 7)),
     b1("usb_reply_ok_wrong_sig", reply_ok(MAGIC_USBC(), 7, 0, 7)),
     b1("usb_reply_ok_all_wrong", reply_ok(0, 0, 1, 9)),
     u1("usb_cdb_packed_len", CDB_SIZE()),
     u1("usb_magic_usbc", MAGIC_USBC()),
     u1("usb_magic_usbs", MAGIC_USBS()),
     u1("usb_reply_unpacked_sig", MAGIC_USBS()),
     u1("usb_reply_unpacked_rtag", 7),
     u1("usb_reply_unpacked_status", 0),
     u1("usb_rtype_out", RTYPE_OUT()),
     u1("usb_rtype_in", RTYPE_IN()),
     u1("usb_ep_out", EP_OUT()),
     u1("usb_ep_in", EP_IN()),
     u1("usb_ep_out_dir", ep_dir(EP_OUT())),
     u1("usb_ep_in_dir", ep_dir(EP_IN())),
     u1("usb_ep_in_is_libusb_endpoint_in",
        Bool.to_u32(U32.is_eq(ep_dir(EP_IN()), enum_val("LIBUSB_ENDPOINT_IN", E_EPDIR())))),
     u1("usb_rtype_in_is_out_or_direction",
        Bool.to_u32(U32.is_eq(U32.or(RTYPE_OUT(), ep_dir(EP_IN())), RTYPE_IN()))),
     u1("usb3_string_buf", USB3_STRING_BUF()),
     u1("usb3_iface", USB3_IFACE()),
     u1("usb3_alt", USB3_ALT()),
     u1("usb3_config", USB3_CONFIG()),
     u1("usb3_log_level_debug", USB3_LOG_LEVEL_DEBUG())]))
# ===========================================================================
# THE TRACE. Every libusb / libc / ctypes binding in `usb.py` is ONE
# `Call{k, a, b, c}` entry in `Tr` and nothing else, so no foreign effect is
# declared and `--check-only` stays green in both lanes. `SYMS()` maps each `k`
# back to the C symbol, which is what keeps the seam greppable: `grep -n
# libusb_ this_file` finds the symbol as a LITERAL, not inside an opaque body.
#
# `a`, `b`, `c` are the call's arguments that are ARITHMETIC -- an endpoint, a
# wValue, a byte count, a request type. A call whose arguments are all POINTERS
# (`libusb_open(dev, handle)`, `libusb_alloc_transfer(0)`) records zeros, and that
# is not a gap in the port: the pointer is the SEAM's.
# ===========================================================================

type Call is Data:
  Call{k: U32, a: U32, b: U32, c: U32}

def Call.k(x: Call) -> U32:
  match x:
    case Call{k, a, b, c}: k

def Call.a(x: Call) -> U32:
  match x:
    case Call{k, a, b, c}: a

def Call.b(x: Call) -> U32:
  match x:
    case Call{k, a, b, c}: b

def Call.c(x: Call) -> U32:
  match x:
    case Call{k, a, b, c}: c

# THE SEAM'S INVENTORY, AS A LIST. It is a list and not a `match` ladder because
# Bend's `match` over a `Nat` needs a `case 1n+m:` arm to be total, and twenty-four
# symbol names are twenty-four lines of noise where a list is one.
def SYMS() -> List<&2, String>:
  ["libusb_init", "libusb_set_option", "libusb_get_device_list",
   "libusb_get_device_descriptor", "libusb_ref_device", "libusb_get_bus_number",
   "libusb_get_device_address", "libusb_free_device_list", "libusb_open",
   "libusb_get_device", "libusb_get_string_descriptor_ascii",
   "libusb_kernel_driver_active", "libusb_detach_kernel_driver",
   "libusb_reset_device", "libusb_set_configuration", "libusb_claim_interface",
   "libusb_set_interface_alt_setting", "libusb_control_transfer",
   "libusb_bulk_transfer", "libusb_alloc_transfer", "libusb_handle_events_timeout",
   "libusb_submit_transfer", "memcpy", "libusb_strerror"]

# The tail's head. It is here so `M31`'s off-by-one edit COMPILES -- answering
# `head_name(t2, "")`, the NEXT symbol, instead of `h0` -- and it is NOT on the
# live path. It is declared BEFORE `sym_at_head` because Bend refuses a def USED
# before it is written ("an unfilled law is a dead claim"), which is also why
# `sym_at_head` is declared before `sym_at.go`.
def head_name(xs: List<&2, String>, dflt: String) -> String:
  match xs:
    case Nil{}: dflt
    case h <> t: h

# THE HEAD-AT-ZERO ARM IS ITS OWN DEF so `M31`'s off-by-one edit COMPILES, and the
# arm answers `h0`: the head IS the zero-th entry.
def sym_at_head(+h0: String, +t2: List<&2, String>) -> String: h0

# THE KIND -> SYMBOL LOOKUP. `n` IS THE INDEX and the head is the ZERO-th entry.
# The version that matched `1n+m` and returned the head when `m == 0n` was off by
# one, and every order row in the file read as the symbol BELOW the truth --
# exactly the error a count-only gate cannot see and a whole-value row can.
def sym_at.go(n: Nat, ss: List<&2, String>) -> String:
  match n:
    case 0n:
      match ss:
        case Nil{}: "libusb_unknown"
        case h0 <> t2: sym_at_head(h0, t2)
    case 1n+m:
      match ss:
        case Nil{}: "libusb_unknown"
        case h0 <> t2: sym_at.go(m, t2)

def sym_at(+n: Nat, ss: List<&2, String>) -> String: sym_at.go(n, ss)

def call_sym(+k: U32) -> String: sym_at(U32.to_nat(k), SYMS())

def Call.sym(x: Call) -> String: call_sym(Call.k(x))

# THE CALL KINDS. They are PORT-INVENTED -- no line of `usb.py` says "K_INIT is
# 0" -- so what is checkable is the BIJECTION onto `SYMS()`, and `usb-symmap.py`
# checks that plus that every name is a real `autogen.libusb` export.
def K_INIT() -> U32: 0
def K_SET_OPTION() -> U32: 1
def K_GET_DEVLIST() -> U32: 2
def K_GET_DESC() -> U32: 3
def K_REF_DEVICE() -> U32: 4
def K_BUS_NUMBER() -> U32: 5
def K_DEV_ADDRESS() -> U32: 6
def K_FREE_DEVLIST() -> U32: 7
def K_OPEN() -> U32: 8
def K_GET_DEVICE() -> U32: 9
def K_STR_ASCII() -> U32: 10
def K_KDRV_ACTIVE() -> U32: 11
def K_DETACH_KDRV() -> U32: 12
def K_RESET_DEVICE() -> U32: 13
def K_SET_CONFIG() -> U32: 14
def K_CLAIM_IFACE() -> U32: 15
def K_SET_ALT() -> U32: 16
def K_CTRL_XFER() -> U32: 17
def K_BULK_XFER() -> U32: 18
def K_ALLOC_XFER() -> U32: 19
def K_EVENTS() -> U32: 20
def K_SUBMIT_XFER() -> U32: 21
def K_MEMCPY() -> U32: 22
def K_STRERROR() -> U32: 23

type Tr is Data:
  Tr{calls: List<&2, Call>, next: U32, bad_at: U32, seen: U32, refused: Bool}

def Tr.of() -> Tr: Tr{Nil{}, 0, 0, 0, False{}}

def Tr.calls(t: Tr) -> List<&2, Call>:
  match t:
    case Tr{calls, next, bad_at, seen, refused}: calls

def Tr.refused(t: Tr) -> Bool:
  match t:
    case Tr{calls, next, bad_at, seen, refused}: refused

# THE ORDINAL OF THE REFUSAL THAT SHOULD FIRE, so one fixture reaches each raise
# site in turn. 0 = never, which is every successful fixture.
def Tr.fail_at(t: Tr, n: U32) -> Tr:
  match t:
    case Tr{calls, next, bad_at, seen, refused}: Tr{calls, next, n, seen, refused}

# THE RAISE IS IN THE TRACE, so a refusal is a TRUNCATION and no step needs a
# guard of its own. The failing call IS still recorded -- it sets `refused` in the
# same breath, so on entry its own `refused` is still False. Every step goes
# through `Tr.emit.go`, so two steps cannot disagree about the guard.
#
# `Tr.emit` AND `Tr.raise` ARE THE SAME FUNCTION with a different GUARD, and which
# one a step uses IS THE PORTED FACT: `usb.py`'s `checked` (:13-18) raises when the
# return code is negative, so every call wrapped in `checked` is a `Tr.raise` site
# and every RAW call is a `Tr.emit`. A `Tr.emit` CANNOT refuse at all, which is why
# `usb_enum_refused_6_raw_no_fire` is False and the row above it is True.
def Tr.emit.go(+refuse: Bool, +refused: Bool, +k: U32, a: U32, b: U32, c: U32,
               +calls: List<&2, Call>, +next: U32, +bad_at: U32,
               +seen: U32) -> Tr:
  Tr{Bool.pick(List<&2, Call>, refused, calls,
               List.append(&2, Call, calls, [Call{k, a, b, c}])),
     Bool.pick(U32, refused, next, U32.add(next, 1)), bad_at,
     Bool.pick(U32, refused, seen, U32.add(seen, 1)),
     Bool.or(refused, refuse)}

def Tr.emit(+k: U32, a: U32, b: U32, c: U32, t: Tr) -> Tr:
  match t:
    case Tr{calls, next, bad_at, seen, refused}:
      Tr.emit.go(False{}, refused, k, a, b, c, calls, next, bad_at, seen)

# the `bad_at`-th emit raises.
def Tr.raise(+k: U32, a: U32, b: U32, c: U32, t: Tr) -> Tr:
  match t:
    case Tr{calls, next, +bad_at, +seen, +refused}:
      Tr.emit.go(U32.is_eq(U32.add(seen, 1), bad_at), refused, k, a, b, c,
                 calls, next, bad_at, seen)

# THE ORDER, as ONE string of symbol names. A count is not a gate and a set is not
# a gate: this is the call SEQUENCE, and every `usb_*_order_*` row is a
# whole-value string, so a swapped pair of steps moves them and changes nothing
# else.
def Tr.sym.go(n: Nat, cs: List<&2, Call>, acc: String, +sep: String) -> String:
  match n:
    case 0n: acc
    case 1n+m:
      match cs:
        case Nil{}: acc
        case c <> t: Tr.sym.go(m, t, String.append(acc, String.append(Call.sym(c), sep)), sep)

def Tr.sym(+t: Tr) -> String:
  Tr.sym.go(List.length(&2, Call, Tr.calls(t)), Tr.calls(t), "", ",")

def Tr.n(+t: Tr) -> U32: U32.from_nat(List.length(&2, Call, Tr.calls(t)))

# `has` is a real SUBSEQUENCE test -- the fuel is the TRACE length and not the
# pattern length, which is the bug ops_webgpu.bend's gate found in ITSELF.
def Tr.has.step(+c: Call, +w: Call) -> Bool:
  Bool.and(Bool.and(U32.is_eq(Call.k(c), Call.k(w)), U32.is_eq(Call.a(c), Call.a(w))),
           Bool.and(U32.is_eq(Call.b(c), Call.b(w)), U32.is_eq(Call.c(c), Call.c(w))))

def Tr.has.step.at(m: Maybe<&2, Call>, +c: Call, at: Nat) -> Nat:
  match m:
    case None{}: at
    case Some{+w}: Nat.add(at, U32.to_nat(Bool.to_u32(Tr.has.step(c, w))))

def Tr.has.go(n: Nat, +patlen: Nat, cs: List<&2, Call>, +pat: List<&2, Call>,
              +at: Nat) -> Bool:
  match n:
    case 0n: Nat.is_eq(at, patlen)
    case 1n+m:
      match cs:
        case Nil{}: Nat.is_eq(at, patlen)
        case c <> t: Tr.has.go(m, patlen, t, pat,
                               Tr.has.step.at(List.get(&2, Call, pat, at), c, at))

def Tr.has(+cs: List<&2, Call>, +pat: List<&2, Call>) -> Bool:
  Tr.has.go(List.length(&2, Call, cs), List.length(&2, Call, pat), cs, pat, 0n)

# ===========================================================================
# THE ENUMERATION. `USB3.list_devices` (:30-37) is ONE loop and it is the wall
# ops_amd.bend records as `TODO(p3) runtime/ops_amd.py:812  USB3.list_devices`.
#
# THE SELECTION IS A PURE PREDICATE and the trace is the walk: the port compares
# `(idVendor, idProduct) == (vendor, dev)` from the descriptor fields it has
# already parsed BY NAME, and only appends REF_DEVICE + BUS_NUMBER +
# DEV_ADDRESS on a match. `usb_list_match` is that predicate and `usb_enum_order_*`
# is the walk, so the negative case -- a descriptor whose ids do not pair -- is one
# row from its positive.
# ===========================================================================

def list_match(+idVendor: U32, +idProduct: U32, +vendor: U32, +dev: U32) -> Bool:
  Bool.and(U32.is_eq(idVendor, vendor), U32.is_eq(idProduct, dev))

# :35 the label, `f"usb:{bus}-{addr}"`. A STRING TABLE, so it is diffed as a
# string: `String.concat` drops a literal silently and a boolean about a string
# cannot see that happen.
def list_label(+bus: U32, +addr: U32) -> String:
  String.concat(["usb:", U32.show(bus), "-", U32.show(addr)])

# THE DESCRIPTOR IS READ FIRST AND THE SELECTION IS SECOND (:33 then :34), and the
# emit chain records the INNERMOST call first. A MISS STILL READS IT: the read is
# unconditional and only the ref/bus/address triple is conditional, so a miss is
# FOUR calls shorter than a hit and not three.
#
# And the `Tr.emit` vs `Tr.raise` split inside is the ported `checked` fact:
# `libusb_ref_device` (:35) is RAW and cannot refuse; the descriptor read (:33) is
# `checked` and can. `usb_enum_refused_5_fires` and `usb_enum_refused_6_raw_no_fire`
# are one row apart and say so.
def usb_enum.device(+hit: Bool, +bus: U32, +addr: U32, +t: Tr) -> Tr:
  Bool.pick(Tr, hit,
    Tr.raise(K_DEV_ADDRESS(), addr, 0, 0,
      Tr.raise(K_BUS_NUMBER(), bus, 0, 0,
        Tr.emit(K_REF_DEVICE(), 0, 0, 0, Tr.raise(K_GET_DESC(), 0, 0, 0, t)))),
    Tr.raise(K_GET_DESC(), 0, 0, 0, t))

# THE FUEL IS THE DEVICE COUNT and there is no device LIST, because
# `libusb_get_device_list` hands back a POINTER to a C array: the seam's. The
# first version destructured an always-empty list and so emitted ONE device
# whatever `n` said.
def usb_enum.walk(n: Nat, +hit: Bool, +bus: U32, +addr: U32, +t: Tr) -> Tr:
  match n:
    case 0n: t
    case 1n+m: usb_enum.walk(m, hit, bus, addr, usb_enum.device(hit, bus, addr, t))

# :32 GET_DEVICE_LIST, the walk, then :36 `libusb_free_device_list(devs, 1)`. THE
# FREE IS LAST and it is NOT conditional, and it is a RAW call so it cannot
# refuse -- which is why `usb_enum_refused_6_raw_no_fire` is False.
def usb_enum(n: Nat, +hit: Bool, +bus: U32, +addr: U32, t: Tr) -> Tr:
  Tr.emit(K_FREE_DEVLIST(), 1, 0, 0,
    usb_enum.walk(n, hit, bus, addr, Tr.raise(K_GET_DEVLIST(), 0, 0, 0, t)))

# ===========================================================================
# THE OPEN. `USB3.__init__` (:39-62). `ops_disk.bend` records `_might_open` as a
# WALK OF STATE THAT ENDS IN A CLAIM; this is the same shape, and it is the one
# ops_amd.bend could not reach.
#
# `libusb_get_device` (:49) is RAW and the three calls around it are `checked`, so
# the two kinds interleave. The product assert (:52) is NOT a raise site -- it is
# an `assert` after a successful read -- so it is modelled by refusing AT the read
# and letting `usb_open` take the `have_product` branch.
def usb_open.after(have_product: Bool, +t: Tr) -> Tr:
  Tr.raise(K_STR_ASCII(), USB3_STRING_BUF(), 0, 0,
    Tr.raise(K_GET_DESC(), 0, 0, 0, Tr.emit(K_GET_DEVICE(), 0, 0, 0,
      Tr.raise(K_OPEN(), 0, 0, 0, t))))

# :55-57 the detach branch, and its THREE calls appear ONLY when
# `libusb_kernel_driver_active` answered true. The ABSENCE of those three is what
# the two open traces differ by.
def usb_open.detach(kdrv_active: Bool, +t: Tr) -> Tr:
  Bool.pick(Tr, kdrv_active,
    Tr.raise(K_RESET_DEVICE(), 0, 0, 0,
      Tr.raise(K_DETACH_KDRV(), USB3_IFACE(), 0, 0,
        Tr.raise(K_KDRV_ACTIVE(), USB3_IFACE(), 0, 0, t))), t)

def usb_open(have_product: Bool, kdrv_active: Bool, +t: Tr) -> Tr:
  Tr.raise(K_SET_ALT(), USB3_IFACE(), USB3_ALT(), 0,
    Tr.raise(K_CLAIM_IFACE(), USB3_IFACE(), 0, 0,
      Tr.raise(K_SET_CONFIG(), USB3_CONFIG(), 0, 0,
        usb_open.detach(kdrv_active, usb_open.after(have_product, t)))))

# :20-27 `USB3.ctx()`: `libusb_init`, then `libusb_set_option(ctx,
# LIBUSB_OPTION_LOG_LEVEL, 4)` ONLY when `DEBUG >= 6`. There is no third call.
def usb_ctx(debug6: Bool, +t: Tr) -> Tr:
  Bool.pick(Tr, debug6,
    Tr.raise(K_SET_OPTION(), enum_val("LIBUSB_OPTION_LOG_LEVEL", E_OPTION()),
             USB3_LOG_LEVEL_DEBUG(), 0, Tr.raise(K_INIT(), 0, 0, 0, t)),
    Tr.raise(K_INIT(), 0, 0, 0, t))

# ===========================================================================
# THE TRANSFER CALLS. `usb_chunk` (:336-355), `usb_reap` (:324-328),
# `usb_drained` (:330-334) and the control/bulk wrappers (:64-84) are where the
# remaining trace kinds are emitted, and what matters is the SEQUENCE.
#
# ONE CALL PER DEF, and the composition IS the order. Nesting seven `Tr.emit`s
# inside each other is a counting exercise with no compiler help, and a miscount is
# a silent change to which call is recorded first; one def per call makes the
# sequence read top-down and each def independently gateable.
# ===========================================================================

# :457 `libusb_alloc_transfer(0)` -- the xfer this chunk submits
def usb_chunk.alloc(+t: Tr) -> Tr: Tr.emit(K_ALLOC_XFER(), 0, 0, 0, t)

# :352 `libusb_submit_transfer(xfer.index(0))`
def usb_chunk.submit(+t: Tr) -> Tr: Tr.emit(K_SUBMIT_XFER(), 0, 0, 0, t)

# :348 `usb_ctrl(h, 0x40, 0xF2, wire // 512, ((end - wire) // SLOT) | (wire // SLOT << 8), ...)`
def usb_chunk.f2(+half: U32, +wire: U32, +t: Tr) -> Tr:
  Tr.emit(K_CTRL_XFER(), RTYPE_OUT(), REQ_F2(), chunk_wvalue(wire), t)

# :347 `usb_drained(h, n)`, whose 0xE4 read carries the FENCE ADDRESS. Its length
# is ONE -- the byte that makes the predicate mod 256 -- and that length is why
# `drained_step` is a separate def and not a trace field.
def usb_chunk.drained(+t: Tr) -> Tr:
  Tr.emit(K_CTRL_XFER(), RTYPE_IN(), REQ_E4(), WIN_FENCE_LO(), t)

# :342 `usb_reap(h, xfer)`, and :326's `libusb_handle_events_timeout` with a ZERO
# timeout. The poll LOOP is the UOp graph and the seam's.
def usb_chunk.reap(+t: Tr) -> Tr: Tr.emit(K_EVENTS(), 0, 0, 0, t)

# :343 `memcpy(stage + end - wire, addr, size)`
def usb_chunk.memcpy(+half: U32, +wire: U32, +t: Tr) -> Tr:
  Tr.emit(K_MEMCPY(), chunk_off(half, wire), 0, 0, t)

# :342..:352 IN EXECUTION ORDER, WHICH IS NOT LINE ORDER. The `h = h.after(...)`
# chain runs bottom-up in the source, so :347's usb_drained happens BEFORE :348's
# usb_ctrl -- the port had them the other way round and the CPython order row,
# built from `usb_chunk`'s call SITES, is what caught it. A count is identical
# either way.
#
# :350-351 `field("status").store(0xff)`, `field("length").store(wire)` and
# `field("buffer").store(...)` MAKE NO DEVICE CALL: they are stores into the
# transfer struct the port holds as a POINTER. So there is NO trace entry for them
# and the earlier version's `K_BULK_XFER` there was a lie the order rows faithfully
# reproduced. What IS ported is the ORDINALS those names resolve to --
# `usb_xfer_status_ix`, `_length_ix`, `_buffer_ix` -- and `M38` (status and length
# transposed) is the mutation that moves them.
def usb_chunk.step(+half: U32, +wire: U32, +status_ok: Bool, +t: Tr) -> Tr:
  usb_chunk.memcpy(half, wire, usb_chunk.reap(
    usb_chunk.f2(half, wire, usb_chunk.drained(usb_chunk.submit(usb_chunk.alloc(t))))))

# :326 `usb_handle_events_timeout(handle, usb_stack(uint64, 0, 0))`
def usb_reap(pending: Bool, +t: Tr) -> Tr:
  Bool.pick(Tr, pending, Tr.emit(K_EVENTS(), 0, 0, 0, t), t)

# :332 `usb_ctrl(h, 0xC0, 0xE4, usb_fence(h.device).getaddr("CPU"), 0, slot, 1)`:
# ONE byte, at the fence, IN. The predicate that decides whether it is made at
# all is `drained_step`, and `usb_drained_order_need` / `_done` are the pair.
def usb_drained_trace(+need: U32, +fence: U32, +t: Tr) -> Tr:
  Bool.pick(Tr, drained_step(need, fence),
            Tr.emit(K_CTRL_XFER(), RTYPE_IN(), REQ_E4(), WIN_FENCE_LO(), t), t)

# :67/:71 the two control transfers. The ONLY difference is the request type --
# 0x40 for OUT and 0xC0 for IN -- and `Tr.emit` carries THREE arguments, so the
# trace holds the request type, the bRequest and the byte count; the buffer
# pointer and the timeout are the seam's and are the `usb_ctrl_buf_in_trace` and
# `usb_timeout` rows.
def usb_ctrl_req(+is_out: Bool, +req: U32, +n: U32, +t: Tr) -> Tr:
  Tr.emit(K_CTRL_XFER(), Bool.pick(U32, is_out, RTYPE_OUT(), RTYPE_IN()), req, n, t)

# :78/:83 the two bulk transfers, and here the ENDPOINT differs and the request
# type does not: 0x02 OUT and 0x81 IN, which is 0x01 | LIBUSB_ENDPOINT_IN.
def usb_bulk_req(+is_out: Bool, +n: U32, +t: Tr) -> Tr:
  Tr.emit(K_BULK_XFER(), Bool.pick(U32, is_out, EP_OUT(), EP_IN()), n, 0, t)

# THE THREE `field("...")` STORES' ORDINALS. They are the rows that hold those
# names in that order.
def K_XFER_STATUS() -> U32: Fld.find("status", F_TRANSFER())
def K_XFER_LENGTH() -> U32: Fld.find("length", F_TRANSFER())
def K_XFER_BUFFER() -> U32: Fld.find("buffer", F_TRANSFER())

# :107 `_f0_out`'s wValue and wIndex, which the trace records and the arithmetic
# rows measure. `wValue = fmt_type | (byte_en << 8)`, `wIndex = mode & 0x03`.
def t_f0() -> IO(Unit):
  IO.print(lines_of(
    [u1("usb_wvalue_0x40_0f", pcie_wvalue(64, 15)),
     u1("usb_wvalue_0x60_0f", pcie_wvalue(96, 15)),
     u1("usb_wvalue_0x20_0f", pcie_wvalue(32, 15)),
     u1("usb_wvalue_0xf0_ff", pcie_wvalue(240, 255)),
     u1("usb_wvalue_0x44_0f", pcie_wvalue(68, 15)),
     u1("usb_windex_0", pcie_windex(0)),
     u1("usb_windex_1", pcie_windex(1)),
     u1("usb_windex_2", pcie_windex(2)),
     u1("usb_windex_3", pcie_windex(3)),
     u1("usb_windex_4", pcie_windex(4)),
     u1("usb_timeout", USB3_TIMEOUT()),
     u1("usb_ctrl_buf_in_trace", USB3_CTRL_BUF()),
     u1("usb_xfer_status_ix", K_XFER_STATUS()),
     u1("usb_xfer_length_ix", K_XFER_LENGTH()),
     u1("usb_xfer_buffer_ix", K_XFER_BUFFER())]))

# ===========================================================================
# THE TRANSFER ROWS. Order and identity, one row per fixture. THE HALF PAIR is
# the negative case: half 1's window is 2*HALF and not HALF, so every recorded
# offset differs.
# ===========================================================================
def t_xfer() -> IO(Unit):
  IO.print(lines_of(
    [s1("usb_chunk_order_h0", Tr.sym(usb_chunk.step(0, usb_wire(512), True{}, Tr.of()))),
     s1("usb_chunk_order_h1", Tr.sym(usb_chunk.step(1, usb_wire(512), True{}, Tr.of()))),
     s1("usb_chunk_order_h1_2chunk",
        Tr.sym(usb_chunk.step(1, usb_wire(U32.mul(2, CHUNK())), True{}, Tr.of()))),
     # the negative case of the order above: the SAME order with and without a
     # pending transfer, so a port that always polled would look right on `_h0`.
     b1("usb_chunk_pending_same",
        String.eq(Tr.sym(usb_chunk.step(0, usb_wire(512), True{}, Tr.of())),
                  Tr.sym(usb_chunk.step(0, usb_wire(512), False{}, Tr.of())))),
     s1("usb_reap_order_pending", Tr.sym(usb_reap(True{}, Tr.of()))),
     s1("usb_reap_order_idle", Tr.sym(usb_reap(False{}, Tr.of()))),
     s1("usb_drained_order_need", Tr.sym(usb_drained_trace(7, 7, Tr.of()))),
     s1("usb_drained_order_done", Tr.sym(usb_drained_trace(7, 5, Tr.of()))),
     s1("usb_ctrl_order_out", Tr.sym(usb_ctrl_req(True{}, REQ_F2(), 4, Tr.of()))),
     s1("usb_ctrl_order_in", Tr.sym(usb_ctrl_req(False{}, REQ_E4(), 1, Tr.of()))),
     s1("usb_bulk_order_out", Tr.sym(usb_bulk_req(True{}, 512, Tr.of()))),
     s1("usb_bulk_order_in", Tr.sym(usb_bulk_req(False{}, 512, Tr.of())))]))
# ===========================================================================
# THE TRACE ROWS. Three things are gateable about a trace and only three: the
# IDENTITY of each call, the ORDER of the calls, and the TRUNCATION POINT of a
# refusal. All three are whole-value rows here.
# ===========================================================================

def t_trace() -> IO(Unit):
  IO.print(lines_of(
    # :23-26 `USB3.ctx()` -- the option is conditional on `DEBUG >= 6` and there
    # is no third call.
    [s1("usb_ctx_order_debug6", Tr.sym(usb_ctx(True{}, Tr.of()))),
     s1("usb_ctx_order_nodebug", Tr.sym(usb_ctx(False{}, Tr.of()))),
     u1("usb_ctx_n_debug6", Tr.n(usb_ctx(True{}, Tr.of()))),
     u1("usb_ctx_n_nodebug", Tr.n(usb_ctx(False{}, Tr.of()))),
     # THE CHECKED/RAW SPLIT, and it is the reason a refusal ordinal means
     # anything at all. Each row asks `Tr.refused` at ONE ordinal, so a call that
     # goes through `Tr.emit` cannot refuse and the row is False. A port that
     # emitted everything through `Tr.raise` would print eleven Trues here.
     b1("usb_ctx_init_checked", Tr.refused(usb_ctx(True{}, Tr.fail_at(Tr.of(), 1)))),
     b1("usb_ctx_setoption_checked", Tr.refused(usb_ctx(True{}, Tr.fail_at(Tr.of(), 2)))),
     # :32-36 the enumeration, on ZERO, ONE and TWO devices, hit and miss.
     s1("usb_enum_order_0", Tr.sym(usb_enum(0n, False{}, 0, 0, Tr.of()))),
     s1("usb_enum_order_1_miss", Tr.sym(usb_enum(1n, False{}, 0, 0, Tr.of()))),
     s1("usb_enum_order_1_hit", Tr.sym(usb_enum(1n, True{}, 3, 7, Tr.of()))),
     s1("usb_enum_order_2_hit", Tr.sym(usb_enum(2n, True{}, 3, 7, Tr.of()))),
     u1("usb_enum_n_0", Tr.n(usb_enum(0n, False{}, 0, 0, Tr.of()))),
     u1("usb_enum_n_1_miss", Tr.n(usb_enum(1n, False{}, 0, 0, Tr.of()))),
     u1("usb_enum_n_1_hit", Tr.n(usb_enum(1n, True{}, 3, 7, Tr.of()))),
     u1("usb_enum_n_2_hit", Tr.n(usb_enum(2n, True{}, 3, 7, Tr.of()))),
     b1("usb_enum_getdevlist_checked", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 1)))),
     b1("usb_enum_ref_device_checked", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 3)))),
     b1("usb_enum_free_checked", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 6)))),
     # :39-62 the open, on both kernel-driver branches.
     s1("usb_open_order_nodetach", Tr.sym(usb_open(True{}, False{}, Tr.of()))),
     s1("usb_open_order_detach", Tr.sym(usb_open(True{}, True{}, Tr.of()))),
     u1("usb_open_n_nodetach", Tr.n(usb_open(True{}, False{}, Tr.of()))),
     u1("usb_open_n_detach", Tr.n(usb_open(True{}, True{}, Tr.of()))),
     b1("usb_open_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 1)))),
     b1("usb_open_getdevice_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 2)))),
     b1("usb_open_strascii_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 4)))),
     b1("usb_open_setcfg_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 5)))),
     b1("usb_open_claim_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 6)))),
     b1("usb_open_alt_checked", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 7)))),
     b1("usb_open_kdrv_checked", Tr.refused(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 5)))),
     # THE SEAM'S INVENTORY IN THE PORT'S OWN VOCABULARY: each `K_*` and the symbol
     # it names. `usb-symmap.py` proves the mapping is a BIJECTION onto `SYMS()`
     # and that every symbol is a real libusb export; these rows are what a
     # transposed `K_*` ladder would move. `usb_inventory_past_end` is the
     # negative case, one row past the last kind.
     s1("usb_inventory_init", call_sym(K_INIT())),
     s1("usb_inventory_set_option", call_sym(K_SET_OPTION())),
     s1("usb_inventory_get_devlist", call_sym(K_GET_DEVLIST())),
     s1("usb_inventory_get_desc", call_sym(K_GET_DESC())),
     s1("usb_inventory_ref_device", call_sym(K_REF_DEVICE())),
     s1("usb_inventory_bus_number", call_sym(K_BUS_NUMBER())),
     s1("usb_inventory_dev_address", call_sym(K_DEV_ADDRESS())),
     s1("usb_inventory_free_devlist", call_sym(K_FREE_DEVLIST())),
     s1("usb_inventory_open", call_sym(K_OPEN())),
     s1("usb_inventory_get_device", call_sym(K_GET_DEVICE())),
     s1("usb_inventory_str_ascii", call_sym(K_STR_ASCII())),
     s1("usb_inventory_kdrv_active", call_sym(K_KDRV_ACTIVE())),
     s1("usb_inventory_detach_kdrv", call_sym(K_DETACH_KDRV())),
     s1("usb_inventory_reset_device", call_sym(K_RESET_DEVICE())),
     s1("usb_inventory_set_config", call_sym(K_SET_CONFIG())),
     s1("usb_inventory_claim_iface", call_sym(K_CLAIM_IFACE())),
     s1("usb_inventory_set_alt", call_sym(K_SET_ALT())),
     s1("usb_inventory_ctrl_xfer", call_sym(K_CTRL_XFER())),
     s1("usb_inventory_bulk_xfer", call_sym(K_BULK_XFER())),
     s1("usb_inventory_alloc_xfer", call_sym(K_ALLOC_XFER())),
     s1("usb_inventory_events", call_sym(K_EVENTS())),
     s1("usb_inventory_submit_xfer", call_sym(K_SUBMIT_XFER())),
     s1("usb_inventory_memcpy", call_sym(K_MEMCPY())),
     s1("usb_inventory_strerror", call_sym(K_STRERROR())),
     u1("usb_inventory_len", U32.from_nat(List.length(&2, String, SYMS()))),
     s1("usb_inventory_past_end", sym_at(24n, SYMS())),
     # THE SEAM'S INVENTORY IN libusb's OWN NAMES, which is the other direction of
     # the same table. `memcpy` has NO row here and that is the fact: it is the one
     # entry of `SYMS()` that is not an `autogen.libusb` export, so a port that
     # named a `libusb_` symbol which does not exist would print
     # `NOT-A-LIBUSB-SYMBOL` against this row.
     s1("usb_sym_libusb_init", call_sym(K_INIT())),
     s1("usb_sym_libusb_set_option", call_sym(K_SET_OPTION())),
     s1("usb_sym_libusb_get_device_list", call_sym(K_GET_DEVLIST())),
     s1("usb_sym_libusb_get_device_descriptor", call_sym(K_GET_DESC())),
     s1("usb_sym_libusb_ref_device", call_sym(K_REF_DEVICE())),
     s1("usb_sym_libusb_get_bus_number", call_sym(K_BUS_NUMBER())),
     s1("usb_sym_libusb_get_device_address", call_sym(K_DEV_ADDRESS())),
     s1("usb_sym_libusb_free_device_list", call_sym(K_FREE_DEVLIST())),
     s1("usb_sym_libusb_open", call_sym(K_OPEN())),
     s1("usb_sym_libusb_get_device", call_sym(K_GET_DEVICE())),
     s1("usb_sym_libusb_get_string_descriptor_ascii", call_sym(K_STR_ASCII())),
     s1("usb_sym_libusb_kernel_driver_active", call_sym(K_KDRV_ACTIVE())),
     s1("usb_sym_libusb_detach_kernel_driver", call_sym(K_DETACH_KDRV())),
     s1("usb_sym_libusb_reset_device", call_sym(K_RESET_DEVICE())),
     s1("usb_sym_libusb_set_configuration", call_sym(K_SET_CONFIG())),
     s1("usb_sym_libusb_claim_interface", call_sym(K_CLAIM_IFACE())),
     s1("usb_sym_libusb_set_interface_alt_setting", call_sym(K_SET_ALT())),
     s1("usb_sym_libusb_control_transfer", call_sym(K_CTRL_XFER())),
     s1("usb_sym_libusb_bulk_transfer", call_sym(K_BULK_XFER())),
     s1("usb_sym_libusb_alloc_transfer", call_sym(K_ALLOC_XFER())),
     s1("usb_sym_libusb_handle_events_timeout", call_sym(K_EVENTS())),
     s1("usb_sym_libusb_submit_transfer", call_sym(K_SUBMIT_XFER())),
     s1("usb_sym_libusb_strerror", call_sym(K_STRERROR())),
     # THE BUS/ADDRESS LABEL, which rides on the two enumeration calls.
     s1("usb_list_label_b3_a7", list_label(3, 7)),
     s1("usb_list_label_b0_a0", list_label(0, 0)),
     s1("usb_list_label_b255_a127", list_label(255, 127))]))

# THE SELECTION, with the NEGATIVE CASE one row from its positive. A descriptor
# whose idVendor matches and whose idProduct does not is NOT selected, and a
# descriptor whose product matches with the vendor swapped is NOT selected --
# the comparison is a PAIR and not two independent halves.
def t_select() -> IO(Unit):
  IO.print(lines_of(
    [b1("usb_list_match_exact", list_match(7531, 260, 7531, 260)),
     b1("usb_list_match_vendor_only", list_match(7531, 260, 7531, 261)),
     b1("usb_list_match_product_only", list_match(7531, 260, 1204, 260)),
     b1("usb_list_match_both_wrong", list_match(7531, 260, 1204, 305)),
     b1("usb_list_match_zero_zero", list_match(0, 0, 0, 0)),
     b1("usb_list_match_ffff_ffff", list_match(65535, 65535, 65535, 65535)),
     # the two descriptor field ORDINALS the comparison reads, by name
     u1("usb_list_ix_idvendor", Fld.find("idVendor", F_DEVICE_DESCRIPTOR())),
     u1("usb_list_ix_idproduct", Fld.find("idProduct", F_DEVICE_DESCRIPTOR()))]))

# THE REFUSALS. Each one is a TRUNCATION and the row is the trace that survived, so
# the ordinal of the failing emit is in the value and a refusal moved one step late
# shows up as a different string rather than as a missing row.
#
# THE ORDINALS. `Tr.raise` records the failing call and THEN sets `refused`, so a
# refusal at `bad_at = k` leaves a k-call trace. The no-detach open emits 1 OPEN,
# 2 GET_DEVICE, 3 GET_DESC, 4 STR_ASCII, 5 SET_CONFIG, 6 CLAIM, 7 SET_ALT; the
# detach branch adds 5 KDRV_ACTIVE, 6 DETACH, 7 RESET and shifts the rest by three.
# A RAW ordinal -- 2 GET_DEVICE in the open, 6 FREE_DEVLIST in the enumeration --
# cannot refuse at all, so its truncation row is the FULL trace and that is the row
# that would look like a gate and is not one.
def t_refuse() -> IO(Unit):
  IO.print(lines_of(
    [s1("usb_open_refuse_1_open", Tr.sym(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 1)))),
     s1("usb_open_refuse_4_product", Tr.sym(usb_open(False{}, False{}, Tr.fail_at(Tr.of(), 4)))),
     s1("usb_open_refuse_5_config", Tr.sym(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 5)))),
     s1("usb_open_refuse_6_claim", Tr.sym(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 6)))),
     s1("usb_open_refuse_7_alt", Tr.sym(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 7)))),
     s1("usb_open_refuse_5_kdrv", Tr.sym(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 5)))),
     s1("usb_open_refuse_8_detach", Tr.sym(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 8)))),
     s1("usb_open_refuse_10_alt", Tr.sym(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 10)))),
     b1("usb_open_refused_4", Tr.refused(usb_open(False{}, False{}, Tr.fail_at(Tr.of(), 4)))),
     b1("usb_open_refused_6", Tr.refused(usb_open(True{}, False{}, Tr.fail_at(Tr.of(), 6)))),
     b1("usb_open_refused_beyond_10", Tr.refused(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 10)))),
     b1("usb_open_refused_beyond_11", Tr.refused(usb_open(True{}, True{}, Tr.fail_at(Tr.of(), 11)))),
     b1("usb_open_ok_norefs", Tr.refused(usb_open(True{}, False{}, Tr.of()))),
     # the ENUMERATION's checked/RAW split: emit 2 of a one-device HIT is the
     # descriptor read and can refuse, emit 3 is the RAW `libusb_ref_device` and
     # cannot, and emit 6 is the RAW `libusb_free_device_list`. One row apart, and
     # they disagree.
     b1("usb_enum_refused_2_is_checked", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 2)))),
     b1("usb_enum_refused_5_is_checked", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 5)))),
     b1("usb_enum_refused_5_fires", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 5)))),
     b1("usb_enum_refused_6_raw_no_fire", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 6)))),
     b1("usb_enum_refused_beyond_7", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.fail_at(Tr.of(), 7)))),
     b1("usb_enum_ok_norefs", Tr.refused(usb_enum(1n, True{}, 3, 7, Tr.of()))),
     # the ENUMERATION's negative case: a MISS emits the descriptor read and NONE
     # of the ref triple, so it is FOUR calls shorter than a hit and not three.
     s1("usb_enum_order_1_miss_full", Tr.sym(usb_enum(1n, False{}, 0, 0, Tr.of())))]))

# THE LAST-WINS FIXTURE. The generated dicts are LAST-wins -- a repeated key is
# overwritten by the later literal -- and both folds have to agree with that. But
# NONE of the twenty-one live tables can exercise the rule: 6 is the only value that
# ever repeats, and `LIBUSB_CLASS_IMAGE` is NOT a table entry (it is a walrus
# binding the dict overwrote), so after that correction every value and every name
# in every table is UNIQUE. `M36` and `M37` measured 0 rows moved, and a 0 is a
# REQUEST FOR A FIXTURE, not a coverage claim. So the rule gets a table BUILT TO
# EXERCISE IT: value 10 is named ALPHA then GAMMA, the name SYNTH_BETA is carried by
# values 11 and 12, and the `usb_synth_*` rows are the only fixtures in the file
# that see either fold's tie-break.
def E_SYNTH() -> List<&2, Ent>:
  [Ent{10, "SYNTH_ALPHA"}, Ent{11, "SYNTH_BETA"}, Ent{10, "SYNTH_GAMMA"},
   Ent{12, "SYNTH_BETA"}, Ent{13, "SYNTH_DELTA"}]

# THE TWO WALRUS GLOBALS at 6, and they are constants that are NOT table entries.
def LIBUSB_CLASS_IMAGE() -> U32: 6
def LIBUSB_CLASS_PTP() -> U32: 6

# ===========================================================================
# THE STRUCT ROWS. The field lists are printed as the ROUND TRIP of the literal
# through `String.split` and back, so a dropped field, a transposed pair or a split
# that eats the separator all change the line -- where a row that printed the
# literal would be a tautology. `Fld.find` / `Fld.at` are the by-NAME lookups
# `usb_chunk` and `list_devices` actually perform, and they are rows too: a lookup
# answering the wrong ordinal is a wrong transfer, and an ordinal COUNT is not a
# gate.
# ===========================================================================
def t_structs() -> IO(Unit):
  IO.print(lines_of(
    [s1("usb_fld_transfer", flds(F_TRANSFER())),
     s1("usb_fld_device_descriptor", flds(F_DEVICE_DESCRIPTOR())),
     s1("usb_fld_endpoint_descriptor", flds(F_ENDPOINT_DESCRIPTOR())),
     s1("usb_fld_interface_descriptor", flds(F_INTERFACE_DESCRIPTOR())),
     s1("usb_fld_config_descriptor", flds(F_CONFIG_DESCRIPTOR())),
     s1("usb_fld_interface", flds(F_INTERFACE())),
     s1("usb_fld_interface_association_descriptor", flds(F_INTERFACE_ASSOCIATION_DESCRIPTOR())),
     s1("usb_fld_interface_association_descriptor_array",
        flds(F_INTERFACE_ASSOCIATION_DESCRIPTOR_ARRAY())),
     s1("usb_fld_control_setup", flds(F_CONTROL_SETUP())),
     s1("usb_fld_iso_packet_descriptor", flds(F_ISO_PACKET_DESCRIPTOR())),
     s1("usb_fld_bos_descriptor", flds(F_BOS_DESCRIPTOR())),
     s1("usb_fld_bos_dev_capability_descriptor", flds(F_BOS_DEV_CAPABILITY_DESCRIPTOR())),
     s1("usb_fld_ss_usb_device_capability_descriptor",
        flds(F_SS_USB_DEVICE_CAPABILITY_DESCRIPTOR())),
     s1("usb_fld_ss_endpoint_companion_descriptor", flds(F_SS_ENDPOINT_COMPANION_DESCRIPTOR())),
     s1("usb_fld_usb_2_0_extension_descriptor", flds(F_USB_2_0_EXTENSION_DESCRIPTOR())),
     s1("usb_fld_container_id_descriptor", flds(F_CONTAINER_ID_DESCRIPTOR())),
     s1("usb_fld_platform_descriptor", flds(F_PLATFORM_DESCRIPTOR())),
     s1("usb_fld_init_option", flds(F_INIT_OPTION())),
     s1("usb_fld_init_option_value", flds(F_INIT_OPTION_VALUE())),
     s1("usb_fld_pollfd", flds(F_POLLFD())),
     s1("usb_fld_version", flds(F_VERSION())),
     s1("usb_fld_timeval", flds(F_TIMEVAL())),
     u1("usb_fld_transfer_status_ix", Fld.find("status", F_TRANSFER())),
     u1("usb_fld_transfer_length_ix", Fld.find("length", F_TRANSFER())),
     u1("usb_fld_transfer_buffer_ix", Fld.find("buffer", F_TRANSFER())),
     u1("usb_fld_transfer_endpoint_ix", Fld.find("endpoint", F_TRANSFER())),
     u1("usb_fld_transfer_type_ix", Fld.find("type", F_TRANSFER())),
     u1("usb_fld_transfer_timeout_ix", Fld.find("timeout", F_TRANSFER())),
     u1("usb_fld_transfer_actual_length_ix", Fld.find("actual_length", F_TRANSFER())),
     u1("usb_fld_transfer_nosuch_ix", Fld.find("nosuchfield", F_TRANSFER())),
     u1("usb_fld_device_descriptor_idVendor_ix", Fld.find("idVendor", F_DEVICE_DESCRIPTOR())),
     u1("usb_fld_device_descriptor_idProduct_ix", Fld.find("idProduct", F_DEVICE_DESCRIPTOR())),
     u1("usb_fld_device_descriptor_iProduct_ix", Fld.find("iProduct", F_DEVICE_DESCRIPTOR())),
     u1("usb_fld_device_descriptor_iManufacturer_ix",
        Fld.find("iManufacturer", F_DEVICE_DESCRIPTOR())),
     s1("usb_fld_transfer_at5", Fld.at(5, F_TRANSFER())),
     s1("usb_fld_transfer_at11", Fld.at(11, F_TRANSFER())),
     s1("usb_fld_transfer_at99", Fld.at(99, F_TRANSFER())),
     u1("usb_siz_transfer", SIZ_TRANSFER()),
     u1("usb_siz_device_descriptor", SIZ_DEVICE_DESCRIPTOR()),
     u1("usb_siz_endpoint_descriptor", SIZ_ENDPOINT_DESCRIPTOR()),
     u1("usb_siz_interface_descriptor", SIZ_INTERFACE_DESCRIPTOR()),
     u1("usb_siz_config_descriptor", SIZ_CONFIG_DESCRIPTOR()),
     u1("usb_siz_interface", SIZ_INTERFACE()),
     u1("usb_siz_interface_association_descriptor", SIZ_INTERFACE_ASSOCIATION_DESCRIPTOR()),
     u1("usb_siz_interface_association_descriptor_array",
        SIZ_INTERFACE_ASSOCIATION_DESCRIPTOR_ARRAY()),
     u1("usb_siz_control_setup", SIZ_CONTROL_SETUP()),
     u1("usb_siz_iso_packet_descriptor", SIZ_ISO_PACKET_DESCRIPTOR()),
     u1("usb_siz_bos_descriptor", SIZ_BOS_DESCRIPTOR()),
     u1("usb_siz_bos_dev_capability_descriptor", SIZ_BOS_DEV_CAPABILITY_DESCRIPTOR()),
     u1("usb_siz_ss_usb_device_capability_descriptor",
        SIZ_SS_USB_DEVICE_CAPABILITY_DESCRIPTOR()),
     u1("usb_siz_ss_endpoint_companion_descriptor", SIZ_SS_ENDPOINT_COMPANION_DESCRIPTOR()),
     u1("usb_siz_usb_2_0_extension_descriptor", SIZ_USB_2_0_EXTENSION_DESCRIPTOR()),
     u1("usb_siz_container_id_descriptor", SIZ_CONTAINER_ID_DESCRIPTOR()),
     u1("usb_siz_platform_descriptor", SIZ_PLATFORM_DESCRIPTOR()),
     u1("usb_siz_init_option", SIZ_INIT_OPTION()),
     u1("usb_siz_init_option_value", SIZ_INIT_OPTION_VALUE()),
     u1("usb_siz_pollfd", SIZ_POLLFD()),
     u1("usb_siz_version", SIZ_VERSION()),
     u1("usb_siz_timeval", SIZ_TIMEVAL())]))


# ===========================================================================
# THE ENUM ROWS. Twenty-one table walks, BOTH directions each, then the
# scalar rows: the signed negatives, the walrus globals, and the two
# negative cases (`usb_enumval_notfound_is_io` answers with the sentinel,
# `usb_synth_v_absent` likewise) beside their positives.
# ===========================================================================
def t_consts() -> IO(Unit):
  IO.print(lines_of(
    List.concat(&2, String, [
     enum_rows("classcode", E_CLASSCODE()),
     enum_rows("dtype", E_DTYPE()),
     enum_rows("epdir", E_EPDIR()),
     enum_rows("eptype", E_EPTYPE()),
     enum_rows("xtype", E_XTYPE()),
     enum_rows("xstatus", E_XSTATUS()),
     enum_rows("xflags", E_XFLAGS()),
     enum_rows("err", E_ERR()),
     enum_rows("reqtype", E_REQTYPE()),
     enum_rows("streq", E_STREQ()),
     enum_rows("recip", E_RECIP()),
     enum_rows("speed", E_SPEED()),
     enum_rows("supspeed", E_SUPSPEED()),
     enum_rows("loglevel", E_LOGLEVEL()),
     enum_rows("logcb", E_LOGCB()),
     enum_rows("option", E_OPTION()),
     enum_rows("isosync", E_ISOSYNC()),
     enum_rows("isousage", E_ISOUSAGE()),
     enum_rows("cap", E_CAP()),
     enum_rows("bostype", E_BOSTYPE()),
     enum_rows("ext20", E_EXT20()),
     enum_rows("sscap", E_SSCAP()),
     [i1("usb_err_interrupted_signed", enum_val("LIBUSB_ERROR_INTERRUPTED", E_ERR()))],
     [i1("usb_err_other_signed", enum_val("LIBUSB_ERROR_OTHER", E_ERR()))],
     [i1("usb_err_success_signed", enum_val("LIBUSB_SUCCESS", E_ERR()))],
     [u1("usb_opt_log_level", enum_val("LIBUSB_OPTION_LOG_LEVEL", E_OPTION()))],
     [u1("usb_opt_log_level_is_debug", enum_val("LIBUSB_LOG_LEVEL_DEBUG", E_LOGLEVEL()))],
     [u1("usb_opt_max", enum_val("LIBUSB_OPTION_MAX", E_OPTION()))],
     [s1("usb_classcode_6_name", enum_nm(6, E_CLASSCODE()))],
     [u1("usb_classcode_len", U32.from_nat(List.length(&2, Ent, E_CLASSCODE())))],
     [u1("usb_classcode_image_walrus", LIBUSB_CLASS_IMAGE())],
     [u1("usb_classcode_ptp_walrus", LIBUSB_CLASS_PTP())],
     [u1("usb_classcode_image_in_dict", Bool.to_u32(U32.is_ne(enum_val("LIBUSB_CLASS_IMAGE", E_CLASSCODE()), NOT_FOUND())))],
     [s1("usb_enumnm_absent_4242", enum_nm(4242, E_CLASSCODE()))],
     [s1("usb_enumnm_absent_neg1", enum_nm(4294967295, E_ERR()))],
     [u1("usb_enumval_notfound_is_io", enum_val("LIBUSB_ENUM_NONE", E_ERR()))],
     [s1("usb_synth_n_10", enum_nm(10, E_SYNTH()))],
     [s1("usb_synth_n_11", enum_nm(11, E_SYNTH()))],
     [s1("usb_synth_n_13", enum_nm(13, E_SYNTH()))],
     [u1("usb_synth_v_alpha", enum_val("SYNTH_ALPHA", E_SYNTH()))],
     [u1("usb_synth_v_gamma", enum_val("SYNTH_GAMMA", E_SYNTH()))],
     [u1("usb_synth_v_beta", enum_val("SYNTH_BETA", E_SYNTH()))],
     [u1("usb_synth_v_absent", enum_val("SYNTH_NOPE", E_SYNTH()))]])))



# ===========================================================================
# THE FFI SEAM SPLIT. Every `libusb`/`libc`/`ctypes` binding in `usb.py` is one
# `Call{k, a, b, c}` in `Tr` and nothing else. The table below is the whole
# inventory: what is a trace tag, and the `usb.py` line that becomes it. An
# `@extern` seam would have to be exactly these calls and nothing else, and
# replacing `Tr.emit` is the entire change.
#
# | call | usb.py | checked? | what `a`, `b`, `c` carry |
# | --- | --- | --- | --- |
# | `libusb_init` | :24 | yes | all zero: the argument is a `POINTER(context)` |
# | `libusb_set_option` | :25 | yes | `LIBUSB_OPTION_LOG_LEVEL` (0) and level 4 |
# | `libusb_get_device_list` | :32 | yes | all zero: the list is the SEAM's |
# | `libusb_get_device_descriptor` | :33, :49 | yes | all zero: the struct is the SEAM's |
# | `libusb_ref_device` | :35 | NO | all zero: a pointer in, a pointer out |
# | `libusb_get_bus_number` | :35 | yes | the bus number -- the label's first field |
# | `libusb_get_device_address` | :35 | yes | the device address -- the label's second |
# | `libusb_free_device_list` | :36 | NO | `1`, `usb_unref_devices` |
# | `libusb_open` | :44 | yes | all zero: the handle is the SEAM's |
# | `libusb_get_device` | :49 | NO | all zero: a pointer in, a pointer out |
# | `libusb_get_string_descriptor_ascii` | :50 | yes | 256, `_buf` |
# | `libusb_kernel_driver_active` | :55 | yes | 0, the interface |
# | `libusb_detach_kernel_driver` | :56 | yes | 0, the interface |
# | `libusb_reset_device` | :57 | yes | all zero |
# | `libusb_set_configuration` | :60 | yes | 1, the configuration |
# | `libusb_claim_interface` | :61 | yes | 0, the interface |
# | `libusb_set_interface_alt_setting` | :62 | yes | 0, 0: interface and alt-setting |
# | `libusb_control_transfer` | :67, :71 | yes | rtype 0x40/0xC0, request, n |
# | `libusb_bulk_transfer` | :78, :83 | yes | 0x02/0x81, n |
# | `libusb_alloc_transfer` | :457 | yes | all zero: `libusb_alloc_transfer(0)` |
# | `libusb_handle_events_timeout` | :326 | yes | all zero: the timeout is 0 |
# | `libusb_submit_transfer` | :352 | yes | all zero: the xfer is the SEAM's |
# | `memcpy` | :343 | NO | the byte count |
# | `libusb_strerror` | :16 | NO | NO EMIT SITE: `checked` calls it inside the |
# |   |   |   | exception it is raising, and a trace that has refused records |
# |   |   |   | nothing further. `usb_inventory_strerror` names it. |
#
# `checked` IS A REFUSAL SITE and `usb.py`'s OWN `assert` is not a call at all, so
# `have_product` is a parameter of `usb_open` and the refusal is modelled at the
# string read that precedes it. Those two facts are what `usb_open_refuse_4_product`
# measures.
# ===========================================================================
# WHAT IS NOT IN THIS FILE, NAMED BY ITS LINE. Each is an FFI seam or an
# outside-the-arena owner, and each is a TODO(p3) with the line that owns it. An
# honest "this is a seam" is a complete result; what is NOT acceptable is a row that
# pretends to cover one. The full list of `TODO(p3)` lines is at the end of this
# file.
# ===========================================================================
# ===========================================================================
# THE MUTATION TABLE. One edit per RULE, applied to a scratch copy, and the
# INTERPRETED lane re-run; the diff is over WHOLE `name=value` LINES and not over
# row NAMES, because agent-core.md records a name-comparing harness that reported
# 0 for all 30 mutations in one unit and 0 for all 68 in another.
#
# A mutation that moves nothing is a BLIND SPOT and is REPORTED WITH ITS REASON,
# not closed with a row that encodes the bug. One zero here is a THEOREM: `M6`
# swaps the two operands of a two-term SUM, which no fixture in any file could
# separate.
#
# The counts below are MEASURED, not transcribed: `usb-mutate.py --md` writes this
# table and the builder reads it back.
# ===========================================================================
# | # | rows moved | the edit | what it is testing |
# | --- | --- | --- | --- |
# | M1 | 11 | `usb_wire`: 512 -> 0 in the first add | :253's sentinel block. Eleven fixtures, and every one of them is below SLOT so the block is what rounds them UP to a whole slot. |
# | M2 | 15 | `usb_wire`: SLOT -> 512 in the divisor | the SLOT granularity itself, and the three fixtures at SLOT/2SLOT boundaries are the ones that separate it from 512. |
# | M3 | 3 | `usb_sentinel`: the 0xFFFFFF mask -> 0xFFFF | :254's 24-bit mask. `usb_sentinel_0` and `usb_sentinel_max24` are the fixtures that see it; the COLLISION rows are the ones that say why 24 and not 16. |
# | M4 | 5 | `usb_sentinel`: the 0x51 magic -> 0x50 | the high byte. This is the constant the differ caught me getting wrong (1363148800), so the row set has to see a change here. |
# | M5 | 4 | `usb_split`: `full > 1` -> `full >= 1` | :260's `full if full > 1 else 0` -- the no-one-trip-loops rule. The `_full1` and `_full1_p1` fixtures are the boundary and they are the only ones that separate `>` from `>=`. |
# | M6 | 0 | `usb_split`: `nranges` counts full as `full != 0` -> `tail != 0` | THE ZERO, AND IT IS A THEOREM. `nranges` is a two-term SUM, so swapping the terms cannot change the value for ANY input: no fixture in any file could separate them. The rule that matters -- that both terms are `!= 0` and not `> 0` -- is held by `M25` and `M26`, which move 3 rows each. |
# | M7 | 3 | `usb_window`: copyin and copyout share CHUNK | :257's `CHUNK if host else 2*CHUNK`. The two window rows and the two split fixtures move, which is the whole point of pairing them. |
# | M8 | 5 | `pcie_byte_en`: `<< offset` -> `<< 0` | :118's shift AMOUNT. Five of the eight fixtures use offset 0 and do not move, so this measures 3 of 8 -- a partial-zero, reported as such. |
# | M9 | 10 | `pcie_read_mask`: `1 << (8*size)` -> `1 << size` | :135's mask. `usb_pcie_mask_1` is a THEOREM here (8*1 - 1 == 1 - 1 is false, so it does move), and `_mask_4` is the row that sees the 1<<32 saturation. |
# | M10 | 1 | `pcie_no_completion`: the second fast path's mask -> the first's | :122's TWO fast paths becoming one. Only the fixtures that separate 0x30 from 0x40 can see it. |
# | M11 | 5 | `pcie_cfg_fmt`: `int(bus > 0)` -> `1` | :139's bus term. The `_b0` fixtures move and the `_b1`/`_b255` ones do not. |
# | M12 | 3 | `pcie_cfg_addr`: `dev << 19` -> `dev << 18` | :140's device shift, which is 19 and not the PCI-standard 11. Only the fixtures with a non-zero device move, so this measures 2 of 10. |
# | M13 | 1 | `pcie_cfg_addr_ok`: drop the `bus >> 8` bound | :138's four bounds. The `usb_cfg_rd_b256` fixture is the one that sees it. |
# | M14 | 2 | `xdata_nchunks`: the `length == 0` guard -> `1` | :161's loop for an EMPTY read. `usb_xdata_0_nchunks` is the fixture and it is one row from `_xdata_1_nchunks`. |
# | M15 | 3 | `scsi_padded`: 512 -> 256 | :172's `round_up(len(buf), 512)`. The `_511`/`_512`/`_513` fixtures are the boundary triple and all three move. |
# | M16 | 10 | `scsi_windex`: the `<< 8` -> `<< 7` | :173's slot-count shift. Only the fixtures whose padded length EXCEEDS 0x4000 have a non-zero count, so this measures 3 of 11. |
# | M17 | 8 | `copyout_second`: drop the explicit clamp (the U32-wrap bug) | THE REGRESSION. `size - CHUNK` wraps in a U32 and `U32.max(4294967295, 0)` is 4294967295 where Python's `max(-1, 0)` is 0. The differ found this and `usb_co_chunk_m1_second` / `_wire` are the rows that hold it. |
# | M18 | 2 | `copyout_wire`: drop the second-half sentinel term | :375's `(second > 0) ? 512 : 0`. Only the fixtures that SPILL into the second half move, which is `_chunk_p1` and `_2chunk`. |
# | M19 | 20 | `chunk_end`: `(half + 1) * HALF` -> `half * HALF` | :338. Every `chunk_rows` fixture moves because both halves share the derivation. |
# | M20 | 5 | `chunk_sentinel_word`: `end // 4 - 1` -> `end // 4` | :344's dword index. Five fixtures, five moves -- one row per (half, wire). |
# | M21 | 5 | `chunk_windex`: `wire // SLOT << 8` -> `wire // SLOT << 4` | :348's slot-count shift. |
# | M22 | 4 | `table_size_word`: `+ TABLE_SIZE_OFF` -> `+ 0` | :321's `+ 8`. Both table columns move together, so the ADDRESS column is the negative case. |
# | M23 | 5 | `off_of_index_sz`: `el_sz` -> `0` | :182's integer arm's SIZE, which is `el_sz` and not the slice's extent. Only the `_int_sz` rows move and NOT the `_slice_sz` rows, which is the arm separation. |
# | M24 | 1 | `off_of_slice_sz`: `(stop - start)` -> `(stop)` | :181's slice extent. `usb_mmio_slice2_9_el4_slice_sz` moves and the `slice0_4` one does not -- the second is the boundary that separates them. |
# | M25 | 3 | `drained_step`: `> 1` -> `> 0` | :334's `> 1`. The `_ahead2` fixture is the boundary and the wrap fixtures are the negative case. |
# | M26 | 3 | `drained_step`: drop the `& 0xff` | the ONE-BYTE read's reason for existing: without the mask a fence AHEAD of need wraps into the far side. `usb_drain_wrap_*` is the row set and every wrap fixture moves. |
# | M27 | 1 | `is_remote_prefix`: `starts_with` -> `contains` | :387's `str(p.tag).startswith((...))`. `usb_remote_xusb_host` is the negative case and it is the ONLY fixture that separates the two. |
# | M28 | 1 | `product_ok`: the second prefix -> the first | :52's `or`. `usb_prod_as2462_x_either` is the only fixture that moves. |
# | M29 | 5 | `cpl_name`: fall back to `Completer Abort` instead of Reserved | :133's `.get(cpl_status, f'Reserved (0b...)')`. The five statuses with no map entry are the fixtures and the three with one are the negative case. |
# | M30 | 1 | `reply_ok`: drop the `status == 0` test | :92's three-tuple compare. `usb_reply_ok_nonzero_status` is the fixture, one row from `usb_reply_ok_exact`. |
# | M31 | 73 | `sym_at_head`: answer the NEXT symbol instead of this one | THE OFF-BY-ONE THIS FILE SHIPPED FOR AN HOUR: every order row named the symbol AFTER the one it meant, every COUNT stayed right, and only the whole-string order rows plus the CPython oracle could see it. Same class, one index, same arity, same length. The edit is the whole def body because `sym_at_head` is the head-at-zero ARM lifted into its own def exactly so this edit compiles. |
# | M32 | 4 | `usb_enum.device`: the descriptor read AFTER the ref triple | :33-35 read the descriptor BEFORE the comparison. Four order rows move, and the oracle is the AST so the direction is not a matter of taste. |
# | M33 | 5 | `usb_open.detach`: emit the detach branch unconditionally | :55-57's `if libusb_kernel_driver_active`. The `_nodetach` order row moves and the `_detach` one does not -- and they are ONE call string apart in the output, so the negative case is right there. |
# | M34 | 3 | `usb_open.after`: `Tr.raise` -> `Tr.emit` on the product read | THE CHECKED/RAW SPLIT. If the string read cannot refuse, then `usb_open_refuse_4_product` grows to the full seven-call trace and every later ordinal shifts -- which is exactly what the four `usb_open_refuse_*` rows are for. |
# | M35 | 26 | `Tr.sym`: the separator `,` -> `|` | the ORDER rows' own encoding. Every order row is a whole value, so a separator that lost a call would still be a different string -- this is the check that the string is not accidentally insensitive to a dropped element. |
# | M36 | 1 | `enum_nm`: LAST-wins -> FIRST-wins | the LAST-wins rule the generated dicts have. The ONLY row in the file that sees it is `usb_synth_n_10`, because 6 is the only value that ever repeats in twenty-one tables and `LIBUSB_CLASS_IMAGE` is not a table entry at all -- a one-row fixture for a real rule, BUILT for it. |
# | M37 | 1 | `enum_val`: LAST-wins -> FIRST-wins | the same rule the other way, and the ONLY row that sees it is `usb_synth_v_beta`: no name repeats in the twenty-one live tables, so the fixture had to be BUILT (`E_SYNTH` carries SYNTH_BETA at 11 and 12) for the rule to be observable at all. |
# | M38 | 6 | `F_TRANSFER`: swap `status` and `length` | THE FIELD-ORDER MUTATION. `ops_cl`'s unit found `Sig`'s field names INVERTED and this is the same class of bug: `usb_chunk` addresses three of these by NAME, so a transposed pair writes the timeout where the status goes. The `usb_fld_*_ix` rows are the ones that see it. |
# | M39 | 5 | `F_DEVICE_DESCRIPTOR`: swap `idVendor` and `idProduct` | the two names `list_devices` compares, and the pair the comparison cannot survive being transposed: `usb_list_match_vendor_only` and `_product_only` are its negative cases. |
# | M40 | 1 | `F_DEVICE_DESCRIPTOR`: drop `bNumConfigurations` | a DROPPED field. The whole-string row moves and a field COUNT would not -- which is why the field list is diffed as a string. |
# | M41 | 18 | `CHUNK`: `HALF - 512` -> `HALF` | :208's reserved sentinel block. This is the constant that sets HALF-DEPENDENT arithmetic everywhere, so it is the widest mutation in the file and the row count says how wide. |
# | M42 | 2 | `CDB_SIZE`: 31 -> 37 | `struct.calcsize("<IIIBBB16s")`. 37 is what a reader gets by counting 16s as four more uint32, and `usb_reply_read_len` (13) is the row that says the reply disagrees with it. |
# | M43 | 4 | `ep_dir`: `& 128` -> `& 127` | the `LIBUSB_ENDPOINT_IN` bit, which the oracle reads from the header as 128. |
# | M44 | 3 | `pcie_cfg_addr`: drop the `fn << 16` term | :140's FUNCTION nibble. Only the fixtures with a non-zero fn move. |
# | M45 | 2 | `SENTINEL_MASK`: 0xFFFFFF -> 0xFFFFFFFF | :254's mask width, and the row that says why 24 and not 32: the COLLISION fixture at 2^24 moves and the one at 2^23 does not. |



# ===========================================================================
# THE GATE. Seven scripts, all in `.agents/slop/`, and every number below is one
# of their outputs rather than an estimate.
#
# | script | what it does | last run |
# | --- | --- | --- |
# | `usb-diff.py` | runs the INTERPRETED lane and diffs WHOLE `name=value` lines against four CPython oracles | `rows bend=939 oracle=939 disagree=0 oracle_only=0 bend_only=0` |
# | `usb-constsweep.py` | evaluates every `def NAME() -> U32` and compares it against an AST POSITION in `usb.py`, `ctypes.sizeof`, or `struct.calcsize` | `swept 124: 123 CONFIRMED, 0 WRONG, 1 unverified` |
# | `usb-handmap.py` | the position map itself; `--list` prints every candidate so a position is auditable without running anything | 71 positions |
# | `usb-symmap.py` | the `K_*` -> `SYMS()` bijection, and that every name is a real libusb export | `kinds=24 syms=24 injective=True all_symbols_real=True` |
# | `usb-dead.py` | a def nothing calls is invisible to every other check | `339 defs, 0 dead` |
# | `usb-mutate.py` | 45 mutations, one edit each, diffing whole `name=value` lines | 44 move rows, 1 theorem |
# | `usb-build.py` | assembles THIS FILE from its pieces | -- |
#
# THE ONE UNVERIFIED CONSTANT IS `NOT_FOUND`, and it is PORT-INTERNAL: it is this
# port's own "no such name" answer, chosen to be 0xFFFFFFFF because every
# `enum_libusb_*` value is a C enum and the largest negative is -1. It has no line
# in `usb.py` and it is reported rather than counted as right.
#
# EVERY EXPECTATION IS GENERATED BY CALLING CPYTHON. The enum and struct tables are
# read out of the live `autogen.libusb`, the arithmetic from the same expressions
# `usb.py` writes, the trace ORDERS from `usb.py`'s own AST, and the packet rows from
# `struct.calcsize` and `struct.pack`. Not one is transcribed by eye, because
# agent-core.md records five units where a hand-typed expectation was wrong
# (cstyle 17 of 215, ops_nv 33 of 219, ops_rdma `BNXT_VENDOR` 5356 vs 5348) and one
# where the PORT and the ORACLE were wrong the SAME WAY (`nv_query_litter`), so
# their agreement meant nothing.
#
# THE CONSTANTS THAT WERE WRONG. Two, both hand-typed, both caught by the differ:
#   * `SENTINEL_MAGIC` was 1363148800. 0x51000000 is 1358954496.
#   * `FAST_P1_MASK` was 215. 0b11011111 is 223.
# And the PORT BUGS the gate caught, which no constant audit would have:
#   * `copyout_second` was `U32.max(U32.sub(size, CHUNK()), 0)`, which WRAPS.
#   * `sym_at` was off by one, so every order row named the symbol AFTER the one
#     it meant. `M31` is the mutation and it moves 73 rows.
#   * `usb_chunk` had `usb_drained` (:347) AFTER `usb_ctrl` (:348); the CPython
#     order row, built from the call SITES, is what caught it.
#   * `usb_enum.device` read the descriptor AFTER the ref/bus/address triple, and
#     the SEEN-SET version of `enum_rows` emitted zero `_n_` rows.
#   * `enum_rows` walked the REVERSED table, which builds the accumulator
#     backwards, so all 478 enum rows came out in the opposite of the header's own
#     order. A cons fold over a reversed walk is still a backwards fold.
# ===========================================================================

# ===========================================================================
# THE ENTRY POINT. One line per row section, in the order the sections read.
# ===========================================================================

def main() -> IO(Unit):
  do IO<Unit>:
    a : Unit <- t_consts()
    b : Unit <- t_structs()
    c : Unit <- t_window()
    d : Unit <- t_wire()
    e : Unit <- t_sentinel()
    f : Unit <- t_split()
    g : Unit <- t_byteen()
    h : Unit <- t_pcie_read()
    i : Unit <- t_fastpath()
    j : Unit <- t_cfg()
    k : Unit <- t_xdata()
    l : Unit <- t_scsi()
    m : Unit <- t_stream()
    n : Unit <- t_copyout()
    o : Unit <- t_chunk()
    p : Unit <- t_table()
    q : Unit <- t_mmio()
    r : Unit <- t_drained()
    s : Unit <- t_remote()
    t : Unit <- t_trace()
    u : Unit <- t_select()
    v : Unit <- t_refuse()
    w : Unit <- t_strings()
    x : Unit <- t_packets()
    y : Unit <- t_f0()
    z : Unit <- t_xfer()
    IO.print("usb-done=1")

