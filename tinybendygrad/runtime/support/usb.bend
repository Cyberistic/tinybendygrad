    b1("usb_drain_wrap_need2_fence0", drained_step(2, 0)),
    # A `need` PAST the one-byte window is the case the `& 0xff` exists for: 300
    # and 44 differ by 256, so the masked difference is 44 and the step is True,
    # while 300 and 43 differ by 257 and the masked difference is 1, which is not
    # `> 1`. One row from its positive, and it is the only pair that can see it.
    b1("usb_drain_need300_fence44", drained_step(300, 44)),
    b1("usb_drain_need300_fence43", drained_step(300, 43))
  ]))

