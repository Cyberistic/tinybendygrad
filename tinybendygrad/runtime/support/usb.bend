# tinybendygrad/runtime/support/usb.bend -- port of tinygrad/runtime/support/usb.py
#
# ===========================================================================
# THIS FILE IS GENERATED by `.agents/slop/usb-build.py` from pieces that are
# themselves generated from `usb.py` and `autogen/libusb.py`. Edit a PIECE and
# rebuild; do not edit here.
#
# ===========================================================================
# SCOPE, AND WHY IT IS THIS SCOPE. `grep -rl "support/usb" tinybendygrad
# --include="*.bend"` is EMPTY: no committed file cites this one, so unlike every
# other unit in this wave it was not scoped for me by a citation. I therefore
# chose it, and the choice is dictated by the source. `usb.py` is 473 lines in
# three parts that share almost nothing:
#
#   :12-18   alloc_cbuffer / checked                    SEAM   ctypes
#   :20-92   USB3 -- enumeration, open, control/bulk    PORTED the ORDER + the
#                                                          argument arithmetic
#   :94-174  CustomASM24Controller -- vendor protocol   PORTED the arithmetic,
#                                                          the refusals, the strings
#   :176-202 USBMMIOInterface                           PORTED the index arithmetic
#   :204-247 the UOp placeholders and the WINDOW        PORTED the window
#   :249-309 staging rewrites                           PORTED the ORDER only
#   :311-385 host functions                             PORTED the ORDER + arithmetic
#   :386-471 lowering + bufferize                       PORTED the ORDER only
#
# WHAT IS WORTH PORTING, AND WHY. `usb.py` is the only file in tinygrad that
# talks to a device through a GENERATED ctypes binding, and
# `tinygrad/runtime/autogen/libusb.py` is that binding: 21 `enum_libusb_*` dicts and
# 22 `@c.record` structs whose `register_fields` carries a field NAME and an OFFSET
# for every member. That is a descriptor table in the exact sense this project gets
# burned on -- `ops_nv`'s audit found 33 of 219 constants wrong in a file already
# printing 590 green rows, and `ops_rdma` shipped `BNXT_VENDOR` as 5356 where the
# header says 5348. `struct_libusb_transfer`'s thirteen field names, in order, are
# what `usb_chunk` (:350-351) addresses three times by name, so a transposed pair
# is a silently wrong transfer.
#
# ===========================================================================
# THE WALLS THIS CLOSES.
#
# `ops_amd.bend` records WALL 3 ("USB3, USBIface, ops_amd.py:810-833") naming
# `USB3.list_devices`, `dma_view`, and the `0/4096/20480` controller window, with
# `TODO(p3) runtime/ops_amd.py:812  USB3.list_devices` and
# `TODO(p3) runtime/ops_amd.py:824  pci_dev.dma_view(40960, 544768)`. This file
# closes:
#
#   * WALL 3, part 1 -- `USB3.list_devices` (:30-37). The enumeration is a `Tr`
#     trace: GET_DEVICE_LIST, then per device GET_DEVICE_DESCRIPTOR, the
#     (idVendor, idProduct) == (vendor, dev) test, REF_DEVICE with the bus/address
#     label, FREE_DEVICE_LIST(devs, 1). `usb_list_match` is the SELECTION, with the
#     negative case (a descriptor whose ids do not pair) one row from its positive.
#   * WALL 3, part 3 -- the WINDOW. ops_amd could name the three `map_range` pieces
#     but could not derive them, because the offsets live here: `usb_fence`
#     0x800/0x804, `usb_cq` 0x100c/0x1010, `usb_sram` 0x5000/0x5000+2*HALF, and the
#     sizes that make them. `usb_win_*` is that derivation.
#   * AND A CORRECTION TO CARRY BACK. ops_amd's 4096 is `0x1000`, which is NOT
#     `usb_cq`'s offset: `usb_cq` is `usb_asm24[0x100c:0x1010]` = 4108..4112, and
#     0x1000 is `USB3`'s own CONTROL buffer size (:42, `alloc_cbuffer(0x1000)`). Both
#     are real, they are different numbers, and this file rows both -- so a port
#     that conflated them shows up as a disagreement rather than as a plausible
#     constant. `usb_sram_win_fits_asm24` is the row that says the SRAM pair EXACTLY
#     fills `usb_asm24`, which is ops_amd's 544768.
#   * `ops_disk.bend`'s `_might_open` ladder -- USB3's open is the same shape (a
#     walk of state that ends in a CLAIM) and `usb_open` is its trace.
#
# NOT CLOSED, DELIBERATELY. `dma_view` (ops_amd.py:824) is a `PCIDevice` method
# that lives in ops_amd.bend's own wall 2 and is not usb.py's to answer.
#
# ===========================================================================
# THE SPLIT, stated once and then obeyed. A def here EITHER builds the argument of
# ONE device call (pure; the gate checks it) OR records that call in the trace (the
# gate checks ORDER and IDENTITY). There is no third kind. Every libusb, libc and
# ctypes binding is a `Call{k, a, b, c}` entry in `Tr` and nothing else, so no
# foreign effect is declared and `--check-only` stays green in both lanes. The
# symbol names live in `SYMS()` and `vend`-style rows name each kind, so the seam is
# greppable: `grep -n libusb_ this_file` finds the C symbol as a LITERAL.
#
# NO @extern SEAMS. Same reason and same result as hcq2.bend and
# support/am/ip.bend: an `@extern` is permanently-red laws plus an import closure
# that reaches the importer's every def. A trace is not.
#
# ===========================================================================
# THE AUDIT. Every constant is generated from the live `autogen.libusb` or
# confirmed against an AST POSITION in `usb.py` -- see THE GATE.

import Base
import ../../helpers.bend as H

# ===========================================================================
# THE ROW BUILDERS. One `name=value` STRING per fact, and the whole block is
# printed with one `IO.print` joined on "\n". That is not a style choice: a
# `do IO<Unit>:` arm and a bare expression arm have DIFFERENT types in Bend
# 2.0.34, an effectful walk over a list is a type error where a pure one is not,
# and a `do` block cannot be followed by the next `def`. Pure rows also make the
# harness's job exact: one line per fact, and `name=value` WHOLE.
# ===========================================================================

def u1(nm: String, v: U32) -> String: String.concat([nm, "=", U32.show(v)])
def b1(nm: String, v: Bool) -> String: String.concat([nm, "=", Bool.show(v)])
def s1(nm: String, v: String) -> String: String.concat([nm, "=", v])

# the six signed libusb error codes diff against CPython's `-10` and not against
# 4294967286: a U32 bit pattern is how the header stores them and a signed C `int`
# is how CPython prints them.
def show_i32(+x: U32) -> String:
  Bool.pick(String, H.i32_is_neg(x),
            String.concat(["-", U32.show(H.i32_abs(H.i32_is_neg(x), x))]), U32.show(x))

def i1(nm: String, v: U32) -> String: String.concat([nm, "=", show_i32(v)])

def lines_of(xs: List<&2, String>) -> String: String.join(xs, "\n")


type Ent is Data:
  Ent{val: U32, name: String}

# ===========================================================================
# THE libusb CONSTANT TABLES, GENERATED FROM `autogen.libusb` -- see
# `usb-gen-tables.py`. Both directions come from ONE list and two folds, because
# that is how the header has them: `enum_libusb_class_code` is a `dict[int, str]`,
# so `enum_nm` is the dict and `enum_val` is its inverse. Keeping them as ONE list
# and two folds is what makes both directions testable over the same data -- a
# table written twice is two tables and one of them is wrong.
#
# `val` is the C bit pattern in a U32, so the six negative libusb error codes are
# stored two's-complement and PRINTED signed by `show_i32`: `usb.py` compares
# against `LIBUSB_ERROR_INTERRUPTED` and the gate has to diff CPython's `-10` and
# not 4294967286.
# ===========================================================================
# `autogen/libusb.py`'s `enum_libusb_class_code`
# `enum_libusb_class_code` binds LIBUSB_CLASS_IMAGE to 6 and then
# LIBUSB_CLASS_PTP to 6, so the TABLE has one name for 6 and the walrus
# leaves `LIBUSB_CLASS_IMAGE` a module global that is not a dict value
# at all. The constant, the table length and the membership test are
# three separate rows because they are three separate facts.
