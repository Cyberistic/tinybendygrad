def nv.rd(+r: Rgv) -> U32: 0

# :25 `update` -- READ THEN WRITE. `mask` is over the NAMES GIVEN, and

# `nv.mask_named` is the mask of THOSE fields; `nv.rd` is the word, so the written
# value is `(word & ~mask_of_these) | encode_of_these`. The OR is on the value,
# the AND is on the read, and swapping them is a silently wrong register write.

def t_mask() -> IO(Unit):
  do IO<Unit>:
    # six SUBSETS, chosen so that a bit-offset error moves one and not another:
    # one field, two ADJACENT (implementation+architecture), two FAR APART
    # (minor_extended_revision+architecture), all six, chip_id ALONE, and EMPTY.
    IP.urow("nv_mask_one", nv.mask_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1)]))
    IP.urow("nv_maskn_one", nv.maskn_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1)]))
    IP.urow("nv_mask_two_adj", nv.mask_of(nv.reg_boot42(), [Kv.of("implementation", 1), Kv.of("architecture", 1)]))
    IP.urow("nv_maskn_two_adj", nv.maskn_of(nv.reg_boot42(), [Kv.of("implementation", 1), Kv.of("architecture", 1)]))
    IP.urow("nv_mask_two_far", nv.mask_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1), Kv.of("architecture", 1)]))
    IP.urow("nv_maskn_two_far", nv.maskn_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1), Kv.of("architecture", 1)]))
    IP.urow("nv_mask_all", nv.mask(nv.reg_boot42()))
    IP.urow("nv_maskn_all", nv.maskn_all())
    IP.urow("nv_mask_impl", nv.mask_of(nv.reg_boot42(), [Kv.of("implementation", 1)]))
    IP.urow("nv_mask_arch", nv.mask_of(nv.reg_boot42(), [Kv.of("architecture", 1)]))
    IP.urow("nv_mask_chipid", nv.mask_of(nv.reg_boot42(), [Kv.of("chip_id", 1)]))
    IP.urow("nv_mask_empty", nv.mask_of(nv.reg_boot42(), []))
    # THE ALIAS ROW, and the reason names are gated. `mask(implementation,
    # architecture)` and `mask(chip_id)` are the SAME NUMBER, 1072693248, because
    # chip_id spans 20:29 and covers both. The oracle agrees, and this row is the
    # proof that the port agrees too: it was MEASURED to be equal, not asserted.
    IP.row("nv_mask_alias_equal", U32.is_eq(nv.mask_of(nv.reg_boot42(), [Kv.of("implementation", 1),
      Kv.of("architecture", 1)]), nv.mask_of(nv.reg_boot42(), [Kv.of("chip_id", 1)])))
    # ... and the NAMES differ, which is the whole point.
    IP.srow("nv_mask_two_adj_names", nv.named(nv.reg_boot42(), [Kv.of("implementation", 1), Kv.of("architecture", 1)]))
    IP.srow("nv_mask_chipid_names", nv.named(nv.reg_boot42(), [Kv.of("chip_id", 1)]))
    # THE MASK-INVARIANT ROW: `decode(mask(names))` puts every NAMED field at its
    # all-ones and every OTHER field at zero. That is what a wrong bit offset
    # breaks, and a COUNT cannot see it.
    IP.srow("nv_maskinv_all", nv.dec(nv.reg_boot42(), nv.mask(nv.reg_boot42())))
    IP.srow("nv_maskinv_impl", nv.dec(nv.reg_boot42(), nv.mask_of(nv.reg_boot42(), [Kv.of("implementation", 1)])))
    IP.srow("nv_maskinv_two_far", nv.dec(nv.reg_boot42(), nv.mask_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1),
      Kv.of("architecture", 1)])))

# `mask` restricted to a SUBSET -- :27's `mask(*names)`. The whole-register mask
# is the empty-subset case and `nv.mask` answers it.

def t_tr_reads() -> IO(Unit):
  do IO<Unit>:
    # :112-113 -- chip_id is a RAW read of BOOT_0 and chip_details a read of
    # BOOT_42, at DIFFERENT word indices, in that order.
    IP.srow("nv_tr_chip", nv.trace(nv.chip_reads(IP.Tr.of())))
    IP.urow("nv_tr_chip_n", IP.Tr.ncalls(nv.chip_reads(IP.Tr.of())))
    # :105 -- the WPR2 read, the config clear, the reset, the config set. The
    # ORDER is the contract and `nv.trace` prints all four in sequence.
    IP.srow("nv_tr_wpr2", nv.trace(nv.wpr2_cfg(IP.Tr.of())))
    IP.urow("nv_tr_wpr2_n", IP.Tr.ncalls(nv.wpr2_cfg(IP.Tr.of())))
    # :131 -- the vram_size read, alone.
    IP.srow("nv_tr_vram", nv.trace(nv.vram_read(IP.Tr.of())))
    # :95 vs :92 -- a read and a write of the SAME word index, distinguished only
    # by the call id. Two files that swapped `rreg` and `wreg` would pass a count.
    IP.srow("nv_tr_rw", nv.trace(nv.rreg(2560, nv.wreg(2560, 436207616, IP.Tr.of()))))
    # the word index, not the byte address: 0xA00 is element 0x280.
    IP.urow("nv_tr_word_a00", nv.word(2560))
    IP.urow("nv_tr_word_0", nv.word(0))
    IP.urow("nv_tr_word_4", nv.word(16))
    # THE PCI COMMAND PAIR, and the fact that both operands are 4.
    IP.urow("nv_pci_command", nv.pci_command())
    IP.urow("nv_pci_master", nv.pci_master())
    IP.urow("nv_cfg_sz", nv.cfg_sz())
    IP.urow("nv_cfg_clear_0000", nv.cfgclear(0))
    IP.urow("nv_cfg_set_0000", nv.cfgset(0))
    IP.urow("nv_cfg_clear_0002", nv.cfgclear(2))
    IP.urow("nv_cfg_set_0002", nv.cfgset(2))
    IP.urow("nv_cfg_clear_0004", nv.cfgclear(4))
    IP.urow("nv_cfg_set_0004", nv.cfgset(4))
    IP.urow("nv_cfg_clear_0006", nv.cfgclear(6))
    IP.urow("nv_cfg_set_0006", nv.cfgset(6))
    IP.urow("nv_cfg_clear_0007", nv.cfgclear(7))
    IP.urow("nv_cfg_set_0007", nv.cfgset(7))
    IP.urow("nv_cfg_clear_ffff", nv.cfgclear(65535))
    IP.urow("nv_cfg_set_ffff", nv.cfgset(65535))

def Kv.v(k: Kv) -> U32:
  match k:
    case Kv{n, +v}: v

# `kv.val` -- the value kwargs gives for a field name, 0 if it gives none. This is
# the U32 arm of Python's `self.fields[name][0]` at :30, and the walk is over the
# REGISTER's field order, which is what turns the overlapping-field case
# (`chip_id` over `implementation`+`architecture`) into a definite number instead
# of an order-dependent one.

def kv.val.go(+ks: List<&2, Kv>, +nm: String, acc: U32) -> U32:
  match ks:
    case Nil{}: acc
    case Kv{n, v} <> r: Bool.pick(U32, String.eq(n, nm), v, kv.val.go(r, nm, acc))

def kv.val(+ks: List<&2, Kv>, +nm: String) -> U32: kv.val.go(ks, nm, 0)

def nv.enc.go(n: Nat, +fs: List<&2, Fld>, +ks: List<&2, Kv>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r: nv.enc.go(m, r, ks, U32.or(acc, nv.fenc(Fld.s(f), kv.val(ks, Fld.n(f)))))

def nv.enc(+r: Rgv, ks: List<&2, Kv>) -> U32: nv.enc.go(Rgv.nat(r), Rgv.fs(r), ks, 0)

# `decode` (:31) -- the ORDERED `name=value,...` string. This is the row that
# sees a transposed field, because it prints names AND bits together.

def t_encode() -> IO(Unit):
  do IO<Unit>:
    # FIFTEEN encode fixtures, and NONE of them is all-equal: the widths are
    # 4,4,4,4,6 and the values span 0..63, so any two rows differ in a bit
    # position that a transposition would move.
    IP.urow("nv_encode_zeros", nv.enc(nv.reg_boot42(), []))
    IP.urow("nv_encode_impl_d", nv.enc(nv.reg_boot42(), [Kv.of("implementation", 13)]))
    IP.urow("nv_encode_impl_f", nv.enc(nv.reg_boot42(), [Kv.of("implementation", 15)]))
    IP.urow("nv_encode_arch_17", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 23)]))
    IP.urow("nv_encode_arch_19", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 25)]))
    IP.urow("nv_encode_arch_1a", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 26)]))
    IP.urow("nv_encode_arch_1b", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 27)]))
    IP.urow("nv_encode_arch_1f", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 31)]))
    IP.urow("nv_encode_arch_20", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 32)]))
    IP.urow("nv_encode_arch_3f", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 63)]))
    IP.urow("nv_encode_boot42_full", nv.enc(nv.reg_boot42(), [Kv.of("minor_extended_revision", 15),
      Kv.of("minor_revision", 15), Kv.of("major_revision", 15), Kv.of("implementation", 15),
      Kv.of("architecture", 63)]))
    IP.srow("nv_stray_empty", kv.stray(nv.reg_boot42(), [Kv.of("architecture", 26)]))
    IP.srow("nv_stray_named", kv.stray(nv.reg_boot42(), [Kv.of("nope", 1)]))
    # decode of each encode: name AND value together. THE ORDER IS IN HERE.
    IP.srow("nv_decode_impl_d", nv.dec(nv.reg_boot42(), nv.enc(nv.reg_boot42(), [Kv.of("implementation", 13)])))
    IP.srow("nv_decode_arch_1a", nv.dec(nv.reg_boot42(), nv.enc(nv.reg_boot42(), [Kv.of("architecture", 26)])))
    IP.srow("nv_decode_arch_1b", nv.dec(nv.reg_boot42(), nv.enc(nv.reg_boot42(), [Kv.of("architecture", 27)])))
    IP.srow("nv_decode_arch_3f", nv.dec(nv.reg_boot42(), nv.enc(nv.reg_boot42(), [Kv.of("architecture", 63)])))
    IP.srow("nv_decode_boot42_full", nv.dec(nv.reg_boot42(), nv.enc(nv.reg_boot42(), [Kv.of("minor_extended_revision", 15),
      Kv.of("minor_revision", 15), Kv.of("major_revision", 15), Kv.of("implementation", 15),
      Kv.of("architecture", 63)])))
    IP.srow("nv_decode_order_boot42", nv.names(nv.reg_boot42()))
    # NV_PMC_BOOT_0, whose field ORDER IS NOT SORTED BY BIT POSITION:
    # `architecture_1` at bit 8 sits between `major_revision` (4:7) and
    # `implementation` (20:23). A port that sorted the fields would still have
    # the right count and the right set.
    IP.srow("nv_decode_boot0_full", nv.dec(nv.reg_boot0(), nv.enc(nv.reg_boot0(), [Kv.of("minor_revision", 15),
      Kv.of("major_revision", 15), Kv.of("architecture_1", 1), Kv.of("implementation", 15),
      Kv.of("architecture_0", 31)])))
    IP.srow("nv_decode_order_boot0", nv.names(nv.reg_boot0()))
    IP.urow("nv_encode_boot0_full", nv.enc(nv.reg_boot0(), [Kv.of("minor_revision", 15),
      Kv.of("major_revision", 15), Kv.of("architecture_1", 1), Kv.of("implementation", 15),
      Kv.of("architecture_0", 31)]))
    IP.urow("nv_encode_boot0_17d", nv.enc(nv.reg_boot0(), [Kv.of("minor_revision", 3), Kv.of("major_revision", 7),
      Kv.of("architecture_1", 1), Kv.of("implementation", 13), Kv.of("architecture_0", 23)]))

# `update` (:25) -- READ THEN WRITE, and the value is the ANSWER, not its parts.

def t_boot() -> IO(Unit):
  do IO<Unit>:
    t_ru(0)
    t_ru(1)
    t_ru(4095)
    t_ru(4096)
    t_ru(4097)
    t_ru(8191)
    t_ru(8192)
    t_ru(74565)
    t_ru(1048576)
    IP.urow("nv_bar1_lo", nv.bar1_lo())
    IP.urow("nv_bar1_hi", nv.bar1_hi())
    IP.urow("nv_page", nv.page())
    t_sa(0, 1n)
    t_sa(0, 2n)
    t_sa(0, 3n)
    t_sa(8192, 1n)
    t_sa(8192, 2n)
    t_sa(16384, 3n)
    t_sa(2097152, 2n)
    # THE SYSDADDR OVERFLOW, as rows: bar1 is 2^32, so element 0 of any list
    # already overflows a U32 and element 1 carries the carry.
    IP.urow("nv_sysaddr_lo_0", nv.sysaddr_lo(0, 0))
    IP.urow("nv_sysaddr_hi_0", nv.sysaddr_hi(0, 0))
    IP.urow("nv_sysaddr_lo_1", nv.sysaddr_lo(0, 1))
    IP.urow("nv_sysaddr_hi_1", nv.sysaddr_hi(0, 1))
    IP.urow("nv_sysaddr_lo_3", nv.sysaddr_lo(8192, 3))
    IP.urow("nv_sysaddr_hi_3", nv.sysaddr_hi(8192, 3))
    # on_range_mapped's value, in halves.
    IP.urow("nv_inval_lo", nv.inval_lo())
    IP.urow("nv_inval_hi", nv.inval_hi())
    IP.srow("nv_inval_bits", nv.inval_bits())
    IP.urow("nv_inval_value_lo", nv.enc(nv.reg_inval(), [Kv.of("all_va", 1), Kv.of("all_pdb", 1),
      Kv.of("sys_membar", 1), Kv.of("trigger", 1)]))
    IP.srow("nv_inval_at_0", nv.at_field(nv.reg_inval(), 0))
    IP.srow("nv_inval_at_1", nv.at_field(nv.reg_inval(), 1))
    IP.srow("nv_inval_at_6", nv.at_field(nv.reg_inval(), 6))
    IP.srow("nv_inval_at_31", nv.at_field(nv.reg_inval(), 31))

def nv.reg_write(+r: Rgv, ini: U32, ks: List<&2, Kv>, t: IP.Tr) -> IP.Tr:
  nv.wreg(Rgv.addr(nv.reg_boot42()), U32.or(ini, nv.enc(r, ks)), t)

# The `read()` answer `update` needs, INJECTED. :25 is
# `self.write(self.read() & ~self.mask(*kwargs.keys()), **kwargs)`, and the read
# is device memory, so it is a parameter rather than a second trace call: one
# update is ONE write plus one read it already knows.

def nv.on_range_mapped(t: IP.Tr) -> IP.Tr:
  nv.reg_write(nv.reg_inval(), 0, [Kv.of("all_va", 1), Kv.of("all_pdb", 1),
    Kv.of("sys_membar", 1), Kv.of("trigger", 1)], t)

# :88-89 `fini` -- `for ip in [self.gsp, self.flcn]: ip.fini_hw()`, so GSP FIRST
# and FLCN SECOND. That is the REVERSE of `__init__`'s init order (:85-86 loop
# over [flcn, gsp]), and the reversal is the whole of the two lines.

def t_tr_boot() -> IO(Unit):
  do IO<Unit>:
    # :152 -- the sysmem branch, one call, and the size is the UNROUNDED one.
    IP.srow("nv_tr_sysmem", nv.trace(nv.boot_sysmem(4097, True{}, IP.Tr.of())))
    # :155-157 -- the palloc branch: palloc THEN the bar map carrying the paddr.
    IP.srow("nv_tr_vramboot", nv.trace(nv.boot_vram(8192, 8192, IP.Tr.of())))
    # :158 -- the view write, whose length is `size` and NOT the rounded `sz`.
    IP.srow("nv_tr_fill", nv.trace(nv.boot_fill(4097, IP.Tr.of())))
    # A REFUSAL IS A TRUNCATION. `IP.Tr.fail_at` stops the chain at that ordinal,
    # so a refused palloc shows a trace with ONE call and not two -- no guard of
    # its own anywhere, because the seam is the trace.
    IP.srow("nv_tr_refuse_1", nv.trace(IP.Tr.fail_at(nv.boot_vram(8192, 8192, IP.Tr.of()), 1)))
    IP.urow("nv_tr_refuse_1_n", IP.Tr.ncalls(IP.Tr.fail_at(nv.boot_vram(8192, 8192, IP.Tr.of()), 1)))
    IP.srow("nv_tr_refuse_2", nv.trace(IP.Tr.fail_at(nv.boot_vram(8192, 8192, IP.Tr.of()), 2)))
    IP.urow("nv_tr_refuse_2_n", IP.Tr.ncalls(IP.Tr.fail_at(nv.boot_vram(8192, 8192, IP.Tr.of()), 2)))
    IP.srow("nv_tr_refuse_inval", nv.trace(IP.Tr.fail_at(nv.on_range_mapped(IP.Tr.of()), 1)))
    IP.urow("nv_tr_refuse_inval_n", IP.Tr.ncalls(IP.Tr.fail_at(nv.on_range_mapped(IP.Tr.of()), 1)))
    # and the whole chain at fail 0 (never) is the untruncated one, so the three
    # above are visibly a PREFIX of it rather than a different trace.
    IP.srow("nv_tr_norefine", nv.trace(nv.boot_vram(8192, 8192, IP.Tr.of())))
    IP.urow("nv_tr_norefine_n", IP.Tr.ncalls(nv.boot_vram(8192, 8192, IP.Tr.of())))

def nv.update(+r: Rgv, +ks: List<&2, Kv>, word: U32, t: IP.Tr) -> IP.Tr:
  nv.reg_write(r, nv.upd_ini(r, ks, word), ks, t)

# :72 `on_range_mapped` -- ONE register write of (1<<0)|(1<<1)|(1<<6)|(1<<31) =
# 0x80000003, through NV_VIRTUAL_FUNCTION_PRIV_MMU_INVALIDATE. Bit 31 is the top
# bit of the word, and that register's OWN field table names bits 0, 1, 6 and 31
# `all_va`, `all_pdb`, `sys_membar`, `trigger` -- so the write is expressed as
# four named fields, which is the only representation in which it is checkable.

def t_tr_writes() -> IO(Unit):
  do IO<Unit>:
    # :72 -- on_range_mapped writes 0x80000003 through FOUR NAMED FIELDS, and the
    # trace carries the low word. The high bit is `trigger` at bit 31, which is
    # the word's TOP bit and not a negative number.
    IP.srow("nv_tr_inval", nv.trace(nv.on_range_mapped(IP.Tr.of())))
    IP.urow("nv_tr_inval_n", IP.Tr.ncalls(nv.on_range_mapped(IP.Tr.of())))
    IP.urow("nv_tr_inval_hi", nv.inval_hi())
    # an update is ONE write: `nv.update` injects the read, so the trace has a
    # single call. That is a real property of the port and the row pins it.
    IP.srow("nv_tr_upd", nv.trace(nv.update(nv.reg_boot42(), [Kv.of("architecture", 26)], 0, IP.Tr.of())))
    IP.urow("nv_tr_upd_n", IP.Tr.ncalls(nv.update(nv.reg_boot42(), [Kv.of("architecture", 26)], 0, IP.Tr.of())))

def t_trace() -> IO(Unit):
  do IO<Unit>:
    t_tr_reads()
    t_tr_writes()
    t_tr_init()
    t_tr_mmu()
    t_tr_boot()
    t_tr_refuse()
    t_end()

def nv.arch_val(+r: Rgv, a: U32) -> U32:
  nv.getb(nv.enc(r, [Kv.of("architecture", a)]), nv.fld_of(r, "architecture", 0),
    nv.fld_of(r, "architecture", 1))

# `fld_of` -- one field's start (which=0) or end (which=1) BY NAME. The name is
# the input, so a transposed NAME in the table moves this and nothing else.

def t_arch(+a: U32) -> IO(Unit):
  do IO<Unit>:
    IP.urow(String.concat(["nv_arch_", IP.hex8(a)]), nv.arch_val(nv.reg_boot42(), a))
    IP.srow(String.concat(["nv_fam_", IP.hex8(a)]), nv.fam(nv.arch_val(nv.reg_boot42(), a)))
    IP.urow(String.concat(["nv_mmuver_", IP.hex8(a)]), nv.mmuver(nv.arch_val(nv.reg_boot42(), a)))
    IP.urow(String.concat(["nv_fmcboot_", IP.hex8(a)]), Bool.to_u32(nv.fmcboot(nv.arch_val(nv.reg_boot42(), a))))
    IP.srow(String.concat(["nv_chipname_", IP.hex8(a), "_0d"]), nv.chipname(nv.arch_val(nv.reg_boot42(), a), 13))
    IP.srow(String.concat(["nv_chipname_", IP.hex8(a), "_00"]), nv.chipname(nv.arch_val(nv.reg_boot42(), a), 0))
    IP.srow(String.concat(["nv_fwname_", IP.hex8(a), "_0d"]), nv.fw(nv.chipprefix(nv.arch_val(nv.reg_boot42(), a))))
    IP.srow(String.concat(["nv_chipname_len_", IP.hex8(a), "_0d"]), U32.show(U32.from_nat(
      String.length(nv.chipname(nv.arch_val(nv.reg_boot42(), a), 13)))))
    IP.srow(String.concat(["nv_chipprefix_", IP.hex8(a), "_0d"]), nv.chipprefix(nv.arch_val(nv.reg_boot42(), a)))

# `arch_val` -- the ROUND TRIP: encode `architecture` into BOOT_42's word and read
# it back out of the `architecture` field. This is :113's `read_bitfields()` and
# it is a ROUND TRIP on purpose: an encode and a decode that share a wrong offset
# would cancel, so the row that matters is the WORD (`nv_encode_*`), and this one
# proves the port's decode agrees with its own encode at the field's own place.

def t_chip() -> IO(Unit):
  do IO<Unit>:
    # TWELVE architectures, chosen to straddle the 0x1a boundary from both sides
    # AND to include two values ABOVE 0x1f where BOOT_0's five-bit
    # `architecture_0` and BOOT_42's six-bit `architecture` DISAGREE. 0x20 and
    # 0x3f are in BOOT_42's range and not BOOT_0's: a port that read BOOT_0's
    # field would answer a DIFFERENT mmu_ver for both, and no row that only
    # sampled 0x17/0x19/0x1b would see it.
    t_arch(0)
    t_arch(23)
    t_arch(24)
    t_arch(25)
    t_arch(26)
    t_arch(27)
    t_arch(28)
    t_arch(29)
    t_arch(30)
    t_arch(31)
    t_arch(32)
    t_arch(63)
    IP.urow("nv_archmap_n", nv.archmap_n())
    IP.srow("nv_archmap_17", nv.archmap(23))
    IP.srow("nv_archmap_19", nv.archmap(25))
    IP.srow("nv_archmap_1b", nv.archmap(27))
    IP.srow("nv_fwmap_GB2", nv.fw("GB2"))
    IP.srow("nv_fwmap_AD1", nv.fw("AD1"))
    IP.srow("nv_fwmap_GA1", nv.fw("GA1"))
    # THE BOOT_0 / BOOT_42 FIELD DISAGREEMENT, as rows. Both are registers in
    # this file and both are read by _early_ip_init, one at :112 and one at :113.
    IP.urow("nv_boot42_arch_lo", nv.fld_of(nv.reg_boot42(), "architecture", 0))
    IP.urow("nv_boot42_arch_hi", nv.fld_of(nv.reg_boot42(), "architecture", 1))
    IP.urow("nv_boot42_impl_lo", nv.fld_of(nv.reg_boot42(), "implementation", 0))
    IP.urow("nv_boot42_impl_hi", nv.fld_of(nv.reg_boot42(), "implementation", 1))
    IP.urow("nv_boot42_chipid_lo", nv.fld_of(nv.reg_boot42(), "chip_id", 0))
    IP.urow("nv_boot42_chipid_hi", nv.fld_of(nv.reg_boot42(), "chip_id", 1))
    IP.urow("nv_boot42_chipid_span", nv.chipid_span())
    # chip_id SPANS implementation AND architecture -- three names, one word, two
    # overlapping fields. The span row is what makes that a fact rather than a
    # reading of the table.
    IP.srow("nv_boot42_chipid_over", nv.dec(nv.reg_boot42(), nv.fmask(
      nv.fld_of(nv.reg_boot42(), "chip_id", 0), nv.fld_of(nv.reg_boot42(), "chip_id", 1))))
    # the two raw register reads at :112 and :113, which are DIFFERENT ADDRESSES
    IP.urow("nv_chipid_addr", nv.chipid_addr())
    IP.urow("nv_chipdet_addr", nv.chipdet_addr())
    IP.urow("nv_wpr2_addr", nv.wpr2_addr())
    IP.urow("nv_scratch42_addr", nv.scratch42_addr())
    IP.urow("nv_inval_addr", Rgv.addr(nv.reg_inval()))
    IP.urow("nv_chipid_reg_base", Rgv.base(nv.reg_boot0()))
    IP.urow("nv_chipid_reg_off", Rgv.off(nv.reg_boot0()))
    IP.urow("nv_boot42_reg_off", Rgv.off(nv.reg_boot42()))

def nv.upd_w(+r: Rgv, +ks: List<&2, Kv>, word: U32) -> U32:
  U32.or(nv.upd_ini(r, ks, word), nv.enc(r, ks))

# --- THE CHIP TABLES. Three architectures in the dict, and the `>= 0x1a` branch.

def t_update() -> IO(Unit):
  do IO<Unit>:
    # u1: read all ones, set implementation=13. The write must clear ONLY
    # implementation's four bits and leave architecture's six alone.
    IP.urow("nv_upd_u1_mask", nv.upd_mask(nv.reg_boot42(), [Kv.of("implementation", 13)]))
    IP.urow("nv_upd_u1_ini", nv.upd_ini(nv.reg_boot42(), [Kv.of("implementation", 13)], 4294967295))
    IP.urow("nv_upd_u1_enc", nv.enc(nv.reg_boot42(), [Kv.of("implementation", 13)]))
    IP.urow("nv_upd_u1_w", nv.upd_w(nv.reg_boot42(), [Kv.of("implementation", 13)], 4294967295))
    IP.srow("nv_upd_u1_tr", nv.trace(nv.update(nv.reg_boot42(), [Kv.of("implementation", 13)], 4294967295, IP.Tr.of())))
    # u2: read ZERO, set architecture=26. Nothing to clear, so ini == 0.
    IP.urow("nv_upd_u2_mask", nv.upd_mask(nv.reg_boot42(), [Kv.of("architecture", 26)]))
    IP.urow("nv_upd_u2_ini", nv.upd_ini(nv.reg_boot42(), [Kv.of("architecture", 26)], 0))
    IP.urow("nv_upd_u2_w", nv.upd_w(nv.reg_boot42(), [Kv.of("architecture", 26)], 0))
    IP.srow("nv_upd_u2_tr", nv.trace(nv.update(nv.reg_boot42(), [Kv.of("architecture", 26)], 0, IP.Tr.of())))
    # u3: read 0xdeadbeef -- NON-UNIFORM, every byte differs -- and set two
    # ADJACENT fields. This is the fixture a transposition of `minor_revision`
    # and `major_revision` would move and a constant fixture would not.
    IP.urow("nv_upd_u3_mask", nv.upd_mask(nv.reg_boot42(), [Kv.of("minor_revision", 0), Kv.of("major_revision", 7)]))
    IP.urow("nv_upd_u3_ini", nv.upd_ini(nv.reg_boot42(), [Kv.of("minor_revision", 0), Kv.of("major_revision", 7)], 3735928559))
    IP.urow("nv_upd_u3_w", nv.upd_w(nv.reg_boot42(), [Kv.of("minor_revision", 0), Kv.of("major_revision", 7)], 3735928559))
    IP.srow("nv_upd_u3_tr", nv.trace(nv.update(nv.reg_boot42(), [Kv.of("minor_revision", 0), Kv.of("major_revision", 7)], 3735928559, IP.Tr.of())))
    # u4: read 0xA00 -- the register's OWN offset -- and set BOTH halves of the
    # chip_id alias. The write is the mask plus the encode, and the two overlap.
    IP.urow("nv_upd_u4_mask", nv.upd_mask(nv.reg_boot42(), [Kv.of("architecture", 27), Kv.of("implementation", 1)]))
    IP.urow("nv_upd_u4_ini", nv.upd_ini(nv.reg_boot42(), [Kv.of("architecture", 27), Kv.of("implementation", 1)], 2560))
    IP.urow("nv_upd_u4_enc", nv.enc(nv.reg_boot42(), [Kv.of("architecture", 27), Kv.of("implementation", 1)]))
    IP.urow("nv_upd_u4_w", nv.upd_w(nv.reg_boot42(), [Kv.of("architecture", 27), Kv.of("implementation", 1)], 2560))
    IP.srow("nv_upd_u4_tr", nv.trace(nv.update(nv.reg_boot42(), [Kv.of("architecture", 27), Kv.of("implementation", 1)], 2560, IP.Tr.of())))

# `nv.cover_fits` -- does this level's page size fit a U32? `1 << 38`, `1 << 47`
# and `1 << 56` do NOT, and they wrap to 0 in `nv.covers`, which makes
# `supports_huge_page` a `% 0` -- the zero-divisor branch -- at lv 0 and 1 on ver 3.
# That is the wall as a CONSEQUENCE rather than as a number, and the oracle's
# `nv_d_*_cover_exact` carries the value that does not fit.
#
# The check is on the SHIFT (`sh <= 32`), read from the REVERSED shift list, so it
# agrees with `nv.covers` by construction rather than by being a second ladder.

def nv.revs.go(n: Nat, +xs: List<&2, U32>, +acc: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n: List.reverse(&2, U32, acc)
    case 1n+m:
      match xs:
        case Nil{}: List.reverse(&2, U32, acc)
        case x <> r: nv.revs.go(m, r, List.append(&2, U32, acc, [x]))

def nv.rev_shifts(+v: U32) -> List<&2, U32>: nv.revs.go(nv.shifts_nat(v), nv.va_shifts(v), Nil{})

# `nv.revs` -- `va_shifts[::-1]` and NOTHING ELSE. `nv.rev.go` is the SAME fold with
# `pw_of` on each element, because it was written for `pte_covers`; reusing it here
# gave `shift_at(v, 0) == 2^47` instead of `47`, so `cover_fits` was the complement
# of the truth at EVERY level and the gate caught all fourteen. Two folds that
# differ only in a per-element map are two defs, not one parameter -- a Bool
# parameter would have been a runtime branch in a hot walk for nothing.

def nv.shift_at(+v: U32, lv: U32) -> U32: nv.at(nv.shifts_nat(v), nv.rev_shifts(v), lv)

# `va_shifts` REVERSED, so index 0 is the largest shift and index n-1 the page
# size -- the same order `nv.covers` has.

# The level bound is part of the answer: at lv == level_cnt there is no page size,
# and `nv.at` answers 0 out of range, and `0 <= 32` is TRUE -- so without the bound
# an out-of-range level claims to FIT.

def nv.cover_fits(+v: U32, +lv: U32) -> Bool:
  Bool.and(U32.is_lt(lv, nv.level_cnt(v)), U32.is_le(nv.shift_at(v, lv), 32))

def t_pte_l(+v: U32, +lv: U32) -> IO(Unit):
  do IO<Unit>:
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_level_cnt"]), nv.level_cnt(v))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_dual"]), Bool.to_u32(nv.pte_dual(v, lv)))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_ispage"]), Bool.to_u32(nv.pte_ispage(v, lv, 0)))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_ispage_e2"]), Bool.to_u32(nv.pte_ispage2(v, lv, 1)))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_validkey"]), nv.pte_validkey(v, lv))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_small"]), nv.pte_small(v, lv))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_sys"]), nv.pte_sys(v, lv))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_addrkey"]), nv.pte_addrkey(v, lv))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_addrsh"]), nv.pte_addrsh())
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_cover"]), nv.huge_cover(v, lv))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_ispage_top"]), Bool.to_u32(nv.ispage_top(v, lv)))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_cover_fits"]), Bool.to_u32(nv.cover_fits(v, lv)))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_lvmin"]), nv.huge_lvmin(v))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_addrshift"]), nv.pte_paddr(2097152))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_idx0"]), nv.pte_idx(v, lv, 0))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_idx2"]), nv.pte_idx(v, lv, 2))
    IP.urow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_idxlo2"]), nv.pte_idx_lo(v, lv, 2))
    # supports_huge_page over FOUR paddrs, INCLUDING the boundary paddr%cover==0
    # and the one-off 0x200001 that differs from it in the LAST BIT. The pair is
    # what pins the `%`, and no single value does.
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_0"]), nv.huge_str(v, lv, 0))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_200000"]), nv.huge_str(v, lv, 2097152))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_200001"]), nv.huge_str(v, lv, 2097153))
    IP.srow(String.concat(["nv_d_", nv.v_tag(v), "_l", nv.vl_tag(v, lv), "_huge_12345000"]), nv.huge_str(v, lv, 305418240))

def t_pte_v(+v: U32) -> IO(Unit):
  do IO<Unit>:
    t_pte_l(v, 0)
    t_pte_l(v, 1)
    t_pte_l(v, 2)
    t_pte_l(v, 3)
    t_pte_l(v, 4)
    t_pte_l(v, 5)
    t_pte_l(v, 6)
    t_end()

def t_pte() -> IO(Unit):
  do IO<Unit>:
    t_pte_v(2)
    t_pte_v(3)
    t_end()

# `nv.pow_shifts` -- `[1 << x for x in va_shifts]` with NO `[::-1]`. It exists
# ONLY so the mutation "drop the reversal" has a real alternative to swap in; it
# has no caller, which is stated here rather than left to be discovered.

def nv.pow.go(n: Nat, +xs: List<&2, U32>, +acc: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n: acc
    case 1n+m:
      match xs:
        case Nil{}: acc
        case x <> r: nv.pow.go(m, r, List.append(&2, U32, acc, [nv.pw_of(x)]))

def nv.pow_shifts(+v: U32) -> List<&2, U32>: nv.pow.go(nv.shifts_nat(v), nv.va_shifts(v), Nil{})

def main() -> IO(Unit):
  do IO<Unit>:
    +a : Unit <- t_regs()
