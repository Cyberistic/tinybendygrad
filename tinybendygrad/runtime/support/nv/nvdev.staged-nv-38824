def nv.pte_small(+v: U32, lv: U32) -> String: Bool.pick(String, nv.pte_dual(v, lv), "_small", "")

# `nv_is_page_lvmax_*` and `nv_huge_lvmin_*` are :58's `level_cnt - 1` and :59's
# `level_cnt - 3`. THREE BOUNDS OFF ONE NUMBER, and the port keeps them as three
