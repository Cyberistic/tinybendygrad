# ---------------------------------------------------------------------------
# THE CHIP TABLES, :114-116. `chip_details` is `NV_PMC_BOOT_42.read_bitfields()`
# -- so the `architecture` here is BOOT_42's field, bits (24,29), SIX bits wide.
# NV_PMC_BOOT_0 has a field also called architecture-ish, `architecture_0` at
# (24,28), FIVE bits, and it is a DIFFERENT register read at a different offset
# (BOOT_0 is 0x0, BOOT_42 is 0xA00). The first draft of the oracle read BOOT_0's
# and every `>= 0x1a` verdict above 0x1f moved. That is why the row is `nv_arch_*`
# OFF BOOT_42 and the offset is a separate row, `nv_reg_boot42_off`.
# ---------------------------------------------------------------------------

def nv.chipid_addr() -> U32: U32.add(Rgv.base(nv.reg_boot0()), Rgv.off(nv.reg_boot0()))

def nv.chipdet_addr() -> U32: U32.add(Rgv.base(nv.reg_boot42()), Rgv.off(nv.reg_boot42()))

# :105 `NV_PFB_PRI_MMU_WPR2_ADDR_HI.read() != 0` -- the WPR2-IS-UP test. The
# REGISTER lives in dev_fb (not dev_bus), and its single field `val` is bits
# 4:31, so `!= 0` is NOT the same test as `mask("val") != 0`: bits 0..3 are
# outside the field and a word of 0x8 reads as 0 here and as 8 raw.

def nv.chip_reads(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_RREG(), nv.word(nv.chipid_addr()), 0, 0),
            Cal.of(C_NV_RREG(), nv.word(nv.chipdet_addr()), 0, 0)], t)

# :131 `vram_size = NV_PGC6_AON_SECURE_SCRATCH_GROUP_42.read() << 20` -- the
# register is a RAW read (it has NO fields at all, `nv_mmcnt_scratch` is 0), and
# the `<< 20` is the 32-bit wall: see `nv_vram_lo`/`nv_vram_hi`.

def nv.wpr2_addr() -> U32: U32.add(Rgv.base(nv.reg_wpr2()), Rgv.off(nv.reg_wpr2()))

def nv.wpr2_cfg(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_RREG(), nv.word(nv.wpr2_addr()), 0, 0),
            Cal.of(C_NV_CFG_W(), nv.pci_command(), nv.cfgclear(6), nv.cfg_sz()),
            Cal.of(C_NV_RESET(), 0, 0, 0),
            Cal.of(C_NV_CFG_W(), nv.pci_command(), nv.cfgset(6), nv.cfg_sz())], t)

# :112-113 -- chip_id is a RAW read of BOOT_0, chip_details a read of BOOT_42, and
# they are TWO DIFFERENT ADDRESSES (:112's off is 0, :113's is 0xA00). Swapping
# them is a chip that identifies as a different one.

def nv.scratch42_addr() -> U32: U32.add(Rgv.base(nv.reg_scratch()), Rgv.off(nv.reg_scratch()))

# :106,:111 -- `write_config_flush(pci.PCI_COMMAND, read_config(pci.PCI_COMMAND, 2)
# & ~pci.PCI_COMMAND_MASTER, 2)` then the same with `|`. BOTH operands are 4
# (PCI_COMMAND == PCI_COMMAND_MASTER == 4), which makes the clear a no-op on the
# master bit and is itself worth a row.

def nv.vram_read(t: IP.Tr) -> IP.Tr:
  IP.Tr.emit(C_NV_RREG(), nv.word(nv.scratch42_addr()), 0, 0, t)

# :133 -- `self.vram, self.mmio = self.pci_dev.map_bar(1),
# self.pci_dev.map_bar(0, fmt='I')`. BAR 1 THEN BAR 0, with a format on the second
# and not the first; `b` carries that.

# THE HIGH WORD IS THE 32-BIT WALL, STATED. `bar1_hi` is 1 for EVERY element --
# `bar_info(1)[0]` is 2^32, so `bar + paddr + i*0x1000` is a 33-bit value whose
# high word is 1 whatever the offset. The only thing that could make it 2 is a
# CARRY out of `paddr + i*0x1000`, and a U32 that already wrapped cannot be told
# from one that did not, so the carry is unrepresentable. Every paddr a page-table
# walk sees comes from `palloc` inside a vram window and so `paddr + sz < 2^32`;
# outside that range this UNDER-answers by one, and that is the wall, not a bug.

def nv.sysaddr_hi(+paddr: U32, +i: U32) -> U32: nv.bar1_hi()

# ---------------------------------------------------------------------------
# THE TRACE. Every def below EITHER builds the argument of ONE call (above) OR
# records that call (here). There is no third kind, and the raise lives in the
# trace, so a refusal is a TRUNCATED trace and no step needs a guard of its own.
#

def nv.sah.go(n: Nat, +paddr: U32, +i: U32, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      nv.sah.go(m, paddr, U32.add(i, 1), List.append(&2, String, acc,
        [U32.show(nv.sysaddr_hi(paddr, i))]))

def nv.sysaddr_hi_str(paddr: U32, np: Nat) -> String:
  String.join(nv.sah.go(np, paddr, 0, Nil{}), ",")

def t_sa(+paddr: U32, +np: Nat) -> IO(Unit):
  do IO<Unit>:
    IP.srow(String.concat(["nv_sysaddr_", nv.sa_tag(paddr, np)]), nv.sysaddr_str(paddr, np))
    IP.srow(String.concat(["nv_sysaddr_hi_", nv.sa_tag(paddr, np)]), nv.sysaddr_hi_str(paddr, np))

# `nv.chain` is the only sequencing device, and it is a list fold rather than a
# nest of `Bool.pick`s for a measured reason: `Bool.pick` CHOOSES an arm and
# `IP.Tr.emit` is pure, so a chain written as nested picks would work but a chain
# written as nested `match`es cannot -- a `match` may not scrutinise a computed
# value, and `Tr.emit(...)` is one. The fold states the ORDER in the literal.
# ---------------------------------------------------------------------------

def nv.wide_names(+r: Rgv) -> String:
  String.join(nv.wn.go(Rgv.nat(r), Rgv.fs(r), Nil{}), ",")

def nv.mask_of(+r: Rgv, ks: List<&2, Kv>) -> U32: nv.mk.go(Rgv.nat(r), Rgv.fs(r), ks, 0)

def nv.named(+r: Rgv, ks: List<&2, Kv>) -> String:
  String.join(nv.nd.go(Rgv.nat(r), Rgv.fs(r), ks, Nil{}), ",")

def nv.upd_mask(+r: Rgv, ks: List<&2, Kv>) -> U32: nv.mask_of(r, ks)

def nv.fld_of(+r: Rgv, nm: String, which: U32) -> U32: nv.fo.go(Rgv.nat(r), Rgv.fs(r), nm, which, 0)

# --- PER-FIELD ROWS. THE ORDER-INSIDE-A-PAIR CHECK, per SITE.
#
# `Se` is `(start, end)` as a VALUE rather than two lookups, and it exists for a
# linearity reason, not a taste one: a `String` in Bend 2 is consumed by its one
# use, so a helper that needed the field name twice to read two elements could
# not exist. One fold, one use of the name, both elements out.
type Se is Data:
  Se{s: U32, e: U32}

def Se.of(s: U32, e: U32) -> Se:
  Se{s, e}

def Se.s(x: Se) -> U32:
  match x:
    case Se{+s, e}: s

def Se.e(x: Se) -> U32:
  match x:
    case Se{s, +e}: e

def nv.pe.go(n: Nat, +fs: List<&2, Fld>, +nm: String, acc: Se) -> Se:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r: Bool.pick(Se, String.eq(Fld.n(f), nm), Se.of(Fld.s(f), Fld.e(f)), nv.pe.go(m, r, nm, acc))

def nv.fld_se(+r: Rgv, nm: String) -> Se: nv.pe.go(Rgv.nat(r), Rgv.fs(r), nm, Se.of(0, 0))

# THE ROUND TRIP, AND IT NEEDS THE ALL-ONES WORD. Measured: the two naive probes
# are provably BLIND to a transposition, i.e. as gates they cannot fail --
#   getb(enc(1))       = 1 under (8,11) AND 1 under (11,8)
#   getb(enc(pw(w-1))) = 8 under (8,11) AND 0 under (11,8), and the expected
#                        pw(w-1) is 0 there too, because pw saturates to 0
# `nv.fenc(4294967295, s)` loses the top s bits, so `getb` of it is `ones(w)`
# whatever w is. That is the point: the round trip's expected value must come
# from CPython's `w`, and any probe whose expectation is derived from the SAME
# (s,e) is a tautology -- the port agreeing with itself.

def nv.se_w(+x: Se) -> U32: nv.wid(Se.s(x), Se.e(x))

def nv.se_abw(+x: Se) -> String:
  String.concat([U32.show(Se.s(x)), ":", U32.show(Se.e(x)), ":", U32.show(nv.wid(Se.s(x), Se.e(x)))])

def nv.se_max(+x: Se) -> U32: nv.getb(nv.fenc(Se.s(x), 4294967295), Se.s(x), Se.e(x))

def nv.fld_w(r: Rgv, nm: String) -> U32: nv.se_w(nv.fld_se(r, nm))

def nv.fld_abw(r: Rgv, nm: String) -> String: nv.se_abw(nv.fld_se(r, nm))

def nv.fld_max(r: Rgv, nm: String) -> U32: nv.se_max(nv.fld_se(r, nm))

# ONE ROW GROUP PER FIELD for the WHOLE table, so the check is per SITE and not a
# property of one lucky register. The expected values are CPython's --
# nv_nvdev_oracle.py's `(a, b, b - a + 1)`, `B42.mask(nm)` and
# `getbits(4294967295, a, b)`. Between them a transposition cannot hide: `wid` is
# not symmetric modulo 2^32 for any w <= 32, so the width row moves on every one.
#
# THE ROW NAMES ARE LITERALS AND SO IS THE LOOKUP KEY, because a `String` is
# consumed by its one use: a def that built `"nv_fld_" ++ nm` and then looked the
# field up by `nm` could not exist. Fourteen literals per register is cheaper than
# the alternatives, and it has the property that matters -- a mutation has to be
# written out per field to be seen, rather than hiding inside a name that a fold
# rebuilds identically either way.
def t_flds_b42() -> IO(Unit):
  do IO<Unit>:
    IP.srow("nv_fld_minor_extended_revision", nv.fld_abw(nv.reg_boot42(), "minor_extended_revision"))
    IP.urow("nv_fldmask_minor_extended_revision", nv.mask_of(nv.reg_boot42(), [Kv.of("minor_extended_revision", 1)]))
    IP.urow("nv_fldwidth_minor_extended_revision", nv.fld_w(nv.reg_boot42(), "minor_extended_revision"))
    IP.urow("nv_fldmax_minor_extended_revision", nv.fld_max(nv.reg_boot42(), "minor_extended_revision"))
    IP.srow("nv_fld_minor_revision", nv.fld_abw(nv.reg_boot42(), "minor_revision"))
    IP.urow("nv_fldmask_minor_revision", nv.mask_of(nv.reg_boot42(), [Kv.of("minor_revision", 1)]))
    IP.urow("nv_fldwidth_minor_revision", nv.fld_w(nv.reg_boot42(), "minor_revision"))
    IP.urow("nv_fldmax_minor_revision", nv.fld_max(nv.reg_boot42(), "minor_revision"))
    IP.srow("nv_fld_major_revision", nv.fld_abw(nv.reg_boot42(), "major_revision"))
    IP.urow("nv_fldmask_major_revision", nv.mask_of(nv.reg_boot42(), [Kv.of("major_revision", 1)]))
    IP.urow("nv_fldwidth_major_revision", nv.fld_w(nv.reg_boot42(), "major_revision"))
    IP.urow("nv_fldmax_major_revision", nv.fld_max(nv.reg_boot42(), "major_revision"))
    IP.srow("nv_fld_implementation", nv.fld_abw(nv.reg_boot42(), "implementation"))
    IP.urow("nv_fldmask_implementation", nv.mask_of(nv.reg_boot42(), [Kv.of("implementation", 1)]))
    IP.urow("nv_fldwidth_implementation", nv.fld_w(nv.reg_boot42(), "implementation"))
    IP.urow("nv_fldmax_implementation", nv.fld_max(nv.reg_boot42(), "implementation"))
    IP.srow("nv_fld_architecture", nv.fld_abw(nv.reg_boot42(), "architecture"))
    IP.urow("nv_fldmask_architecture", nv.mask_of(nv.reg_boot42(), [Kv.of("architecture", 1)]))
    IP.urow("nv_fldwidth_architecture", nv.fld_w(nv.reg_boot42(), "architecture"))
    IP.urow("nv_fldmax_architecture", nv.fld_max(nv.reg_boot42(), "architecture"))
    IP.srow("nv_fld_chip_id", nv.fld_abw(nv.reg_boot42(), "chip_id"))
    IP.urow("nv_fldmask_chip_id", nv.mask_of(nv.reg_boot42(), [Kv.of("chip_id", 1)]))
    IP.urow("nv_fldwidth_chip_id", nv.fld_w(nv.reg_boot42(), "chip_id"))
    IP.urow("nv_fldmax_chip_id", nv.fld_max(nv.reg_boot42(), "chip_id"))
    # THE SPLIT, for the one field the split rows had skipped. `arch`/`impl`/
    # `chipid` have lo/hi rows because they were transcribed second; the field
    # with the defect has none, which IS why no row could name it. `_lo` and
    # `_hi` are separate rows so that a row that SWAPS them is caught even
    # though the pair as a joined string would be unchanged.
    IP.urow("nv_boot42_merext_lo", nv.fld_of(nv.reg_boot42(), "minor_extended_revision", 0))
    IP.urow("nv_boot42_merext_hi", nv.fld_of(nv.reg_boot42(), "minor_extended_revision", 1))
    t_end()

def nv.chipid_span() -> U32:
  U32.add(U32.sub(nv.fld_of(nv.reg_boot42(), "chip_id", 1),
    nv.fld_of(nv.reg_boot42(), "implementation", 0)), 1)

def nv.at_field(+r: Rgv, b: U32) -> String:
  String.join(nv.af.go(Rgv.nat(r), Rgv.fs(r), b, Nil{}), ",")

# `t_end` -- the bare term that closes every `do IO<Unit>:` whose last statement
# is a `<-` bind. A Bend `do IO<Unit>:` body must END WITH A BARE TERM
# (bend2-constraints.md, rule at line 3298) and this is the cheapest thing in the
# file that can be that, and it prints nothing so the byte-diff against the
# oracle stays exact.

def nv.trace.go(+xs: List<&2, IP.Cx>, +first: Bool) -> String:
  match xs:
    case Nil{}: ""
    case x <> r: String.concat([IP.tr.sep(first), nv.one(x), nv.trace.go(r, True{})])

def nv.trace(+t: IP.Tr) -> String: nv.trace.go(IP.Tr.calls(t), False{})

# ---------------------------------------------------------------------------
# `NVReg` (:12-31) as two records. `Fld` is one `(name, start, end)`; `Rgv` is a
# register's `(base, off, fields)`. `fs` is the ORDERED field list and its order
# IS the contract -- see the header.
# ---------------------------------------------------------------------------

def t_tr_refuse() -> IO(Unit):
  do IO<Unit>:
    # the seam's NAME, and the extension over ip.bend's ten. `nv.tagname`
    # DELEGATES for 0..10, so a call from ip.bend still renders by ip.bend's own
    # name -- which is the shared contract, not a fork.
    IP.srow("nv_tag_11", nv.tagname(11))
    IP.srow("nv_tag_12", nv.tagname(12))
    IP.srow("nv_tag_13", nv.tagname(13))
    IP.srow("nv_tag_14", nv.tagname(14))
    IP.srow("nv_tag_15", nv.tagname(15))
    IP.srow("nv_tag_16", nv.tagname(16))
    IP.srow("nv_tag_17", nv.tagname(17))
    IP.srow("nv_tag_18", nv.tagname(18))
    IP.srow("nv_tag_19", nv.tagname(19))
    IP.srow("nv_tag_0", nv.tagname(0))
    IP.srow("nv_tag_3", nv.tagname(3))
    IP.srow("nv_tag_10", nv.tagname(10))
    # and a trace that MIXES both files' calls renders all of them.
    IP.srow("nv_tr_mixed", nv.trace(nv.wreg(4096, 7, IP.Tr.emit(IP.C_BARRIER(), 1, 2, 3, IP.Tr.of()))))

def t_tr_init() -> IO(Unit):
  do IO<Unit>:
    # :88-89 `fini` -- GSP FIRST, FLCN SECOND, the REVERSE of init.
    IP.srow("nv_tr_fini", nv.trace(nv.fini(IP.Tr.of())))
    IP.urow("nv_tr_fini_n", IP.Tr.ncalls(nv.fini(IP.Tr.of())))
    # :85-86 -- four inits, init_sw then init_hw, flcn then gsp.
    IP.srow("nv_tr_init", nv.trace(nv.init4(IP.Tr.of())))
    IP.urow("nv_tr_init_n", IP.Tr.ncalls(nv.init4(IP.Tr.of())))
    # :121 -- wait_for_reset is the LAST thing _early_ip_init does.
    IP.srow("nv_tr_wait", nv.trace(nv.wait_reset(nv.chip_reads(IP.Tr.of()))))

def t_tr_mmu() -> IO(Unit):
  do IO<Unit>:
    # :101-103 -- nv_ref, dev_fb, dev_gc6_island, IN THAT ORDER, because include
    # is a flat overwrite and the order decides which module wins a name.
    IP.srow("nv_tr_include3", nv.trace(nv.include3(IP.Tr.of())))
    # :124,:127 -- dev_vm then dev_mmu, with the ARCH CHOSEN BY mmu_ver. Two
    # traces, one per mmu_ver, and they MUST DIFFER: gh100 vs tu102.
    IP.srow("nv_tr_mmu_2", nv.trace(nv.include_mmu(2, IP.Tr.of())))
    IP.srow("nv_tr_mmu_3", nv.trace(nv.include_mmu(3, IP.Tr.of())))
    IP.row("nv_tr_mmu_differ", Bool.not(String.eq(nv.trace(nv.include_mmu(2, IP.Tr.of())), nv.trace(nv.include_mmu(3, IP.Tr.of())))))
    # :133 -- BAR 1 THEN BAR 0, with a format on the second and not the first.
    IP.srow("nv_tr_bars", nv.trace(nv.map_bars(IP.Tr.of())))

def nv.mask.go(n: Nat, +fs: List<&2, Fld>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case Fld{n, s, e} <> r: nv.mask.go(m, r, U32.or(acc, nv.fmask(s, e)))

def nv.mask(+r: Rgv) -> U32: nv.mask.go(Rgv.nat(r), Rgv.fs(r), 0)

# `encode` (:30) over `(name, value)` pairs in the register's own field order.

# :25 `self.write(self.read() & ~self.mask(*kwargs.keys()), **kwargs)` -- the mask
# is over THE NAMES GIVEN. `nv.mask_named` used to answer `nv.mask(r)`, which masks
# EVERY field, and `~` of that clears every OTHER bit: with a four-bit
# `implementation` update on a word of all ones the ini came out 0xC00000FF, which
# wipes `major_revision` and `architecture` as well. THE PORT WAS WRONG AND THE
# ORACLE WAS RIGHT, and the row that caught it is `nv_upd_u1_ini`.

def nv.mask_named(+r: Rgv, ks: List<&2, Kv>) -> U32: nv.mask_of(r, ks)

def nv.upd_ini(+r: Rgv, ks: List<&2, Kv>, word: U32) -> U32:
  U32.and(U32.not(nv.mask_named(r, ks)), word)

# `nv.has` -- is `nm` one of a field list's names. Fld2 is the name-plus-list
# record that a `match` scrutinee needs, since a match may not examine a call.

def nv.has.go(+fs: List<&2, Fld>, +nm: String) -> Bool:
  match fs:
    case Nil{}: False{}
    case Fld{n, s, e} <> r: Bool.or(String.eq(n, nm), nv.has.go(r, nm))

def nv.has(+q: Fld2) -> Bool: nv.has.go(Fld2.fs(q), Fld2.n(q))

def kv.len(ks: List<&2, Kv>) -> Nat: List.length(&2, Kv, ks)

def nv.maskn(+r: Rgv, +ks: List<&2, Kv>) -> U32: nv.mn.go(kv.len(ks), ks, 0)

def nv.maskn_of(+r: Rgv, ks: List<&2, Kv>) -> U32: nv.maskn(r, ks)

# `kv.stray` -- the kwargs names that are NOT fields of `r`. Python's `encode`
# raises KeyError on those (:30 does `self.fields[name][0]`). This answers the
# list so the gate can pin it EMPTY, and a non-empty answer IS that KeyError.
# Reported and gated, not raised: nvdev.py has no exceptions to port.

def kv.stray.go(n: Nat, +q: Fld2, +ks: List<&2, Kv>, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      match ks:
        case Nil{}: acc
        case k <> rest:
          kv.stray.go(m, Fld2.of(Kv.n(k), Fld2.fs(q)), rest,
            List.append(&2, String, acc, Bool.pick(List<&2, String>, nv.has(q), [], [Kv.n(k)])))

def kv.stray(+r: Rgv, +ks: List<&2, Kv>) -> String:
  String.join(kv.stray.go(kv.len(ks), Fld2.of("", Rgv.fs(r)), ks, Nil{}), ",")

def nv.dec.go(n: Nat, +fs: List<&2, Fld>, +v: U32, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r: nv.dec.go(m, r, v, List.append(&2, String, acc, [nv.one_fld(f, v)]))

def nv.dec(+r: Rgv, v: U32) -> String: String.join(nv.dec.go(Rgv.nat(r), Rgv.fs(r), v, Nil{}), ",")

def nv.maxw.go(n: Nat, +fs: List<&2, Fld>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case Fld{n, s, e} <> r: nv.maxw.go(m, r, U32.max(acc, nv.wid(s, e)))

def nv.maxw(+r: Rgv) -> U32: nv.maxw.go(Rgv.nat(r), Rgv.fs(r), 0)

# the count of fields WIDER THAN 32 bits -- the WALL COUNT. Not zero for the
# MMU_VER structs, and every one of them is a `mask`/`encode` this file cannot do.

def nv.wide.go(n: Nat, +fs: List<&2, Fld>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case Fld{n, s, e} <> r:
          nv.wide.go(m, r, U32.add(acc, Bool.pick(U32, U32.is_gt(nv.wid(s, e), 32), 1, 0)))

def nv.wide(+r: Rgv) -> U32: nv.wide.go(Rgv.nat(r), Rgv.fs(r), 0)

