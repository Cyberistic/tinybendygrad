# :131 `vram_size = NV_PGC6_AON_SECURE_SCRATCH_GROUP_42.read() << 20` -- and
# `<< 20` ON A U32 IS THE 32-BIT WALL. MEASURED: raw 0xffff and raw 0xffffff
# BOTH give 4293918720 as the low word, and differ only in the high word (15 vs
# 4095). A U32 that carries only the low word reads a 4 GiB device as 64 KiB.
# The 64-bit `read()` itself is the seam; `nv.vram_hi` is what a U32 loses.

def nv.cover_at(+v: U32, lv: U32) -> U32: nv.at(nv.shifts_nat(v), nv.covers(v), lv)

# the `i`th element of a U32 list. The list is `+`, so the walk may read it again
# after the head; the decrement is on the Nat fuel, never on the index.

# `mm.pte_covers[self.lv]` -- and at `lv == level_cnt` the REAL nvdev.py raises
# IndexError, because `pte_covers` has `level_cnt` entries. The port answers the
# SENTINEL 4294967295, which is a distinct value from any real cover, so the
# out-of-range level is visible rather than silently reading cover[0].

def nv.huge_cover(+v: U32, +lv: U32) -> U32:
  Bool.pick(U32, U32.is_ge(lv, nv.level_cnt(v)), 4294967295, nv.cover_at(v, lv))

# :59 `lv >= level_cnt - 3 and paddr % pte_covers[lv] == 0`. TWO SEPARATE THINGS
# live in that one line and each needs its own fixture:
#
#  * the `lv >= level_cnt - 3` BOUND, which is `lvmin` -- ver 2 answers 2 over five
#    levels and ver 3 answers 3 over six, so the SAME level index is a huge-page
#    level on one and not on the other. A port that hard-coded the bound would be
#    right for ver 2 and wrong for ver 3 at lv 2 and 3.
#  * the `% pte_covers[lv]` DIVISIBILITY, which needs a paddr that divides and one
#    that does not AT THE SAME LEVEL. The fixtures are paddr 0 (always divides),
#    0x200000 (divides cover 2MiB and 512MiB... and nothing larger), 0x200001 (the
#    one-off, which divides NOTHING) and 0x12345000.
#
# AND THE ORDER MATTERS: nvdev.py evaluates `lv >= level_cnt - 3` FIRST, so at
# `lv == level_cnt` the `and` short-circuits and `pte_covers[lv]` is NEVER
# evaluated -- which is why :59 does NOT raise at lv == level_cnt while
# `supports_huge_page` DOES. Measured: v2_l5 and v3_l6 answer ERR:IndexError for
# every paddr, and v2_l5's huge_lvmin is 2 so the bound IS satisfied. That means
# nvdev.py evaluates BOTH operands, and the IndexError is real behaviour the port
# must name rather than smooth over.

def nv.pte_huge_ok(+v: U32, +lv: U32, +paddr: U32) -> Bool:
  Bool.and(U32.is_ge(lv, nv.pte_huge_lvmin(v)), U32.is_eq(U32.mod(paddr, nv.cover_at(v, lv)), 0))

# `nv.huge_at` -- is the index in range. Separated from `pte_huge_ok` because the
# IndexError at lv == level_cnt is a property of the INDEX and not of the bound,
# and a row that cannot see it cannot report it.

def nv.huge_at(+v: U32, lv: U32) -> Bool: U32.is_lt(lv, nv.level_cnt(v))

# :58's `else True` is the TOP-LEVEL branch and it is the row that pins it: at and
# above `level_cnt - 1` EVERY entry is a page whatever the word says, and getting
# the comparison the wrong way round makes the top level a directory.

def nv.ispage_top(+v: U32, lv: U32) -> Bool: Bool.not(U32.is_lt(lv, nv.is_page_lvmax_x(v)))

# "fits" is `sh <= 32`, and `sh` is read out of the shift list the same way every
# other row reads it.

# `nv.huge_str` -- `supports_huge_page` as TEXT, because at `lv == level_cnt` the
# REAL nvdev.py raises IndexError and the row has to be able to say so. The
# U32-encoded form (`nv.huge_bit`) was dropped rather than kept as a second
# spelling: a def nothing calls is invisible to every other check, which is how
# three functions at `schedule/indexing.bend` were found written, commented and
# never exercised.

def nv.huge_str(+v: U32, +lv: U32, +paddr: U32) -> String:
  Bool.pick(String, nv.huge_at(v, lv), Bool.pick(String, nv.pte_huge_ok(v, lv, paddr), "1", "0"),
    "ERR:IndexError")

# --- set_entry's FIELD NAMES and the two branch encodings. This is where a
# --- transposed `pcf`/`vol` or `pcf_small`/`no_ats` lands on a different field.

def Cal.of(k: U32, a: U32, b: U32, c: U32) -> Cal:
  Cal{k, a, b, c}

def Cal.k(x: Cal) -> U32:
  match x:
    case Cal{+k, a, b, c}: k

def Cal.a(x: Cal) -> U32:
  match x:
    case Cal{k, +a, b, c}: a

def Cal.b(x: Cal) -> U32:
  match x:
    case Cal{k, a, +b, c}: b

def Cal.c(x: Cal) -> U32:
  match x:
    case Cal{k, a, b, +c}: c

def nv.chain(cal: List<&2, Cal>, t: IP.Tr) -> IP.Tr:
  match cal:
    case Nil{}: t
    case +x <> r: nv.chain(r, IP.Tr.emit(Cal.k(x), Cal.a(x), Cal.b(x), Cal.c(x), t))

# :92-95 -- `self.mmio[addr // 4] = value` and `return self.mmio[addr // 4]`. The
# trace carries the WORD INDEX, not the byte address, because `addr // 4` is where
# a wrong division would show up and the index is what the device sees.

def nv.rreg(+addr: U32, t: IP.Tr) -> IP.Tr: IP.Tr.emit(C_NV_RREG(), nv.word(addr), 0, 0, t)

def nv.wreg(+addr: U32, val: U32, t: IP.Tr) -> IP.Tr:
  IP.Tr.emit(C_NV_WREG(), nv.word(addr), val, 0, t)

# :23 `write(_ini_val=0, **kwargs)` -- `nvdev.wreg(base + off, _ini | encode(**kw))`.

def nv.fini(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_WREG(), 0, 0, 0), Cal.of(C_NV_WREG(), 0, 0, 1)], t)

# :85-86 `for ip in [self.flcn, self.gsp]: ip.init_sw()` then the same for
# `init_hw()`. FLCN FIRST, and ALL FOUR init calls run before `__init__` clears
# `is_booting` (:83).

def nv.init4(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_WREG(), 1, 0, 0), Cal.of(C_NV_WREG(), 2, 0, 0),
            Cal.of(C_NV_WREG(), 1, 1, 0), Cal.of(C_NV_WREG(), 2, 1, 0)], t)

# :161-163 `include` is a flat overwrite into one dict, so the ORDER of the
# include calls DECIDES WHICH MODULE WINS A NAME. :101-103 is nv_ref, dev_fb,
# dev_gc6_island; `c` carries the position in that list, which is the value.

def nv.include3(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_INCLUDE(), 0, 0, 0), Cal.of(C_NV_INCLUDE(), 0, 1, 0),
            Cal.of(C_NV_INCLUDE(), 0, 2, 0)], t)

# :124,:127 -- dev_vm, then dev_mmu with the ARCH CHOSEN BY mmu_ver. `b` is the
# mmu_ver, so the trace says which of gh100/tu102 was loaded.

def nv.include_mmu(+v: U32, t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_INCLUDE(), 1, 0, 0), Cal.of(C_NV_INCLUDE(), 2, v, 0)], t)

# :105-111 -- read WPR2, and ONLY IF it was nonzero: clear PCI_COMMAND, reset,
# sleep, set PCI_COMMAND. `time.sleep(0.1)` (:109) is a time gap and has no trace
# tag: it is the seam, and no tag claims to be it.

def nv.map_bars(t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_MAP_BAR(), 1, 0, 0), Cal.of(C_NV_MAP_BAR(), 0, 1, 0)], t)

# :152,:155,:157 `_alloc_boot_mem`'s two branches. `sysmem` picks between
# `alloc_sysmem` -- which yields NO paddr and a driver-supplied sysaddr list -- and
# `palloc`, which yields a paddr, a vram view, and a sysaddr list COMPUTED at
# :157 as `bar_info(1)[0] + paddr + i * 0x1000`.

def nv.boot_sysmem(+size: U32, cont: Bool, t: IP.Tr) -> IP.Tr:
  IP.Tr.emit(C_NV_SYSMEM(), size, Bool.pick(U32, cont, 1, 0), 0, t)

def nv.boot_vram(+sz: U32, +paddr: U32, t: IP.Tr) -> IP.Tr:
  nv.chain([Cal.of(C_NV_PALLOC(), sz, 0, 0), Cal.of(C_NV_MAP_BAR(), 1, 2, paddr)], t)

# :158 `if data is not None: view[:size] = data` -- the only write into the view,
# and it is LENGTH `size`, not the rounded `sz`.

def nv.boot_fill(+size: U32, t: IP.Tr) -> IP.Tr:
  IP.Tr.emit(C_NV_MAP_BAR(), 3, size, 0, t)

# :121 `self.flcn.wait_for_reset()` -- the LAST thing _early_ip_init does.

def nv.wait_reset(t: IP.Tr) -> IP.Tr: IP.Tr.emit(C_NV_WAIT_RESET(), 0, 0, 0, t)

# ===========================================================================
# THE GATE. Every `py=` value below is a row the CPython oracle emitted by
# CALLING the real `NVReg` / `NVPageTableEntry` classes over the real
# `tinygrad/runtime/autogen/nv_regs/` tables. Nothing here is transcribed.
#
# The shape of a gate row in this file is FOUR FACTS PLUS THE ANSWER as ONE
# string wherever a count would not do it:
#
#   * `nv_reg_*_names`  -- the field ORDER. `nv_reg_*_nf` is the COUNT, and the
#     count is CONSTANT over the whole suite: a transposition leaves it unchanged.
#     The names row is the one that moves.
#   * `nv_reg_*_ranges` -- the OFFSETS, in the same order. A second transcription
#     of the same table, so a wrong bit position is caught even where the names
#     are right.
#   * `nv_dec_*`         -- name AND decoded value together, which is the row a
#     shifted offset actually breaks.
#   * `nv_upd_*_w`       -- the read-modify-write RESULT, not its parts.
#
# The fixtures are NON-UNIFORM BY CONSTRUCTION, and this is measured rather than
# asserted: `NV_PMC_BOOT_42`'s five named fields have widths 4,4,4,4,6 and starts
# 8,12,16,20,24, so a fixture that sets one field to a constant cannot equal one
# that sets it to another. `NV_PMC_BOOT_0`'s are 4,4,1,4,5. There is no all-equal
# fixture in this file, because an all-equal fixture cannot detect order -- that
# was proven by mutation elsewhere in this project (six rows printing `1,1`, and a
# list reversal moving none of them).
# ===========================================================================

# --- ONE def per register, so a row NAMES its register and a mutation that
# --- touches one register cannot move another's row.

def nv.wn.go(n: Nat, +fs: List<&2, Fld>, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r:
          nv.wn.go(m, r, Bool.pick(List<&2, String>, U32.is_gt(nv.wid(Fld.s(f), Fld.e(f)), 32),
            List.append(&2, String, acc, [Fld.n(f)]), acc))

# --- THE BIT CODEC: mask / encode / decode / update, over NON-UNIFORM fixtures.

def kv.has(+ks: List<&2, Kv>, +nm: String) -> Bool:
  match ks:
    case Nil{}: False{}
    case Kv{n, v} <> r: Bool.or(String.eq(n, nm), kv.has(r, nm))

def nv.mk.go(n: Nat, +fs: List<&2, Fld>, +ks: List<&2, Kv>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r:
          nv.mk.go(m, r, ks, U32.or(acc, Bool.pick(U32, kv.has(ks, Fld.n(f)),
            nv.fmask(Fld.s(f), Fld.e(f)), 0)))

def nv.mn.go(n: Nat, +ks: List<&2, Kv>, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match ks:
        case Nil{}: acc
        case k <> r: nv.mn.go(m, r, U32.add(acc, 1))

def nv.nd.go(n: Nat, +fs: List<&2, Fld>, +ks: List<&2, Kv>, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r:
          nv.nd.go(m, r, ks, Bool.pick(List<&2, String>, kv.has(ks, Fld.n(f)),
            List.append(&2, String, acc, [Fld.n(f)]), acc))

def nv.fo.go(n: Nat, +fs: List<&2, Fld>, +nm: String, +which: U32, acc: U32) -> U32:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r: Bool.pick(U32, String.eq(Fld.n(f), nm),
          Bool.pick(U32, U32.is_eq(which, 0), Fld.s(f), Fld.e(f)), nv.fo.go(m, r, nm, which, acc))

def nv.lb_tag(+nb: U32, +sz: U32) -> String:
  String.concat([IP.hex8(nb), "_", IP.hex8(sz)])

# `covers` is a pure function of the shifts, so its invariant is a fact about the
# ladder: every `covers[i] * (covers[i-1] // covers[i])` EQUALS `covers[i-1]`.

def t_largebar(+nb: U32, +sz: U32) -> IO(Unit):
  do IO<Unit>:
    IP.urow(String.concat(["nv_largebar_", nv.lb_tag(nb, sz)]), Bool.to_u32(nv.largebar(nb, sz)))
    IP.urow(String.concat(["nv_reserve_ptable_", nv.lb_tag(nb, sz)]), Bool.to_u32(nv.reserve_ptable(nv.largebar(nb, sz))))
    IP.urow(String.concat(["nv_sysmem_default_", nv.lb_tag(nb, sz)]), Bool.to_u32(Bool.not(nv.largebar(nb, sz))))
    IP.urow(String.concat(["nv_sysmem_", nv.lb_tag(nb, sz), "_None"]), Bool.to_u32(nv.sysmem(nv.largebar(nb, sz), nv.sm_none())))
    IP.urow(String.concat(["nv_sysmem_", nv.lb_tag(nb, sz), "_True"]), Bool.to_u32(nv.sysmem(nv.largebar(nb, sz), nv.sm_true())))
    IP.urow(String.concat(["nv_sysmem_", nv.lb_tag(nb, sz), "_False"]), Bool.to_u32(nv.sysmem(nv.largebar(nb, sz), nv.sm_false())))

def nv.v_tag(+v: U32) -> String: U32.show(v)

# `is_page` for entry 2 as well as entry 0. In nvdev.py it depends on the stored
# word's bit 0, which is DEVICE state; with no word the port answers the branch
# (:58's `lv < level_cnt - 1`) and `nv.pte_ispage2` is that branch at entry 2.

def t_sf_v(+v: U32) -> IO(Unit):
  do IO<Unit>:
    # A PTE (:40-41): `pcf` on ver 3, `vol` on ver 2. THE NAMES DIFFER.
    IP.srow(String.concat(["nv_sf_pte_", nv.v_tag(v)]), nv.pte_uncfield_pte(v))
    # A PDE (:44-46): `_small` is the dual test, and `pcf_small`/`no_ats` is the
    # ver test. FOUR combinations, and all four are named.
    IP.srow(String.concat(["nv_sf_pde_l0_", nv.v_tag(v)]), nv.pte_uncfield_pde(v, 0))
    IP.srow(String.concat(["nv_sf_pde_l3_", nv.v_tag(v)]), nv.pte_uncfield_pde(v, nv.dual_lv(v)))
    IP.srow(String.concat(["nv_sf_pde_l4_", nv.v_tag(v)]), nv.pte_uncfield_pde(v, 4))
    IP.urow(String.concat(["nv_sf_pdeval_", nv.v_tag(v)]), nv.pte_uncval_pde(v))
    # THE PTE/DIRECTORY VALUE ASYMMETRY: a PTE stores `int(uncached)` and a
    # directory stores 0b10 (ver 3) or the CONSTANT 1 (ver 2). `uncached` is not
    # consulted on either directory path, so a port that threaded it through would
    # answer 0 or 1 where nvdev.py writes 2.
    IP.urow(String.concat(["nv_sf_pteval_", nv.v_tag(v), "_0"]), Bool.to_u32(nv.pte_uncval_pte(v, False{})))
    IP.urow(String.concat(["nv_sf_pteval_", nv.v_tag(v), "_1"]), Bool.to_u32(nv.pte_uncval_pte(v, True{})))
    # `is_pte=False` for a directory, and the key it is looked up under is
    # `aperture{small}`, which is `aperture` when not dual.
    IP.srow(String.concat(["nv_sf_apkey_", nv.v_tag(v)]), nv.pte_validkey(v, 0))
    IP.srow(String.concat(["nv_sf_apkey_dual_", nv.v_tag(v)]), nv.pte_validkey(v, nv.dual_lv(v)))
    # the WRITE INDEX, for a dual and a non-dual level: `2*e+1` and `e`.
    IP.srow(String.concat(["nv_sf_idx_", nv.v_tag(v), "_l0_e2"]), nv.idx_str(v, 0, 2))
    IP.srow(String.concat(["nv_sf_idx_", nv.v_tag(v), "_dual_e2"]), nv.idx_str(v, nv.dual_lv(v), 2))

def t_ru(+sz: U32) -> IO(Unit):
  do IO<Unit>:
    IP.urow(String.concat(["nv_roundup_", IP.hex8(sz)]), nv.ru(sz))
    IP.urow(String.concat(["nv_pages_", IP.hex8(sz)]), nv.pages(sz))
    IP.urow(String.concat(["nv_pages_raw_", IP.hex8(sz)]), nv.pages_raw(sz))

def nv.af.go(n: Nat, +fs: List<&2, Fld>, +b: U32, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: acc
    case 1n+m:
      match fs:
        case Nil{}: acc
        case f <> r: nv.af.go(m, r, b, Bool.pick(List<&2, String>,
          Bool.and(U32.is_le(Fld.s(f), b), U32.is_ge(Fld.e(f), b)),
          List.append(&2, String, acc, [Fld.n(f)]), acc))

# --- THE TRACE: refusals as TRUNCATED traces, and ORDER as a first-class fact.

def t_end() -> IO(Unit):
  IO.print("")

def t_setfield() -> IO(Unit):
  do IO<Unit>:
    t_sf_v(2)
    t_sf_v(3)
    t_end()

def t_mmu_tables() -> IO(Unit):
  do IO<Unit>:
    IP.urow("nv_vabits_3", nv.va_bits(3))
    IP.srow("nv_vashifts_3", nv.shifts_str(3))
    IP.urow("nv_vashifts_n_3", nv.shifts_n(3))
    IP.srow("nv_covers_3", nv.covers_str(3))
    IP.urow("nv_levelcnt_3", nv.level_cnt(3))
    IP.srow("nv_lvlmsb_3", nv.lvl_msb(3))
    IP.urow("nv_dual_pde_lv_3", nv.dual_lv(3))
    IP.urow("nv_is_page_lvmax_3", nv.is_page_lvmax_x(3))
    IP.urow("nv_huge_lvmin_3", nv.huge_lvmin(3))
    IP.urow("nv_sys_lvlmax_3", nv.sys_lvmax(3))
    IP.urow("nv_vabits_2", nv.va_bits(2))
    IP.srow("nv_vashifts_2", nv.shifts_str(2))
    IP.urow("nv_vashifts_n_2", nv.shifts_n(2))
    IP.srow("nv_covers_2", nv.covers_str(2))
    IP.urow("nv_levelcnt_2", nv.level_cnt(2))
    IP.srow("nv_lvlmsb_2", nv.lvl_msb(2))
    IP.urow("nv_dual_pde_lv_2", nv.dual_lv(2))
    IP.urow("nv_is_page_lvmax_2", nv.is_page_lvmax_x(2))
    IP.urow("nv_huge_lvmin_2", nv.huge_lvmin(2))
    IP.urow("nv_sys_lvlmax_2", nv.sys_lvmax(2))
    # THE REVERSAL ROW. `covers` must be the REVERSE of `[1 << s for s in
    # shifts]`, so `covers[0]` is the LARGEST and `covers[n-1]` is the page size.
    # A port that forgot the `[::-1]` still prints six correct-looking numbers,
    # in the wrong order.
    IP.urow("nv_cover_top_3", nv.cover_at(3, 0))
    IP.urow("nv_cover_bot_3", nv.cover_at(3, 5))
    IP.urow("nv_cover_top_2", nv.cover_at(2, 0))
    IP.urow("nv_cover_bot_2", nv.cover_at(2, 4))
    IP.urow("nv_cover_oob_3", nv.cover_at(3, 6))
    # the invariant that ties covers to itself, as ONE fact about the ladder
    # rather than six numbers.
    IP.row("nv_cover_inv_3", nv.cover_inv(3))
    IP.row("nv_cover_inv_2", nv.cover_inv(2))
    IP.urow("nv_tail_reserved", nv.tail_reserved())
    IP.urow("nv_boot_size", nv.boot_size())
    IP.urow("nv_va_base", nv.va_base())
    IP.srow("nv_palloc_x", nv.palloc_str())
    IP.urow("nv_palloc_n", nv.palloc_n())
    IP.urow("nv_tlsf_size_lo", nv.tlsf_size_lo())
    IP.urow("nv_tlsf_size_hi", nv.tlsf_size_hi())
    IP.urow("nv_tlsf_base_hi", nv.tlsf_base_hi())
    # THE 32-BIT WALL, AS ROWS. `vram_size = raw << 20` does not fit a U32, and
    # the fixture is chosen so the TRUNCATION IS VISIBLE: 0xffff and 0xffffff
    # both answer 4293918720 as the low word and differ ONLY in the high word.
    IP.urow("nv_vramsize_zero", nv.vram_lo(0))
    IP.urow("nv_vramsize_zero_hi", nv.vram_hi(0))
    IP.urow("nv_vramsize_one", nv.vram_lo(1))
    IP.urow("nv_vramsize_one_hi", nv.vram_hi(1))
    IP.urow("nv_vramsize_k", nv.vram_lo(65535))
    IP.urow("nv_vramsize_k_hi", nv.vram_hi(65535))
    IP.urow("nv_vramsize_full", nv.vram_lo(16777215))
    IP.urow("nv_vramsize_full_hi", nv.vram_hi(16777215))
    IP.urow("nv_vramsize_sh20_zero", nv.vram_sh20(0))
    IP.urow("nv_vramsize_sh20_one", nv.vram_sh20(1))
    IP.urow("nv_vramsize_sh20_k", nv.vram_sh20(65535))
    IP.urow("nv_vramsize_sh20_full", nv.vram_sh20(16777215))
    # THE COLLISION ROW: the two raws answer the SAME low word. That is the wall
    # stated as a property rather than as a sentence about U32.
    IP.row("nv_vramsize_collide", U32.is_eq(nv.vram_lo(65535), nv.vram_lo(16777215)))
    IP.row("nv_vramsize_hi_differ", Bool.not(U32.is_eq(nv.vram_hi(65535), nv.vram_hi(16777215))))
    # large_bar and its two consequences.
    t_largebar(2147483648, 1073741824)
    t_largebar(2147483648, 2147483648)
    t_largebar(2147483648, 2147483649)
    t_largebar(1073741824, 1073741824)
    t_largebar(2147483647, 1073741824)
    t_end()

def Rgv.of(base: U32, off: U32, fs: List<&2, Fld>) -> Rgv:
  Rgv{base, off, fs}

def Rgv.base(r: Rgv) -> U32:
  match r:
    case Rgv{+base, off, fs}: base

def t_const() -> IO(Unit):
  do IO<Unit>:
    IP.urow("nv_pte_kind", nv.pte_kind())
    IP.urow("nv_pte_aperture_0", nv.pte_aperture(False{}))
    IP.urow("nv_pte_aperture_1", nv.pte_aperture(True{}))
    IP.srow("nv_sf_addrkey_2000", nv.pte_addrkey(3, 0))
    IP.srow("nv_sf_addrkey_2000_v2", nv.pte_addrkey(2, 0))
    IP.srow("nv_sf_addrkey_2000_v3", nv.pte_addrkey(3, 0))
    t_end()

# `nv.nat_str` -- a Nat as decimal text. `U32.show` answers a U32 and a page count
# is a Nat (it is `sz // 0x1000`, a length), so the two are not interchangeable and
# the conversion has to be explicit. Measured from the interpreter, not assumed.

def nv.nat_str(n: Nat) -> String: U32.show(U32.from_nat(n))

def nv.sa_tag(+p: U32, n: Nat) -> String: String.concat([IP.hex8(p), "_", nv.nat_str(n)])

def Rgv.off(r: Rgv) -> U32:
  match r:
    case Rgv{base, +off, fs}: off

def Rgv.fs(r: Rgv) -> List<&2, Fld>:
  match r:
    case Rgv{base, off, +fs}: fs

def Rgv.nat(+r: Rgv) -> Nat: List.length(&2, Fld, Rgv.fs(r))

# `nf` is `nat` seen as a number, for the `nv_reg_*_nf` rows.

def Rgv.nf(r: Rgv) -> U32: U32.from_nat(Rgv.nat(r))

# `with_base` (:18) -- base + self.base, same off, same field list.

def Rgv.with_base(+r: Rgv, b: U32) -> Rgv: Rgv.of(U32.add(b, Rgv.base(r)), Rgv.off(r), Rgv.fs(r))

# :20 `read` -- `self.nvdev.rreg(self.base + self.off)`. The pure half is the
# ADDRESS; the call itself is the seam and is `nv.rreg` below.

def Rgv.addr(+r: Rgv) -> U32: U32.add(Rgv.base(r), Rgv.off(r))

# :92-93 `wreg` -- `self.mmio[addr // 4] = value`. THE WORD INDEX IS `addr // 4`,
# not `addr`, and a register at 0xA00 is mmio element 0x280.

def nv.reg_boot0() -> Rgv: Rgv.of(0, 0, [Fld.of("minor_revision", 0, 3), Fld.of("major_revision", 4, 7), Fld.of("architecture_1", 8, 8), Fld.of("implementation", 20, 23), Fld.of("architecture_0", 24, 28)])

# `emit` -- ip.bend's own row printer, one `IO.print` for a whole list. A `do
# IO<Unit>:` block can ONLY BIND AN `IO` (bend2-constraints.md, rule at line 1419),
# so a PURE value like `nv.reg_boot0()` may not be `<-`-bound: the shape that
# works is a PURE def returning a LIST OF ROW STRINGS, printed by `emit`. Every
# `t_*` group below is that shape, and it is why the rows are built by `go` folds
# rather than assigned to locals.

def nv.reg_boot42() -> Rgv: Rgv.of(0, 2560, [Fld.of("minor_extended_revision", 8, 11), Fld.of("minor_revision", 12, 15), Fld.of("major_revision", 16, 19), Fld.of("implementation", 20, 23), Fld.of("architecture", 24, 29), Fld.of("chip_id", 20, 29)])

