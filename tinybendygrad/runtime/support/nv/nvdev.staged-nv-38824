# The `else True` is not a default: at and above the top level EVERY entry is a
# page, and getting the comparison the wrong way round makes the top level a
# directory.

# THE STORED WORD IS INJECTED, AND IT IS A PARAMETER RATHER THAN A CONSTANT.
# :58 `return (self.entry(entry_id) & 1 == 1) if self.lv < level_cnt - 1 else True`
# reads DEVICE MEMORY for the test, and at every level below the top the answer
# therefore DEPENDS ON WHAT WAS WRITTEN. `nv.stored_word` returning a literal 0
# made the port answer False at every such level regardless of the store, which is
# a claim about the device rather than a port of the predicate. The word is a
# parameter of `nv.pte_ispage` now, and the gate passes both 0 and 1 so the branch
# is exercised in BOTH directions.

def nv.stored_word(word: U32, lv: U32) -> U32: word

# :59 `lv >= level_cnt - 3 and paddr % pte_covers[lv] == 0`.

# `entry(entry_id) & 1 == 1`. Bit 0 is bit 0 of the low half in BOTH layouts: a
# dual level's `entry` is `(entries[2e+1] << 64) | entries[2e]` (:52) and bit 0 of
# that is bit 0 of `entries[2e]`. So there is NO dual case here -- an earlier
# version added `Bool.or(Bool.not(dual), ...)` and answered True at every non-dual
# level whatever the word was, which is what `nv_d_*_ispage` caught.

def nv.entry_is_one(+word: U32, +lv: U32) -> Bool: U32.is_eq(U32.and(word, 1), 1)

# the word `is_page` reads. Only the low bit is load-bearing, and it is bit 0 of
# the low half in BOTH the dual and the plain layout, so one def serves both.

# :58 `return (self.entry(entry_id) & 1 == 1) if self.lv < self.nvdev.mm.level_cnt - 1
# else True` -- THE BOUND IS `level_cnt - 1`, NOT `level_cnt`. This is the off-by-one
# that `nv_d_2_l4_ispage` and `nv_d_3_l5_ispage` caught: with `lv < level_cnt` the
# top level fell into the word test and answered False on a fresh table, where
# nvdev.py's `else True` answers True for EVERY entry. `nv.ispage_top` had the
# `- 1` right all along, so the file carried two spellings of one bound and only
# one of them was tested -- which is exactly the shape of the bug the field-ORDER
# rows are there to catch.

def nv.pte_huge_lvmin(v: U32) -> U32: U32.sub(nv.level_cnt(v), 3)

