# THE SATURATION WALL, made explicit. `U32.shln` SATURATES TO 0 PAST 31, so
# `(1 << 56) - 1` is NOT `U32.sub(U32.shln(1, 56n), 1)` -- that is `0 - 1`, which
# wraps to 0xffffffff and is a 32-bit answer for a 56-bit mask. `nv.pw` is the
# only correct spelling: build the power of two by DOUBLING, which wraps the way
# a U32 is supposed to, and the width wall is then only ever a QUESTION about
# which fields are wider than 32 bits -- which `nv.wide` counts and `nv.wide_names`
# names, rather than something the arithmetic silently gets wrong.

def nv.pw.w(k: Nat, +acc: U32) -> U32:
  match k:
    case 0n: acc
    case 1n+m: nv.pw.w(m, U32.add(acc, acc))

def nv.pw(k: Nat) -> U32: nv.pw.w(k, 1)

def nv.pw_of(w: U32) -> U32: nv.pw(U32.to_nat(w))

# `ones(w)` for a width that FITS a U32 is `pw(w) - 1`, and `pw` doubles, so this
# is exact for w <= 32 and is the wall for w > 32 (where it saturates to
# 0xffffffff, which is the honest "does not fit" answer rather than a wrong one).

def nv.rev.go(n: Nat, +xs: List<&2, U32>, +acc: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n: List.reverse(&2, U32, acc)
    case 1n+m:
      match xs:
        case Nil{}: List.reverse(&2, U32, acc)
        case x <> r: nv.rev.go(m, r, List.append(&2, U32, acc, [nv.pw_of(x)]))

# `pte_covers = [1 << x for x in va_shifts][::-1]` -- and THIS IS THE 32-BIT WALL.
# `1 << 38`, `1 << 47` and `1 << 56` DO NOT FIT A U32: `nv.pw` wraps them to 0, so
# `covers[0]` and `covers[1]` read 0 for ver 3 and `covers[0]` reads 0 for ver 2.
# That is not a typo to be fixed -- `pte_covers[lv]` is INDEXED BY lv in
# nvdev.py:59 and `mm.pte_covers` in memory.py, and the two entries that do not
# fit are exactly the ones a U32 cannot hold. The rows `nv_covers_2/_3` print the
# wrapped list, `nv_cover_wide_*` counts how many entries wrapped, and the ORACLE
# prints both halves so the wall is a measurement and not an excuse.

def nv.covers(+v: U32) -> List<&2, U32>: nv.pow_shifts(v)

def nv.cover_inv(+v: U32) -> Bool: nv.ci.go(nv.shifts_nat(v), nv.covers(v), 0)

def nv.covers_str(+v: U32) -> String: String.join(nv.cstr.go(nv.shifts_nat(v), nv.covers(v), Nil{}), ",")

def nv.ones(w: U32) -> U32: U32.sub(nv.pw_of(w), 1)

# ---------------------------------------------------------------------------
# THE REGISTER TABLES. GENERATED -- see .agents/slop/nv_nvdev_gen.py, which
# reads the CPython oracle's output and refuses to run if a row is missing.
#
# 11 registers, 86 fields, and 10 of those fields are WIDER THAN 32 BITS. Those
# 10 are `address_sys` (46), `address_big_sys` (50), `address_small_sys` (46) on
# the ver-2 structs and `address` (40), `address_big` (44), `address_small` (40)
# on the ver-3 ones. `nv.ones` cannot build their mask and `nv.fenc` cannot place
# their value, so `mask`/`encode`/`decode` over any of them is THE WALL. See the
# WALLS section at the end; the count is gated as `nv_wide_*`.
#
# `nv.addr_*` IS 0 for all six MMU_VER structs, and that is not a transcription
# slip: those six entries in dev_mmu.py are `(None, None, {fields})`. They have
# NO register address, because nvdev.py never reads them -- :128 hands them to
# NVPageTableEntry, which uses them only for `.encode`/`.decode`/`.mask`. So
# "has no address" is a PROPERTY of the port, not a gap in it.
# ---------------------------------------------------------------------------
# GENERATED by .agents/slop/nv_nvdev_gen.py from the CPython oracle. DO NOT HAND-EDIT.

def nv.getb(v: U32, +s: U32, e: U32) -> U32: U32.and(U32.shrn(v, U32.to_nat(s)), nv.ones(nv.wid(s, e)))

# `mask` (:27) as an OR-fold over the ORDERED fields. OR is commutative, so the
# fold's accumulator direction is not observable here -- unlike `encode`, whose
# order IS observable when two fields overlap (they do: `chip_id` spans
# `implementation` and `architecture`), which is why `decode` below rebuilds the
# order into a string instead.

def nv.fmask(+s: U32, e: U32) -> U32: U32.shln(nv.ones(nv.wid(s, e)), U32.to_nat(s))

