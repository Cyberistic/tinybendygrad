# ---------------------------------------------------------------------------
# THE MMU TABLES, :143 and memory.py's :186-188. `bits, shifts = (56, [12, 21, 29,
# 38, 47, 56]) if mmu_ver == 3 else (48, [12, 21, 29, 38, 47])`.
# THE ORDER IS LOAD-BEARING: memory.py REVERSES it into `pte_covers`, so
# `va_shifts[0]` is the SMALLEST and `pte_covers[0]` is the LARGEST. A port that
# reverses once too many reads a 2 GiB page where the driver wrote a 4 KiB one.
# ---------------------------------------------------------------------------

def nv.va_bits(+v: U32) -> U32: Bool.pick(U32, U32.is_eq(v, 3), 56, 48)

def nv.va_shifts(+v: U32) -> List<&2, U32>:
  Bool.pick(List<&2, U32>, U32.is_eq(v, 3), [12, 21, 29, 38, 47, 56], [12, 21, 29, 38, 47])

def nv.shifts_n(+v: U32) -> U32: U32.from_nat(List.length(&2, U32, nv.va_shifts(v)))

# :188 `self.level_cnt = len(va_shifts)` -- the shifts WITHOUT the extra that
# `lvl_msb` gets, so level_cnt is one SHORTER than lvl_msb.

def nv.level_cnt(+v: U32) -> U32: nv.shifts_n(v)

def nv.msb.go(v: U32, n: Nat, +xs: List<&2, U32>, +acc: List<&2, String>) -> List<&2, String>:
  match n:
    case 0n: List.append(&2, String, acc, [U32.show(U32.add(nv.va_bits(v), 1))])
    case 1n+m:
      match xs:
        case Nil{}: List.append(&2, String, acc, [U32.show(U32.add(nv.va_bits(v), 1))])
        case x <> r: nv.msb.go(v, m, r, List.append(&2, String, acc, [U32.show(x)]))

# memory.py :187 `pte_covers = [1 << x for x in va_shifts][::-1]` -- the REVERSAL.

def nv.shifts_nat(+v: U32) -> Nat: List.length(&2, U32, nv.va_shifts(v))

def nv.lvl_msb(+v: U32) -> String: String.join(nv.msb.go(v, nv.shifts_nat(v), nv.va_shifts(v), Nil{}), ",")

