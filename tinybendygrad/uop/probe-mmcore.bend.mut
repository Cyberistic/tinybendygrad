# probe-mmcore.bend -- the `_min_max` arithmetic core, standalone, so the width
# decision and the six helpers can be gated before anything is hung off an arena.
import Base
import ./../helpers.bend as H
import ./../LAWS/spec.bend as S

# ===========================================================================
# `_min_max` -- ops.py:1104-1163, the INTEGER INTERVAL OF A UOp.
#
# WHAT THIS IS. `self._min_max` is `(vmin, vmax)`: the smallest and largest value a
# node can take, used by `resolve` (ops.py:64) to decide a symbolic bool, by
# `shard_shape` (ops.py:461) to size a shard, and by `variable` (ops.py:1013) to
# decide whether a PARAM has bounds. It is a Kahn fold over the same arena as the
# other six properties, and it is answered HERE, on its own walk, for the reason the
# header gives: `_min_max` needs no shape, no device and no addrspace, and a node
# whose `_shape` this file defers (every RESHAPE, and UNSHARD) still HAS an interval.
# Folding it into `Derived` would have made every deferred shape defer its interval
# too, and `gap_ok` is the row that would have noticed.
#
# ===========================================================================
# THE WIDTH, AND IT IS NOT A CHOICE -- IT IS MEASURED.
#
# Python's ints are arbitrary precision, and `_min_max`'s bounds LEAVE int64 on real
# graphs. Measured by `.agents/slop/oracles/mm-range.py` over 21 tinygrad graphs:
#
#   graph      nodes   widest bound (bit length)   nodes with a bound past i64
#   --------   -----   ------------------------   ---------------------------
#   matmul       232            96                        21
#   conv         328            96                        24
#   sum          198            96                        13
#   arange        31            32                         0
#
# and the values past i64 are `dtypes.u64.max` = 2**64-1 and `uint64.max << 10`.
# So the honest width is NOT 64 bits. Two facts decide what this port can do:
#
#   1. `U32.shrn`/`shln` and `Nat` are the runtime's only numbers, and `Nat` REFUSES
#      past 2**48-1 (`.agents/slop/notes/bend2-constraints.md`; `Nat.pow(2n,70n)`
#      prints "a Nat past the largest immediate 2^48-1"). A 65-bit value is not a
#      runtime number in Bend 2.0.34 at all.
#   2. `H.I64` is a HAND-ROLLED PAIR, so a magnitude wider than 2**64-1 is
#      expressible in principle and absent in practice.
#
# The port is therefore a SIGN BIT PLUS AN UNSIGNED 64-BIT MAGNITUDE, which covers
# [-2**63, 2**64-1] -- every dtype limit tinygrad has, INCLUDING `uint64.max`, which
# a signed I64 cannot hold. When an INTERMEDIATE leaves that window the answer is
# `PInf`/`NInf`, and that is not a fudge: a value at or beyond 2**64 is at or beyond
# every dtype limit, so widening to infinity is a sound OVER-APPROXIMATION and every
# consumer of `_min_max` asks a question an over-approximation still answers
# (`resolve` asks whether vmin is zero; `shard_shape` asks for a count).
#
# THE THREE BUGS THAT MATURED IN THE ARITHMETIC, all measured against CPython and
# all of them silent, since each produced a plausible number:
#   * `Bool.or(is_zero(lo), is_zero(hi))` reads as "the pair is zero" and is not --
#     it reads as "SOME word is zero", so 2**32 came out as a product of zero.
#   * the underflow test for an unsigned subtract is `a < b`, and NOT `result < a`;
#     the second is what an ADD overflows on and it is the wrong predicate here.
#   * in a 64x64 product `s` IS limb 1 and `u` IS limb 2, so the overflow test is
#     `u != 0 or t3.hi != 0`, and NOT `t3.hi + (u >> 32) != 0` (that sum wraps).
# ===========================================================================

type Bound is Data:
  NInf{}                       # below every representable value
  PInf{}                       # above every representable value
  Int{neg: Bool, mag: H.I64}   # exact integer: 0 <= mag <= 2**64-1
  Flt{bits: U32}               # an exact f32 image, as its IEEE bits

type MinMax is Data:
  MinMax{lo: Bound, hi: Bound}

def Bound.int(neg: Bool, mag: H.I64) -> Bound:
  Int{neg, mag}

def Bound.zero() -> Bound: Int{False{}, H.i64_of_hi_lo(0, 0)}

# ===========================================================================
# THE UNSIGNED 64-BIT CORE, on the `hi`/`lo` pair, overflow-ANSWERING. `None` is the
# overflow and every caller turns it into `PInf`/`NInf`, which is the ONE place this
# port knowingly differs from CPython and the difference is an over-approximation.
# ===========================================================================

def u64.of(ok: Bool, +hi: U32, +lo: U32) -> Maybe<&2, H.I64>:
  match ok:
    case True{}: Some{H.i64_of_hi_lo(hi, lo)}
    case False{}: None{}

def u64.lt(+eh: U32, el: U32, +fh: U32, fl: U32) -> Bool:
  Bool.or(U32.is_lt(eh, fh), Bool.and(U32.is_eq(eh, fh), U32.is_lt(el, fl)))

def u64.le(+eh: U32, el: U32, +fh: U32, fl: U32) -> Bool:
  Bool.or(U32.is_lt(eh, fh), Bool.and(U32.is_eq(eh, fh), U32.is_le(el, fl)))

def u64.eq(+eh: U32, el: U32, fh: U32, fl: U32) -> Bool:
  Bool.and(U32.is_eq(eh, fh), U32.is_eq(el, fl))

# "this pair is zero", which is what every overflow test asks. IT IS `and`: `or`
# answers true for (0, 5) as well as for (0, 0), and that is how 2**32 came out as a
# product of zero.
def u64.is_zero(+hi: U32, lo: U32) -> Bool:
  Bool.and(U32.is_zero(lo), U32.is_zero(hi))

def u64.is_one(+hi: U32, lo: U32) -> Bool:
  Bool.and(U32.is_zero(hi), U32.is_eq(lo, 1))

# the carry out of `U32.add`, which is its own overflow test
def u32c(+a: U32, b: U32) -> U32:
  Bool.pick(U32, U32.is_lt(U32.add(a, b), a), 1, 0)

def u64.add(+ah: U32, +al: U32, bh: U32, +bl: U32) -> Maybe<&2, H.I64>:
  +lo = U32.add(al, bl)
  +hi = U32.add(U32.add(ah, bh), u32c(al, bl))
  u64.of(Bool.not(u64.lt(hi, lo, ah, al)), hi, lo)

# WRAPPING, because restoring division needs `r - d` mod 2**64 and the borrow there
# is answered by the shift's own carried bit rather than by the subtraction.
def u64w.sub(+ah: U32, +al: U32, +bh: U32, +bl: U32) -> H.I64:
  H.i64_of_hi_lo(U32.sub(ah, U32.add(bh, u32c(bl, U32.sub(al, bl)))), U32.sub(al, bl))

# The underflow test is `a < b`, NOT `result < a`. The second is what an ADD
# overflows on and it is silently the wrong predicate for a subtraction: `0 - 2**32`
# wraps to a value GREATER than `a` and so reads as no underflow at all.
def u64.sub(+ah: U32, +al: U32, +bh: U32, +bl: U32) -> Maybe<&2, H.I64>:
  +lo = U32.sub(al, bl)
  +hi = U32.sub(ah, U32.add(bh, u32c(bl, U32.sub(al, bl))))
  u64.of(Bool.not(u64.lt(ah, al, bh, bl)), hi, lo)

# ---- MUL ---------------------------------------------------------------------
#
# A 64x64 product is 128 bits, so the answer is the HIGH word and every bit from
# 2**64 up is the overflow.
#
# THE LIMBS ARE 16 WIDE, and that is the whole trick. `U32.mul` wraps, so a 32x32
# product cannot be overflow-tested at all -- `U32.mul(a,b)/a == b` holds for a
# wrapped product of a particular size as readily as for an exact one. A 16x16
# product is BELOW 2**32, so `U32.mul` is exact on it, and the four partials
# accumulate with every column sum under 2**20 -- no wrap test anywhere in this
# section.
def u32x16(+x: U32) -> U32: U32.shrn(x, 16n)

def u32lo16(+x: U32) -> U32: U32.and(x, 65535)

# a*b = p0 + (p1+p2)*2**16 + p3*2**32 over 16-bit halves, which is the statement
# `u32m.wide`'s three `n` lines are.
def u32m.wide(+p0: U32, +p1: U32, +p2: U32, +p3: U32) -> H.I64:
  +n1 = U32.add(U32.add(u32lo16(p1), u32lo16(p2)), u32x16(p0))
  +n2 = U32.add(U32.add(U32.add(u32x16(p1), u32x16(p2)), u32lo16(p3)), u32x16(n1))
  +n3 = U32.add(u32x16(p3), u32x16(n2))
  H.i64_of_hi_lo(U32.or(u32lo16(n2), U32.shln(u32lo16(n3), 16n)),
    U32.or(u32lo16(p0), U32.shln(u32lo16(n1), 16n)))

def u32m(+a: U32, +b: U32) -> H.I64:
  u32m.wide(U32.mul(u32lo16(a), u32lo16(b)), U32.mul(u32lo16(a), u32x16(b)),
    U32.mul(u32x16(a), u32lo16(b)), U32.mul(u32x16(a), u32x16(b)))

# The 64x64 combination is THREE columns wide, so each is under 2**34 and cannot
# wrap either.
def u64.join(+t0: H.I64, +t1: H.I64, +t2: H.I64, +t3: H.I64) -> Maybe<&2, H.I64>:
  +s = U32.add(U32.add(H.hi32(t0), H.lo32(t1)), H.lo32(t2))
  +u = U32.add(U32.add(U32.add(H.hi32(t1), H.hi32(t2)), H.lo32(t3)), U32.shrn(s, 32n))
  # `s` IS LIMB 1 and `u` IS LIMB 2 -- the WORDS, not partial words -- so every bit
  # of `u` is already above 2**64 and the overflow test is `u != 0 or t3.hi != 0`.
  # It is NOT `t3.hi + (u >> 32) != 0`, which wraps a U32 and reads as zero for a
  # product that overflowed. Nor can `u << 32` build the high word: a U32 shift by
  # 32 SATURATES TO 0 (bend2-constraints, the `1 << 34` trap).
  u64.of(Bool.and(u64.is_zero(H.hi32(t3), 0), u64.is_zero(u, 0)),
    U32.or(U32.and(s, 4294967295), U32.shln(U32.and(u, 4294967295), 32n)),
    H.lo32(t0))

def u64.mul(+ah: U32, +al: U32, +bh: U32, +bl: U32) -> Maybe<&2, H.I64>:
  u64.join(u32m(al, bl), u32m(al, bh), u32m(ah, bl), u32m(ah, bh))

# ---- THE SHIFTS --------------------------------------------------------------
#
# `U32.shl` is a ONE-BIT shift and `U32.shln(x, n)` is the n-bit one, so every shift
# AMOUNT below is a `Nat`. That is the whole of the rule bend2-constraints records:
# a bit-packer whose field positions are runtime values is UNWRITABLE, so the
# amounts here are `Nat` differences and not `U32`s. `Nat.sub` underflows to 0, which
# is what makes the eagerly-evaluated other arm harmless.
# ---- THE BIT COUNT -----------------------------------------------------------
#
# `int(x).bit_length()` is the AND arm's mask width (ops.py:1110) and it is a COUNT,
# so it is a `Nat` and the doubling below is the only way to get one.
# THE ZERO TEST IS A MATCH ON THE TWO WORDS THEMSELVES, not on a computed Bool: Bend
# refuses `match` on a call, and `u64.is_zero(...)` is a call. The words are
# parameters, so `case 0 0:` is a legal scrutinee -- and this is the only place in
# the section where the PATTERN carries the answer instead of a flag.
# OVERFLOW IS DECIDED FROM THE SHIFT AMOUNT AND THE WORDS, NOT FROM A BIT COUNT.
# `bit_length` is the obvious test and it is NOT AVAILABLE: it needs a walk whose
# zero test cannot be a `match` scrutinee (Bend refuses a call), whose growing
# counter cannot lead a self-call, and whose test and step cannot be two defs
# because mutual recursion is refused. So `shl` overflows iff `a >= 2**(64-k)`, which
# is one word and one shift:
#   k <= 32   the bits at position >= 64-k all live in the HIGH word, at 32-k
#   k >  32   they straddle: `ah != 0` already decides it, else `al` at 64-k
def u64.shl.lo(+ah: U32, +al: U32, +k: Nat) -> H.I64:
  H.i64_of_hi_lo(U32.or(U32.shln(ah, k), U32.shrn(al, Nat.sub(32n, k))), U32.shln(al, k))

# FOR `k >= 32` THE HIGH WORD COMES FROM `al` AND ONLY FROM `al`: `a * 2**k` has
# high word `al * 2**(k-32)` plus `ah * 2**k` reduced mod 2**32, and the second term
# is 0 for every k past 31. Reading `ah` here instead drops the low word entirely and
# answers 0 for `1 << 63`, which is `2147483648:0`.
def u64.shl.hi(+ah: U32, +al: U32, +k: Nat) -> H.I64:
  H.i64_of_hi_lo(U32.shln(al, Nat.sub(k, 32n)), 0)

def u64.shl.lo_half(+k: Nat) -> Bool:
  U32.is_lt(U32.from_nat(k), 32)

def u64.shl.put(lo: Bool, +ah: U32, +al: U32, +k: Nat) -> H.I64:
  Bool.pick(H.I64, lo, u64.shl.lo(ah, al, k), u64.shl.hi(ah, al, k))

def u64.shl.under32(+k: Nat) -> Bool:
  U32.is_le(U32.from_nat(k), 32)

def u64.shl.lost32(+k: Nat) -> Nat: Nat.sub(32n, k)

def u64.shl.lost64(+k: Nat) -> Nat: Nat.sub(64n, k)

def u64.shl.lost(+k: Nat) -> Nat:
  Bool.pick(Nat, u64.shl.under32(k), u64.shl.lost32(k), u64.shl.lost64(k))

def u64.shl.ok32(+ah: U32, al: U32, +k: Nat) -> Bool:
  Bool.pick(Bool, U32.is_zero(U32.from_nat(k)), True{},
    U32.is_zero(U32.shrn(ah, u64.shl.lost(k))))

# `and`, NOT `or`: overflow is `ah != 0 OR al's tail is nonzero`, so the FIT test is
# both-zero. `or` fits every divisor-shaped word and answers a value where CPython
# says OVER -- 1 << 64 is the row that notices.
def u64.shl.okhi(+ah: U32, al: U32, +k: Nat) -> Bool:
  Bool.and(U32.is_zero(ah), U32.is_zero(U32.shrn(al, u64.shl.lost(k))))

def u64.shl.ok(+ah: U32, +al: U32, +k: Nat) -> Bool:
  Bool.pick(Bool, u64.shl.under32(k), u64.shl.ok32(ah, al, k), u64.shl.okhi(ah, al, k))

def u64.shl.of(ok: Bool, +ah: U32, +al: U32, +k: Nat) -> Maybe<&2, H.I64>:
  match ok:
    case True{}: Some{u64.shl.put(u64.shl.lo_half(k), ah, al, k)}
    case False{}: None{}

def u64.shl(+ah: U32, +al: U32, +k: Nat) -> Maybe<&2, H.I64>:
  u64.shl.of(u64.shl.ok(ah, al, k), ah, al, k)

def u64.shr.go(+k: Nat, +ah: U32, +al: U32) -> H.I64:
  match k:
    case 0n: H.i64_of_hi_lo(ah, al)
    case 1n+p: u64.shr.go(p, U32.shrn(ah, 1n), U32.or(U32.shrn(al, 1n), U32.shln(U32.and(ah, 1), 31n)))

def u64.shr(+ah: U32, +al: U32, +k: Nat) -> H.I64:
  u64.shr.go(k, ah, al)


# ---- BITWISE, on the two halves ------------------------------------------------
#
# `_min_max` reaches bitwise arithmetic on NON-NEGATIVE bounds only -- the AND arm
# masks with `(1 << bit_length) - 1` and the XOR arm is `~x`, which is `-x - 1` and
# not a bit pattern. So two's-complement sign extension is never needed and is not
# here; a general infinite-width `&` is the one thing this section does NOT have.

def u64.and(ah: U32, al: U32, bh: U32, bl: U32) -> H.I64:
  H.i64_of_hi_lo(U32.and(ah, bh), U32.and(al, bl))

def u64.or(ah: U32, al: U32, bh: U32, bl: U32) -> H.I64:
  H.i64_of_hi_lo(U32.or(ah, bh), U32.or(al, bl))

def u64.xor(ah: U32, al: U32, bh: U32, bl: U32) -> H.I64:
  H.i64_of_hi_lo(U32.xor(ah, bh), U32.xor(al, bl))

def u64.not(ah: U32, al: U32) -> H.I64:
  H.i64_of_hi_lo(U32.not(ah), U32.not(al))
# ---- RESTORING DIVISION --------------------------------------------------------
#
# `helpers.bend` already has `cdiv_i32_go` and `floordiv_i32`, and both are this
# algorithm on a smaller pair: the QUOTIENT is truncated, then stepped DOWN one more
# only when the division was inexact and the two signs differ. So the sign work is
# REUSED and only the 64-step division is new.
#
# `qb` IS THE QUOTIENT BIT FOR THIS STEP, carried because the compare happens before
# the bit is known and restoring division sets a quotient bit exactly when it
# subtracts. Setting it unconditionally answers 1 for every step, which is a
# quotient of all ones and a remainder of the dividend.
type St is Data:
  St{qh: U32, ql: U32, rh: U32, rl: U32, up: Bool, qb: Bool}

def St.qh(x: St) -> U32:
  match x:
    case St{qh, ql, rh, rl, up, qb}: qh

def St.ql(x: St) -> U32:
  match x:
    case St{qh, ql, rh, rl, up, qb}: ql

def St.rh(x: St) -> U32:
  match x:
    case St{qh, ql, rh, rl, up, qb}: rh

def St.rl(x: St) -> U32:
  match x:
    case St{qh, ql, rh, rl, up, qb}: rl

def St.up(x: St) -> Bool:
  match x:
    case St{qh, ql, rh, rl, up, qb}: up

def St.qb(x: St) -> Bool:
  match x:
    case St{qh, ql, rh, rl, up, qb}: qb

# `k < 32` puts bit `k` in the LOW word, so this flag names the LOW half. Both picks
# below read it as "pick the low arm", and getting those two arms the wrong way round
# reads every dividend bit out of the wrong half and the quotient comes out zero.
def dm.low_half(k: Nat) -> Bool:
  U32.is_lt(U32.from_nat(k), 32)

# STEP `k` READS DIVIDEND BIT `k` AND WRITES QUOTIENT BIT `k` -- the same index on
# both sides, which is the whole of restoring division and the reason the walk counts
# DOWN from 63: the first bit processed is the most significant of each.
#
# `U32.shrn(w, j)` is `w >> j` and NOT `(w >> j) & 1`, and the caller ORs the answer
# straight into the low word of the remainder, so both arms mask.
def dm.bit.hi(+bh: U32, +bl: U32, +k: Nat) -> U32:
  U32.and(U32.shrn(bh, Nat.sub(k, 32n)), 1)

def dm.bit.lo(+bh: U32, +bl: U32, +k: Nat) -> U32:
  U32.and(U32.shrn(bl, k), 1)

def dm.bit(+bh: U32, +bl: U32, +k: Nat, low: Bool) -> U32:
  Bool.pick(U32, low, dm.bit.lo(bh, bl, k), dm.bit.hi(bh, bl, k))

def dm.get_bit(+bh: U32, +bl: U32, +k: Nat) -> U32:
  dm.bit(bh, bl, k, dm.low_half(k))

def dm.put(qh: U32, ql: U32, +r: H.I64) -> St:
  match r:
    case H.I64{nh, nl}: St{qh, ql, nh, nl, False{}, True{} }

# `r = 2r + bit`, WITH the 65th bit kept rather than lost: a U32 shift of 1 by 1
# drops the top of the high word, and that bit is the one that decides the compare.
def dm.shift(+s: St, bit: U32) -> St:
  St{St.qh(s), St.ql(s), U32.or(U32.shln(St.rh(s), 1n), U32.shrn(St.rl(s), 31n)),
    U32.or(U32.shln(St.rl(s), 1n), bit), U32.is_eq(U32.shrn(St.rh(s), 31n), 1), False{}}

def dm.drop(+s: St, +dh: U32, +dl: U32) -> St:
  dm.put(St.qh(s), St.ql(s), u64w.sub(St.rh(s), St.rl(s), dh, dl))

# `(up, r) >= d`: ONE subtract is enough, because the invariant is `r < d` before
# the step, so `up` alone already decides the comparison. The compare is `>= d` and
# NOT `<= d`: subtracting on every step where the remainder is merely BELOW the
# divisor answers a quotient of all ones for any dividend smaller than the divisor.
def dm.same(+s: St) -> St:
  St{St.qh(s), St.ql(s), St.rh(s), St.rl(s), St.up(s), False{}}

def dm.cmp(ge: Bool, s: St, +dh: U32, +dl: U32) -> St:
  match ge:
    case True{}: dm.drop(s, dh, dl)
    case False{}: dm.same(s)

def dm.fit(+s: St, +dh: U32, +dl: U32) -> St:
  dm.cmp(Bool.or(St.up(s), Bool.not(u64.lt(St.rh(s), St.rl(s), dh, dl))), s, dh, dl)

# THE QUOTIENT BIT IS AT POSITION `k`, THE SAME INDEX THE DIVIDEND BIT CAME FROM, so
# each arm shifts by exactly what `dm.bit` shifted by.
def dm.qbit.hi(+k: Nat, +s: St) -> St:
  St{U32.or(St.qh(s), U32.shln(1, Nat.sub(k, 32n))), St.ql(s), St.rh(s), St.rl(s), False{}, False{}}

def dm.qbit.lo(+k: Nat, +s: St) -> St:
  St{St.qh(s), U32.or(St.ql(s), U32.shln(1, k)), St.rh(s), St.rl(s), False{}, False{}}

def dm.qbit.at(low: Bool, +k: Nat, set: Bool, +s: St) -> St:
  Bool.pick(St, Bool.not(set), s, Bool.pick(St, low, dm.qbit.lo(k, s), dm.qbit.hi(k, s)))

def dm.step(+k: Nat, +s: St, +bh: U32, +bl: U32, +dh: U32, +dl: U32) -> St:
  +f = dm.fit(dm.shift(s, dm.get_bit(bh, bl, k)), dh, dl)
  dm.qbit.at(dm.low_half(k), k, St.qb(f), f)

# THE COUNTER IS A PARAMETER WITH `+`, not a field of the state: `case 1n+p:` SPENDS
# `p` on the match, so `p` cannot be read twice -- and the fix is `+` on the
# SCRUTINEE, never on the binder (bend2-constraints, the `1n+p` rule 5).
def dm.loop(+k: Nat, +bh: U32, +bl: U32, +dh: U32, +dl: U32, +s: St) -> St:
  match k:
    case 0n: s
    case 1n+p: dm.loop(p, bh, bl, dh, dl, dm.step(p, s, bh, bl, dh, dl))

def dm_run(nh: U32, nl: U32, dh: U32, dl: U32) -> St:
  dm.loop(63n, nh, nl, dh, dl, St{0, 0, 0, 0, False{}, False{}})

def dm_show(+d: St) -> String:
  String.concat(["q=", H.i64_text(H.i64_of_hi_lo(St.qh(d), St.ql(d))), " r=", H.i64_text(H.i64_of_hi_lo(St.rh(d), St.rl(d)))])

def mm_show(m: Maybe<&2, H.I64>) -> String:
  match m:
    case Some{x}: H.i64_text(x)
    case None{}: "OVER"

def mm_row(nm: String, got: String) -> IO(Unit):
  IO.print(String.concat(["mm_", nm, " ", got]))

def mm_main() -> IO(Unit):
  do IO<Unit>:
    mm_row("add_zero", mm_show(u64.add(0, 0, 0, 0)))
    mm_row("add_small", mm_show(u64.add(0, 5, 0, 7)))
    mm_row("add_carrylo", mm_show(u64.add(0, 4294967295, 0, 1)))
    mm_row("add_carryhi", mm_show(u64.add(0, 1, 0, 4294967295)))
    mm_row("add_hilo", mm_show(u64.add(1, 0, 0, 4294967295)))
    mm_row("add_over64", mm_show(u64.add(1, 0, 4294967295, 4294967295)))
