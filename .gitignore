# --- tinybendygrad additions -------------------------------------------
# The pinned Bend 2 compiler. It is a toolchain dependency, not part of the
# port, so it stays out of history (clone it with tools/get-bend.sh).
/vendor/

# bin/ is tiny launcher scripts for the vendored toolchain.
/bin/bend

# The Bend port's build output: compiled kernels, the JIT cache, and the
# native binaries `bend x.bend -o x` produces.
bendgrad/**/*.bin
bendgrad/**/*.gpu
bendgrad/**/.build/
bendgrad/**/kernel_cache/

# Python scratch from the oracle harness. The Python tinygrad/ tree itself is
# tracked and must stay pristine: it is what the port is measured against.
__pycache__/
*.py[cod]
*.egg-info/
.hypothesis/
.venv/
